# Copy to C:\BackUp\backup-1c.secret.ps1 on S2016 (same machine as night DumpIB / SQL bak).
# Do not commit the real file. Keep ACL: Administrators (+ SYSTEM for scheduled tasks) only.

# Infobase user (same as old bat /n /p) — used by Backup-1C-Forma.ps1 DumpIB
$IbUser = 'Admin'
$IbPassword = 'CHANGE_ME'

# Cluster admin (usually empty on club server). Fill only if rac requires it.
$ClusterUser = ''
$ClusterPassword = ''

# SQL Server login — used by Backup-1C-Forma-SQL.ps1 (compressed .bak)
# Same sa you use in SSMS. Windows auth (FORMA\Администратор) often has no SQL login.
$SqlServerInstance = 'localhost'
$SqlDatabase = 'forma'
$SqlUser = 'sa'
$SqlPassword = 'CHANGE_ME_SQL_SA'
