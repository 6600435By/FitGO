// Разовая проверка метаданных рассрочки Документ.Продажа.
// Вставить в консоль кода / внешнюю обработку на сервере 1С.

Процедура ВыполнитьПробу() Экспорт
    Сообщить("=== FitGO probe: ШаблоныРассрочек / Продажа ===");

    ЕстьСправочник = Метаданные.Справочники.Найти("ШаблоныРассрочек") <> Неопределено;
    Сообщить("Справочник.ШаблоныРассрочек: " + ?(ЕстьСправочник, "есть", "НЕТ"));

    МД = Метаданные.Документы.Найти("Продажа");
    Если МД = Неопределено Тогда
        Сообщить("Документ.Продажа не найден");
        Возврат;
    КонецЕсли;

    Сообщить("--- Реквизиты (имя / типы) ---");
    Для Каждого Рекв Из МД.Реквизиты Цикл
        Типы = "";
        Для Каждого Т Из Рекв.Тип.Типы() Цикл
            Типы = Типы + Строка(Т) + ";";
        КонецЦикла;
        Если СтрНайти(ВРег(Рекв.Имя), "РАССРОЧ") > 0
            ИЛИ СтрНайти(ВРег(Рекв.Имя), "ШАБЛОН") > 0
            ИЛИ СтрНайти(ВРег(Типы), "ШАБЛОНЫРАССРОЧЕК") > 0 Тогда
            Сообщить("  * " + Рекв.Имя + " :: " + Типы);
        КонецЕсли;
    КонецЦикла;

    Сообщить("--- Табличные части ---");
    Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
        Имя = ВРег(ТЧ.Имя);
        Если СтрНайти(Имя, "РАССРОЧ") > 0
            ИЛИ СтрНайти(Имя, "ПЛАТЕЖ") > 0
            ИЛИ СтрНайти(Имя, "ГРАФИК") > 0 Тогда
            Сообщить("  ТЧ " + ТЧ.Имя);
            Для Каждого Кол Из ТЧ.Реквизиты Цикл
                Сообщить("    - " + Кол.Имя);
            КонецЦикла;
        КонецЕсли;
    КонецЦикла;

    Сообщить("=== конец пробы ===");
КонецПроцедуры
