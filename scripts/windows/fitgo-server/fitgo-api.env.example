# Copy to <InstallRoot>\FitGO\apps\api\.env  (never commit real secrets)

DATABASE_URL="postgresql://fitgo:CHANGE_ME@127.0.0.1:5432/fitgo?schema=public"

API_PORT=3001
JWT_SECRET="CHANGE_ME_at_least_32_chars_random"
JWT_EXPIRES_IN="7d"
# Admin web (LAN) + specialist portal (Cloudflare Pages) — comma-separated
CORS_ORIGIN="http://127.0.0.1:3000,http://localhost:3000,http://192.168.1.20:3000"
WEB_URL="http://127.0.0.1:3000"

NODE_ENV=production
# Club 1C uses self-signed TLS on :8445
NODE_TLS_REJECT_UNAUTHORIZED=0

FITNESS_PROVIDER=forma
# LAN to 1C on the same Windows box (or club LAN IP)
FORMA_BASE_URL=https://127.0.0.1:444/forma/hs/api/v3
FORMA_FITGO_URL=https://127.0.0.1:8445/fitgo/hs/fitgo/v1
FORMA_ANALYTICS_URL=https://127.0.0.1:8445/fitgo/hs/analytics/v1
FORMA_CLUB_ID=97f057be-defe-11e6-af15-784561bf6e7c
FORMA_API_KEY=
FORMA_BASIC_AUTH=

ENABLE_ADMIN_SALES_CRON=true
ENABLE_NOTIFICATION_CRON=true

# OSMI optional — leave mock until cards are needed
OSMI_ENABLED=true
OSMI_PROVIDER=mock

# Minimal seed on first install (Install-FitGO.ps1 sets these)
# FITGO_SEED_MODE=minimal
# FITGO_SUPERADMIN_EMAIL=superadmin@club.local
# FITGO_SUPERADMIN_PASSWORD=
