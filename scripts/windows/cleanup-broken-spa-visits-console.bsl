// Вставить целиком в «Консоль кода» / «Выполнить» в режиме 1С:Предприятие
// (не в конфигураторе). Не открывает форму — только объектный API.
// УДАЛЯЕТ напрямую Документ.Занятие с комментарием FitGO SPA и ПУСТЫМ СоставЗанятия
// (именно пустая ТЧ роняет ФормаПосещенияСалонаКрасоты на [0]).
// PAID-визит со строкой, но без ОснованиеОплаты — валиден, НЕ трогаем.
// Прямое Удалить() вместо пометки: стандартное «Удаление помеченных» открывает форму → краш.

Мд = Метаданные.Документы.Найти("Занятие");
Если Мд = Неопределено Тогда
	Сообщить("Документ.Занятие не найден");
Иначе
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата
	|ИЗ
	|	Документ.Занятие КАК Док
	|ГДЕ
	|	Док.Комментарий ПОДОБНО &Коммент";
	Запрос.УстановитьПараметр("Коммент", "%FitGO SPA%");
	Выборка = Запрос.Выполнить().Выбрать();
	Удалено = 0;
	Пропущено = 0;
	Ошибки = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			Док = Выборка.Ссылка.ПолучитьОбъект();
			Пустой = Истина;
			Попытка
				Пустой = (Док.СоставЗанятия.Количество() < 1);
			Исключение
				Пустой = Истина;
			КонецПопытки;
			Если НЕ Пустой Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Если Док.Проведен Тогда
				Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Док.Удалить();
			Удалено = Удалено + 1;
			Сообщить("DEL " + Выборка.Номер + " " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy HH:mm"));
		Исключение
			Ошибки = Ошибки + 1;
			Сообщить("ERR " + Выборка.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Сообщить("Итого: удалено=" + Удалено + " пропущено(валидные)=" + Пропущено + " ошибок=" + Ошибки);
КонецЕсли;
