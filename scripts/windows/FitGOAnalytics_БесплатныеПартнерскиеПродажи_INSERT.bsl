// Бесплатные партнёрские продажи (Allsports биоимпеданс): строки Запасы с Сумма=0.
// Основной запрос по Оборотам отбрасывает СтоимостьОборот=0 — их нет в кассе.
// Важно: в шапке FFS «Реализация» часто нет реквизита Сотрудник (есть Автор/Продавец) —
// обращение к ТЧ.Ссылка.Сотрудник роняло весь запрос в Пустой массив (тихий Except).
Функция ПолучитьБесплатныеПартнерскиеПродажи(ДатаНачала, ДатаОкончания, Сотрудник)
    Результат = Новый Массив;
    ИменаДок = Новый Массив;
    // FFS: документ продажи = «Реализация» (синоним «Продажа»).
    ИменаДок.Добавить("Реализация");
    ИменаДок.Добавить("Продажа");

    Для Каждого ИмяДок Из ИменаДок Цикл
        Таблица = ВыбратьБесплатныеСтрокиЗапасов(ИмяДок, ДатаНачала, ДатаОкончания, Сотрудник, Истина);
        Если Таблица = Неопределено Тогда
            // Нет поля Сумма / иное — берём все строки периода, ноль отфильтруем в коде.
            Таблица = ВыбратьБесплатныеСтрокиЗапасов(ИмяДок, ДатаНачала, ДатаОкончания, Сотрудник, Ложь);
        КонецЕсли;
        Если Таблица = Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Для Каждого Строка Из Таблица Цикл
            ИмяНом = СокрЛП(Строка(Строка.Номенклатура));
            Если НЕ ЭтоНазваниеБиоимпеданса(ИмяНом) Тогда
                Продолжить;
            КонецЕсли;
            СуммаСтроки = 0;
            Попытка
                СуммаСтроки = Число(Строка.СуммаСтроки);
            Исключение
                СуммаСтроки = 0;
            КонецПопытки;
            Если СуммаСтроки > 0.009 Или СуммаСтроки < -0.009 Тогда
                Продолжить;
            КонецЕсли;
            Элемент = БесплатнаяПартнерскаяПродажаВJSON(Строка);
            Если Элемент <> Неопределено Тогда
                Результат.Добавить(Элемент);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Без ТЧ.Ссылка.Сотрудник — в шапке Реализации его часто нет.
Функция ВыбратьБесплатныеСтрокиЗапасов(ИмяДок, ДатаНачала, ДатаОкончания, Сотрудник, ФильтрСуммаНоль)
    Текст =
    "ВЫБРАТЬ
    |    ТЧ.Ссылка КАК ДокументПродажи,
    |    ТЧ.Ссылка.Дата КАК Период,
    |    ТЧ.Ссылка.Контрагент КАК Контрагент,
    |    ТЧ.Номенклатура КАК Номенклатура,
    |    ТЧ.Сотрудник КАК Исполнитель,
    |    ЕСТЬNULL(ТЧ.Сумма, 0) КАК СуммаСтроки
    |ИЗ
    |    Документ." + ИмяДок + ".Запасы КАК ТЧ
    |ГДЕ
    |    ТЧ.Ссылка.Проведен
    |    И ТЧ.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
    |    И НЕ ТЧ.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)";
    Если ФильтрСуммаНоль Тогда
        Текст = Текст + "
    |    И ЕСТЬNULL(ТЧ.Сумма, 0) = 0";
    КонецЕсли;
    Если ЗначениеЗаполнено(Сотрудник) Тогда
        Текст = Текст + "
    |    И ТЧ.Сотрудник = &Сотрудник";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст = Текст;
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    Если ЗначениеЗаполнено(Сотрудник) Тогда
        Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    КонецЕсли;

    Попытка
        Возврат Запрос.Выполнить().Выгрузить();
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ЭтоНазваниеБиоимпеданса(ИмяУслуги)
    С = НРег(СокрЛП(Строка(ИмяУслуги)));
    Если ПустаяСтрока(С) Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрНайти(С, "биоимпеданс") > 0 Или СтрНайти(С, "bioimped") > 0 Тогда
        Возврат Истина;
    КонецЕсли;
    Если СтрНайти(С, "allsports") > 0 И СтрНайти(С, "биоимп") > 0 Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Ложь;
КонецФункции

Функция БесплатнаяПартнерскаяПродажаВJSON(Строка)
    Если НЕ ЗначениеЗаполнено(Строка.ДокументПродажи) Тогда
        Возврат Неопределено;
    КонецЕсли;

    КлючСтроки = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.ДокументПродажи)
        + ":" + FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Номенклатура)
        + ":" + Формат(Строка.Период, "ДФ=yyyyMMddHHmmss")
        + ":free";

    Элемент = Новый Структура;
    Элемент.Вставить("saleDocumentId", КлючСтроки);
    Элемент.Вставить("documentId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.ДокументПродажи));
    Элемент.Вставить("operationType", "sale");
    Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    Элемент.Вставить("paidAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    Элемент.Вставить("amount", 0);
    Элемент.Вставить("saleAmount", 0);
    Элемент.Вставить("amountAttributed", 0);
    Элемент.Вставить("attributionMode", "none");
    Элемент.Вставить("shiftSize", 1);
    Элемент.Вставить("paidAmount", 0);
    Элемент.Вставить("refundAmount", 0);
    Элемент.Вставить("cash", 0);
    Элемент.Вставить("card", 0);
    Элемент.Вставить("cashless", 0);
    Элемент.Вставить("personalAccount", 0);
    Элемент.Вставить("paymentMethod", "complimentary");
    Элемент.Вставить("saleType", "service");
    Элемент.Вставить("productName", Строка(Строка.Номенклатура));
    Элемент.Вставить("productExternalId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Номенклатура));

    КодНом = "";
    ГруппаНом = "";
    Попытка
        КодНом = СокрЛП(Строка(Строка.Номенклатура.Код));
    Исключение
    КонецПопытки;
    Попытка
        Если ЗначениеЗаполнено(Строка.Номенклатура.Родитель) Тогда
            ГруппаНом = СокрЛП(Строка(Строка.Номенклатура.Родитель));
        КонецЕсли;
    Исключение
    КонецПопытки;
    Элемент.Вставить("productCode", КодНом);
    Элемент.Вставить("productGroupName", ГруппаНом);
    Элемент.Вставить("clientExternalId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент));
    Элемент.Вставить("clientName", Строка(Строка.Контрагент));

    // Менеджер/автор — из шапки/регистра (не ТЧ.Ссылка.Сотрудник: поля может не быть).
    СотрДок = АвторПродажиИзРегистра(Строка.ДокументПродажи);
    Если ПустаяСтрока(СотрДок.Имя) Тогда
        СотрДок = СотрудникИзДокумента(Строка.ДокументПродажи);
    КонецЕсли;
    Элемент.Вставить("employeeExternalId", СокрЛП(Строка(СотрДок.Код)));
    Элемент.Вставить("employeeName", СокрЛП(Строка(СотрДок.Имя)));

    // Исполнитель из ТЧ Запасы.Сотрудник (на скрине — Бирюкова).
    Если ЗначениеЗаполнено(Строка.Исполнитель) Тогда
        Попытка
            Элемент.Вставить("performerExternalId", СокрЛП(Строка(Строка.Исполнитель.Код)));
            Элемент.Вставить("performerName", Строка(Строка.Исполнитель));
        Исключение
        КонецПопытки;
    Иначе
        Исп = ИсполнительИзДокументаПродажи(Строка.ДокументПродажи, Строка.Номенклатура);
        Если Исп <> Неопределено И НЕ ПустаяСтрока(Исп.Имя) Тогда
            Элемент.Вставить("performerExternalId", Исп.Код);
            Элемент.Вставить("performerName", Исп.Имя);
        КонецЕсли;
    КонецЕсли;

    Элемент.Вставить("countsTowardIncome", Ложь);
    Элемент.Вставить("countsTowardMotivation", Истина);
    Возврат Элемент;
КонецФункции

