// Заготовка HTTP GET /discounts для FitGOAnalytics.
// Вставить в модуль HTTP-сервиса Analytics рядом с /sales.
// ПОЛЯ ЗАПОЛНЯТЬ ТОЛЬКО ПОСЛЕ СЪЁМА СКД Отчет.ПредоставленныеСкидки —
// не подставлять имена колонок наугад.
//
// Эталон: e1cib/app/Отчет.ПредоставленныеСкидки
// Docs: FitGOAnalytics_Discounts.md

Функция Discounts(Запрос)
    // from / to — обязательные query-параметры (YYYY-MM-DD).
    FromStr = Запрос.ПараметрыЗапроса.Получить("from");
    ToStr = Запрос.ПараметрыЗапроса.Получить("to");
    Если ПустаяСтрока(FromStr) Или ПустаяСтрока(ToStr) Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибка(400, "from and to required");
    КонецЕсли;

    // TODO: после съёма СКД — выполнить запрос отчёта за период и заполнить items.
    // Пока возвращаем пустой список (HTTP 200), чтобы Nest мог отличить
    // «метод есть, данных нет» от 404 «endpoint_missing».

    Данные = Новый Структура;
    Данные.Вставить("from", FromStr);
    Данные.Вставить("to", ToStr);
    Данные.Вставить("items", Новый Массив);
    Данные.Вставить("note", "Stub: fill from Отчет.ПредоставленныеСкидки after schema dump");

    Возврат FitGOAnalyticsОбщегоНазначения.ОтветJSON(Данные);
КонецФункции
