Функция StatsRevenueGET(Запрос)
    Если НЕ FitGOAnalyticsОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Период = FitGOAnalyticsОбщегоНазначения.РазобратьПериод(Запрос);
    Если Период = Неопределено Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "from and to required");
    КонецЕсли;

    SaleType = FitGOAnalyticsОбщегоНазначения.РазобратьSaleType(Запрос);
    Если SaleType = Неопределено Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "invalid saleType");
    КонецЕсли;

    GroupBy = НРег(СокрЛП(Запрос.ПараметрыЗапроса.Получить("groupBy")));
    Если ПустаяСтрока(GroupBy) Тогда
        GroupBy = "paymentMethod";
    КонецЕсли;
    Если GroupBy <> "paymentMethod" И GroupBy <> "saleType" И GroupBy <> "day" Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "invalid groupBy");
    КонецЕсли;

    // TODO: только SUPER_ADMIN

    Данные = FitGOAnalyticsПродажи.ПолучитьВыручкуЗаПериод(
        Период.from,
        Период.to,
        SaleType,
        GroupBy);

    Возврат FitGOAnalyticsОбщегоНазначения.ОтветJSON(200, Данные);
КонецФункции

// Конфигуратор FitGOAnalytics → шаблоны URL:
//   Имя: StatsVisits
//   Шаблон: /v1/stats/visits
//   Метод GET → StatsVisitsGET
// После добавления шаблона — опубликовать HTTP analytics.
Функция StatsVisitsGET(Запрос)
    Если НЕ FitGOAnalyticsОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Период = FitGOAnalyticsОбщегоНазначения.РазобратьПериод(Запрос);
    Если Период = Неопределено Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "from and to required (YYYY-MM-DD)");
    КонецЕсли;

    Попытка
        Данные = FitGOAnalyticsПродажи.ПолучитьКоличествоПосещений(Период.from, Период.to);
    Исключение
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(500, ОписаниеОшибки());
    КонецПопытки;

    Возврат FitGOAnalyticsОбщегоНазначения.ОтветJSON(200, Данные);
КонецФункции

// --- Вспомогательные ---

Функция РазрешитьСотрудника(Запрос)
    ВнешнийИд = СокрЛП(Строка(Запрос.ПараметрыЗапроса.Получить("employeeId")));
    Если ПустаяСтрока(ВнешнийИд) Тогда
        Возврат Неопределено;
    КонецЕсли;

    // FitGO передаёт employeeCode (000000168) — ищем по коду.
    Попытка
        ПоКоду = Справочники.Сотрудники.НайтиПоКоду(ВнешнийИд);
        Если ЗначениеЗаполнено(ПоКоду) Тогда
            Возврат ПоКоду;
        КонецЕсли;
    Исключение
    КонецПопытки;

    // UUID ссылки (редкий случай)
    Попытка
        Возврат Справочники.Сотрудники.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции
