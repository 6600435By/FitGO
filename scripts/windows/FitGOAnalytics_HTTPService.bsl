// Модуль HTTP-сервиса FitGOAnalytics
// Корневой URL: analytics, шаблон: v1
// Итог: https://host:8445/fitgo/hs/analytics/v1/...

Функция HealthGET(Запрос)
    Данные = Новый Структура("status", "ok");
    Попытка
        Данные.Вставить("segments", FitGOAnalyticsНастройки.ДиагностикаСегментов());
    Исключение
        Данные.Вставить("segmentsError", ОписаниеОшибки());
    КонецПопытки;
    Возврат FitGOAnalyticsОбщегоНазначения.ОтветJSON(200, Данные);
КонецФункции

Функция SalesGET(Запрос)
    Если НЕ FitGOAnalyticsОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Период = FitGOAnalyticsОбщегоНазначения.РазобратьПериод(Запрос);
    Если Период = Неопределено Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "from and to required (YYYY-MM-DD)");
    КонецЕсли;

    SaleType = FitGOAnalyticsОбщегоНазначения.РазобратьSaleType(Запрос);
    Если SaleType = Неопределено Тогда
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(400, "invalid saleType");
    КонецЕсли;

    Пагинация = FitGOAnalyticsОбщегоНазначения.РазобратьПагинацию(Запрос);
    Сотрудник = РазрешитьСотрудника(Запрос);

    // TODO: для роли ADMIN — всегда подставлять СотрудникТекущегоПользователя()
    // Супер-админ может передать employeeId

    // scope=cash — «Сводный отчет по выручке»: все движения кассы, без фильтра номенклатуры.
    // scope=debt — открытые остатки Долг/Рассрочка на дату «to» (не оплачено).
    // scope=installments — продажи с шаблоном рассрочки + график план/факт (для задач админа).
    Область = НРег(СокрЛП(Запрос.ПараметрыЗапроса.Получить("scope")));

    Попытка
        Если Область = "cash" Тогда
            Данные = FitGOAnalyticsПродажи.ПолучитьДвиженияВыручки(
                Период.from,
                Период.to,
                Пагинация.page,
                Пагинация.pageSize);
        ИначеЕсли Область = "debt" Тогда
            // employeeId → только долги этого продавца (отчёт «Неоплаченные продажи»).
            Данные = FitGOAnalyticsПродажи.ПолучитьОстаткиДолга(Период.to, Сотрудник);
        ИначеЕсли Область = "changes" Тогда
            Данные = FitGOAnalyticsПродажи.ПолучитьИзмененияЖурнала(
                Период.from,
                Период.to);
        ИначеЕсли Область = "installments" Тогда
            // Период в URL обязателен общим разбором, но список — все открытые графики.
            Данные = FitGOAnalyticsПродажи.ПолучитьРассрочки();
        Иначе
            Данные = FitGOAnalyticsПродажи.ПолучитьПродажи(
                Период.from,
                Период.to,
                Сотрудник,
                SaleType,
                Пагинация.page,
                Пагинация.pageSize);
        КонецЕсли;
    Исключение
        Возврат FitGOAnalyticsОбщегоНазначения.ОтветОшибки(500, ОписаниеОшибки());
    КонецПопытки;

    Возврат FitGOAnalyticsОбщегоНазначения.ОтветJSON(200, Данные);
КонецФункции

