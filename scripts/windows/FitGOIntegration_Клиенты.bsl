Функция РеквизитСовместимСоЗначением(Рекв, Значение)

    Если Значение = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Попытка
        ТипЗн = ТипЗнч(Значение);
        Для Каждого Т Из Рекв.Тип.Типы() Цикл
            Если Т = ТипЗн Тогда
                Возврат Истина;
            КонецЕсли;
            // Ссылочные типы: ДокументСсылка.* / СправочникСсылка.* — сравнение через НайтиПоТипу
            Если Метаданные.НайтиПоТипу(Т) <> Неопределено И Метаданные.НайтиПоТипу(ТипЗн) <> Неопределено Тогда
                Если Метаданные.НайтиПоТипу(Т) = Метаданные.НайтиПоТипу(ТипЗн) Тогда
                    Возврат Истина;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Ложь;

