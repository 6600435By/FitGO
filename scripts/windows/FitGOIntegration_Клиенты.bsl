    Ключи.Добавить("КРАСОТ");
    Ключи.Добавить("SPA");

    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ВИД") = 0 И СтрНайти(ИмяВерх, "ТИП") = 0
            И СтрНайти(ИмяВерх, "КАТЕГОР") = 0 Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого Тип Из Рекв.Тип.Типы() Цикл
            Попытка
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого Зн Из МдПереч.ЗначенияПеречисления Цикл
                    ИмяЗн = ВРег(Зн.Имя);
                    СинЗн = ВРег(Зн.Синоним);
                    Для Каждого К Из Ключи Цикл
                        Если СтрНайти(ИмяЗн, К) > 0 ИЛИ СтрНайти(СинЗн, К) > 0 Тогда
                            Док[Рекв.Имя] = Перечисления[МдПереч.Имя][Зн.Имя];
                            Возврат;
                        КонецЕсли;
                    КонецЦикла;
               КонецЦикла;
            Исключение
            КонецПопытки;
       КонецЦикла;
   КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСтрокуТЧСалонУслуги(Док, ДокМд, Услуга, Количество, DurationMin)

    Попытка
        Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
            ИмяТЧ = ВРег(ТЧ.Имя);
            Если СтрНайти(ИмяТЧ, "УСЛУГ") = 0 Тогда
                Продолжить;
            КонецЕсли;
            СтрокаТЧ = Док[ТЧ.Имя].Добавить();
            Для Каждого Рекв Из ТЧ.Реквизиты Цикл
                ИмяВерх = ВРег(Рекв.Имя);
                Если СтрНайти(ИмяВерх, "ПРИЗНАК") > 0 Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    Если (ИмяВерх = "УСЛУГА" ИЛИ ИмяВерх = "НОМЕНКЛАТУРА")
                        И РеквизитСовместимСоЗначением(Рекв, Услуга) Тогда
                        СтрокаТЧ[Рекв.Имя] = Услуга;
                    ИначеЕсли ИмяВерх = "КОЛИЧЕСТВО" И Рекв.Тип.СодержитТип(Тип("Число")) Тогда
                        СтрокаТЧ[Рекв.Имя] = Количество;
                    ИначеЕсли (ИмяВерх = "МИН" ИЛИ СтрНайти(ИмяВерх, "ДЛИТЕЛЬН") > 0 ИЛИ СтрНайти(ИмяВерх, "ПРОДОЛЖ") > 0)
                        И Рекв.Тип.СодержитТип(Тип("Число")) Тогда
                        СтрокаТЧ[Рекв.Имя] = DurationMin;
                    ИначеЕсли (ИмяВерх = "ВРЕМЯ" ИЛИ СтрНайти(ИмяВерх, "ВРЕМЯНАЧ") > 0)
                        И Рекв.Тип.СодержитТип(Тип("Дата")) Тогда
                        СтрокаТЧ[Рекв.Имя] = Док.Дата;
                    КонецЕсли;
                Исключение
                КонецПопытки;
            КонецЦикла;
            Сотр = НайтиСправочникПоИмени("Сотрудники,ФизическиеЛица,Пользователи", "Универсальный");
            Если Сотр <> Неопределено Тогда
                ЗаполнитьРеквизитСтрокиТЧПоМаске(СтрокаТЧ, ТЧ, "СОТРУДНИК,СОТРУД,МАСТЕР,ТРЕНЕР", Сотр);
            КонецЕсли;
            Помещ = НайтиСправочникПоИмени("Помещения,СтруктурныеЕдиницы,Склады", "Массажный кабинет");
            Если Помещ = Неопределено Тогда
                Помещ = НайтиСправочникПоИмени("Помещения,СтруктурныеЕдиницы", "Массаж");
            КонецЕсли;
            Если Помещ <> Неопределено Тогда
                ЗаполнитьРеквизитСтрокиТЧПоМаске(СтрокаТЧ, ТЧ, "ПОМЕЩЕН,КАБИНЕТ,ЗАЛ", Помещ);
            КонецЕсли;
            Возврат;
        КонецЦикла;
    Исключение
    КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьРеквизитСтрокиТЧПоМаске(СтрокаТЧ, ТЧМд, МаскаВерх, Значение)
    Маски = СтрРазделить(МаскаВерх, ",");
    Для Каждого Рекв Из ТЧМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Для Каждого М Из Маски Цикл
            Если СтрНайти(ИмяВерх, СокрЛП(М)) > 0 И РеквизитСовместимСоЗначением(Рекв, Значение) Тогда
                Попытка
                    СтрокаТЧ[Рекв.Имя] = Значение;
                    Возврат;
                Исключение
                КонецПопытки;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Функция НайтиСправочникПоИмени(ИменаСправочниковЧерезЗапятую, Наименование)
    ИмяНорм = ВРег(СокрЛП(Наименование));
    Если ПустаяСтрока(ИмяНорм) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого ИмяСпр Из СтрРазделить(ИменаСправочниковЧерезЗапятую, ",") Цикл
        ИмяСпр = СокрЛП(ИмяСпр);
        Мд = Метаданные.НайтиПоПолномуИмени("Справочник." + ИмяСпр);
        Если Мд = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Спр.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник." + ИмяСпр + " КАК Спр
        |ГДЕ
        |    НЕ Спр.ПометкаУдаления
        |    И НЕ Спр.ЭтоГруппа
        |    И (ВРег(Спр.Наименование) = &Имя
        |        ИЛИ ВРег(Спр.Наименование) ПОДОБНО &ИмяПодобно)";
        Запрос.УстановитьПараметр("Имя", ИмяНорм);
        Запрос.УстановитьПараметр("ИмяПодобно", "%" + ИмяНорм + "%");
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                Возврат Выборка.Ссылка;
            КонецЕсли;
        Исключение
            // без ЭтоГруппа (если нет иерархии)
            Запрос.Текст =
            "ВЫБРАТЬ ПЕРВЫЕ 1
            |    Спр.Ссылка КАК Ссылка
            |ИЗ
            |    Справочник." + ИмяСпр + " КАК Спр
            |ГДЕ
            |    НЕ Спр.ПометкаУдаления
            |    И (ВРег(Спр.Наименование) = &Имя
            |        ИЛИ ВРег(Спр.Наименование) ПОДОБНО &ИмяПодобно)";
            Запрос.УстановитьПараметр("Имя", ИмяНорм);
            Запрос.УстановитьПараметр("ИмяПодобно", "%" + ИмяНорм + "%");
            Попытка
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Возврат Выборка.Ссылка;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецПопытки;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция НайтиСправочникПоКоду(ИменаСправочниковЧерезЗапятую, Код)
    КодНорм = СокрЛП(Строка(Код));
    Если ПустаяСтрока(КодНорм) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Каждого ИмяСпр Из СтрРазделить(ИменаСправочниковЧерезЗапятую, ",") Цикл
        ИмяСпр = СокрЛП(ИмяСпр);
        Мд = Метаданные.НайтиПоПолномуИмени("Справочник." + ИмяСпр);
        Если Мд = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Спр.Ссылка КАК Ссылка
        |ИЗ
        |    Справочник." + ИмяСпр + " КАК Спр
        |ГДЕ
        |    НЕ Спр.ПометкаУдаления
        |    И Спр.Код = &Код";
        Запрос.УстановитьПараметр("Код", КодНорм);
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                Возврат Выборка.Ссылка;
            КонецЕсли;
        Исключение
        КонецПопытки;
        // код без ведущих нулей (только если строка числовая)
        Попытка
            Если СтрДлина(СтрЗаменить(СтрЗаменить(КодНорм, "0", ""), " ", "")) > 0
                И Строка(Число(КодНорм)) <> "" Тогда
                Запрос.УстановитьПараметр("Код", Формат(Число(КодНорм), "ЧГ=0"));
                Выборка = Запрос.Выполнить().Выбрать();
                Если Выборка.Следующий() Тогда
                    Возврат Выборка.Ссылка;
                КонецЕсли;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

// SPA: помещение всегда «Массажный кабинет»; сотрудник — из FitGO-слота, иначе Универсальный.
Процедура УстановитьСотрудникаИПомещениеСалон(Док, ДокМд, EmployeeName = "", EmployeeCode = "")

    Помещ = НайтиСправочникПоКоду("Помещения,СтруктурныеЕдиницы", "000000006");
    Если Помещ = Неопределено Тогда
        Помещ = НайтиСправочникПоИмени("Помещения,СтруктурныеЕдиницы,Склады", "Массажный кабинет");
    КонецЕсли;
    Если Помещ = Неопределено Тогда
        Помещ = НайтиСправочникПоИмени("Помещения,СтруктурныеЕдиницы", "Массаж");
    КонецЕсли;
    Если Помещ <> Неопределено Тогда
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "ПОМЕЩЕН,КАБИНЕТ", Помещ);
        Попытка
            Док.Помещение = Помещ;
        Исключение
        КонецПопытки;
    КонецЕсли;

    Сотр = Неопределено;
    Если НЕ ПустаяСтрока(СокрЛП(Строка(EmployeeCode))) Тогда
        Сотр = НайтиСправочникПоКоду("Сотрудники,ФизическиеЛица,Пользователи", EmployeeCode);
    КонецЕсли;
    Если Сотр = Неопределено И НЕ ПустаяСтрока(СокрЛП(Строка(EmployeeName))) Тогда
        Сотр = НайтиСправочникПоИмени("Сотрудники,ФизическиеЛица,Пользователи", EmployeeName);
        // «Базыльчик Владислав» ↔ «Владислав Базыльчик»
        Если Сотр = Неопределено Тогда
            Части = СтрРазделить(СокрЛП(Строка(EmployeeName)), " ");
            Если Части.Количество() >= 2 Тогда
                Сотр = НайтиСправочникПоИмени(
                    "Сотрудники,ФизическиеЛица,Пользователи",
                    Части[0]); // фамилия
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Если Сотр = Неопределено Тогда
        Сотр = НайтиСправочникПоКоду("Сотрудники,ФизическиеЛица,Пользователи", "000000081");
    КонецЕсли;
    Если Сотр = Неопределено Тогда
        Сотр = НайтиСправочникПоИмени("Сотрудники,ФизическиеЛица,Пользователи", "Универсальный");
    КонецЕсли;
    Если Сотр <> Неопределено Тогда
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "СОТРУДНИК,ИСПОЛНИТЕЛЬ,МАСТЕР,ТРЕНЕР", Сотр);
        Попытка
            Док.Сотрудник = Сотр;
        Исключение
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Функция ОстатокУслугиУменьшился(Членство, ИмяУслуги, ОстатокДо, Момент = Неопределено)
    После = НайтиУслугуСегментВОстатках(Членство, СокрЛП(ИмяУслуги), Момент);
    Если После = Неопределено Тогда
        Возврат Истина; // строки остатка нет — квота 0 / списана
    КонецЕсли;
    Если После.Свойство("unlimited") И После.unlimited = Истина Тогда
        Возврат Истина;
    КонецЕсли;
    Если После.Свойство("remaining") Тогда
        Попытка
            Возврат Число(После.remaining) < Число(ОстатокДо);
        Исключение
            Возврат После.remaining < ОстатокДо;
        КонецПопытки;
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Регистратор (наш «Занятие») уже сделал движения по РН квот — успех, даже если
// Остатки(&Сейчас) ещё не видят будущую дату документа (occurredAt > now).
Функция ДокументДалДвиженияКвоты(Регистратор)
    Если НЕ ЗначениеЗаполнено(Регистратор) Тогда
        Возврат Ложь;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ИСТИНА КАК Есть
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг КАК Движения
    |ГДЕ
    |    Движения.Регистратор = &Рег";
    Запрос.УстановитьПараметр("Рег", Регистратор);
    Попытка
        Возврат НЕ Запрос.Выполнить().Пустой();
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// АктивныйАбонементJSON / Остатки на момент документа. Регистратор — главный критерий.
Функция КвотаУслугиУменьшилась(Контрагент, Членство, ИмяУслуги, ОстатокДо, Момент = Неопределено, Регистратор = Неопределено)
    Если ДокументДалДвиженияКвоты(Регистратор) Тогда
        Возврат Истина;
    КонецЕсли;

    ИмяНорм = ВРег(СокрЛП(ИмяУслуги));
    МоментПроверки = Момент;
    Если МоментПроверки = Неопределено ИЛИ НЕ ЗначениеЗаполнено(МоментПроверки) Тогда
        МоментПроверки = ТекущаяДатаСеанса();
    КонецЕсли;
    // Остатки на дату документа (не раньше «сейчас»), иначе будущий occurredAt не виден.
    Если МоментПроверки < ТекущаяДатаСеанса() Тогда
        МоментПроверки = ТекущаяДатаСеанса();
    КонецЕсли;

    Если ОстатокУслугиУменьшился(Членство, ИмяУслуги, ОстатокДо, МоментПроверки) Тогда
        Возврат Истина;
    КонецЕсли;

    Попытка
        Мем = АктивныйАбонементJSON(Контрагент);
        Если Мем = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
        Если НЕ Мем.Свойство("services") ИЛИ Мем.services = Неопределено Тогда
            Возврат Истина;
        КонецЕсли;
        Для Каждого Усл Из Мем.services Цикл
            ИмяУсл = "";
            Если Усл.Свойство("name") Тогда
                ИмяУсл = СокрЛП(Строка(Усл.name));
            ИначеЕсли Усл.Свойство("serviceName") Тогда
                ИмяУсл = СокрЛП(Строка(Усл.serviceName));
            КонецЕсли;
            ИмяУслВ = ВРег(ИмяУсл);
            Если ИмяУслВ <> ИмяНорм
                И СтрНайти(ИмяУслВ, ИмяНорм) = 0
                И СтрНайти(ИмяНорм, ИмяУслВ) = 0 Тогда
                Продолжить;
            КонецЕсли;
            Если Усл.Свойство("unlimited") И Усл.unlimited = Истина Тогда
                Возврат Истина;
            КонецЕсли;
            Если Усл.Свойство("remaining") Тогда
                Возврат Число(Усл.remaining) < Число(ОстатокДо);
            КонецЕсли;
            Возврат Ложь;
        КонецЦикла;
        Возврат Истина; // строки услуги больше нет — списана полностью
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция ЗначениеЗаполненоРеквизитаПоМаске(Док, ДокМд, МаскаВерх)
    Маски = СтрРазделить(МаскаВерх, ",");
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Для Каждого М Из Маски Цикл
            Если СтрНайти(ИмяВерх, СокрЛП(М)) > 0 Тогда
                Попытка
                    Возврат ЗначениеЗаполнено(Док[Рекв.Имя]);
                Исключение
                    Возврат Ложь;
                КонецПопытки;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

// Платная SPA: то же «Посещение салона красоты» (как на ресепшене).
Функция ПродатьСпаУслугу(Контрагент, ServiceName, BookingRef, OccurredAt = Неопределено, PriceMinor = 0, Currency = "BYN", DurationMin = 0, EmployeeName = "", EmployeeCode = "") Экспорт

    Ответ = Новый Структура;
    Ответ.Вставить("ok", Ложь);
    Ответ.Вставить("error", "");
    Ответ.Вставить("membership", Неопределено);

    ИмяУслуги = СокрЛП(Строка(ServiceName));
    Если ПустаяСтрока(ИмяУслуги) Тогда
        Ответ.error = "serviceName required";
        Возврат Ответ;
    КонецЕсли;

    ДатаДок = ТекущаяДатаСеанса();
    Если OccurredAt <> Неопределено И ЗначениеЗаполнено(OccurredAt) Тогда
        ДатаДок = OccurredAt;
    КонецЕсли;

    Членство = Неопределено;
    Итоги = ИтогиЧленстваПоКлиенту(Контрагент);
    Если Итоги <> Неопределено Тогда
        Членство = Итоги.Членство;
    КонецЕсли;

    Номенклатура = НайтиНоменклатуруПоИмени(ИмяУслуги);
    Если Номенклатура = Неопределено Тогда
        Номенклатура = НайтиНоменклатуруПоИмени("Массаж классический общий");
    КонецЕсли;
    Если Номенклатура = Неопределено И ЗначениеЗаполнено(Членство) Тогда
        Сег = НайтиУслугуСегментВОстатках(Членство, ИмяУслуги);
        Если Сег = Неопределено Тогда
            Сег = НайтиУслугуСегментВОстатках(Членство, "Массаж классический общий");
        КонецЕсли;
        Если Сег <> Неопределено Тогда
            Номенклатура = Сег.Ссылка;
        КонецЕсли;
    КонецЕсли;
    Если Номенклатура = Неопределено Тогда
        Номенклатура = НайтиСсылкуУслугиПоИмениВДвижениях(ИмяУслуги);
    КонецЕсли;
    Если Номенклатура = Неопределено Тогда
        Ответ.error = "Nomenclature not found for: " + ИмяУслуги
            + " | docs=" + СписокДокументовСалонКлючи();
        Возврат Ответ;
    КонецЕсли;

    Мин = ?(DurationMin > 0, DurationMin, 60);

    // PAID: платный визит, оплата на ресепшене. Членство НЕ передаём как ОснованиеОплаты —
    // иначе проведение чистит строку (нет квоты) и форма салона падает на [0].
    Рез = ПопыткаСписатьЧерезПосещениеСалона(
        Контрагент, Неопределено, Номенклатура, Номенклатура,
        ДатаДок, BookingRef, Мин, Истина, Неопределено, ИмяУслуги,
        EmployeeName, EmployeeCode);
    Если Рез.ok Тогда
        Ответ.ok = Истина;
        Ответ.membership = АктивныйАбонементJSONСДокСсылкой(Контрагент, Рез);
        Возврат Ответ;
    КонецЕсли;

    Ответ.error = "Salon paid visit failed: " + Рез.error;
    Возврат Ответ;
КонецФункции

Функция НайтиСсылкуУслугиПоИмениВДвижениях(ИмяУслуги)

    ИмяНорм = ВРег(СокрЛП(ИмяУслуги));
    Если ПустаяСтрока(ИмяНорм) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 200
    |    Движения.УслугаСегмент КАК Услуга
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг КАК Движения
    |ГДЕ
    |    Движения.УслугаСегмент <> НЕОПРЕДЕЛЕНО";
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Предст = ВРег(СокрЛП(Строка(Выборка.Услуга)));
            Если Предст = ИмяНорм ИЛИ СтрНайти(Предст, ИмяНорм) > 0 Тогда
                Возврат Выборка.Услуга;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 200
    |    Остатки.УслугаСегмент КАК Услуга
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(, ) КАК Остатки
    |ГДЕ
    |    Остатки.УслугаСегмент <> НЕОПРЕДЕЛЕНО";
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Предст = ВРег(СокрЛП(Строка(Выборка.Услуга)));
            Если Предст = ИмяНорм ИЛИ СтрНайти(Предст, ИмяНорм) > 0 Тогда
                Возврат Выборка.Услуга;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

Процедура ЗаполнитьРеквизитТочнымИменем(Док, ДокМд, ИмяРекв, Значение)
    Попытка
        Для Каждого Рекв Из ДокМд.Реквизиты Цикл
            Если Рекв.Имя = ИмяРекв Тогда
                Если РеквизитСовместимСоЗначением(Рекв, Значение) Тогда
                    Док[Рекв.Имя] = Значение;
                КонецЕсли;
                Возврат;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция ВизитыJSON(Контрагент, ДатаС, ДатаПо) Экспорт
    Результат = Новый Массив;

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаПосещений();
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаВизитов(ДатаС));
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияВизитов(ДатаПо));

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Результат;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Элемент = Новый Структура;
        Элемент.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Регистратор));
        Элемент.Вставить("date", FitGOIntegrationОбщегоНазначения.ISOДата(Выборка.Период));
        Элемент.Вставить("checkIn", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.Период));
        Если ЗначениеЗаполнено(Выборка.ДатаВыхода) Тогда
            Элемент.Вставить("checkOut", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.ДатаВыхода));
        КонецЕсли;
        Элемент.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
        Если ЗначениеЗаполнено(Выборка.Занятие) Тогда
            Элемент.Вставить("title", Строка(Выборка.Занятие));
        КонецЕсли;
        ВидИТип = КлассифицироватьОснованиеПосещения(Выборка.Занятие);
        Элемент.Вставить("kind", ВидИТип.kind);
        Элемент.Вставить("basisType", ВидИТип.basisType);
        Результат.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Возвращает Структура(kind, basisType) для документа посещения.
// kind: GYM | GROUP | PT | SPA_MASSAGE | SPA_BODYCOMP | SOLARIUM | UNKNOWN
// basisType: membership | class | service | other
Функция КлассифицироватьОснованиеПосещения(Основание)
    Результат = Новый Структура("kind, basisType", "GYM", "membership");
    Если НЕ ЗначениеЗаполнено(Основание) Тогда
        Возврат Результат;
    КонецЕсли;

    Попытка
        ТипОсн = ТипЗнч(Основание);
        Если ТипОсн = Тип("ДокументСсылка.ЧленствоПакетУслуг") Тогда
            Результат.basisType = "membership";
            Результат.kind = "GYM";
            Возврат Результат;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Попытка
        ТипОсн = ТипЗнч(Основание);
        Если ТипОсн = Тип("ДокументСсылка.Занятие")
            ИЛИ ТипОсн = Тип("ДокументСсылка.ГрупповоеЗанятие") Тогда
            Результат.basisType = "class";
            Результат.kind = "GROUP";
            Возврат Результат;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Заголовок = НРег(Строка(Основание));
    Если СтрНайти(Заголовок, "персонал") > 0 ИЛИ СтрНайти(Заголовок, "индивидуал") > 0 Тогда
        Результат.basisType = "class";
        Результат.kind = "PT";
        Возврат Результат;
    КонецЕсли;
    Если СтрНайти(Заголовок, "массаж") > 0 Тогда
        Результат.basisType = "service";
        Результат.kind = "SPA_MASSAGE";
        Возврат Результат;
    КонецЕсли;
    Если СтрНайти(Заголовок, "состав тела") > 0 ИЛИ СтрНайти(Заголовок, "inbody") > 0 Тогда
        Результат.basisType = "service";
        Результат.kind = "SPA_BODYCOMP";
        Возврат Результат;
    КонецЕсли;
    Если СтрНайти(Заголовок, "соляр") > 0 Тогда
        Результат.basisType = "service";
        Результат.kind = "SOLARIUM";
        Возврат Результат;
    КонецЕсли;
    Если СтрНайти(Заголовок, "йога") > 0 ИЛИ СтрНайти(Заголовок, "пилатес") > 0
        ИЛИ СтрНайти(Заголовок, "группа") > 0 ИЛИ СтрНайти(Заголовок, "занятие") > 0 Тогда
        Результат.basisType = "class";
        Результат.kind = "GROUP";
        Возврат Результат;
    КонецЕсли;
    Если СтрНайти(Заголовок, "членство") > 0 ИЛИ СтрНайти(Заголовок, "абонемент") > 0 Тогда
        Результат.basisType = "membership";
        Результат.kind = "GYM";
        Возврат Результат;
    КонецЕсли;

    Результат.basisType = "other";
    Результат.kind = "UNKNOWN";
    Возврат Результат;
КонецФункции

Функция КартаДоступаJSON(Контрагент) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Карты.Ссылка КАК Карта,
    |    Карты.КодКарты КАК Штрихкод,
    |    Карты.Наименование КАК Наименование
    |ИЗ
    |    Справочник.Карты КАК Карты
    |ГДЕ
    |    Карты.ВладелецКарты = &Контрагент
    |    И НЕ Карты.ПометкаУдаления
    |    И НЕ Карты.Заблокирована
    |УПОРЯДОЧИТЬ ПО
    |    Карты.ДатаОткрытия УБЫВ";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если НЕ Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Штрихкод = СокрЛП(Строка(Выборка.Штрихкод));
    Если ПустаяСтрока(Штрихкод) Тогда
        Штрихкод = СокрЛП(Строка(Выборка.Наименование));
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Карта));
    Результат.Вставить("barcode", Штрихкод);
    Результат.Вставить("clientName", Строка(Контрагент));
    Результат.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
    Возврат Результат;
КонецФункции

// --- заморозка ---

Процедура ДобавитьПоляЗаморозки(Результат, Членство, Остатки, СтатусJSON)

    // Scan 2026-09-08 (Куделко VIP): total=КоличествоДнейЗаморозок, remaining=КоличествоДнейЗаморозокОстаток
    // Не путать с ДнейДополнительноОстаток (другой ресурс).
    ВсегоЗаморозок = КоличествоДнейЗаморозкиИзЧленства(Членство);
    ОстатокЗаморозок = Неопределено;
    Если Остатки <> Неопределено И Остатки.Свойство("КоличествоДнейЗаморозок") Тогда
        ОстатокЗаморозок = Остатки.КоличествоДнейЗаморозок;
    КонецЕсли;

    Разрешено = Ложь;
    Если ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок > 0 Тогда
        Разрешено = Истина;
        Если ОстатокЗаморозок = Неопределено Тогда
            ОстатокЗаморозок = ВсегоЗаморозок;
        КонецЕсли;
    ИначеЕсли ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок = 0 Тогда
        Разрешено = Ложь;
        ОстатокЗаморозок = 0;
    ИначеЕсли ОстатокЗаморозок <> Неопределено И ОстатокЗаморозок > 0 Тогда
        Разрешено = Истина;
    ИначеЕсли ЕстьПризнакЗаморозкиВЧленстве(Членство) Тогда
        Разрешено = Истина;
        Если ОстатокЗаморозок = Неопределено Тогда
            ОстатокЗаморозок = 0;
        КонецЕсли;
    Иначе
        Разрешено = Ложь;
        ОстатокЗаморозок = 0;
    КонецЕсли;

    Результат.Вставить("freezeAllowed", Разрешено);
    Если Разрешено Тогда
        Результат.Вставить("freezeDaysRemaining", ?(ОстатокЗаморозок = Неопределено, 0, ОстатокЗаморозок));
        Если ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок > 0 Тогда
            Результат.Вставить("freezeDaysTotal", ВсегоЗаморозок);
        КонецЕсли;
    КонецЕсли;

    Если СтатусJSON = "FROZEN" Тогда
        ДатаДо = ДатаОкончанияТекущейЗаморозки(Членство);
        Если ТипЗнч(ДатаДо) = Тип("Дата") И ЗначениеЗаполнено(ДатаДо) Тогда
            Результат.Вставить("frozenUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаДо));
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

Функция КоличествоДнейЗаморозкиИзЧленства(Членство)

    // Предпочесть точный реквизит КоличествоДнейЗаморозок (не Минимум…).
    Попытка
        Зн = Членство.КоличествоДнейЗаморозок;
        Если ТипЗнч(Зн) = Тип("Число") Тогда
            Возврат Зн;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Попытка
        Мд = Членство.Метаданные();
        Для Каждого Рекв Из Мд.Реквизиты Цикл
            Верх = ВРег(Рекв.Имя);
            Если Верх <> "КОЛИЧЕСТВОДНЕЙЗАМОРОЗОК" Тогда
                Если СтрНайти(Верх, "ЗАМОРОЗ") = 0 ИЛИ СтрНайти(Верх, "МИНИМУМ") > 0 Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
            Попытка
                Зн = Членство[Рекв.Имя];
                Если ТипЗнч(Зн) = Тип("Число") Тогда
                    Возврат Зн;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

Функция ЕстьПризнакЗаморозкиВЧленстве(Членство)

    Попытка
        Мд = Членство.Метаданные();
        Для Каждого Рекв Из Мд.Реквизиты Цикл
            Если СтрНайти(ВРег(Рекв.Имя), "ЗАМОРОЗ") > 0 Тогда
                Возврат Истина;
            КонецЕсли;
       КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Ложь;

КонецФункции

Функция ДатаОкончанияТекущейЗаморозки(Членство)

    // Последняя проведённая операция Заморозка — реквизит даты окончания («до»).
    // Нельзя искать маской "ДО": она ловит ВидОперации (подстрока «ДО» в «ВИДO…»).
    ДокМд = НайтиМетаданныеОперацииСЧленством();
    Если ДокМд = Неопределено Тогда
        Возврат '00010101';
    КонецЕсли;
    ИмяРеквЧленства = "";
    ИмяРеквДо = "";
    ИмяРеквОпер = "";
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        Верх = ВРег(Рекв.Имя);
        Если ПустаяСтрока(ИмяРеквЧленства)
            И (Верх = "ЧЛЕНСТВОПАКЕТУСЛУГ" ИЛИ Верх = "ЧЛЕНСТВО"
                ИЛИ СтрНайти(Верх, "ЧЛЕНСТВ") > 0) Тогда
            ИмяРеквЧленства = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяРеквДо) И ЭтоРеквизитДатыОкончанияЗаморозки(Рекв) Тогда
            ИмяРеквДо = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяРеквОпер)
            И (СтрНайти(Верх, "ОПЕРАЦ") > 0 ИЛИ Верх = "ВИДОПЕРАЦИИ" ИЛИ Верх = "ВИД") Тогда
            ИмяРеквОпер = Рекв.Имя;
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(ИмяРеквЧленства) ИЛИ ПустаяСтрока(ИмяРеквДо) Тогда
        Возврат '00010101';
    КонецЕсли;

    Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Док." + ИмяРеквДо + " КАК ДатаДо
    |ИЗ
    |    Документ." + ДокМд.Имя + " КАК Док
    |ГДЕ
    |    Док.Проведен
    |    И НЕ Док.ПометкаУдаления
    |    И Док." + ИмяРеквЧленства + " = &Членство
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата УБЫВ";
    Запрос = Новый Запрос(Текст);
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Зн = Выборка.ДатаДо;
            Если ТипЗнч(Зн) = Тип("Дата") И ЗначениеЗаполнено(Зн) Тогда
                Возврат Зн;
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат '00010101';

КонецФункции

Функция ЭтоРеквизитДатыОкончанияЗаморозки(Рекв)

    Верх = ВРег(Рекв.Имя);
    // Явные имена с формы стойки («до»)
    Если Верх = "ДАТАПО" ИЛИ Верх = "ДАТАОКОНЧАНИЯ"
        ИЛИ Верх = "ОКОНЧАНИЕ" ИЛИ Верх = "СРОКДО" ИЛИ Верх = "ДЕЙСТВУЕТДО"
        ИЛИ Верх = "ПО" ИЛИ Верх = "ДО" Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    Если СтрНайти(Верх, "ДАТАПО") > 0 ИЛИ СтрНайти(Верх, "ДАТАОКОНЧ") > 0 Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    // «…До» на конце, но не ВидОперации / Документ*
    Если СтрДлина(Верх) >= 2 И Прав(Верх, 2) = "ДО"
        И СтрНайти(Верх, "ОПЕРАЦ") = 0
        И СтрНайти(Верх, "ДОКУМЕНТ") = 0
        И СтрНайти(Верх, "ВИД") = 0 Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    Возврат Ложь;

КонецФункции

Функция РеквизитСодержитТипДата(Рекв)

    Попытка
        Для Каждого Т Из Рекв.Тип.Типы() Цикл
            Если Т = Тип("Дата") Тогда
                Возврат Истина;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Ложь;

КонецФункции

Функция НайтиМетаданныеОперацииСЧленством()

    // Подтверждено сканером 2026-09-08: Документ.ОперацииСЧленствомПакетомУслуг
    МдТочный = Метаданные.НайтиПоПолномуИмени("Документ.ОперацииСЧленствомПакетомУслуг");
    Если МдТочный <> Неопределено Тогда
        Возврат МдТочный;
    КонецЕсли;

    Попытка
        Кандидаты = Новый Массив;
        Для Каждого Мд Из Метаданные.Документы Цикл
            Имя = ВРег(Мд.Имя);
            Син = ВРег(Мд.Синоним);
            Если (СтрНайти(Имя, "ОПЕРАЦ") > 0 ИЛИ СтрНайти(Син, "ОПЕРАЦ") > 0)
                И (СтрНайти(Имя, "ЧЛЕНСТВ") > 0 ИЛИ СтрНайти(Син, "ЧЛЕНСТВ") > 0
                    ИЛИ СтрНайти(Имя, "ПАКЕТ") > 0 ИЛИ СтрНайти(Син, "ПАКЕТ") > 0) Тогда
                Кандидаты.Добавить(Мд);
            КонецЕсли;
        КонецЦикла;
        Для Каждого Мд Из Кандидаты Цикл
            Син = ВРег(Мд.Синоним);
            Если СтрНайти(Син, "ОПЕРАЦИЯ С ЧЛЕНСТВОМ") > 0 ИЛИ СтрНайти(Син, "ОПЕРАЦИЯ С ЧЛЕНСТВ") > 0 Тогда
                Возврат Мд;
            КонецЕсли;
        КонецЦикла;
        Если Кандидаты.Количество() > 0 Тогда
            Возврат Кандидаты[0];
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

