// Возвращает имя установленного значения перечисления или "" если не нашли.
Функция УстановитьОперациюИспользование(Док, ДокМд)

    Ключи = Новый Массив;
    Ключи.Добавить("ИСПОЛЬЗ");
    Ключи.Добавить("ОКАЗАН");
    Ключи.Добавить("СПИСАН");
    Ключи.Добавить("РАСХОД");
    Ключи.Добавить("КОРРЕКТ");
    Ключи.Добавить("ИЗМЕНЕН");
    Ключи.Добавить("ВИЗИТ");
    Ключи.Добавить("УМЕНЬШ");
    Ключи.Добавить("СЕАНС");

    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ОПЕРАЦ") = 0 И СтрНайти(ИмяВерх, "ВИД") = 0 Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого Тип Из Рекв.Тип.Типы() Цикл
            Попытка
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого Зн Из МдПереч.ЗначенияПеречисления Цикл
                    ИмяЗн = ВРег(Зн.Имя);
                    СинЗн = ВРег(Зн.Синоним);
                    Если СтрНайти(ИмяЗн, "ЗАМОРОЗ") > 0 ИЛИ СтрНайти(СинЗн, "ЗАМОРОЗ") > 0 Тогда
                        Продолжить;
                    КонецЕсли;
                    Если СтрНайти(ИмяЗн, "РАЗМОРОЗ") > 0 ИЛИ СтрНайти(СинЗн, "РАЗМОРОЗ") > 0 Тогда
                        Продолжить;
                    КонецЕсли;
                    Для Каждого К Из Ключи Цикл
                        Если СтрНайти(ИмяЗн, К) > 0 ИЛИ СтрНайти(СинЗн, К) > 0 Тогда
                            Док[Рекв.Имя] = Перечисления[МдПереч.Имя][Зн.Имя];
                            Возврат Зн.Имя;
                        КонецЕсли;
                    КонецЦикла;
               КонецЦикла;
            Исключение
            КонецПопытки;
       КонецЦикла;
   КонецЦикла;
    Возврат "";

