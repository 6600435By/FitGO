// Общий модуль FitGOIntegrationКлиенты (сервер)
// Клиент 375296600435 — docs/TEST_CLIENT.md
// Метаданные Forma (ФитнесКлуб_ПРОФ):
//   membership → РегистрНакопления.ЧленстваПакетыУслуг
//   visits     → Документ.Посещение
//   card       → Справочник.Карты (ВладелецКарты, КодКарты)

#Область ПрограммныйИнтерфейс

Функция НайтиКонтрагентаПоТелефону(Телефон) Экспорт
    Нормализованный = FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Телефон);
    Хвост = FitGOIntegrationОбщегоНазначения.ХвостТелефона(Телефон);
    Если ПустаяСтрока(Хвост) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Контрагент = НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост);
    Если ЗначениеЗаполнено(Контрагент) Тогда
        Возврат Контрагент;
    КонецЕсли;

    Возврат НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост);
КонецФункции

Функция НайтиКонтрагентаПоВнешнемуИд(ВнешнийИд) Экспорт
    Попытка
        Возврат Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ДанныеКлиентаJSON(Контрагент) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("externalId", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Контрагент));
    Данные.Вставить("firstName", Строка(Контрагент.Имя));
    Данные.Вставить("lastName", Строка(Контрагент.Фамилия));
    Данные.Вставить("phone", ТелефонКонтрагента(Контрагент));

    Если ЗначениеЗаполнено(Контрагент.Отчество) Тогда
        Данные.Вставить("middleName", Строка(Контрагент.Отчество));
    КонецЕсли;

    Email = EmailКонтрагента(Контрагент);
    Если ЗначениеЗаполнено(Email) Тогда
        Данные.Вставить("email", Email);
    КонецЕсли;

    Возврат Данные;
КонецФункции

Функция АктивныйАбонементJSON(Контрагент) Экспорт
    Выборка = ВыполнитьЗапросЧленства(Контрагент);
    Если Выборка = Неопределено ИЛИ НЕ Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Статус = СтатусЧленстваJSON(Выборка.Состояние);
    Попытка
        Если ЗначениеЗаполнено(Выборка.ДатаОкончания)
            И Выборка.ДатаОкончания > ДАТАВРЕМЯ(1, 1, 1)
            И Выборка.ДатаОкончания < НачалоДня(ТекущаяДатаСеанса()) Тогда
            Статус = "EXPIRED";
        КонецЕсли;
    Исключение
    КонецПопытки;

    // Доп. реквизиты с элемента справочника (даты/статус), если выборка из посещения
    ДатаНачала = Выборка.ДатаНачала;
    ДатаОкончания = Выборка.ДатаОкончания;
    Попытка
        Членство = Выборка.ЧленствоПакетУслуг;
        Если ЗначениеЗаполнено(Членство) Тогда
            Если НЕ ЗначениеЗаполнено(ДатаОкончания) ИЛИ ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1) Тогда
                Попытка
                    ДатаОкончания = Членство.СрокДействия;
                Исключение
                КонецПопытки;
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ ДатаНачала = ДАТАВРЕМЯ(1, 1, 1) Тогда
                Попытка
                    ДатаНачала = Членство.ДатаАктивации;
                Исключение
                КонецПопытки;
            КонецЕсли;
            Если Статус = "ACTIVE" Тогда
                Попытка
                    Статус = СтатусЧленстваJSON(Членство.Статус);
                Исключение
                КонецПопытки;
            КонецЕсли;
            Если ЗначениеЗаполнено(ДатаОкончания)
                И ДатаОкончания > ДАТАВРЕМЯ(1, 1, 1)
                И ДатаОкончания < НачалоДня(ТекущаяДатаСеанса()) Тогда
                Статус = "EXPIRED";
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.ЧленствоПакетУслуг));
    Результат.Вставить("name", Строка(Выборка.ЧленствоПакетУслуг));
    Результат.Вставить("status", Статус);
    Результат.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаНачала));
    Результат.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаОкончания));

    Если ЗначениеЗаполнено(Выборка.ОстатокПосещений) Тогда
        Результат.Вставить("visitsRemaining", Выборка.ОстатокПосещений);
    КонецЕсли;

    Попытка
        Если ЗначениеЗаполнено(Выборка.Долг) Тогда
            Результат.Вставить("debtAmount", Выборка.Долг);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Результат;
КонецФункции

Функция ВизитыJSON(Контрагент, ДатаС, ДатаПо) Экспорт
    Результат = Новый Массив;

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаПосещений();
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаВизитов(ДатаС));
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияВизитов(ДатаПо));

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Результат;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Элемент = Новый Структура;
        Элемент.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Регистратор));
        Элемент.Вставить("date", FitGOIntegrationОбщегоНазначения.ISOДата(Выборка.Период));
        Элемент.Вставить("checkIn", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.Период));
        Если ЗначениеЗаполнено(Выборка.ДатаВыхода) Тогда
            Элемент.Вставить("checkOut", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.ДатаВыхода));
        КонецЕсли;
        Элемент.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
        Если ЗначениеЗаполнено(Выборка.Занятие) Тогда
            Элемент.Вставить("title", Строка(Выборка.Занятие));
        КонецЕсли;
        Результат.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция КартаДоступаJSON(Контрагент) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Карты.Ссылка КАК Карта,
    |    Карты.КодКарты КАК Штрихкод,
    |    Карты.Наименование КАК Наименование
    |ИЗ
    |    Справочник.Карты КАК Карты
    |ГДЕ
    |    Карты.ВладелецКарты = &Контрагент
    |    И НЕ Карты.ПометкаУдаления
    |    И НЕ Карты.Заблокирована
    |УПОРЯДОЧИТЬ ПО
    |    Карты.ДатаОткрытия УБЫВ";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если НЕ Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Штрихкод = СокрЛП(Строка(Выборка.Штрихкод));
    Если ПустаяСтрока(Штрихкод) Тогда
        Штрихкод = СокрЛП(Строка(Выборка.Наименование));
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Карта));
    Результат.Вставить("barcode", Штрихкод);
    Результат.Вставить("clientName", Строка(Контрагент));
    Результат.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапросЧленства(Контрагент)
    // Пустая выборка ≠ ошибка: пробуем следующий текст запроса.
    Тексты = Новый Массив;

    // 1) Справочник членств по Владельцу (типично для Forma)
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЧПУ.Ссылка КАК ЧленствоПакетУслуг,
    |    ЧПУ.Статус КАК Состояние,
    |    ЧПУ.ДатаАктивации КАК ДатаНачала,
    |    ЧПУ.СрокДействия КАК ДатаОкончания,
    |    0 КАК ОстатокПосещений,
    |    0 КАК Долг
    |ИЗ
    |    Справочник.ЧленстваПакетыУслуг КАК ЧПУ
    |ГДЕ
    |    ЧПУ.Владелец = &Контрагент
    |    И НЕ ЧПУ.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |    ЧПУ.СрокДействия УБЫВ");

    // 2) Справочник по реквизиту Контрагент
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЧПУ.Ссылка КАК ЧленствоПакетУслуг,
    |    ЧПУ.Статус КАК Состояние,
    |    ЧПУ.ДатаАктивации КАК ДатаНачала,
    |    ЧПУ.СрокДействия КАК ДатаОкончания,
    |    0 КАК ОстатокПосещений,
    |    0 КАК Долг
    |ИЗ
    |    Справочник.ЧленстваПакетыУслуг КАК ЧПУ
    |ГДЕ
    |    ЧПУ.Контрагент = &Контрагент
    |    И НЕ ЧПУ.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |    ЧПУ.СрокДействия УБЫВ");

    // 3) Справочник по реквизиту Клиент
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ЧПУ.Ссылка КАК ЧленствоПакетУслуг,
    |    ЧПУ.Статус КАК Состояние,
    |    ЧПУ.ДатаАктивации КАК ДатаНачала,
    |    ЧПУ.СрокДействия КАК ДатаОкончания,
    |    0 КАК ОстатокПосещений,
    |    0 КАК Долг
    |ИЗ
    |    Справочник.ЧленстваПакетыУслуг КАК ЧПУ
    |ГДЕ
    |    ЧПУ.Клиент = &Контрагент
    |    И НЕ ЧПУ.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |    ЧПУ.СрокДействия УБЫВ");

    // 4) Остатки регистра: Владелец у измерения
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Остатки.ЧленствоПакетУслуг КАК ЧленствоПакетУслуг,
    |    Остатки.Статус КАК Состояние,
    |    Остатки.ДатаАктивации КАК ДатаНачала,
    |    Остатки.СрокДействия КАК ДатаОкончания,
    |    Остатки.КоличествоОстаток КАК ОстатокПосещений,
    |    Остатки.Долг КАК Долг
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(&Сейчас, ) КАК Остатки
    |ГДЕ
    |    Остатки.ЧленствоПакетУслуг.Владелец = &Контрагент
    |УПОРЯДОЧИТЬ ПО
    |    Остатки.СрокДействия УБЫВ");

    // 5) Остатки: Контрагент у измерения/владельца
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Остатки.ЧленствоПакетУслуг КАК ЧленствоПакетУслуг,
    |    Остатки.Статус КАК Состояние,
    |    Остатки.ДатаАктивации КАК ДатаНачала,
    |    Остатки.СрокДействия КАК ДатаОкончания,
    |    Остатки.КоличествоОстаток КАК ОстатокПосещений,
    |    Остатки.Долг КАК Долг
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(&Сейчас, ) КАК Остатки
    |ГДЕ
    |    Остатки.ЧленствоПакетУслуг.Контрагент = &Контрагент
    |УПОРЯДОЧИТЬ ПО
    |    Остатки.СрокДействия УБЫВ");

    // 6) Fallback: основание последнего посещения (уже работает в /visits)
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Посещение.Основание КАК ЧленствоПакетУслуг,
    |    НЕОПРЕДЕЛЕНО КАК Состояние,
    |    Посещение.ДатаПрихода КАК ДатаНачала,
    |    ДАТАВРЕМЯ(1, 1, 1) КАК ДатаОкончания,
    |    0 КАК ОстатокПосещений,
    |    0 КАК Долг
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.Основание <> НЕОПРЕДЕЛЕНО
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ");

    Для Каждого ТекстЗапроса Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                // Перечитываем с начала: вызывающий код тоже делает Следующий()
                Выборка = Запрос.Выполнить().Выбрать();
                Возврат Выборка;
            КонецЕсли;
        Исключение
            // пробуем следующий вариант
        КонецПопытки;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

Функция НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.Объект КАК Контрагент
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект ССЫЛКА Справочник.Контрагенты
    |    И (
    |        Контакт.НомерТелефона = &Нормализованный
    |        ИЛИ Контакт.НомерТелефона ПОДОБНО &МаскаХвост
    |        ИЛИ Контакт.Представление ПОДОБНО &МаскаХвост
    |        ИЛИ Контакт.ЗначенияПолей ПОДОБНО &МаскаХвост)";

    Запрос.УстановитьПараметр("Нормализованный", Нормализованный);
    Запрос.УстановитьПараметр("МаскаХвост", "%" + Хвост + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Контрагент;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

Функция НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контрагенты.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    НЕ Контрагенты.ПометкаУдаления
    |    И (
    |        Контрагенты.Наименование ПОДОБНО &МаскаХвост
    |        ИЛИ Контрагенты.Комментарий ПОДОБНО &МаскаПолный)";

    Запрос.УстановитьПараметр("МаскаХвост", "%" + Хвост + "%");
    Запрос.УстановитьПараметр("МаскаПолный", "%" + Нормализованный + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Контрагент;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

Функция ТелефонКонтрагента(Контрагент)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.НомерТелефона КАК Телефон
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект = &Контрагент
    |    И Контакт.НомерТелефона <> """"";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Выборка.Телефон);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция EmailКонтрагента(Контрагент)
    Попытка
        Если ЗначениеЗаполнено(Контрагент.ЭлектроннаяПочта) Тогда
            Возврат Строка(Контрагент.ЭлектроннаяПочта);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция ТекстЗапросаПосещений()
    Возврат
    "ВЫБРАТЬ
    |    Посещение.Ссылка КАК Регистратор,
    |    Посещение.ДатаПрихода КАК Период,
    |    Посещение.ДатаУхода КАК ДатаВыхода,
    |    Посещение.Основание КАК Занятие
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.ДатаПрихода >= &ДатаНачала
    |    И Посещение.ДатаПрихода <= &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ";
КонецФункции

Функция СтатусЧленстваJSON(Состояние)
    Имя = ВРег(СокрЛП(Строка(Состояние)));
    Если ПустаяСтрока(Имя) Тогда
        Возврат "ACTIVE";
    КонецЕсли;
    Если СтрНайти(Имя, "ЗАМОРОЖ") > 0 Тогда
        Возврат "FROZEN";
    КонецЕсли;
    Если СтрНайти(Имя, "ИСТЕК") > 0
        ИЛИ СтрНайти(Имя, "ЗАКРЫТ") > 0
        ИЛИ СтрНайти(Имя, "ПРОСРОЧ") > 0
        ИЛИ СтрНайти(Имя, "НЕДЕЙСТВ") > 0 Тогда
        Возврат "EXPIRED";
    КонецЕсли;
    Если СтрНайти(Имя, "ДЕЙСТВ") > 0 ИЛИ СтрНайти(Имя, "АКТИВ") > 0 Тогда
        Возврат "ACTIVE";
    КонецЕсли;
    Возврат "ACTIVE";
КонецФункции

Функция ДатаНачалаВизитов(ДатаС)
    Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецЕсли;
    Попытка
        Возврат XMLЗначение(Тип("Дата"), ДатаС);
    Исключение
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецПопытки;
КонецФункции

Функция ДатаОкончанияВизитов(ДатаПо)
    Если НЕ ЗначениеЗаполнено(ДатаПо) Тогда
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецЕсли;
    Попытка
        Возврат КонецДня(XMLЗначение(Тип("Дата"), ДатаПо));
    Исключение
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецПопытки;
КонецФункции

#КонецОбласти
