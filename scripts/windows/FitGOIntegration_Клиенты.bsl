Функция ВыборкаИтоговВСтруктуру(Запрос)
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Если НЕ Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Р = Новый Структура;
    Р.Вставить("Членство", Выборка.Членство);
    Р.Вставить("Статус", СокрЛП(Строка(Выборка.Статус)));
    Р.Вставить("ДатаАктивации", Выборка.ДатаАктивации);
    Р.Вставить("СрокДействия", Выборка.СрокДействия);
    Р.Вставить("ДнейОстаток", Выборка.ДнейОстаток);
    Р.Вставить("КоличествоОстаток", Выборка.КоличествоОстаток);
    Возврат Р;
КонецФункции

Функция СтатусЧленстваИзРегистра(Членство)
