        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Кандидат = "";
                Если ЗначениеЗаполнено(Выборка.Номер) Тогда
                    Кандидат = Строка(Выборка.Номер);
                ИначеЕсли ЗначениеЗаполнено(Выборка.Представление) Тогда
                    Кандидат = Строка(Выборка.Представление);
                КонецЕсли;
                Цифры = ТолькоЦифрыТелефона(Кандидат);
                Если СтрДлина(Цифры) >= 9 Тогда
                    Норм = "";
                    Попытка
                        Норм = FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Кандидат);
                    Исключение
                    КонецПопытки;
                    Возврат ?(ПустаяСтрока(Норм), Цифры, Норм);
                КонецЕсли;
            КонецЦикла;
        Исключение
        КонецПопытки;
    КонецЦикла;

    // Запас: строковые реквизиты справочника
    Для Каждого Имя Из СтрРазделить("Телефон,МобильныйТелефон,НомерТелефона,ТелефонМобильный", ",") Цикл
        Попытка
            Значение = Контрагент[Имя];
            Цифры = ТолькоЦифрыТелефона(Значение);
            Если СтрДлина(Цифры) >= 9 Тогда
                Возврат Цифры;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат "";
КонецФункции

Функция EmailКонтрагента(Контрагент)
    Попытка
        Если ЗначениеЗаполнено(Контрагент.ЭлектроннаяПочта) Тогда
            Возврат Строка(Контрагент.ЭлектроннаяПочта);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция ТекстЗапросаПосещений()
    Возврат
    "ВЫБРАТЬ
    |    Посещение.Ссылка КАК Регистратор,
    |    Посещение.ДатаПрихода КАК Период,
    |    Посещение.ДатаУхода КАК ДатаВыхода,
    |    Посещение.Основание КАК Занятие
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.ДатаПрихода >= &ДатаНачала
    |    И Посещение.ДатаПрихода <= &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ";
КонецФункции

Функция ДатаНачалаВизитов(ДатаС)
    Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецЕсли;
    Попытка
        Возврат XMLЗначение(Тип("Дата"), ДатаС);
    Исключение
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецПопытки;
КонецФункции

Функция ДатаОкончанияВизитов(ДатаПо)
    Если НЕ ЗначениеЗаполнено(ДатаПо) Тогда
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецЕсли;
    Попытка
        Возврат КонецДня(XMLЗначение(Тип("Дата"), ДатаПо));
    Исключение
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецПопытки;
КонецФункции

// ─── Group session roster (журнал ГП) ───────────────────────────────────────

// Состав группового занятия по appointmentId (= ИдентификаторЗанятия / UUID документа).
// Ответ: { data: [ { externalId, clientName, phone } ] }
Функция СоставГрупповогоЗанятияJSON(AppointmentId) Экспорт
    Результат = Новый Структура("data", Новый Массив);
    ИдСтр = СокрЛП(Строка(AppointmentId));
    Если ПустаяСтрока(ИдСтр) Тогда
        Возврат Результат;
    КонецЕсли;

    ДокСсылка = НайтиЗанятиеПоИдентификатору(ИдСтр);
    Если НЕ ЗначениеЗаполнено(ДокСсылка) Тогда
        Возврат Результат;
    КонецЕсли;

    Попытка
        ДокОб = ДокСсылка.ПолучитьОбъект();
    Исключение
        Возврат Результат;
    КонецПопытки;
    Если ДокОб = Неопределено Тогда
        Возврат Результат;
    КонецЕсли;

    УжеДобавлены = Новый Соответствие;
    Попытка
        Для Каждого Стр Из ДокОб.СоставЗанятия Цикл
            Контрагент = Неопределено;
            Попытка
                Контрагент = Стр.Контрагент;
            Исключение
                Попытка
                    Контрагент = Стр.Клиент;
                Исключение
                КонецПопытки;
            КонецПопытки;
            Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
                Продолжить;
            КонецЕсли;
            ExternalId = "";
            Попытка
                ExternalId = Строка(Контрагент.УникальныйИдентификатор());
            Исключение
            КонецПопытки;
            Если ПустаяСтрока(ExternalId) Тогда
                Продолжить;
            КонецЕсли;
            Если УжеДобавлены.Получить(ExternalId) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            УжеДобавлены.Вставить(ExternalId, Истина);

            ИмяКлиента = СокрЛП(Строка(Контрагент));
            Телефон = "";
            Попытка
                Телефон = СокрЛП(Строка(Контрагент.Телефон));
            Исключение
            КонецПопытки;
            Если ПустаяСтрока(Телефон) Тогда
                Попытка
                    Телефон = СокрЛП(Строка(Контрагент.НомерТелефона));
                Исключение
                КонецПопытки;
            КонецЕсли;

            Эл = Новый Структура;
            Эл.Вставить("externalId", ExternalId);
            Эл.Вставить("clientName", ИмяКлиента);
            Эл.Вставить("phone", Телефон);
            Результат.data.Добавить(Эл);
        КонецЦикла;
    Исключение
    КонецПопытки;

    Возврат Результат;
КонецФункции

Функция НайтиЗанятиеПоИдентификатору(ИдСтр)
    // 1) Точное совпадение УникальныйИдентификатор
    Попытка
        Уид = Новый УникальныйИдентификатор(ИдСтр);
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ ПЕРВЫЕ 1
        |    Занятие.Ссылка КАК Ссылка
        |ИЗ
        |    Документ.Занятие КАК Занятие
        |ГДЕ
        |    Занятие.ИдентификаторЗанятия = &Уид
        |    И НЕ Занятие.ПометкаУдаления";
        Запрос.УстановитьПараметр("Уид", Уид);
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Ссылка;
        КонецЕсли;
    Исключение
    КонецПопытки;

    // 2) Ссылка документа по UUID (appointmentId = ref документа)
    Попытка
        УидДок = Новый УникальныйИдентификатор(ИдСтр);
        СсылкаДок = Документы.Занятие.ПолучитьСсылку(УидДок);
        Если ЗначениеЗаполнено(СсылкаДок) Тогда
            Попытка
                Об = СсылкаДок.ПолучитьОбъект();
                Если Об <> Неопределено И НЕ Об.ПометкаУдаления Тогда
                    Возврат СсылкаДок;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

