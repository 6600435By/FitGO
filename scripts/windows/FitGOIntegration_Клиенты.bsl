// Общий модуль FitGOIntegrationКлиенты (сервер)
// Клиент 375296600435 — docs/TEST_CLIENT.md
// Метаданные Forma (ФитнесКлуб_ПРОФ), подтверждены FitGO_DataScanner v3 (2026-09-08):
//   membership → Документ.ЧленствоПакетУслуг (Контрагент, Номенклатура, ДатаРучнойАктивации,
//                СрокДействия[Число] + СрокДействияТип[Периодичность], СрокДействияДатой, Архивный)
//                остатки → РегистрНакопления.ЧленстваПакетыУслуг.Остатки(Основание = членство)
//                          измерения: Основание, УслугаСегмент; ресурсы: Количество, Дней, ДнейДополнительно…
//   visits     → Документ.Посещение (Контрагент, ДатаПрихода, Основание, ПризнакОтменен)
//   card       → Справочник.Карты (ВладелецКарты, КодКарты)
// Справочника ЧленстваПакетыУслуг в конфигурации НЕТ.

#Область ПрограммныйИнтерфейс

Функция НайтиКонтрагентаПоТелефону(Телефон) Экспорт
    Нормализованный = FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Телефон);
    Хвост = FitGOIntegrationОбщегоНазначения.ХвостТелефона(Телефон);
    Если ПустаяСтрока(Хвост) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Контрагент = НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост);
    Если ЗначениеЗаполнено(Контрагент) Тогда
        Возврат Контрагент;
    КонецЕсли;

    Возврат НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост);
КонецФункции

Функция НайтиКонтрагентаПоВнешнемуИд(ВнешнийИд) Экспорт
    Попытка
        Возврат Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ДанныеКлиентаJSON(Контрагент) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("externalId", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Контрагент));
    Данные.Вставить("firstName", Строка(Контрагент.Имя));
    Данные.Вставить("lastName", Строка(Контрагент.Фамилия));
    Данные.Вставить("phone", ТелефонКонтрагента(Контрагент));

    Если ЗначениеЗаполнено(Контрагент.Отчество) Тогда
        Данные.Вставить("middleName", Строка(Контрагент.Отчество));
    КонецЕсли;

    Email = EmailКонтрагента(Контрагент);
    Если ЗначениеЗаполнено(Email) Тогда
        Данные.Вставить("email", Email);
    КонецЕсли;

    Возврат Данные;
КонецФункции

Функция АктивныйАбонементJSON(Контрагент) Экспорт
    Членство = НайтиЧленство(Контрагент);
    Если НЕ ЗначениеЗаполнено(Членство) Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Реквизиты документа (Документ.ЧленствоПакетУслуг)
    Наименование = "";
    ДатаНачала = ДАТАВРЕМЯ(1, 1, 1);
    СрокЧисло = 0;
    СрокТип = "";
    СрокДатой = ДАТАВРЕМЯ(1, 1, 1);
    Архивный = Ложь;
    Попытка
        Наименование = СокрЛП(Строка(Членство.Номенклатура));
        ДатаНачала = Членство.ДатаРучнойАктивации;
        Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
            ДатаНачала = Членство.Дата;
        КонецЕсли;
        СрокЧисло = Членство.СрокДействия;
        СрокТип = ВРег(Строка(Членство.СрокДействияТип));
        СрокДатой = Членство.СрокДействияДатой;
        Архивный = Членство.Архивный;
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(Наименование) Тогда
        Наименование = Строка(Членство);
    КонецЕсли;

    Остатки = ОстаткиЧленства(Членство);

    // Дата окончания: явная СрокДействияДатой, иначе активация + срок + дополнительные дни.
    // TODO: заменить на регистр с рассчитанной датой окончания (ищет FitGO_DataScanner: registersByType).
    ДатаОкончания = СрокДатой;
    Если НЕ ЗначениеЗаполнено(ДатаОкончания) И ЗначениеЗаполнено(ДатаНачала) Тогда
        ДатаОкончания = ДобавитьСрок(ДатаНачала, СрокЧисло, СрокТип);
        Если Остатки.ДнейДополнительно > 0 Тогда
            ДатаОкончания = ДатаОкончания + Остатки.ДнейДополнительно * 86400;
        КонецЕсли;
    КонецЕсли;

    // Статус: доверяем флагу 1С; дату не используем как признак EXPIRED, пока не подтверждён источник даты.
    Статус = ?(Архивный, "EXPIRED", "ACTIVE");

    Ид = "";
    Попытка
        Ид = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Членство);
    Исключение
        Ид = Строка(Членство);
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("id", Ид);
    Результат.Вставить("name", Наименование);
    Результат.Вставить("status", Статус);
    Результат.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаНачала));
    Результат.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаОкончания));

    Если Остатки.Посещения <> Неопределено Тогда
        Результат.Вставить("visitsRemaining", Остатки.Посещения);
    КонецЕсли;
    Если Остатки.Услуги.Количество() > 0 Тогда
        Результат.Вставить("services", Остатки.Услуги);
    КонецЕсли;

    Возврат Результат;
КонецФункции

Функция ВизитыJSON(Контрагент, ДатаС, ДатаПо) Экспорт
    Результат = Новый Массив;

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаПосещений();
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаВизитов(ДатаС));
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияВизитов(ДатаПо));

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Результат;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Элемент = Новый Структура;
        Элемент.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Регистратор));
        Элемент.Вставить("date", FitGOIntegrationОбщегоНазначения.ISOДата(Выборка.Период));
        Элемент.Вставить("checkIn", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.Период));
        Если ЗначениеЗаполнено(Выборка.ДатаВыхода) Тогда
            Элемент.Вставить("checkOut", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.ДатаВыхода));
        КонецЕсли;
        Элемент.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
        Если ЗначениеЗаполнено(Выборка.Занятие) Тогда
            Элемент.Вставить("title", Строка(Выборка.Занятие));
        КонецЕсли;
        Результат.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция КартаДоступаJSON(Контрагент) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Карты.Ссылка КАК Карта,
    |    Карты.КодКарты КАК Штрихкод,
    |    Карты.Наименование КАК Наименование
    |ИЗ
    |    Справочник.Карты КАК Карты
    |ГДЕ
    |    Карты.ВладелецКарты = &Контрагент
    |    И НЕ Карты.ПометкаУдаления
    |    И НЕ Карты.Заблокирована
    |УПОРЯДОЧИТЬ ПО
    |    Карты.ДатаОткрытия УБЫВ";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Если НЕ Выборка.Следующий() Тогда
        Возврат Неопределено;
    КонецЕсли;

    Штрихкод = СокрЛП(Строка(Выборка.Штрихкод));
    Если ПустаяСтрока(Штрихкод) Тогда
        Штрихкод = СокрЛП(Строка(Выборка.Наименование));
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Карта));
    Результат.Вставить("barcode", Штрихкод);
    Результат.Вставить("clientName", Строка(Контрагент));
    Результат.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текущее членство клиента: последний проведённый неархивный Документ.ЧленствоПакетУслуг,
// запас — Основание последнего посещения (если документ по Контрагенту не нашёлся).
Функция НайтиЧленство(Контрагент)
    Тексты = Новый Массив;

    // 1) Только тип «Членство» (не пакеты разовых услуг)
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Ч.Ссылка КАК Членство
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |    И Ч.ТипЧленстваПакетаУслуг = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Членство)
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ");

    // 2) Любой неархивный документ членства/пакета
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Ч.Ссылка КАК Членство
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ");

    // 3) Основание последнего посещения
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Посещение.Основание КАК Членство
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.Основание ССЫЛКА Документ.ЧленствоПакетУслуг
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ");

    Для Каждого ТекстЗапроса Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Членство) Тогда
                Возврат Выборка.Членство;
            КонецЕсли;
        Исключение
            // текст не скомпилировался (нет перечисления и т.п.) — следующий вариант
        КонецПопытки;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

// Остатки по РегистрНакопления.ЧленстваПакетыУслуг (измерения Основание, УслугаСегмент).
// Строка без УслугаСегмент — общие ресурсы членства (Дней, ДнейДополнительно, Количество посещений).
// Строки с УслугаСегмент — квоты услуг (Солярий 10, Массаж 1 …).
Функция ОстаткиЧленства(Членство)
    Результат = Новый Структура;
    Результат.Вставить("Посещения", Неопределено);
    Результат.Вставить("ДнейДополнительно", 0);
    Результат.Вставить("Дней", 0);
    Результат.Вставить("Услуги", Новый Массив);

    ВсегоПоУслугам = Новый Соответствие;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    СУ.УслугаСегмент КАК Услуга,
    |    СУ.Количество КАК Количество
    |ИЗ
    |    Документ.ЧленствоПакетУслуг.СоставУслуг КАК СУ
    |ГДЕ
    |    СУ.Ссылка = &Членство";
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            ВсегоПоУслугам.Вставить(Выборка.Услуга, Выборка.Количество);
        КонецЦикла;
    Исключение
    КонецПопытки;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.УслугаСегмент КАК Услуга,
    |    Остатки.КоличествоОстаток КАК Количество,
    |    Остатки.ДнейОстаток КАК Дней,
    |    Остатки.ДнейДополнительноОстаток КАК ДнейДополнительно,
    |    Остатки.КоличествоНеограниченноПризнакОстаток КАК Неограниченно
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(&Сейчас, Основание = &Членство) КАК Остатки";
    Запрос.УстановитьПараметр("Членство", Членство);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Результат;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.Услуга) Тогда
            Результат.Дней = ?(Выборка.Дней = NULL, 0, Выборка.Дней);
            Результат.ДнейДополнительно = ?(Выборка.ДнейДополнительно = NULL, 0, Выборка.ДнейДополнительно);
            Если Выборка.Количество <> NULL И Выборка.Количество > 0 Тогда
                Результат.Посещения = Выборка.Количество;
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Услуга = Новый Структура;
        Услуга.Вставить("name", СокрЛП(Строка(Выборка.Услуга)));
        Если Выборка.Неограниченно <> NULL И Выборка.Неограниченно > 0 Тогда
            Услуга.Вставить("unlimited", Истина);
        Иначе
            Услуга.Вставить("remaining", ?(Выборка.Количество = NULL, 0, Выборка.Количество));
        КонецЕсли;
        Всего = ВсегоПоУслугам.Получить(Выборка.Услуга);
        Если Всего <> Неопределено И Всего > 0 Тогда
            Услуга.Вставить("total", Всего);
        КонецЕсли;
        Результат.Услуги.Добавить(Услуга);
    КонецЦикла;

    Возврат Результат;
КонецФункции

// СрокДействия (Число) + СрокДействияТип (Перечисление.Периодичность) → дата окончания.
Функция ДобавитьСрок(ДатаНачала, Число, ТипСрока)
    Если НЕ ЗначениеЗаполнено(Число) ИЛИ Число <= 0 Тогда
        Возврат ДатаНачала;
    КонецЕсли;
    Если СтрНайти(ТипСрока, "ГОД") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число * 12);
    ИначеЕсли СтрНайти(ТипСрока, "КВАРТ") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число * 3);
    ИначеЕсли СтрНайти(ТипСрока, "МЕС") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число);
    ИначеЕсли СтрНайти(ТипСрока, "НЕД") > 0 Тогда
        Возврат ДатаНачала + Число * 7 * 86400;
    КонецЕсли;
    // День и всё неизвестное — считаем днями
    Возврат ДатаНачала + Число * 86400;
КонецФункции

Функция НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.Объект КАК Контрагент
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект ССЫЛКА Справочник.Контрагенты
    |    И (
    |        Контакт.НомерТелефона = &Нормализованный
    |        ИЛИ Контакт.НомерТелефона ПОДОБНО &МаскаХвост
    |        ИЛИ Контакт.Представление ПОДОБНО &МаскаХвост
    |        ИЛИ Контакт.ЗначенияПолей ПОДОБНО &МаскаХвост)";

    Запрос.УстановитьПараметр("Нормализованный", Нормализованный);
    Запрос.УстановитьПараметр("МаскаХвост", "%" + Хвост + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Контрагент;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

Функция НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контрагенты.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
    |    НЕ Контрагенты.ПометкаУдаления
    |    И (
    |        Контрагенты.Наименование ПОДОБНО &МаскаХвост
    |        ИЛИ Контрагенты.Комментарий ПОДОБНО &МаскаПолный)";

    Запрос.УстановитьПараметр("МаскаХвост", "%" + Хвост + "%");
    Запрос.УстановитьПараметр("МаскаПолный", "%" + Нормализованный + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.Контрагент;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

Функция ТелефонКонтрагента(Контрагент)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.НомерТелефона КАК Телефон
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект = &Контрагент
    |    И Контакт.НомерТелефона <> """"";

    Запрос.УстановитьПараметр("Контрагент", Контрагент);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Выборка.Телефон);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция EmailКонтрагента(Контрагент)
    Попытка
        Если ЗначениеЗаполнено(Контрагент.ЭлектроннаяПочта) Тогда
            Возврат Строка(Контрагент.ЭлектроннаяПочта);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция ТекстЗапросаПосещений()
    Возврат
    "ВЫБРАТЬ
    |    Посещение.Ссылка КАК Регистратор,
    |    Посещение.ДатаПрихода КАК Период,
    |    Посещение.ДатаУхода КАК ДатаВыхода,
    |    Посещение.Основание КАК Занятие
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.ДатаПрихода >= &ДатаНачала
    |    И Посещение.ДатаПрихода <= &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ";
КонецФункции

Функция ДатаНачалаВизитов(ДатаС)
    Если НЕ ЗначениеЗаполнено(ДатаС) Тогда
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецЕсли;
    Попытка
        Возврат XMLЗначение(Тип("Дата"), ДатаС);
    Исключение
        Возврат ДобавитьМесяц(ТекущаяДатаСеанса(), -3);
    КонецПопытки;
КонецФункции

Функция ДатаОкончанияВизитов(ДатаПо)
    Если НЕ ЗначениеЗаполнено(ДатаПо) Тогда
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецЕсли;
    Попытка
        Возврат КонецДня(XMLЗначение(Тип("Дата"), ДатаПо));
    Исключение
        Возврат КонецДня(ТекущаяДатаСеанса());
    КонецПопытки;
КонецФункции

#КонецОбласти
