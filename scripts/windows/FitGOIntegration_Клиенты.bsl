// Возврат: Структура { Ссылка, remaining|unlimited } или Неопределено.
Функция НайтиУслугуСегментВОстатках(Членство, ИмяУслуги, Момент = Неопределено)

    ИмяНорм = ВРег(СокрЛП(ИмяУслуги));
    Если ПустаяСтрока(ИмяНорм) Тогда
        Возврат Неопределено;
    КонецЕсли;

    МоментОст = Момент;
    Если МоментОст = Неопределено ИЛИ НЕ ЗначениеЗаполнено(МоментОст) Тогда
        МоментОст = ТекущаяДатаСеанса();
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.УслугаСегмент КАК Услуга,
    |    Остатки.КоличествоОстаток КАК Количество,
    |    Остатки.КоличествоНеограниченноПризнакОстаток КАК Неограниченно
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(&Сейчас, Основание = &Членство) КАК Остатки
    |ГДЕ
    |    Остатки.УслугаСегмент <> НЕОПРЕДЕЛЕНО";
    Запрос.УстановитьПараметр("Членство", Членство);
    Запрос.УстановитьПараметр("Сейчас", МоментОст);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.Услуга) Тогда
            Продолжить;
        КонецЕсли;
        ИмяУсл = ВРег(СокрЛП(Строка(Выборка.Услуга)));
        Если ИмяУсл <> ИмяНорм
            И СтрНайти(ИмяУсл, ИмяНорм) = 0
            И СтрНайти(ИмяНорм, ИмяУсл) = 0 Тогда
            Продолжить;
        КонецЕсли;
        Рез = Новый Структура;
        Рез.Вставить("Ссылка", Выборка.Услуга);
        Если Выборка.Неограниченно <> NULL И Выборка.Неограниченно > 0 Тогда
            Рез.Вставить("unlimited", Истина);
        Иначе
            Кол = ?(Выборка.Количество = NULL, 0, Выборка.Количество);
            Рез.Вставить("remaining", Кол);
        КонецЕсли;
        Возврат Рез;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

Процедура ЗаполнитьСтрокуТЧУслугиЕслиЕсть(Док, ДокМд, НоменклатураИлиСегмент, Количество, Сумма = Неопределено)

    Попытка
        Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
            ИмяТЧ = ВРег(ТЧ.Имя);
            Если СтрНайти(ИмяТЧ, "УСЛУГ") = 0
                И СтрНайти(ИмяТЧ, "ТОВАР") = 0
                И СтрНайти(ИмяТЧ, "СОСТАВ") = 0
                И СтрНайти(ИмяТЧ, "НОМЕНКЛ") = 0 Тогда
                Продолжить;
            КонецЕсли;
            СтрокаТЧ = Док[ТЧ.Имя].Добавить();
            Для Каждого Рекв Из ТЧ.Реквизиты Цикл
                ИмяВерх = ВРег(Рекв.Имя);
                Если СтрНайти(ИмяВерх, "ПРИЗНАК") > 0 Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    Если (СтрНайти(ИмяВерх, "НОМЕНКЛ") > 0
                        ИЛИ СтрНайти(ИмяВерх, "СЕГМЕНТ") > 0
                        ИЛИ ИмяВерх = "УСЛУГА"
                        ИЛИ ИмяВерх = "ТОВАР")
                        И РеквизитСовместимСоЗначением(Рекв, НоменклатураИлиСегмент) Тогда
                        СтрокаТЧ[Рекв.Имя] = НоменклатураИлиСегмент;
                    ИначеЕсли СтрНайти(ИмяВерх, "КОЛИЧЕСТВ") > 0 И Рекв.Тип.СодержитТип(Тип("Число")) Тогда
                        СтрокаТЧ[Рекв.Имя] = Количество;
                    ИначеЕсли Сумма <> Неопределено
                        И (СтрНайти(ИмяВерх, "СУММА") > 0 ИЛИ СтрНайти(ИмяВерх, "ЦЕНА") > 0)
                        И Рекв.Тип.СодержитТип(Тип("Число")) Тогда
                        СтрокаТЧ[Рекв.Имя] = Сумма;
                    КонецЕсли;
                Исключение
                КонецПопытки;
            КонецЦикла;
            Возврат;
        КонецЦикла;
    Исключение
    КонецПопытки;

КонецПроцедуры

Функция НайтиМетаданныеРеализацииУслуги()

    Точные = Новый Массив;
    Точные.Добавить("Документ.РеализацияТоваровУслуг");
    Точные.Добавить("Документ.РеализацияУслуг");
    Точные.Добавить("Документ.ЧекККМ");
    Точные.Добавить("Документ.НачислениеНаЛицевойСчет");
    Точные.Добавить("Документ.ОперацияПоЛицевомуСчету");
    Для Каждого ПолноеИмя Из Точные Цикл
        Мд = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
        Если Мд <> Неопределено Тогда
            Возврат Мд;
        КонецЕсли;
    КонецЦикла;

    Попытка
        Для Каждого Мд Из Метаданные.Документы Цикл
            Имя = ВРег(Мд.Имя);
            Син = ВРег(Мд.Синоним);
            Если СтрНайти(Имя, "РЕАЛИЗАЦ") > 0 ИЛИ СтрНайти(Син, "РЕАЛИЗАЦ") > 0 Тогда
                Возврат Мд;
            КонецЕсли;
            Если (СтрНайти(Имя, "НАЧИСЛ") > 0 ИЛИ СтрНайти(Син, "НАЧИСЛ") > 0)
                И (СтрНайти(Имя, "ЛИЦЕВ") > 0 ИЛИ СтрНайти(Син, "ЛИЦЕВ") > 0
                    ИЛИ СтрНайти(Имя, "СЧЕТ") > 0 ИЛИ СтрНайти(Син, "СЧЕТ") > 0) Тогда
                Возврат Мд;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

Функция НайтиНоменклатуруПоИмени(ИмяУслуги)

    ИмяНорм = ВРег(СокрЛП(ИмяУслуги));
    Если ПустаяСтрока(ИмяНорм) Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Карточка «Услуга» в Forma = элемент Справочник.Номенклатура (тип Услуга, вид Салон).
    // «В продаже» может быть выкл — на поиск не фильтруем.
    Тексты = Новый Массив;
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Номенклатура.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |    НЕ Номенклатура.ПометкаУдаления
    |    И ВРег(Номенклатура.Наименование) = &Имя");
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Номенклатура.Ссылка КАК Ссылка
    |ИЗ
    |    Справочник.Номенклатура КАК Номенклатура
    |ГДЕ
    |    НЕ Номенклатура.ПометкаУдаления
    |    И ВРег(Номенклатура.Наименование) ПОДОБНО &ИмяПодобно");

    Для Каждого ТекстЗапроса Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Имя", ИмяНорм);
        Запрос.УстановитьПараметр("ИмяПодобно", "%" + ИмяНорм + "%");
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() Тогда
                Возврат Выборка.Ссылка;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// РС.ЧленстваПакетыУслугИтоги — рассчитанный срок и статус (подтверждено сканером: СрокДействия=24.10.2026, Статус=Активен).
Функция ИтогиЧленстваПоКлиенту(Контрагент)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Итоги.ЧленствоПакетУслуг КАК Членство,
    |    Итоги.Статус КАК Статус,
    |    Итоги.ДатаАктивации КАК ДатаАктивации,
    |    Итоги.СрокДействия КАК СрокДействия,
    |    Итоги.ДнейОстаток КАК ДнейОстаток,
    |    Итоги.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |    РегистрСведений.ЧленстваПакетыУслугИтоги КАК Итоги
    |ГДЕ
    |    Итоги.ЧленствоПакетУслуг.Контрагент = &Контрагент
    |    И НЕ Итоги.ЧленствоПакетУслуг.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |    Итоги.СрокДействия УБЫВ";
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Возврат ВыборкаИтоговВСтруктуру(Запрос);
КонецФункции

