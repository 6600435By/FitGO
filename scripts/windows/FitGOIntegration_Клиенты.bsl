    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Статусы.Статус КАК Статус
    |ИЗ
    |    РегистрСведений.СтатусыЧленствПакетовУслуг.СрезПоследних(&Сейчас, ЧленствоПакетУслуг = &Членство) КАК Статусы";
    Запрос.УстановитьПараметр("Членство", Членство);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат СокрЛП(Строка(Выборка.Статус));
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат "";
КонецФункции

Функция СтатусЧленстваJSON(Состояние)
    Имя = ВРег(СокрЛП(Строка(Состояние)));
    Если ПустаяСтрока(Имя) Тогда
        Возврат "ACTIVE";
    КонецЕсли;
    Если СтрНайти(Имя, "ЗАМОРОЖ") > 0 Тогда
        Возврат "FROZEN";
    КонецЕсли;
    Если СтрНайти(Имя, "ИСТЕК") > 0
        ИЛИ СтрНайти(Имя, "ЗАКРЫТ") > 0
        ИЛИ СтрНайти(Имя, "ПРОСРОЧ") > 0
        ИЛИ СтрНайти(Имя, "НЕДЕЙСТВ") > 0
        ИЛИ СтрНайти(Имя, "АРХИВ") > 0 Тогда
        Возврат "EXPIRED";
    КонецЕсли;
    // До «АКТИВ»: «Не активирован» содержит «АКТИВ» и иначе стал бы ACTIVE.
    Если СтрНайти(Имя, "НЕ АКТИВ") > 0
        ИЛИ СтрНайти(Имя, "НЕАКТИВ") > 0
        ИЛИ СтрНайти(Имя, "ОЖИДА") > 0
        ИЛИ СтрНайти(Имя, "PENDING") > 0 Тогда
        Возврат "PENDING";
    КонецЕсли;
    Если СтрНайти(Имя, "АКТИВ") > 0 ИЛИ СтрНайти(Имя, "ДЕЙСТВ") > 0 Тогда
        Возврат "ACTIVE";
    КонецЕсли;
    Возврат "ACTIVE";
КонецФункции

// Лицевые счета + задолженность.
// Источник Forma: РегистрНакопления.РасчетыСПокупателями
//   «Лицевой счет» → accountBalance
//   «Долг» → debtAmount = сумма |отрицательных| (sumAbsNeg).
Функция СчетаИДолгиКлиента(Контрагент)
    Результат = Новый Структура("accountBalance,debtAmount,debug", Неопределено, Неопределено, Неопределено);
    Debug = Новый Структура;
    Debug.Вставить("ok", Ложь);
    Debug.Вставить("err", "");
    Debug.Вставить("rowCount", 0);
    Debug.Вставить("cols", "");
    Debug.Вставить("sample", "");
    Debug.Вставить("dim", "");
    Debug.Вставить("query", "");
    Debug.Вставить("face", 0);
    Debug.Вставить("debtAbsNeg", 0);
    Debug.Вставить("debtPos", 0);
    Debug.Вставить("countFace", 0);
    Debug.Вставить("countNeg", 0);
    Debug.Вставить("countPos", 0);
    Результат.debug = Debug;

    Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
        Debug.err = "empty_client";
        Возврат Результат;
    КонецЕсли;

    // Привилегии — отдельно: сбой режима не должен отменять чтение остатков
    Попытка
        УстановитьПривилегированныйРежим(Истина);
        Debug.Вставить("privileged", Истина);
    Исключение
        Debug.Вставить("privileged", Ложь);
    КонецПопытки;

    Попытка
        Пакет = ОстаткиРасчетовСПокупателямиПакет(Контрагент);
        Debug.dim = Пакет.dim;
        Debug.query = Пакет.query;
        Debug.err = Пакет.err;
        Таб = Пакет.table;
        Если Таб = Неопределено Тогда
            Debug.err = ?(ПустаяСтрока(Debug.err), "no_table", Debug.err);
        Иначе
            Debug.rowCount = Таб.Количество();
            ИменаКол = Новый Массив;
            Для Каждого Кол Из Таб.Колонки Цикл
                ИменаКол.Добавить(Кол.Имя);
            КонецЦикла;
            Debug.cols = СтрСоединить(ИменаКол, ",");
            Если Таб.Количество() > 0 Тогда
                Debug.sample = СтрокаПервойДенежнойСтроки(Таб[0], Таб.Колонки);
            КонецЕсли;

            Сводка = СвернутьДенежнуюТаблицу(Таб);
            Debug.ok = Истина;
            Debug.face = Сводка.face;
            Debug.debtAbsNeg = Сводка.debtAbsNeg;
            Debug.debtPos = Сводка.debtPos;
            Debug.countFace = Сводка.countFace;
            Debug.countNeg = Сводка.countNeg;
            Debug.countPos = Сводка.countPos;

            Если Сводка.countFace > 0 Тогда
                Результат.accountBalance = Сводка.face;
            КонецЕсли;
            Если Сводка.countNeg > 0 Тогда
                Результат.debtAmount = Сводка.debtAbsNeg;
            ИначеЕсли Сводка.countPos > 0 Тогда
                Результат.debtAmount = Сводка.debtPos;
            КонецЕсли;
        КонецЕсли;
    Исключение
        Debug.err = FitGOКраткоОшибку(ИнформацияОбОшибке());
    КонецПопытки;

    Попытка
        УстановитьПривилегированныйРежим(Ложь);
    Исключение
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция СвернутьДенежнуюТаблицу(Таб)
    Сводка = Новый Структура("face,debtPos,debtAbsNeg,countFace,countPos,countNeg", 0, 0, 0, 0, 0, 0);
    Для Каждого Стр Из Таб Цикл
        Для Каждого Акк Из РазобратьДенежнуюСтрокуТаблицы(Стр, Таб.Колонки) Цикл
            Если Акк.isAccount Тогда
                Сводка.face = Сводка.face + Акк.amount;
                Сводка.countFace = Сводка.countFace + 1;
            ИначеЕсли Акк.isDebt Тогда
                Если Акк.amount > 0 Тогда
                    Сводка.debtPos = Сводка.debtPos + Акк.amount;
                    Сводка.countPos = Сводка.countPos + 1;
                ИначеЕсли Акк.amount < 0 Тогда
                    Сводка.debtAbsNeg = Сводка.debtAbsNeg + (-Акк.amount);
                    Сводка.countNeg = Сводка.countNeg + 1;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Сводка;
КонецФункции

Функция СтрокаПервойДенежнойСтроки(Стр, Колонки)
    Части = Новый Массив;
    Для Каждого Кол Из Колонки Цикл
        Значение = Стр[Кол.Имя];
        Предст = "";
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            Предст = Формат(Значение, "ЧГ=0; ЧДЦ=2");
        ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
            Предст = Лев(Строка(Значение), 80);
        КонецЕсли;
        Если НЕ ПустаяСтрока(Предст) Тогда
            Части.Добавить(Кол.Имя + "=" + Предст);
        КонецЕсли;
    КонецЦикла;
    Возврат СтрСоединить(Части, "; ");
КонецФункции

// Разбор строки остатков — как сканер РазобратьДенежныйРяд.
Функция РазобратьДенежнуюСтрокуТаблицы(Стр, Колонки)
    Результат = Новый Массив;
    СуммаОбщая = Неопределено;
    ВидИзм = "";
    ЛицевРесурс = Неопределено;
    ДолгРесурс = Неопределено;

    Для Каждого Кол Из Колонки Цикл
        ИмяВ = ВРег(Кол.Имя);
        Значение = Стр[Кол.Имя];
        Если ТипЗнч(Значение) = Тип("Число") Тогда
            Если СтрНайти(ИмяВ, "ЛИЦЕВ") > 0 Тогда
                ЛицевРесурс = Значение;
            ИначеЕсли ИмяВ = "ДОЛГ" ИЛИ СтрНайти(ИмяВ, "ДОЛГ") = 1 Тогда
                ДолгРесурс = Значение;
            ИначеЕсли СтрНайти(ИмяВ, "СУММ") > 0 Тогда
                СуммаОбщая = Значение;
            ИначеЕсли СтрНайти(ИмяВ, "ОСТАТОК") > 0
                И СтрНайти(ИмяВ, "КОЛИЧЕСТВ") = 0
                И СтрНайти(ИмяВ, "ДНЕЙ") = 0 Тогда
                Если СуммаОбщая = Неопределено Тогда
                    СуммаОбщая = Значение;
                КонецЕсли;
            КонецЕсли;
        ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
            Предст = Строка(Значение);
            ПредстВ = ВРег(Предст);
            // Приоритет: явный Лицевой/Долг в значении
            Если СтрНайти(ПредстВ, "ЛИЦЕВ") > 0 ИЛИ СтрНайти(ПредстВ, "ДОЛГ") > 0 Тогда
                ВидИзм = Предст;
            ИначеЕсли ПустаяСтрока(ВидИзм)
                И (СтрНайти(ИмяВ, "ВИД") > 0 ИЛИ СтрНайти(ИмяВ, "ТИПРАСЧ") > 0
                    ИЛИ СтрНайти(ИмяВ, "СЧЕТРАСЧ") > 0 ИЛИ СтрНайти(ИмяВ, "ТИПРАС") > 0) Тогда
                ВидИзм = Предст;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Если ЛицевРесурс <> Неопределено Тогда
        Результат.Добавить(Новый Структура("amount,isDebt,isAccount", ЛицевРесурс, Ложь, Истина));
    КонецЕсли;
    Если ДолгРесурс <> Неопределено Тогда
        Результат.Добавить(Новый Структура("amount,isDebt,isAccount", ДолгРесурс, Истина, Ложь));
    КонецЕсли;
    Если Результат.Количество() = 0 И СуммаОбщая <> Неопределено Тогда
        ВидВ = ВРег(ВидИзм);
        ЭтоДолг = СтрНайти(ВидВ, "ДОЛГ") > 0;
        ЭтоЛиц = СтрНайти(ВидВ, "ЛИЦЕВ") > 0 ИЛИ СтрНайти(ВидВ, "БОНУС") > 0;
        Если ЭтоДолг ИЛИ ЭтоЛиц Тогда
            Результат.Добавить(Новый Структура("amount,isDebt,isAccount", СуммаОбщая, ЭтоДолг, ЭтоЛиц));
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

// Возвращает Структура: table, dim, query, err
Функция ОстаткиРасчетовСПокупателямиПакет(Контрагент)
    Пакет = Новый Структура("table,dim,query,err", Неопределено, "", "", "");
    ИменаИзм = ИменаИзмеренийКлиентаРасчетов(Контрагент);
    Пакет.dim = СтрСоединить(ИменаИзм, ",");

    Тексты = Новый Массив;
    Для Каждого ИмяИзм Из ИменаИзм Цикл
        Тексты.Добавить(Новый Структура("dim,text", ИмяИзм,
            "ВЫБРАТЬ * ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, " + ИмяИзм + " = &К) КАК Остатки"));
        Тексты.Добавить(Новый Структура("dim,text", ИмяИзм,
            "ВЫБРАТЬ * ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(&Сейчас, " + ИмяИзм + " = &К) КАК Остатки"));
    КонецЦикла;
    Для Каждого ИмяИзм Из ИменаИзм Цикл
        Тексты.Добавить(Новый Структура("dim,text", ИмяИзм,
        "ВЫБРАТЬ
        |    Остатки.ТипРасчетов КАК Вид,
        |    СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
        |ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, " + ИмяИзм + " = &К) КАК Остатки
        |СГРУППИРОВАТЬ ПО Остатки.ТипРасчетов"));
        Тексты.Добавить(Новый Структура("dim,text", ИмяИзм,
        "ВЫБРАТЬ
        |    Остатки.ВидРасчетов КАК Вид,
        |    СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
        |ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, " + ИмяИзм + " = &К) КАК Остатки
        |СГРУППИРОВАТЬ ПО Остатки.ВидРасчетов"));
        Тексты.Добавить(Новый Структура("dim,text", ИмяИзм,
        "ВЫБРАТЬ
        |    Остатки.СчетРасчетов КАК Вид,
        |    СУММА(Остатки.СуммаОстаток) КАК СуммаОстаток
        |ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, " + ИмяИзм + " = &К) КАК Остатки
        |СГРУППИРОВАТЬ ПО Остатки.СчетРасчетов"));
    КонецЦикла;

    Ошибки = Новый Массив;
    Для Каждого Эл Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = Эл.text;
        Запрос.УстановитьПараметр("К", Контрагент);
        Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
        Попытка
            Таб = Запрос.Выполнить().Выгрузить();
            Если Таб.Количество() > 0 Тогда
                Пакет.table = Таб;
                Пакет.dim = Эл.dim;
                Пакет.query = Лев(СтрЗаменить(Эл.text, Символы.ПС, " "), 160);
                Возврат Пакет;
            КонецЕсли;
        Исключение
            Ошибки.Добавить(Эл.dim + ":" + FitGOКраткоОшибку(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;

    Если Ошибки.Количество() > 0 Тогда
        Пакет.err = СтрСоединить(Ошибки, " | ");
        Если СтрДлина(Пакет.err) > 500 Тогда
            Пакет.err = Лев(Пакет.err, 500);
        КонецЕсли;
    Иначе
        Пакет.err = "empty_balances";
    КонецЕсли;
    Возврат Пакет;
КонецФункции

Функция ИменаИзмеренийКлиентаРасчетов(Контрагент = Неопределено)
    Имена = Новый Массив;
    Имена.Добавить("Контрагент");
    Попытка
        Мд = Метаданные.РегистрыНакопления.РасчетыСПокупателями;
        ТипКлиента = Неопределено;
        Если Контрагент <> Неопределено Тогда
            ТипКлиента = ТипЗнч(Контрагент);
        Иначе
            ТипКлиента = Тип("СправочникСсылка.Контрагенты");
        КонецЕсли;
        Для Каждого Изм Из Мд.Измерения Цикл
            Попытка
                Если Изм.Тип.СодержитТип(ТипКлиента) И НЕ ИмяУжеВМассиве(Имена, Изм.Имя) Тогда
                    Имена.Добавить(Изм.Имя);
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Для Каждого Доп Из СтрРазделить("Клиент,Партнер,Покупатель", ",") Цикл
        Если НЕ ИмяУжеВМассиве(Имена, Доп) Тогда
            Имена.Добавить(Доп);
        КонецЕсли;
    КонецЦикла;
    Возврат Имена;
КонецФункции

Функция ИмяУжеВМассиве(МассивИмен, Имя)
    Для Каждого Эл Из МассивИмен Цикл
        Если Эл = Имя Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция FitGOКраткоОшибку(Инфо)
    Попытка
        Возврат Лев(ПодробноеПредставлениеОшибки(Инфо), 200);
    Исключение
    КонецПопытки;
    Попытка
        Возврат Лев(Строка(Инфо.Описание), 200);
    Исключение
    КонецПопытки;
    Попытка
        Возврат Лев(Строка(Инфо), 200);
    Исключение
        Возврат "error";
    КонецПопытки;
КонецФункции

// Все проведённые неархивные пакеты клиента (абонемент + блок массажей и др.).
Функция СписокЧленствПакетовКлиента(Контрагент)

    Результат = Новый Массив;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Ч.Ссылка КАК Членство
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ";
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если ЗначениеЗаполнено(Выборка.Членство) Тогда
                Результат.Добавить(Выборка.Членство);
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Результат;

КонецФункции

// Пакет с остатком по имени услуги (VIP или отдельный блок массажей).
// Возврат: Структура { Членство, УслугаСегмент } или Неопределено.
Функция НайтиЧленствоСУслугой(Контрагент, ИмяУслуги)

    Пакеты = СписокЧленствПакетовКлиента(Контрагент);
    Если Пакеты.Количество() = 0 Тогда
        // Запас: один «активный» из итогов / НайтиЧленство
        Членство = Неопределено;
        Итоги = ИтогиЧленстваПоКлиенту(Контрагент);
        Если Итоги <> Неопределено Тогда
            Членство = Итоги.Членство;
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Членство) Тогда
            Членство = НайтиЧленство(Контрагент);
        КонецЕсли;
        Если ЗначениеЗаполнено(Членство) Тогда
            Пакеты.Добавить(Членство);
        КонецЕсли;
    КонецЕсли;

    Для Каждого Членство Из Пакеты Цикл
        УслугаСегмент = НайтиУслугуСегментВОстатках(Членство, ИмяУслуги);
        Если УслугаСегмент = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если УслугаСегмент.Свойство("unlimited") И УслугаСегмент.unlimited = Истина Тогда
            Рез = Новый Структура;
            Рез.Вставить("Членство", Членство);
            Рез.Вставить("УслугаСегмент", УслугаСегмент);
            Возврат Рез;
        КонецЕсли;
        Если УслугаСегмент.Свойство("remaining") И УслугаСегмент.remaining > 0 Тогда
            Рез = Новый Структура;
            Рез.Вставить("Членство", Членство);
            Рез.Вставить("УслугаСегмент", УслугаСегмент);
            Возврат Рез;
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

// Сводка квот услуг по всем пакетам клиента (для GET /membership.services).
// PrimaryУслуги — уже собранные остатки основного документа (чтобы не дергать дважды).
Функция ОбъединитьКвотыУслугПакетов(Контрагент, ОсновноеЧленство, PrimaryУслуги)

    ПоИмени = Новый Соответствие;

    // Primary
    Если PrimaryУслуги <> Неопределено Тогда
        Для Каждого Услуга Из PrimaryУслуги Цикл
            Ключ = ВРег(СокрЛП(Строка(Услуга.name)));
            Если ПустаяСтрока(Ключ) Тогда
                Продолжить;
            КонецЕсли;
            ПоИмени.Вставить(Ключ, Услуга);
        КонецЦикла;
    КонецЕсли;

    Пакеты = СписокЧленствПакетовКлиента(Контрагент);
    Для Каждого Членство Из Пакеты Цикл
        Если ЗначениеЗаполнено(ОсновноеЧленство) И Членство = ОсновноеЧленство Тогда
            Продолжить;
        КонецЕсли;
        // Пропускаем явно истёкшие по итогам
        ИтогиП = ИтогиЧленстваПоСсылке(Членство);
        Если ИтогиП <> Неопределено Тогда
            СтатусП = СтатусЧленстваJSON(ИтогиП.Статус);
            Если СтатусП = "EXPIRED" Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        ОстаткиП = ОстаткиЧленства(Членство);
        Для Каждого Услуга Из ОстаткиП.Услуги Цикл
            Ключ = ВРег(СокрЛП(Строка(Услуга.name)));
            Если ПустаяСтрока(Ключ) Тогда
                Продолжить;
            КонецЕсли;
            Тек = ПоИмени.Получить(Ключ);
            Если Тек = Неопределено Тогда
                ПоИмени.Вставить(Ключ, Услуга);
                Продолжить;
            КонецЕсли;
            // Предпочитаем строку с большим остатком / unlimited
            НовБезлим = (Услуга.Свойство("unlimited") И Услуга.unlimited = Истина);
            СтБезлим = (Тек.Свойство("unlimited") И Тек.unlimited = Истина);
            Если НовБезлим И НЕ СтБезлим Тогда
                ПоИмени.Вставить(Ключ, Услуга);
            ИначеЕсли НЕ НовБезлим И НЕ СтБезлим Тогда
                НовОст = 0;
                СтОст = 0;
                Если Услуга.Свойство("remaining") Тогда
                    НовОст = Услуга.remaining;
                КонецЕсли;
                Если Тек.Свойство("remaining") Тогда
                    СтОст = Тек.remaining;
                КонецЕсли;
                Если НовОст > СтОст Тогда
                    ПоИмени.Вставить(Ключ, Услуга);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Результат = Новый Массив;
    Для Каждого КЗ Из ПоИмени Цикл
        Результат.Добавить(КЗ.Значение);
    КонецЦикла;
    Возврат Результат;

КонецФункции

// GET /v1/packages — все активные пакеты клиента (фаза 1b).
Функция ПакетыКлиентаJSON(Контрагент) Экспорт

    Результат = Новый Массив;
    Пакеты = СписокЧленствПакетовКлиента(Контрагент);
    Для Каждого Членство Из Пакеты Цикл
        Итоги = ИтогиЧленстваПоСсылке(Членство);
        СтатусТекст = "";
        ДатаНачала = '00010101';
        ДатаОкончания = '00010101';
        Если Итоги <> Неопределено Тогда
            СтатусТекст = Итоги.Статус;
            Если ЗначениеЗаполнено(Итоги.ДатаАктивации) Тогда
                ДатаНачала = Итоги.ДатаАктивации;
            КонецЕсли;
            Если ЗначениеЗаполнено(Итоги.СрокДействия) Тогда
                ДатаОкончания = Итоги.СрокДействия;
            КонецЕсли;
        КонецЕсли;
        Если ПустаяСтрока(СтатусТекст) Тогда
            СтатусТекст = СтатусЧленстваИзРегистра(Членство);
        КонецЕсли;
        Статус = СтатусЧленстваJSON(СтатусТекст);
        Если Статус = "EXPIRED" Тогда
            Продолжить;
        КонецЕсли;

        Наименование = "";
        Попытка
            Наименование = СокрЛП(Строка(Членство.Номенклатура));
        Исключение
        КонецПопытки;
        Если ПустаяСтрока(Наименование) Тогда
            Наименование = Строка(Членство);
        КонецЕсли;

        Ид = "";
        Попытка
            Ид = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Членство);
        Исключение
            Ид = Строка(Членство);
        КонецПопытки;

        Остатки = ОстаткиЧленства(Членство);
        Квоты = Новый Массив;
        Для Каждого Услуга Из Остатки.Услуги Цикл
            СтрК = Новый Структура;
            СтрК.Вставить("serviceName", Услуга.name);
            Если Услуга.Свойство("unlimited") И Услуга.unlimited = Истина Тогда
                СтрК.Вставить("unlimited", Истина);
            ИначеЕсли Услуга.Свойство("remaining") Тогда
                СтрК.Вставить("remaining", Услуга.remaining);
            КонецЕсли;
            Если Услуга.Свойство("total") Тогда
                СтрК.Вставить("total", Услуга.total);
            КонецЕсли;
            СтрК.Вставить("saleType", "service");
            Квоты.Добавить(СтрК);
        КонецЦикла;

        Пакет = Новый Структура;
        Пакет.Вставить("id", Ид);
        Пакет.Вставить("name", Наименование);
        Пакет.Вставить("status", Статус);
        Пакет.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаНачала));
        Пакет.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаОкончания));
        Пакет.Вставить("serviceQuotas", Квоты);
        Результат.Добавить(Пакет);
    КонецЦикла;

    Возврат Результат;

КонецФункции

// Текущее членство клиента: последний проведённый неархивный Документ.ЧленствоПакетУслуг,
// запас — Основание последнего посещения (если документ по Контрагенту не нашёлся).
Функция НайтиЧленство(Контрагент)
    Тексты = Новый Массив;

    // 1) Только тип «Членство» (не пакеты разовых услуг)
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Ч.Ссылка КАК Членство
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |    И Ч.ТипЧленстваПакетаУслуг = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Членство)
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ");

    // 2) Любой неархивный документ членства/пакета
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Ч.Ссылка КАК Членство
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ");

    // 3) Основание последнего посещения
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Посещение.Основание КАК Членство
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    Посещение.Контрагент = &Контрагент
    |    И НЕ Посещение.ПометкаУдаления
    |    И НЕ Посещение.ПризнакОтменен
    |    И Посещение.Основание ССЫЛКА Документ.ЧленствоПакетУслуг
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода УБЫВ");

    Для Каждого ТекстЗапроса Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Членство) Тогда
                Возврат Выборка.Членство;
            КонецЕсли;
        Исключение
            // текст не скомпилировался (нет перечисления и т.п.) — следующий вариант
        КонецПопытки;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

// Остатки по РегистрНакопления.ЧленстваПакетыУслуг (измерения Основание, УслугаСегмент).
// Строка без УслугаСегмент — общие ресурсы членства (Дней, ДнейДополнительно, КоличествоДнейЗаморозок, посещения).
// Строки с УслугаСегмент — квоты услуг (Солярий 10, Массаж 1 …).
Функция ОстаткиЧленства(Членство)
    Результат = Новый Структура;
    Результат.Вставить("Посещения", Неопределено);
    Результат.Вставить("ДнейДополнительно", 0);
    Результат.Вставить("Дней", 0);
    Результат.Вставить("КоличествоДнейЗаморозок", 0);
    Результат.Вставить("Услуги", Новый Массив);

    ВсегоПоУслугам = Новый Соответствие;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    СУ.УслугаСегмент КАК Услуга,
    |    СУ.Количество КАК Количество
    |ИЗ
    |    Документ.ЧленствоПакетУслуг.СоставУслуг КАК СУ
    |ГДЕ
    |    СУ.Ссылка = &Членство";
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            ВсегоПоУслугам.Вставить(Выборка.Услуга, Выборка.Количество);
        КонецЦикла;
    Исключение
    КонецПопытки;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.УслугаСегмент КАК Услуга,
    |    Остатки.КоличествоОстаток КАК Количество,
    |    Остатки.ДнейОстаток КАК Дней,
    |    Остатки.ДнейДополнительноОстаток КАК ДнейДополнительно,
    |    Остатки.КоличествоДнейЗаморозокОстаток КАК КоличествоДнейЗаморозок,
    |    Остатки.КоличествоНеограниченноПризнакОстаток КАК Неограниченно
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг.Остатки(&Сейчас, Основание = &Членство) КАК Остатки";
    Запрос.УстановитьПараметр("Членство", Членство);
    Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Результат;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Если НЕ ЗначениеЗаполнено(Выборка.Услуга) Тогда
            Результат.Дней = ?(Выборка.Дней = NULL, 0, Выборка.Дней);
            Результат.ДнейДополнительно = ?(Выборка.ДнейДополнительно = NULL, 0, Выборка.ДнейДополнительно);
            Результат.КоличествоДнейЗаморозок = ?(Выборка.КоличествоДнейЗаморозок = NULL, 0, Выборка.КоличествоДнейЗаморозок);
            Если Выборка.Количество <> NULL И Выборка.Количество > 0 Тогда
                Результат.Посещения = Выборка.Количество;
            КонецЕсли;
            Продолжить;
        КонецЕсли;

        Услуга = Новый Структура;
        Услуга.Вставить("name", СокрЛП(Строка(Выборка.Услуга)));
        Если Выборка.Неограниченно <> NULL И Выборка.Неограниченно > 0 Тогда
            Услуга.Вставить("unlimited", Истина);
        Иначе
            Услуга.Вставить("remaining", ?(Выборка.Количество = NULL, 0, Выборка.Количество));
        КонецЕсли;
        Всего = ВсегоПоУслугам.Получить(Выборка.Услуга);
        Если Всего <> Неопределено И Всего > 0 Тогда
            Услуга.Вставить("total", Всего);
        КонецЕсли;
        Результат.Услуги.Добавить(Услуга);
    КонецЦикла;

    Возврат Результат;
КонецФункции

// СрокДействия (Число) + СрокДействияТип (Перечисление.Периодичность) → дата окончания.
Функция ДобавитьСрок(ДатаНачала, Число, ТипСрока)
    Если НЕ ЗначениеЗаполнено(Число) ИЛИ Число <= 0 Тогда
        Возврат ДатаНачала;
    КонецЕсли;
    Если СтрНайти(ТипСрока, "ГОД") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число * 12);
    ИначеЕсли СтрНайти(ТипСрока, "КВАРТ") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число * 3);
    ИначеЕсли СтрНайти(ТипСрока, "МЕС") > 0 Тогда
        Возврат ДобавитьМесяц(ДатаНачала, Число);
    ИначеЕсли СтрНайти(ТипСрока, "НЕД") > 0 Тогда
        Возврат ДатаНачала + Число * 7 * 86400;
    КонецЕсли;
    // День и всё неизвестное — считаем днями
    Возврат ДатаНачала + Число * 86400;
КонецФункции

Функция НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост)
    // Порядок: ТЧ справочника (БСП) → регистр сведений. Ошибка компиляции текста → следующий вариант.
    Тексты = Новый Массив;

    // 1) БСП: табличная часть Справочник.Контрагенты.КонтактнаяИнформация
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    КИ.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
    |ГДЕ
    |    НЕ КИ.Ссылка.ПометкаУдаления
    |    И (
    |        КИ.НомерТелефона ПОДОБНО &МаскаХвост
    |        ИЛИ КИ.НомерТелефонаБезКодов ПОДОБНО &МаскаХвост
    |        ИЛИ КИ.Представление ПОДОБНО &МаскаХвост)");
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    КИ.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
    |ГДЕ
    |    НЕ КИ.Ссылка.ПометкаУдаления
    |    И (
    |        КИ.НомерТелефона ПОДОБНО &МаскаХвост
    |        ИЛИ КИ.Представление ПОДОБНО &МаскаХвост)");
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    КИ.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты.КонтактнаяИнформация КАК КИ
    |ГДЕ
    |    КИ.Представление ПОДОБНО &МаскаХвост");

    // 2) Регистр сведений КонтактнаяИнформация
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.Объект КАК Контрагент
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект ССЫЛКА Справочник.Контрагенты
    |    И (
    |        Контакт.НомерТелефона = &Нормализованный
    |        ИЛИ Контакт.НомерТелефона ПОДОБНО &МаскаХвост
    |        ИЛИ Контакт.Представление ПОДОБНО &МаскаХвост)");
    Тексты.Добавить(
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контакт.Объект КАК Контрагент
    |ИЗ
    |    РегистрСведений.КонтактнаяИнформация КАК Контакт
    |ГДЕ
    |    Контакт.Объект ССЫЛКА Справочник.Контрагенты
    |    И Контакт.НомерТелефона ПОДОБНО &МаскаХвост");

    Для Каждого ТекстЗапроса Из Тексты Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = ТекстЗапроса;
        Запрос.УстановитьПараметр("Нормализованный", Нормализованный);
        Запрос.УстановитьПараметр("МаскаХвост", "%" + Хвост + "%");
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
                Возврат Выборка.Контрагент;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

Функция НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Контрагенты.Ссылка КАК Контрагент
    |ИЗ
    |    Справочник.Контрагенты КАК Контрагенты
    |ГДЕ
