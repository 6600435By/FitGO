    Возврат Результат;
КонецФункции

// --- заморозка ---

Процедура ДобавитьПоляЗаморозки(Результат, Членство, Остатки, СтатусJSON)

    // Scan 2026-09-08 (Куделко VIP): total=КоличествоДнейЗаморозок, remaining=КоличествоДнейЗаморозокОстаток
    // Не путать с ДнейДополнительноОстаток (другой ресурс).
    ВсегоЗаморозок = КоличествоДнейЗаморозкиИзЧленства(Членство);
    ОстатокЗаморозок = Неопределено;
    Если Остатки <> Неопределено И Остатки.Свойство("КоличествоДнейЗаморозок") Тогда
        ОстатокЗаморозок = Остатки.КоличествоДнейЗаморозок;
    КонецЕсли;

    Разрешено = Ложь;
    Если ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок > 0 Тогда
        Разрешено = Истина;
        Если ОстатокЗаморозок = Неопределено Тогда
            ОстатокЗаморозок = ВсегоЗаморозок;
        КонецЕсли;
    ИначеЕсли ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок = 0 Тогда
        Разрешено = Ложь;
        ОстатокЗаморозок = 0;
    ИначеЕсли ОстатокЗаморозок <> Неопределено И ОстатокЗаморозок > 0 Тогда
        Разрешено = Истина;
    ИначеЕсли ЕстьПризнакЗаморозкиВЧленстве(Членство) Тогда
        Разрешено = Истина;
        Если ОстатокЗаморозок = Неопределено Тогда
            ОстатокЗаморозок = 0;
        КонецЕсли;
    Иначе
        Разрешено = Ложь;
        ОстатокЗаморозок = 0;
    КонецЕсли;

    Результат.Вставить("freezeAllowed", Разрешено);
    Если Разрешено Тогда
        Результат.Вставить("freezeDaysRemaining", ?(ОстатокЗаморозок = Неопределено, 0, ОстатокЗаморозок));
        Если ВсегоЗаморозок <> Неопределено И ВсегоЗаморозок > 0 Тогда
            Результат.Вставить("freezeDaysTotal", ВсегоЗаморозок);
        КонецЕсли;
    КонецЕсли;

    Если СтатусJSON = "FROZEN" Тогда
        ДатаДо = ДатаОкончанияТекущейЗаморозки(Членство);
        Если ТипЗнч(ДатаДо) = Тип("Дата") И ЗначениеЗаполнено(ДатаДо) Тогда
            Результат.Вставить("frozenUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаДо));
        КонецЕсли;
    КонецЕсли;

КонецПроцедуры

Функция КоличествоДнейЗаморозкиИзЧленства(Членство)

    // Предпочесть точный реквизит КоличествоДнейЗаморозок (не Минимум…).
    Попытка
        Зн = Членство.КоличествоДнейЗаморозок;
        Если ТипЗнч(Зн) = Тип("Число") Тогда
            Возврат Зн;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Попытка
        Мд = Членство.Метаданные();
        Для Каждого Рекв Из Мд.Реквизиты Цикл
            Верх = ВРег(Рекв.Имя);
            Если Верх <> "КОЛИЧЕСТВОДНЕЙЗАМОРОЗОК" Тогда
                Если СтрНайти(Верх, "ЗАМОРОЗ") = 0 ИЛИ СтрНайти(Верх, "МИНИМУМ") > 0 Тогда
                    Продолжить;
                КонецЕсли;
            КонецЕсли;
            Попытка
                Зн = Членство[Рекв.Имя];
                Если ТипЗнч(Зн) = Тип("Число") Тогда
                    Возврат Зн;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

Функция ЕстьПризнакЗаморозкиВЧленстве(Членство)

    Попытка
        Мд = Членство.Метаданные();
        Для Каждого Рекв Из Мд.Реквизиты Цикл
            Если СтрНайти(ВРег(Рекв.Имя), "ЗАМОРОЗ") > 0 Тогда
                Возврат Истина;
            КонецЕсли;
       КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Ложь;

КонецФункции

Функция ДатаОкончанияТекущейЗаморозки(Членство)

    // Последняя проведённая операция Заморозка — реквизит даты окончания («до»).
    // Нельзя искать маской "ДО": она ловит ВидОперации (подстрока «ДО» в «ВИДO…»).
    ДокМд = НайтиМетаданныеОперацииСЧленством();
    Если ДокМд = Неопределено Тогда
        Возврат '00010101';
    КонецЕсли;
    ИмяРеквЧленства = "";
    ИмяРеквДо = "";
    ИмяРеквОпер = "";
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        Верх = ВРег(Рекв.Имя);
        Если ПустаяСтрока(ИмяРеквЧленства)
            И (Верх = "ЧЛЕНСТВОПАКЕТУСЛУГ" ИЛИ Верх = "ЧЛЕНСТВО"
                ИЛИ СтрНайти(Верх, "ЧЛЕНСТВ") > 0) Тогда
            ИмяРеквЧленства = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяРеквДо) И ЭтоРеквизитДатыОкончанияЗаморозки(Рекв) Тогда
            ИмяРеквДо = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяРеквОпер)
            И (СтрНайти(Верх, "ОПЕРАЦ") > 0 ИЛИ Верх = "ВИДОПЕРАЦИИ" ИЛИ Верх = "ВИД") Тогда
            ИмяРеквОпер = Рекв.Имя;
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(ИмяРеквЧленства) ИЛИ ПустаяСтрока(ИмяРеквДо) Тогда
        Возврат '00010101';
    КонецЕсли;

    Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Док." + ИмяРеквДо + " КАК ДатаДо
    |ИЗ
    |    Документ." + ДокМд.Имя + " КАК Док
    |ГДЕ
    |    Док.Проведен
    |    И НЕ Док.ПометкаУдаления
    |    И Док." + ИмяРеквЧленства + " = &Членство
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата УБЫВ";
    Запрос = Новый Запрос(Текст);
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Зн = Выборка.ДатаДо;
            Если ТипЗнч(Зн) = Тип("Дата") И ЗначениеЗаполнено(Зн) Тогда
                Возврат Зн;
            КонецЕсли;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат '00010101';

КонецФункции

Функция ЭтоРеквизитДатыОкончанияЗаморозки(Рекв)

    Верх = ВРег(Рекв.Имя);
    // Явные имена с формы стойки («до»)
    Если Верх = "ДАТАПО" ИЛИ Верх = "ДАТАОКОНЧАНИЯ"
        ИЛИ Верх = "ОКОНЧАНИЕ" ИЛИ Верх = "СРОКДО" ИЛИ Верх = "ДЕЙСТВУЕТДО"
        ИЛИ Верх = "ПО" ИЛИ Верх = "ДО" Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    Если СтрНайти(Верх, "ДАТАПО") > 0 ИЛИ СтрНайти(Верх, "ДАТАОКОНЧ") > 0 Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    // «…До» на конце, но не ВидОперации / Документ*
    Если СтрДлина(Верх) >= 2 И Прав(Верх, 2) = "ДО"
        И СтрНайти(Верх, "ОПЕРАЦ") = 0
        И СтрНайти(Верх, "ДОКУМЕНТ") = 0
        И СтрНайти(Верх, "ВИД") = 0 Тогда
        Возврат РеквизитСодержитТипДата(Рекв);
    КонецЕсли;
    Возврат Ложь;

КонецФункции

