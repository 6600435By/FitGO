Функция НайтиМетаданныеОперацииСЧленством()

    // Подтверждено сканером 2026-09-08: Документ.ОперацииСЧленствомПакетомУслуг
    МдТочный = Метаданные.НайтиПоПолномуИмени("Документ.ОперацииСЧленствомПакетомУслуг");
    Если МдТочный <> Неопределено Тогда
        Возврат МдТочный;
    КонецЕсли;

    Попытка
        Кандидаты = Новый Массив;
        Для Каждого Мд Из Метаданные.Документы Цикл
            Имя = ВРег(Мд.Имя);
            Син = ВРег(Мд.Синоним);
            Если (СтрНайти(Имя, "ОПЕРАЦ") > 0 ИЛИ СтрНайти(Син, "ОПЕРАЦ") > 0)
                И (СтрНайти(Имя, "ЧЛЕНСТВ") > 0 ИЛИ СтрНайти(Син, "ЧЛЕНСТВ") > 0
                    ИЛИ СтрНайти(Имя, "ПАКЕТ") > 0 ИЛИ СтрНайти(Син, "ПАКЕТ") > 0) Тогда
                Кандидаты.Добавить(Мд);
            КонецЕсли;
        КонецЦикла;
        Для Каждого Мд Из Кандидаты Цикл
            Син = ВРег(Мд.Синоним);
            Если СтрНайти(Син, "ОПЕРАЦИЯ С ЧЛЕНСТВОМ") > 0 ИЛИ СтрНайти(Син, "ОПЕРАЦИЯ С ЧЛЕНСТВ") > 0 Тогда
                Возврат Мд;
            КонецЕсли;
        КонецЦикла;
        Если Кандидаты.Количество() > 0 Тогда
            Возврат Кандидаты[0];
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

