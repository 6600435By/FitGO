Функция РеквизитСовместимСоЗначением(Рекв, Значение)

    Если Значение = Неопределено Тогда
        Возврат Ложь;
    КонецЕсли;
    Попытка
        ТипЗн = ТипЗнч(Значение);
        Для Каждого Т Из Рекв.Тип.Типы() Цикл
            Если Т = ТипЗн Тогда
                Возврат Истина;
            КонецЕсли;
            // Ссылочные типы: ДокументСсылка.* / СправочникСсылка.* — сравнение через НайтиПоТипу
            Если Метаданные.НайтиПоТипу(Т) <> Неопределено И Метаданные.НайтиПоТипу(ТипЗн) <> Неопределено Тогда
                Если Метаданные.НайтиПоТипу(Т) = Метаданные.НайтиПоТипу(ТипЗн) Тогда
                    Возврат Истина;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Ложь;

КонецФункции

Процедура ЗаполнитьРеквизитДокументаПоМаскеТип(Док, ДокМд, МаскаВерх, Значение)

    Маски = СтрРазделить(МаскаВерх, ",");
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ПРИЗНАК") > 0 Тогда
            Продолжить; // не писать строки/ссылки в булевы «Признак*»
        КонецЕсли;
        Для Каждого М Из Маски Цикл
            М = СокрЛП(М);
            Если СтрНайти(ИмяВерх, М) > 0 Тогда
                Если НЕ РеквизитСовместимСоЗначением(Рекв, Значение) Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    Док[Рекв.Имя] = Значение;
                    Возврат;
                Исключение
                КонецПопытки;
            КонецЕсли;
       КонецЦикла;
   КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитЧисломПоМаскеТип(Док, ДокМд, МаскаВерх, ЧислоЗн)

    Маски = СтрРазделить(МаскаВерх, ",");
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ПРИЗНАК") > 0 Тогда
            Продолжить;
        КонецЕсли;
        Совпад = Ложь;
        Для Каждого М Из Маски Цикл
            Если СтрНайти(ИмяВерх, СокрЛП(М)) > 0 Тогда
                Совпад = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если НЕ Совпад Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Если Рекв.Тип.СодержитТип(Тип("Число")) Тогда
                Док[Рекв.Имя] = ЧислоЗн;
                Возврат;
            КонецЕсли;
        Исключение
        КонецПопытки;
   КонецЦикла;

