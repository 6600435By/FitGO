Функция СегментыКонфигJSON() Экспорт
    Результат = Новый Структура("segments", Новый Массив);
    Карта = КартаСегментовПриложения();
    Для Каждого КЗ Из Карта Цикл
        Ключ = КЗ.Ключ;
        Мет = КЗ.Значение;
        Эл = Новый Структура;
        Эл.Вставить("key", Ключ);
        Эл.Вставить("uuid", Мет.uuid);
        Эл.Вставить("name", Мет.name);
        Эл.Вставить("type", Мет.type);
        ИменаПоиска = Мет.name;
        Попытка
            ИменаПоиска = Мет.names;
        Исключение
        КонецПопытки;
        Ссылка = НайтиСсылкуСегмента(Мет.type, Мет.uuid, Мет.name, ИменаПоиска);
        Найден = ЗначениеЗаполнено(Ссылка);
        Эл.Вставить("found", Найден);
        Кол = 0;
        Если Найден Тогда
            Кол = КоличествоЧленовСегмента(Ссылка);
        КонецЕсли;
        Эл.Вставить("count", Кол);
        Результат.segments.Добавить(Эл);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СегментыЧленыJSON(Ключ, UuidСтр) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("key", Ключ);
    Результат.Вставить("uuid", UuidСтр);
    Результат.Вставить("type", "");
    Результат.Вставить("name", "");
    Результат.Вставить("found", Ложь);
    Результат.Вставить("data", Новый Массив);

    ТипСег = "";
    ИмяСег = "";
    ИменаСег = "";
    UuidИспользовать = СокрЛП(Строка(UuidСтр));

    Если НЕ ПустаяСтрока(Ключ) Тогда
        Карта = КартаСегментовПриложения();
        Мет = Карта.Получить(Ключ);
        Если Мет = Неопределено Тогда
            Результат.Вставить("error", "unknown key");
            Возврат Результат;
        КонецЕсли;
        ТипСег = Мет.type;
        ИмяСег = Мет.name;
        Попытка
            ИменаСег = Мет.names;
        Исключение
            ИменаСег = ИмяСег;
        КонецПопытки;
        Если ПустаяСтрока(UuidИспользовать) Тогда
            UuidИспользовать = Мет.uuid;
        КонецЕсли;
        Результат.key = Ключ;
        Результат.name = ИмяСег;
        Результат.type = ТипСег;
        Результат.uuid = UuidИспользовать;
    Иначе
        // Только uuid — пробуем employee, затем nomenclature
        ТипСег = "employee";
        ИмяСег = "";
        ИменаСег = "";
    КонецЕсли;

    Ссылка = НайтиСсылкуСегмента(ТипСег, UuidИспользовать, ИмяСег, ИменаСег);
    Если НЕ ЗначениеЗаполнено(Ссылка) И ТипСег = "employee" И ПустаяСтрока(Ключ) Тогда
        ТипСег = "nomenclature";
        Ссылка = НайтиСсылкуСегмента(ТипСег, UuidИспользовать, ИмяСег, ИменаСег);
        Результат.type = ТипСег;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Результат;
    КонецЕсли;

    Результат.found = Истина;
    Результат.type = ТипСег;
    Попытка
        Результат.name = СокрЛП(Строка(Ссылка));
    Исключение
    КонецПопытки;

    Объекты = ОбъектыСегмента(Ссылка);
    Для Каждого Объект Из Объекты Цикл
        Если НЕ ЗначениеЗаполнено(Объект) Тогда
            Продолжить;
        КонецЕсли;
        Эл = Новый Структура;
        ExternalId = "";
        Попытка
            ExternalId = Строка(Объект.УникальныйИдентификатор());
        Исключение
        КонецПопытки;
        Эл.Вставить("externalId", ExternalId);
        Эл.Вставить("name", СокрЛП(Строка(Объект)));
        Код = "";
        Попытка
            Код = СокрЛП(Строка(Объект.Код));
        Исключение
        КонецПопытки;
        Эл.Вставить("code", Код);
        Если ТипСег = "employee" Тогда
            Телефон = "";
            Попытка
                Телефон = СокрЛП(Строка(Объект.Телефон));
            Исключение
            КонецПопытки;
            Эл.Вставить("phone", Телефон);
        Иначе
            Цена = 0;
            Попытка
                Цена = Объект.Цена;
            Исключение
            КонецПопытки;
            Эл.Вставить("price", Цена);
            Ед = "";
            Попытка
                Ед = СокрЛП(Строка(Объект.ЕдиницаИзмерения));
            Исключение
            КонецПопытки;
            Эл.Вставить("unit", Ед);
        КонецЕсли;
        Результат.data.Добавить(Эл);
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция СсылкаСегментаСуществует(Ссылка)
    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ложь;
    КонецЕсли;
    Попытка
        Если Ссылка.Пустая() Тогда
            Возврат Ложь;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Попытка
        Предст = ВРег(СокрЛП(Строка(Ссылка)));
        Если СтрНайти(Предст, "НЕ НАЙДЕН") > 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Попытка
        Об = Ссылка.ПолучитьОбъект();
        Если Об = Неопределено Тогда
            Возврат Ложь;
        КонецЕсли;
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

Функция НайтиСсылкуСегментаПоИменам(ЭтоСотрудники, ИмяСег, ИменаЧерезЗапятую)
    СписокИмён = Новый Массив;
    Если ЗначениеЗаполнено(ИменаЧерезЗапятую) Тогда
        Для Каждого Часть Из СтрРазделить(ИменаЧерезЗапятую, ",", Ложь) Цикл
            СписокИмён.Добавить(СокрЛП(Часть));
        КонецЦикла;
    КонецЕсли;
    Если ЗначениеЗаполнено(ИмяСег) Тогда
        СписокИмён.Добавить(СокрЛП(ИмяСег));
    КонецЕсли;
    Для Каждого ИмяПоиска Из СписокИмён Цикл
        Если НЕ ЗначениеЗаполнено(ИмяПоиска) Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Если ЭтоСотрудники Тогда
                Ссылка = Справочники.СегментыСотрудников.НайтиПоНаименованию(ИмяПоиска, Истина);
            Иначе
                Ссылка = Справочники.СегментыНоменклатуры.НайтиПоНаименованию(ИмяПоиска, Истина);
            КонецЕсли;
            Если СсылкаСегментаСуществует(Ссылка) Тогда
                Возврат Ссылка;
            КонецЕсли;
        Исключение
        КонецПопытки;
        Попытка
            Если ЭтоСотрудники Тогда
                Ссылка = Справочники.СегментыСотрудников.НайтиПоНаименованию(ИмяПоиска, Ложь);
            Иначе
                Ссылка = Справочники.СегментыНоменклатуры.НайтиПоНаименованию(ИмяПоиска, Ложь);
            КонецЕсли;
            Если СсылкаСегментаСуществует(Ссылка) Тогда
                Возврат Ссылка;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции

Функция НайтиСсылкуСегментаПоUUID(ЭтоСотрудники, UuidСтр)
    Если НЕ ЗначениеЗаполнено(UuidСтр) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Уид = Новый УникальныйИдентификатор(СокрЛП(UuidСтр));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Попытка
        Если ЭтоСотрудники Тогда
            Ссылка = Справочники.СегментыСотрудников.ПолучитьСсылку(Уид);
        Иначе
            Ссылка = Справочники.СегментыНоменклатуры.ПолучитьСсылку(Уид);
        КонецЕсли;
        Если СсылкаСегментаСуществует(Ссылка) Тогда
            Возврат Ссылка;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Неопределено;
КонецФункции

Функция НайтиСсылкуСегмента(ТипСег, UuidСтр, ИмяСег, ИменаЧерезЗапятую = "")
    ЭтоСотрудники = (ТипСег = "employee");
    // Сначала по имени (надежнее для сегментов «для приложения»), затем UUID.
    Ссылка = НайтиСсылкуСегментаПоИменам(ЭтоСотрудники, ИмяСег, ИменаЧерезЗапятую);
    Если СсылкаСегментаСуществует(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Ссылка = НайтиСсылкуСегментаПоUUID(ЭтоСотрудники, UuidСтр);
    Если СсылкаСегментаСуществует(Ссылка) Тогда
        Возврат Ссылка;
    КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция ОбъектыСегмента(СегментСсылка)
    // Только то, что лежит в СоставСегментов — без разворота групп справочника
    // (иначе в FitGO попадает вся иерархия «Администраторы», а не состав сегмента приложения).
    Результат = Новый Массив;
    Если НЕ ЗначениеЗаполнено(СегментСсылка) Тогда
        Возврат Результат;
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    СоставСегментов.ОбъектСегмента КАК Объект
    |ИЗ
    |    РегистрСведений.СоставСегментов КАК СоставСегментов
    |ГДЕ
    |    СоставСегментов.Сегмент = &Сегмент";
    Запрос.УстановитьПараметр("Сегмент", СегментСсылка);
    УжеЕсть = Новый Соответствие;
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Объект = Выборка.Объект;
            Если НЕ ЗначениеЗаполнено(Объект) Тогда
                Продолжить;
            КонецЕсли;
            // Группы справочника пропускаем — в сегменте для приложения должны быть сотрудники-элементы
            ЭтоГруппа = Ложь;
            Попытка
                ЭтоГруппа = Объект.ЭтоГруппа;
            Исключение
            КонецПопытки;
            Если ЭтоГруппа Тогда
                Продолжить;
            КонецЕсли;
            Пометка = Ложь;
            Попытка
                Пометка = Объект.ПометкаУдаления;
            Исключение
            КонецПопытки;
            Если Пометка Тогда
                Продолжить;
            КонецЕсли;
            КлючЛиста = "";
            Попытка
                КлючЛиста = Строка(Объект.УникальныйИдентификатор());
            Исключение
            КонецПопытки;
            Если ЗначениеЗаполнено(КлючЛиста) Тогда
                Если УжеЕсть.Получить(КлючЛиста) <> Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                УжеЕсть.Вставить(КлючЛиста, Истина);
            КонецЕсли;
            Результат.Добавить(Объект);
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат Результат;
КонецФункции

Функция КоличествоЧленовСегмента(СегментСсылка)
    Возврат ОбъектыСегмента(СегментСсылка).Количество();
КонецФункции

#КонецОбласти

#Область ClassSessionsAndClubVisits

// Документы Занятие за период. Ответ: { data[], page, pageSize, total }
Функция ЗанятияПериодаJSON(ДатаСтрС, ДатаСтрПо, Страница, РазмерСтраницы) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("data", Новый Массив);
    Результат.Вставить("page", Страница);
    Результат.Вставить("pageSize", РазмерСтраницы);
    Результат.Вставить("total", 0);

    ДатаС = ДатаНачалаВизитов(ДатаСтрС);
    ДатаПо = ДатаОкончанияВизитов(ДатаСтрПо);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Занятие.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.Занятие КАК Занятие
    |ГДЕ
    |    НЕ Занятие.ПометкаУдаления
    |    И Занятие.ДатаВремяНачала >= &ДатаНачала
    |    И Занятие.ДатаВремяНачала <= &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |    Занятие.ДатаВремяНачала";
    Запрос.УстановитьПараметр("ДатаНачала", ДатаС);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаПо);

    Ссылки = Новый Массив;
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Ссылки.Добавить(Выборка.Ссылка);
        КонецЦикла;
    Исключение
        // Запас: фильтр по Дата документа
        Запрос.Текст =
        "ВЫБРАТЬ
        |    Занятие.Ссылка КАК Ссылка
        |ИЗ
        |    Документ.Занятие КАК Занятие
        |ГДЕ
        |    НЕ Занятие.ПометкаУдаления
        |    И Занятие.Дата >= &ДатаНачала
        |    И Занятие.Дата <= &ДатаОкончания
        |УПОРЯДОЧИТЬ ПО
        |    Занятие.Дата";
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Ссылки.Добавить(Выборка.Ссылка);
            КонецЦикла;
        Исключение
            Возврат Результат;
        КонецПопытки;
    КонецПопытки;

    Всего = Ссылки.Количество();
    Результат.total = Всего;
    Если Всего = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Нач = (Страница - 1) * РазмерСтраницы;
    Если Нач >= Всего Тогда
        Возврат Результат;
    КонецЕсли;
    Кон = Мин(Нач + РазмерСтраницы - 1, Всего - 1);

    Для Инд = Нач По Кон Цикл
        Эл = ДокументЗанятияВJSON(Ссылки[Инд]);
        Если Эл <> Неопределено Тогда
            Результат.data.Добавить(Эл);
        КонецЕсли;
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция ДокументЗанятияВJSON(ДокСсылка)
    Попытка
        Об = ДокСсылка.ПолучитьОбъект();
    Исключение
        Возврат Неопределено;
    КонецПопытки;
    Если Об = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Ид = "";
    Попытка
        Ид = Строка(Об.ИдентификаторЗанятия);
        Если Ид = "00000000-0000-0000-0000-000000000000" Или ПустаяСтрока(Ид) Тогда
            Ид = "";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(Ид) Тогда
        Попытка
            Ид = FitGOIntegrationОбщегоНазначения.UUIDСсылка(ДокСсылка);
        Исключение
            Ид = Строка(ДокСсылка.УникальныйИдентификатор());
        КонецПопытки;
    КонецЕсли;

    Номер = "";
    Попытка
        Номер = СокрЛП(Строка(Об.Номер));
    Исключение
    КонецПопытки;

    Услуга = "";
    Попытка
        Услуга = СокрЛП(Строка(Об.Номенклатура));
    Исключение
    КонецПопытки;

    СтатусСырой = "";
    Попытка
        СтатусСырой = СокрЛП(Строка(Об.СтатусЗанятия));
    Исключение
    КонецПопытки;
    Статус = НормализоватьСтатусЗанятия(СтатусСырой);

    НачалоСтр = "";
    ОкончаниеСтр = "";
    Попытка
        НачалоСтр = FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Об.ДатаВремяНачала);
    Исключение
        Попытка
            НачалоСтр = FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Об.Дата);
        Исключение
        КонецПопытки;
    КонецПопытки;
    Попытка
        ОкончаниеСтр = FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Об.ДатаВремяОкончания);
    Исключение
    КонецПопытки;

    ДлительностьМин = 0;
    Попытка
        Если ЗначениеЗаполнено(Об.ДатаВремяНачала) И ЗначениеЗаполнено(Об.ДатаВремяОкончания) Тогда
            ДлительностьМин = Цел((Об.ДатаВремяОкончания - Об.ДатаВремяНачала) / 60);
        КонецЕсли;
    Исключение
    КонецПопытки;

    СотрИд = "";
    СотрИмя = "";
    Попытка
        Если ЗначениеЗаполнено(Об.Сотрудник) Тогда
            СотрИмя = СокрЛП(Строка(Об.Сотрудник));
            Попытка
                СотрИд = Строка(Об.Сотрудник.УникальныйИдентификатор());
            Исключение
            КонецПопытки;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Зал = "";
    Попытка
        Если ЗначениеЗаполнено(Об.Помещение) Тогда
            Зал = СокрЛП(Строка(Об.Помещение));
        КонецЕсли;
    Исключение
    КонецПопытки;

    Записано = 0;
    ПосетилоШапка = 0;
    Попытка
        Записано = Число(Об.ВсегоКлиентовЗаписано);
    Исключение
    КонецПопытки;
    Попытка
        ПосетилоШапка = Число(Об.ВсегоКлиентовПосетило);
    Исключение
    КонецПопытки;

    Вид = КлассифицироватьВидЗанятия(Об, Услуга);

    Состав = Новый Массив;
    Прибыло = 0;
    Попытка
        Для Каждого Стр Из Об.СоставЗанятия Цикл
            СтрокаJSON = СтрокаСоставаЗанятияВJSON(Стр);
            Если СтрокаJSON = Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Состав.Добавить(СтрокаJSON);
            Если СтрокаJSON.attendance = "ATTENDED" Тогда
                Прибыло = Прибыло + 1;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Если Записано = 0 Тогда
        Записано = Состав.Количество();
    КонецЕсли;

    // Forma UI «посетило» в шапке — эталон, если строки ТЧ не отдали ATTENDED.
    Если Прибыло = 0 И ПосетилоШапка > 0 Тогда
        Прибыло = ПосетилоШапка;
        // Когда шапка = числу не отменённых строк — пометить их как прибывших.
        НеОтм = 0;
        Для Каждого М Из Состав Цикл
            Если М.cancelled <> Истина И М.attendance <> "CANCELLED" Тогда
                НеОтм = НеОтм + 1;
            КонецЕсли;
        КонецЦикла;
        Если ПосетилоШапка >= НеОтм И НеОтм > 0 Тогда
            Для Каждого М Из Состав Цикл
                Если М.cancelled = Истина Или М.attendance = "CANCELLED" Тогда
                    Продолжить;
                КонецЕсли;
                Если М.attendance = "EXPECTED" Или М.attendance = "NO_SHOW" Тогда
                    М.attendance = "ATTENDED";
                КонецЕсли;
            КонецЦикла;
            Прибыло = 0;
            Для Каждого М Из Состав Цикл
                Если М.attendance = "ATTENDED" Тогда
                    Прибыло = Прибыло + 1;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
    КонецЕсли;

    FitGORef = "";
    Попытка
        FitGORef = FitGOBookingRefИзКомментария(Об.Комментарий);
    Исключение
    КонецПопытки;

    Эл = Новый Структура;
    Эл.Вставить("id", Ид);
    Эл.Вставить("number", Номер);
    Эл.Вставить("kind", Вид);
    Эл.Вставить("status", Статус);
    Эл.Вставить("title", Услуга);
    Эл.Вставить("startAt", НачалоСтр);
    Эл.Вставить("endAt", ОкончаниеСтр);
    Эл.Вставить("durationMin", ДлительностьМин);
    Эл.Вставить("employeeExternalId", СотрИд);
    Эл.Вставить("employeeName", СотрИмя);
    Эл.Вставить("roomTitle", Зал);
    Эл.Вставить("bookedCount", Записано);
    Эл.Вставить("headerAttendedCount", ПосетилоШапка);
    Эл.Вставить("attendedCount", Прибыло);
    Эл.Вставить("members", Состав);
    Если НЕ ПустаяСтрока(FitGORef) Тогда
        Эл.Вставить("fitgoBookingRef", FitGORef);
    КонецЕсли;
    Возврат Эл;
КонецФункции

// Из комментария «FitGO SPA bookingRef=<id>» — ключ для склейки с записью приложения.
Функция FitGOBookingRefИзКомментария(Коммент)
    Текст = СокрЛП(Строка(Коммент));
    Если ПустаяСтрока(Текст) Тогда
        Возврат "";
    КонецЕсли;
    Метка = "bookingRef=";
    Поз = СтрНайти(Текст, Метка);
    Если Поз = 0 Тогда
        Возврат "";
    КонецЕсли;
    Хвост = СокрЛП(Сред(Текст, Поз + СтрДлина(Метка)));
    Разделители = " |;,";
    Для Индекс = 1 По СтрДлина(Хвост) Цикл
        Сим = Сред(Хвост, Индекс, 1);
        Если СтрНайти(Разделители, Сим) > 0 Тогда
            Возврат СокрЛП(Лев(Хвост, Индекс - 1));
        КонецЕсли;
    КонецЦикла;
    Возврат Хвост;
КонецФункции

// Membership + ссылка на созданный документ 1С (для crmDocRef в FitGO).
Функция АктивныйАбонементJSONСДокСсылкой(Контрагент, РезДок)
    ЧленствоJSON = АктивныйАбонементJSON(Контрагент);
    Если ЧленствоJSON = Неопределено Тогда
        ЧленствоJSON = Новый Структура;
        ЧленствоJSON.Вставить("id", "");
        ЧленствоJSON.Вставить("name", "");
        ЧленствоJSON.Вставить("status", "ACTIVE");
        ЧленствоJSON.Вставить("validFrom", "");
        ЧленствоJSON.Вставить("validUntil", "");
    КонецЕсли;
    Попытка
        Если РезДок.Свойство("docId") И НЕ ПустаяСтрока(Строка(РезДок.docId)) Тогда
            ЧленствоJSON.Вставить("docId", СокрЛП(Строка(РезДок.docId)));
        КонецЕсли;
        Если РезДок.Свойство("docNumber") И НЕ ПустаяСтрока(Строка(РезДок.docNumber)) Тогда
            ЧленствоJSON.Вставить("docNumber", СокрЛП(Строка(РезДок.docNumber)));
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат ЧленствоJSON;
КонецФункции

Функция СтрокаСоставаЗанятияВJSON(Стр)
    Контрагент = Неопределено;
    Попытка
        Контрагент = Стр.Контрагент;
    Исключение
        Попытка
            Контрагент = Стр.Клиент;
        Исключение
        КонецПопытки;
    КонецПопытки;
    Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ExternalId = "";
    Попытка
        ExternalId = Строка(Контрагент.УникальныйИдентификатор());
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(ExternalId) Тогда
        Возврат Неопределено;
    КонецЕсли;

    ИмяКлиента = СокрЛП(Строка(Контрагент));
    Явка = "EXPECTED";
    Отменена = Ложь;

    Стат = ПрочитатьСтатусПрибытияСтроки(Стр);
    Если НЕ ПустаяСтрока(Стат) Тогда
        Явка = НормализоватьЯвкуСостава(Стат);
    КонецЕсли;

    Попытка
        Если Стр.Отменена = Истина Тогда
            Отменена = Истина;
            Явка = "CANCELLED";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Попытка
        Если Стр.СтрокаОтменена = Истина Тогда
            Отменена = Истина;
            Явка = "CANCELLED";
        КонецЕсли;
    Исключение
    КонецПопытки;
    // Forma «Показать отменённые»: удалённая крестиком запись остаётся в ТЧ с признаком отмены.
    Для Каждого ИмяФлага Из СтрРазделить("ЗаписьОтменена,Отменен,Отменено,ОтменаЗаписи,Отказ", ",") Цикл
        Попытка
            Если Стр[ИмяФлага] = Истина Тогда
                Отменена = Истина;
                Явка = "CANCELLED";
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
    Для Каждого ИмяПоля Из СтрРазделить("ДатаОтмены,ПричинаОтмены,ДатаОтменыЗаписи", ",") Цикл
        Попытка
            Если ЗначениеЗаполнено(Стр[ИмяПоля]) Тогда
                Отменена = Истина;
                Явка = "CANCELLED";
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Основание = "";
    Попытка
        Если ЗначениеЗаполнено(Стр.ОснованиеОплаты) Тогда
            Основание = СокрЛП(Строка(Стр.ОснованиеОплаты));
        КонецЕсли;
    Исключение
    КонецПопытки;

    Кол = 1;
    Попытка
        Кол = Число(Стр.Количество);
        Если Кол <= 0 Тогда
            Кол = 1;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Эл = Новый Структура;
    Эл.Вставить("externalId", ExternalId);
    Эл.Вставить("clientName", ИмяКлиента);
    Эл.Вставить("attendance", Явка);
    Эл.Вставить("cancelled", Отменена);
    Эл.Вставить("paymentBasis", Основание);
    Эл.Вставить("quantity", Кол);

    ИсточникОплаты = "UNKNOWN";
    ЦенаЕд = 0;
    СуммаПакета = 0;
    КолПакета = 0;
    Если НЕ ПустаяСтрока(Основание) Тогда
        ИсточникОплаты = "PACKAGE";
        Попытка
            Если ЗначениеЗаполнено(Стр.ОснованиеОплаты) Тогда
                Осн = Стр.ОснованиеОплаты;
                Попытка
                    КолПакета = Число(Осн.КоличествоУслуг);
                Исключение
                КонецПопытки;
                Если КолПакета <= 0 Тогда
                    Попытка
                        КолПакета = Число(Осн.КоличествоЗанятий);
                    Исключение
                    КонецПопытки;
                КонецЕсли;
                Если КолПакета <= 0 Тогда
                    Попытка
                        КолПакета = Число(Осн.Количество);
                    Исключение
                    КонецПопытки;
                КонецЕсли;
                Попытка
                    СуммаПакета = Число(Осн.Сумма);
                Исключение
                КонецПопытки;
                Если СуммаПакета <= 0 Тогда
                    Попытка
                        СуммаПакета = Число(Осн.СуммаДокумента);
                    Исключение
                    КонецПопытки;
                КонецЕсли;
                Если СуммаПакета <= 0 Тогда
                    Попытка
                        СуммаПакета = Число(Осн.Цена);
                    Исключение
                    КонецПопытки;
                КонецЕсли;
                Если СуммаПакета > 0 И КолПакета > 0 Тогда
                    ЦенаЕд = СуммаПакета / КолПакета;
                КонецЕсли;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;
    Эл.Вставить("paySource", ИсточникОплаты);
    Эл.Вставить("unitAmount", ЦенаЕд);
    Эл.Вставить("packageAmount", СуммаПакета);
    Эл.Вставить("packageQty", КолПакета);
    Возврат Эл;
КонецФункции

// Статус «Прибыл» в Forma может быть перечислением, булевым или другим реквизитом ТЧ.
Функция ПрочитатьСтатусПрибытияСтроки(Стр)
    Кандидаты = Новый Массив;
    Попытка
        Кандидаты.Добавить(Стр.СтатусПрибытия);
    Исключение
    КонецПопытки;
    Попытка
        Кандидаты.Добавить(Стр.СостояниеПрибытия);
    Исключение
    КонецПопытки;
    Попытка
        Кандидаты.Добавить(Стр.Статус);
    Исключение
    КонецПопытки;

    Для Каждого Зн Из Кандидаты Цикл
        Если НЕ ЗначениеЗаполнено(Зн) Тогда
            Продолжить;
        КонецЕсли;
        Текст = СокрЛП(Строка(Зн));
        Если НЕ ПустаяСтрока(Текст) Тогда
            Возврат Текст;
        КонецЕсли;
        // Имя значения перечисления (если Строка дала пусто / код)
        Попытка
            ИмяПе = XMLСтрока(Зн);
            Если НЕ ПустаяСтрока(ИмяПе) Тогда
                Возврат ИмяПе;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;

    Попытка
        Если Стр.Прибыл = Истина Тогда
            Возврат "Прибыл";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Попытка
        Если Стр.КлиентПрибыл = Истина Тогда
            Возврат "Прибыл";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Попытка
        Если Стр.Посетил = Истина Тогда
            Возврат "Прибыл";
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат "";
КонецФункции

Функция НормализоватьСтатусЗанятия(СтатусСырой)
    С = ВРег(СокрЛП(СтатусСырой));
    Если ПустаяСтрока(С) Тогда
        Возврат "SCHEDULED";
    КонецЕсли;
    Если СтрНайти(С, "ОТМЕН") > 0 Тогда
        Возврат "CANCELLED";
    КонецЕсли;
    Если СтрНайти(С, "ВЫПОЛН") > 0 Или СтрНайти(С, "ПРОВЕД") > 0 Или СтрНайти(С, "ЗАВЕРШ") > 0 Тогда
        Возврат "COMPLETED";
    КонецЕсли;
    Если СтрНайти(С, "ПРОВОД") > 0 Тогда
        Возврат "IN_PROGRESS";
    КонецЕсли;
    Возврат "SCHEDULED";
КонецФункции

Функция НормализоватьЯвкуСостава(СтатусСырой)
    С = ВРег(СокрЛП(СтатусСырой));
    Если ПустаяСтрока(С) Тогда
        Возврат "EXPECTED";
    КонецЕсли;
    Если СтрНайти(С, "ОТМЕН") > 0 Тогда
        Возврат "CANCELLED";
    КонецЕсли;
    Если СтрНайти(С, "НЕ ПРИБ") > 0 Или СтрНайти(С, "НЕПРИБ") > 0
        Или СтрНайти(С, "НЕ ПОСЕТ") > 0 Или СтрНайти(С, "НЕПОСЕТ") > 0
        Или СтрНайти(С, "NOSHOW") > 0 Или СтрНайти(С, "NO_SHOW") > 0 Тогда
        Возврат "NO_SHOW";
    КонецЕсли;
    Если СтрНайти(С, "ПРИБ") > 0 Или СтрНайти(С, "ПОСЕТ") > 0 Или СтрНайти(С, "ПРИШ") > 0
        Или СтрНайти(С, "ATTEND") > 0 Или СтрНайти(С, "ARRIV") > 0
        Или С = "ДА" Или С = "TRUE" Или С = "1" Тогда
        Возврат "ATTENDED";
    КонецЕсли;
    Возврат "EXPECTED";
КонецФункции

Функция КлассифицироватьВидЗанятия(Об, Услуга)
    Заг = НРег(СокрЛП(Услуга));
    // Солярий — отдельно от SPA/ПТ (в Forma иногда тип «персональное»).
    Если СтрНайти(Заг, "соляр") > 0 Тогда
        Возврат "SOLARIUM";
    КонецЕсли;

    Попытка
        ТипЗ = ВРег(СокрЛП(Строка(Об.ТипЗанятия)));
        Если СтрНайти(ТипЗ, "САЛОН") > 0 Или СтрНайти(ТипЗ, "КРАСОТ") > 0 Или СтрНайти(ТипЗ, "SPA") > 0 Тогда
            Возврат "SPA";
        КонецЕсли;
        Если СтрНайти(ТипЗ, "ПЕРСОНАЛ") > 0 Или СтрНайти(ТипЗ, "ИНДИВИД") > 0 Тогда
            Возврат "PT";
        КонецЕсли;
        Если СтрНайти(ТипЗ, "ГРУПП") > 0 Тогда
            Возврат "GROUP";
        КонецЕсли;
    Исключение
    КонецПопытки;

    Если СтрНайти(Заг, "массаж") > 0 Или СтрНайти(Заг, "состав тела") > 0
        Или СтрНайти(Заг, "inbody") > 0 Или СтрНайти(Заг, "спа") > 0 Тогда
        Возврат "SPA";
    КонецЕсли;
    Если СтрНайти(Заг, "персонал") > 0 Или СтрНайти(Заг, "индивидуал") > 0
        Или СтрНайти(Заг, "тренер") > 0 Тогда
        Возврат "PT";
    КонецЕсли;
    Возврат "GROUP";
КонецФункции

// Клубные визиты Документ.Посещение за период. Ответ: { data[], page, pageSize, total }
Функция ВизитыКлубаJSON(ДатаСтрС, ДатаСтрПо, Страница, РазмерСтраницы) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("data", Новый Массив);
    Результат.Вставить("page", Страница);
    Результат.Вставить("pageSize", РазмерСтраницы);
    Результат.Вставить("total", 0);

    ДатаС = ДатаНачалаВизитов(ДатаСтрС);
    ДатаПо = ДатаОкончанияВизитов(ДатаСтрПо);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Посещение.Ссылка КАК Регистратор,
    |    Посещение.Контрагент КАК Контрагент,
    |    Посещение.ДатаПрихода КАК Период,
    |    Посещение.ДатаУхода КАК ДатаВыхода,
    |    Посещение.Основание КАК Занятие
    |ИЗ
    |    Документ.Посещение КАК Посещение
    |ГДЕ
    |    НЕ Посещение.ПометкаУдаления
    |    И Посещение.ДатаПрихода >= &ДатаНачала
    |    И Посещение.ДатаПрихода <= &ДатаОкончания
    |УПОРЯДОЧИТЬ ПО
    |    Посещение.ДатаПрихода";
    Запрос.УстановитьПараметр("ДатаНачала", ДатаС);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаПо);

    ВсеСтроки = Новый Массив;
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Пропуск = Ложь;
            Попытка
                Если Выборка.Регистратор.ПризнакОтменен = Истина Тогда
                    Пропуск = Истина;
                КонецЕсли;
            Исключение
            КонецПопытки;
            Если Пропуск Тогда
                Продолжить;
            КонецЕсли;
            Стр = Новый Структура;
            Стр.Вставить("Регистратор", Выборка.Регистратор);
            Стр.Вставить("Контрагент", Выборка.Контрагент);
            Стр.Вставить("Период", Выборка.Период);
            Стр.Вставить("ДатаВыхода", Выборка.ДатаВыхода);
            Стр.Вставить("Занятие", Выборка.Занятие);
            ВсеСтроки.Добавить(Стр);
        КонецЦикла;
    Исключение
        Возврат Результат;
    КонецПопытки;

    Всего = ВсеСтроки.Количество();
    Результат.total = Всего;
    Если Всего = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Нач = (Страница - 1) * РазмерСтраницы;
    Если Нач >= Всего Тогда
        Возврат Результат;
    КонецЕсли;
    Кон = Мин(Нач + РазмерСтраницы - 1, Всего - 1);

    Для Инд = Нач По Кон Цикл
        Выборка = ВсеСтроки[Инд];
        Элемент = Новый Структура;
        Элемент.Вставить("id", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Регистратор));
        Элемент.Вставить("date", FitGOIntegrationОбщегоНазначения.ISOДата(Выборка.Период));
        Элемент.Вставить("checkIn", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.Период));
        Если ЗначениеЗаполнено(Выборка.ДатаВыхода) Тогда
            Элемент.Вставить("checkOut", FitGOIntegrationОбщегоНазначения.ISOДатаВремя(Выборка.ДатаВыхода));
        КонецЕсли;
        Элемент.Вставить("clubName", FitGOIntegrationНастройки.ИмяКлуба());
        ExtId = "";
        Попытка
            Если ЗначениеЗаполнено(Выборка.Контрагент) Тогда
                ExtId = Строка(Выборка.Контрагент.УникальныйИдентификатор());
            КонецЕсли;
        Исключение
        КонецПопытки;
        Элемент.Вставить("externalId", ExtId);
        Если ЗначениеЗаполнено(Выборка.Занятие) Тогда
            Элемент.Вставить("title", Строка(Выборка.Занятие));
        КонецЕсли;
        ВидИТип = КлассифицироватьОснованиеПосещения(Выборка.Занятие);
        Элемент.Вставить("kind", ВидИТип.kind);
        Элемент.Вставить("basisType", ВидИТип.basisType);
        Результат.data.Добавить(Элемент);
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Установка явки клиента в Документ.Занятие (как «Прибыл» / «Не прибыл» в форме занятия).
// AppointmentId — UUID документа / ИдентификаторЗанятия; ClientExternalId — UUID контрагента;
// Attendance — ATTENDED | NO_SHOW.
Функция УстановитьЯвкуСоставаЗанятияJSON(AppointmentId, ClientExternalId, Attendance) Экспорт

    Ответ = Новый Структура;
    Ответ.Вставить("ok", Ложь);
    Ответ.Вставить("error", "");
    Ответ.Вставить("appointmentId", СокрЛП(Строка(AppointmentId)));
    Ответ.Вставить("clientExternalId", СокрЛП(Строка(ClientExternalId)));
    Ответ.Вставить("attendance", "");
    Ответ.Вставить("field", "");
    Ответ.Вставить("visitedHeader", 0);

    ИдЗанятия = СокрЛП(Строка(AppointmentId));
    ИдКлиента = СокрЛП(Строка(ClientExternalId));
    Явка = ВРег(СокрЛП(Строка(Attendance)));

    Если ПустаяСтрока(ИдЗанятия) Тогда
        Ответ.error = "appointmentId required";
        Возврат Ответ;
    КонецЕсли;
    Если ПустаяСтрока(ИдКлиента) Тогда
        Ответ.error = "clientExternalId required";
        Возврат Ответ;
    КонецЕсли;
    Если Явка <> "ATTENDED" И Явка <> "NO_SHOW" Тогда
        Ответ.error = "attendance must be ATTENDED or NO_SHOW";
        Возврат Ответ;
    КонецЕсли;

    СсылкаЗанятия = НайтиЗанятиеПоИдентификатору(ИдЗанятия);
    Если НЕ ЗначениеЗаполнено(СсылкаЗанятия) Тогда
        Ответ.error = "Class session not found";
        Возврат Ответ;
    КонецЕсли;

    Контрагент = НайтиКонтрагентаПоВнешнемуИд(ИдКлиента);
    Если Контрагент = Неопределено Тогда
        Ответ.error = "Client not found";
        Возврат Ответ;
    КонецЕсли;

    Попытка
        Док = СсылкаЗанятия.ПолучитьОбъект();
    Исключение
        Ответ.error = FitGOКраткоОшибку(ИнформацияОбОшибке());
        Возврат Ответ;
    КонецПопытки;

    СтрокаТЧ = НайтиСтрокуСоставаПоКонтрагенту(Док, Контрагент, ИдКлиента);
    Если СтрокаТЧ = Неопределено Тогда
        Ответ.error = "Client not in session roster";
        Возврат Ответ;
    КонецЕсли;

    // Образец «Прибыл» с соседней строки + имя реквизита (форма рисует именно его).
    Образец = Неопределено;
    ИмяРеквОбразца = "";
    НайтиОбразецЯвкиПрибыл(Док, Образец, ИмяРеквОбразца);

    РезУст = УстановитьСтатусПрибытияСтрокиСостава(СтрокаТЧ, Док, Явка, Образец, ИмяРеквОбразца);
    Если НЕ РезУст.ok Тогда
        Ответ.error = РезУст.error;
        Возврат Ответ;
    КонецЕсли;
    Ответ.field = РезУст.field;

    ПрименитьДатуПрибытияСтроки(СтрокаТЧ, Явка);
    ОбновитьСчетчикПосетилоШапки(Док);

    БылоПроведен = Ложь;
    Попытка
        БылоПроведен = Док.Проведен;
    Исключение
    КонецПопытки;

    // Одно сохранение: Проведение на проведённом доке = перепроведение с текущими данными ТЧ.
    Попытка
        Если БылоПроведен Тогда
            Док.Записать(РежимЗаписиДокумента.Проведение);
        Иначе
            Док.Записать(РежимЗаписиДокумента.Запись);
        КонецЕсли;
    Исключение
        // Fallback: отмена → правка → проведение
        Попытка
            Док = СсылкаЗанятия.ПолучитьОбъект();
            СтрокаТЧ = НайтиСтрокуСоставаПоКонтрагенту(Док, Контрагент, ИдКлиента);
            Если СтрокаТЧ = Неопределено Тогда
                Ответ.error = "Client not in session roster on retry";
                Возврат Ответ;
            КонецЕсли;
            НайтиОбразецЯвкиПрибыл(Док, Образец, ИмяРеквОбразца);
            РезУст = УстановитьСтатусПрибытияСтрокиСостава(СтрокаТЧ, Док, Явка, Образец, ИмяРеквОбразца);
            Если НЕ РезУст.ok Тогда
                Ответ.error = РезУст.error;
                Возврат Ответ;
            КонецЕсли;
            Ответ.field = РезУст.field;
            ПрименитьДатуПрибытияСтроки(СтрокаТЧ, Явка);
            ОбновитьСчетчикПосетилоШапки(Док);
            Если Док.Проведен Тогда
                Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
                Док = СсылкаЗанятия.ПолучитьОбъект();
                СтрокаТЧ = НайтиСтрокуСоставаПоКонтрагенту(Док, Контрагент, ИдКлиента);
                РезУст = УстановитьСтатусПрибытияСтрокиСостава(СтрокаТЧ, Док, Явка, Образец, ИмяРеквОбразца);
                ПрименитьДатуПрибытияСтроки(СтрокаТЧ, Явка);
                ОбновитьСчетчикПосетилоШапки(Док);
                Док.Записать(РежимЗаписиДокумента.Проведение);
            Иначе
                Док.Записать(РежимЗаписиДокумента.Запись);
            КонецЕсли;
        Исключение
            Ответ.error = "Write failed: " + FitGOКраткоОшибку(ИнформацияОбОшибке());
            Возврат Ответ;
        КонецПопытки;
    КонецПопытки;

    // Верификация: сначала объект после Записать, потом перечитывание.
    // Если строка «пропала» при ПолучитьОбъект — не откатываем успех (часто уже записано в БД).
    Попытка
        СтрПров = НайтиСтрокуСоставаПоКонтрагенту(Док, Контрагент, ИдКлиента);
        ДокПров = Док;
        Если СтрПров = Неопределено Тогда
            ДокПров = СсылкаЗанятия.ПолучитьОбъект();
            СтрПров = НайтиСтрокуСоставаПоКонтрагенту(ДокПров, Контрагент, ИдКлиента);
        КонецЕсли;
        Если СтрПров = Неопределено Тогда
            // Запись уже ушла в БД; строгая проверка строки не обязательна.
            Ответ.ok = Истина;
            Ответ.attendance = Явка;
            Ответ.Вставить("warning", "verify row not found after write — reopen 1C form");
            Попытка
                Ответ.visitedHeader = Число(ДокПров.ВсегоКлиентовПосетило);
            Исключение
            КонецПопытки;
            Возврат Ответ;
        КонецЕсли;
        Факт = НормализоватьЯвкуСостава(ПрочитатьСтатусПрибытияСтроки(СтрПров));
        Если Явка = "ATTENDED" Тогда
            Попытка
                Если НЕ ЗначениеЗаполнено(СтрПров.СтатусПрибытия)
                    И Ответ.field <> "СтатусПрибытия"
                    И Ответ.field <> "СостояниеПрибытия" Тогда
                    // Не фейлим жёстко — форма могла читать другой реквизит; отдаём ok + warning
                    Ответ.Вставить("warning", "СтатусПрибытия empty after write; field=" + Ответ.field);
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЕсли;
        Если Явка = "ATTENDED" И Факт <> "ATTENDED" Тогда
            Ответ.error = "Wrote but status still not ATTENDED in 1C (got " + Факт
                + "). Close open document form and retry; field=" + Ответ.field;
            Возврат Ответ;
        КонецЕсли;
        Если Явка = "NO_SHOW" И Факт = "ATTENDED" Тогда
            Ответ.error = "Wrote but status still ATTENDED in 1C; field=" + Ответ.field;
            Возврат Ответ;
        КонецЕсли;
        Попытка
            Ответ.visitedHeader = Число(ДокПров.ВсегоКлиентовПосетило);
        Исключение
        КонецПопытки;
    Исключение
        // Запись уже выполнена — не маскируем успех ошибкой verify.
        Ответ.ok = Истина;
        Ответ.attendance = Явка;
        Ответ.Вставить("warning", "Verify failed: " + FitGOКраткоОшибку(ИнформацияОбОшибке()));
        Возврат Ответ;
    КонецПопытки;

    Ответ.ok = Истина;
    Ответ.attendance = Явка;
    Возврат Ответ;
КонецФункции

Функция НормУидДляСравнения(Знач СтрУид)
    С = ВРег(СокрЛП(Строка(СтрУид)));
    С = СтрЗаменить(С, "{", "");
    С = СтрЗаменить(С, "}", "");
    С = СтрЗаменить(С, "-", "");
    С = СтрЗаменить(С, " ", "");
    Возврат С;
КонецФункции

// Активная строка клиента важнее отменённой (после «крестика» в Forma строка остаётся с признаком отмены).
Функция НайтиСтрокуСоставаПоКонтрагенту(Док, Контрагент, ИдКлиента)
    ИдНорм = НормУидДляСравнения(ИдКлиента);
    ОтменённаяСтрока = Неопределено;
    Попытка
        Для Каждого Стр Из Док.СоставЗанятия Цикл
            К = Неопределено;
            Попытка
                К = Стр.Контрагент;
            Исключение
                Попытка
                    К = Стр.Клиент;
                Исключение
                КонецПопытки;
            КонецПопытки;
            Если НЕ ЗначениеЗаполнено(К) Тогда
                Продолжить;
            КонецЕсли;
            Совпал = ЗначениеЗаполнено(Контрагент) И К = Контрагент;
            Если НЕ Совпал Тогда
                Попытка
                    Совпал = НормУидДляСравнения(К.УникальныйИдентификатор()) = ИдНорм;
                Исключение
                КонецПопытки;
            КонецЕсли;
            Если НЕ Совпал Тогда
                Продолжить;
            КонецЕсли;
            СтрJSON = СтрокаСоставаЗанятияВJSON(Стр);
            Если СтрJSON <> Неопределено И СтрJSON.cancelled = Истина Тогда
                Если ОтменённаяСтрока = Неопределено Тогда
                    ОтменённаяСтрока = Стр;
                КонецЕсли;
                Продолжить;
            КонецЕсли;
            Возврат Стр;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Возврат ОтменённаяСтрока;
КонецФункции

Процедура ПрименитьДатуПрибытияСтроки(СтрокаТЧ, Явка)
    Если Явка = "ATTENDED" Тогда
        Попытка
            СтрокаТЧ.ДатаПрибытия = ТекущаяДатаСеанса();
        Исключение
        КонецПопытки;
    Иначе
        Попытка
            СтрокаТЧ.ДатаПрибытия = Дата(1, 1, 1);
        Исключение
        КонецПопытки;
    КонецЕсли;
КонецПроцедуры

Процедура ОбновитьСчетчикПосетилоШапки(Док)
    Прибыло = 0;
    Попытка
        Для Каждого Стр Из Док.СоставЗанятия Цикл
            Я = НормализоватьЯвкуСостава(ПрочитатьСтатусПрибытияСтроки(Стр));
            Если Я = "ATTENDED" Тогда
                Прибыло = Прибыло + 1;
            КонецЕсли;
        КонецЦикла;
    Исключение
        Возврат;
    КонецПопытки;
    Попытка
        Док.ВсегоКлиентовПосетило = Прибыло;
    Исключение
    КонецПопытки;
    Попытка
        Док.ВсегоКлиентовПосетилоПоДаннымТренера = Прибыло;
    Исключение
    КонецПопытки;
КонецПроцедуры

Процедура НайтиОбразецЯвкиПрибыл(Док, Образец, ИмяРеквОбразца)
    Образец = Неопределено;
    ИмяРеквОбразца = "";
    Приоритет = Новый Массив;
    Приоритет.Добавить("СтатусПрибытия");
    Приоритет.Добавить("СостояниеПрибытия");
    Для Каждого ИмяРекв Из ИменаРеквизитовЯвкиСостава() Цикл
        Если Приоритет.Найти(ИмяРекв) = Неопределено Тогда
            Приоритет.Добавить(ИмяРекв);
        КонецЕсли;
    КонецЦикла;
    Попытка
        Для Каждого СтрОбр Из Док.СоставЗанятия Цикл
            Для Каждого ИмяРекв Из Приоритет Цикл
                Попытка
                    Зн = СтрОбр[ИмяРекв];
                Исключение
                    Продолжить;
                КонецПопытки;
                Если НЕ ЗначениеЗаполнено(Зн) Тогда
                    Продолжить;
                КонецЕсли;
                ТекстЗн = "";
                Попытка
                    ТекстЗн = Строка(Зн);
                Исключение
                КонецПопытки;
                ЭтоПриб = (КлассЯвкиПоТексту(ТекстЗн) = "ATTENDED");
                Если НЕ ЭтоПриб Тогда
                    Попытка
                        ЭтоПриб = (КлассЯвкиПоТексту(XMLСтрока(Зн)) = "ATTENDED");
                    Исключение
                        ЭтоПриб = Ложь;
                    КонецПопытки;
                КонецЕсли;
                Если НЕ ЭтоПриб Тогда
                    Продолжить;
                КонецЕсли;
                Образец = Зн;
                ИмяРеквОбразца = ИмяРекв;
                Возврат;
            КонецЦикла;
        КонецЦикла;
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция КлассЯвкиПоТексту(Текст)
    С = ВРег(СокрЛП(Строка(Текст)));
    С = СтрЗаменить(С, "_", "");
    С = СтрЗаменить(С, " ", "");
    С = СтрЗаменить(С, "-", "");
    Если ПустаяСтрока(С) Тогда
        Возврат "OTHER";
    КонецЕсли;
    // ФИО «Прибыльский» содержит «Прибыл» — не считать явкой.
    Если СтрНайти(С, "ПРИБЫЛЬ") > 0 Тогда
        Возврат "OTHER";
    КонецЕсли;
    Если СтрНайти(С, "НЕПРИБ") > 0 Или СтрНайти(С, "НЕПОСЕТ") > 0
        Или СтрНайти(С, "НЕПРИШ") > 0 Или СтрНайти(С, "NOSHOW") > 0
        Или СтрНайти(С, "ОТСУТСТВ") > 0 Или СтрНайти(С, "НЕЯВИЛ") > 0 Тогда
        Возврат "NO_SHOW";
    КонецЕсли;
    Если СтрНайти(С, "ПРИБЫЛ") > 0 Или СтрНайти(С, "ПОСЕТ") > 0
        Или СтрНайти(С, "ПРИШ") > 0 Или СтрНайти(С, "ЯВИЛ") > 0
        Или СтрНайти(С, "ATTEND") > 0 Или СтрНайти(С, "ARRIV") > 0
        Или СтрНайти(С, "ПРИСУТСТВ") > 0 Тогда
        Возврат "ATTENDED";
    КонецЕсли;
    Возврат "OTHER";
КонецФункции

Функция ИменаРеквизитовЯвкиСостава()
    // Только поля явки — не «Статус»/«Состояние» (слишком общие).
    Имена = Новый Массив;
    Имена.Добавить("СтатусПрибытия");
    Имена.Добавить("СостояниеПрибытия");
    Имена.Добавить("Явка");
    Возврат Имена;
КонецФункции

// Реквизиты ТЧ СоставЗанятия, в которых Forma хранит явку (тип: Булево или перечисление).
Функция ИменаПолейЯвкиДляЗаписи()
    Имена = Новый Массив;
    Имена.Добавить("СтатусПрибытия");
    Имена.Добавить("СостояниеПрибытия");
    Имена.Добавить("Явка");
    Имена.Добавить("Прибыл");
    Имена.Добавить("КлиентПрибыл");
    Имена.Добавить("Посетил");
    Имена.Добавить("Статус");
    Возврат Имена;
КонецФункции

// Явка строки так, как её читает выгрузка class-sessions (единый критерий для записи и проверки).
Функция ЯвкаСтрокиСоответствует(Стр, РежимЯвки)
    Факт = НормализоватьЯвкуСостава(ПрочитатьСтатусПрибытияСтроки(Стр));
    Если РежимЯвки = "ATTENDED" Тогда
        Возврат Факт = "ATTENDED";
    КонецЕсли;
    Возврат Факт <> "ATTENDED";
КонецФункции

// Пишет только реквизит явки; тип берётся из метаданных ТЧ. Возврат {ok, error, field}.
Функция УстановитьСтатусПрибытияСтрокиСостава(СтрокаТЧ, Док, РежимЯвки, Образец = Неопределено, ИмяРеквОбразца = "")
    Р = Новый Структура("ok,error,field", Ложь, "", "");
    Нужно = (РежимЯвки = "ATTENDED");
    Диаг = Новый Массив;

    МдТЧ = Неопределено;
    Попытка
        МдТЧ = Док.Метаданные().ТабличныеЧасти.СоставЗанятия;
    Исключение
        Р.error = "СоставЗанятия metadata not found";
        Возврат Р;
    КонецПопытки;

    Для Каждого ИмяРекв Из ИменаПолейЯвкиДляЗаписи() Цикл
        Рекв = МдТЧ.Реквизиты.Найти(ИмяРекв);
        Если Рекв = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Диаг.Добавить(ИмяРекв + "=" + Строка(Рекв.Тип));
        ЗначениеДо = СтрокаТЧ[ИмяРекв];

        // Булево: Истина = «Прибыл», Ложь = «Не прибыл».
        Если Рекв.Тип.СодержитТип(Тип("Булево")) Тогда
            СтрокаТЧ[ИмяРекв] = Нужно;
            Если ЯвкаСтрокиСоответствует(СтрокаТЧ, РежимЯвки) Тогда
                Р.ok = Истина;
                Р.field = ИмяРекв;
                Возврат Р;
            КонецЕсли;
            СтрокаТЧ[ИмяРекв] = ЗначениеДо;
            Продолжить;
        КонецЕсли;

        // Число (Forma: СтатусПрибытия): 1 = «Прибыл», 0 = «Не прибыл».
        Если Рекв.Тип.СодержитТип(Тип("Число")) Тогда
            СтрокаТЧ[ИмяРекв] = ?(Нужно, 1, 0);
            Если ЯвкаСтрокиСоответствует(СтрокаТЧ, РежимЯвки) Тогда
                Р.ok = Истина;
                Р.field = ИмяРекв;
                Возврат Р;
            КонецЕсли;
            СтрокаТЧ[ИмяРекв] = ЗначениеДо;
            Продолжить;
        КонецЕсли;

        // Перечисление: перебираем значения, оставляем то, которое читается как нужная явка.
        Для Каждого ТипРекв Из Рекв.Тип.Типы() Цикл
            МдПереч = Метаданные.НайтиПоТипу(ТипРекв);
            Если МдПереч = Неопределено Или НЕ Метаданные.Перечисления.Содержит(МдПереч) Тогда
                Продолжить;
            КонецЕсли;
            Для Каждого ЗнПереч Из МдПереч.ЗначенияПеречисления Цикл
                Класс = НормализоватьЯвкуСостава(ЗнПереч.Синоним);
                Если Класс = "EXPECTED" Тогда
                    Класс = НормализоватьЯвкуСостава(ЗнПереч.Имя);
                КонецЕсли;
                Если (Нужно И Класс <> "ATTENDED") Или (НЕ Нужно И Класс <> "NO_SHOW") Тогда
                    Продолжить;
                КонецЕсли;
                СтрокаТЧ[ИмяРекв] = Перечисления[МдПереч.Имя][ЗнПереч.Имя];
                Если ЯвкаСтрокиСоответствует(СтрокаТЧ, РежимЯвки) Тогда
                    Р.ok = Истина;
                    Р.field = ИмяРекв;
                    Возврат Р;
                КонецЕсли;
            КонецЦикла;
            // «Не прибыл» без отдельного значения = пустое значение перечисления.
            Если НЕ Нужно Тогда
                СтрокаТЧ[ИмяРекв] = Перечисления[МдПереч.Имя].ПустаяСсылка();
                Если ЯвкаСтрокиСоответствует(СтрокаТЧ, РежимЯвки) Тогда
                    Р.ok = Истина;
                    Р.field = ИмяРекв;
                    Возврат Р;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        СтрокаТЧ[ИмяРекв] = ЗначениеДо;
    КонецЦикла;

    Р.error = "Could not set attendance on roster row; fields: "
        + ?(Диаг.Количество() = 0, "none of СтатусПрибытия/Прибыл/Посетил in СоставЗанятия", СтрСоединить(Диаг, "; "));
    Возврат Р;
КонецФункции

// Абонементы с СрокДействия в [сегодня; сегодня+Дней].
// Разовые (срок ≤1 день или 1 ед. услуги) не отдаём.
// Для каждого клиента — текущий (ближайший срок) и nextMembership (уже купленный следующий / неактивированный).
Функция ИстекающиеАбонементыJSON(Дней = 14) Экспорт
    Если Дней = Неопределено ИЛИ Дней < 1 Тогда
        Дней = 14;
    КонецЕсли;
    Если Дней > 60 Тогда
        Дней = 60;
    КонецЕсли;

    Сегодня = НачалоДня(ТекущаяДатаСеанса());
    ДоДаты = Сегодня + Дней * 86400;
    Результат = Новый Массив;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Итоги.ЧленствоПакетУслуг КАК Членство,
    |    Итоги.ЧленствоПакетУслуг.Контрагент КАК Контрагент,
    |    Итоги.Статус КАК Статус,
    |    Итоги.ДатаАктивации КАК ДатаАктивации,
    |    Итоги.СрокДействия КАК СрокДействия,
    |    Итоги.КоличествоОстаток КАК КоличествоОстаток
    |ИЗ
    |    РегистрСведений.ЧленстваПакетыУслугИтоги КАК Итоги
    |ГДЕ
    |    Итоги.СрокДействия >= &Сегодня
    |    И Итоги.СрокДействия <= &До
    |    И НЕ Итоги.ЧленствоПакетУслуг.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |    Итоги.СрокДействия";
    Запрос.УстановитьПараметр("Сегодня", Сегодня);
    Запрос.УстановитьПараметр("До", ДоДаты);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Новый Структура("data", Результат);
    КонецПопытки;

    УжеДобавлены = Новый Соответствие;

    Пока Выборка.Следующий() Цикл
        Контрагент = Выборка.Контрагент;
        Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
            Продолжить;
        КонецЕсли;

        Статус = СтатусЧленстваJSON(СокрЛП(Строка(Выборка.Статус)));
        Если Статус <> "ACTIVE" И Статус <> "FROZEN" Тогда
            Продолжить;
        КонецЕсли;

        ExtId = "";
        Попытка
            ExtId = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Контрагент);
        Исключение
            ExtId = Строка(Контрагент);
        КонецПопытки;
        Если ПустаяСтрока(ExtId) Тогда
            Продолжить;
        КонецЕсли;
        Если УжеДобавлены.Получить(ExtId) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;

        Членство = Выборка.Членство;
        Мета = МетаЧленстваДляПродления(Членство, Выборка.ДатаАктивации, Выборка.СрокДействия);
        Если Мета.oneOff = Истина Тогда
            Продолжить;
        КонецЕсли;
        УжеДобавлены.Вставить(ExtId, Истина);

        DocId = "";
        Попытка
            DocId = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Членство);
        Исключение
            DocId = Строка(Членство);
        КонецПопытки;

        Наименование = "";
        Попытка
            Наименование = СокрЛП(Строка(Членство.Номенклатура));
        Исключение
        КонецПопытки;
        Если ПустаяСтрока(Наименование) Тогда
            Наименование = Строка(Членство);
        КонецЕсли;

        ДатаНачала = Выборка.ДатаАктивации;
        Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
            Попытка
                ДатаНачала = Членство.ДатаРучнойАктивации;
                Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
                    ДатаНачала = Членство.Дата;
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЕсли;

        Имя = "";
        Фамилия = "";
        Попытка
            Имя = СокрЛП(Строка(Контрагент.Имя));
            Фамилия = СокрЛП(Строка(Контрагент.Фамилия));
        Исключение
        КонецПопытки;

        Эл = Новый Структура;
        Эл.Вставить("externalId", ExtId);
        Эл.Вставить("firstName", Имя);
        Эл.Вставить("lastName", Фамилия);
        Эл.Вставить("phone", ТелефонКонтрагента(Контрагент));
        Эл.Вставить("docId", DocId);
        Эл.Вставить("name", Наименование);
        Эл.Вставить("status", Статус);
        Эл.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаНачала));
        Эл.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(Выборка.СрокДействия));
        Эл.Вставить("kind", Мета.kind);
        Эл.Вставить("termDays", Мета.termDays);
        Эл.Вставить("totalUnits", Мета.totalUnits);
        Эл.Вставить("oneOff", Ложь);
        Если Выборка.КоличествоОстаток <> Неопределено Тогда
            Эл.Вставить("visitsRemaining", Выборка.КоличествоОстаток);
        КонецЕсли;

        Следующий = СледующийАбонементКлиентаJSON(Контрагент, Членство, Выборка.СрокДействия, ДатаНачала);
        Эл.Вставить("nextMembership", Следующий);

        Результат.Добавить(Эл);
    КонецЦикла;

    Возврат Новый Структура("data", Результат);
КонецФункции

// kind / termDays / totalUnits / oneOff для фильтра продлений.
Функция МетаЧленстваДляПродления(Членство, ДатаАктивации, СрокДействия)
    Р = Новый Структура;
    Р.Вставить("kind", "membership");
    Р.Вставить("termDays", 0);
    Р.Вставить("totalUnits", Неопределено);
    Р.Вставить("oneOff", Ложь);

    Попытка
        ТипСтр = ВРег(СокрЛП(Строка(Членство.ТипЧленстваПакетаУслуг)));
        Если СтрНайти(ТипСтр, "ПАКЕТ") > 0 Тогда
            Р.kind = "package";
        ИначеЕсли СтрНайти(ТипСтр, "ЧЛЕНСТВ") > 0 Тогда
            Р.kind = "membership";
        ИначеЕсли СтрНайти(ТипСтр, "УСЛУГ") > 0 Тогда
            Р.kind = "package";
        КонецЕсли;
    Исключение
    КонецПопытки;

    // Срок в днях: СрокДействия + СрокДействияТип от даты начала, иначе validUntil − validFrom.
    ДатаОт = ДатаАктивации;
    Если НЕ ЗначениеЗаполнено(ДатаОт) Тогда
        Попытка
            ДатаОт = Членство.ДатаРучнойАктивации;
            Если НЕ ЗначениеЗаполнено(ДатаОт) Тогда
                ДатаОт = Членство.Дата;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;

    Попытка
        ЧислоСрока = Членство.СрокДействия;
        ТипСрока = ВРег(Строка(Членство.СрокДействияТип));
        Если ЗначениеЗаполнено(ЧислоСрока) И ЧислоСрока > 0 И ЗначениеЗаполнено(ДатаОт) Тогда
            ДатаКон = ДобавитьСрок(ДатаОт, ЧислоСрока, ТипСрока);
            Р.termDays = Цел((НачалоДня(ДатаКон) - НачалоДня(ДатаОт)) / 86400);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Если Р.termDays <= 0 И ЗначениеЗаполнено(ДатаОт) И ЗначениеЗаполнено(СрокДействия) Тогда
        Р.termDays = Цел((НачалоДня(СрокДействия) - НачалоДня(ДатаОт)) / 86400);
    КонецЕсли;
    Если Р.termDays < 0 Тогда
        Р.termDays = 0;
    КонецЕсли;

    // Сумма квот услуг (без безлимита).
    ВсегоЕд = 0;
    ЕстьБезлимит = Ложь;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    СУ.Количество КАК Количество
    |ИЗ
    |    Документ.ЧленствоПакетУслуг.СоставУслуг КАК СУ
    |ГДЕ
    |    СУ.Ссылка = &Членство";
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Кол = ?(Выборка.Количество = NULL, 0, Выборка.Количество);
            Если Кол <= 0 Тогда
                ЕстьБезлимит = Истина;
            Иначе
                ВсегоЕд = ВсегоЕд + Кол;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Если НЕ ЕстьБезлимит И ВсегоЕд > 0 Тогда
        Р.totalUnits = ВсегоЕд;
    КонецЕсли;

    Р.oneOff = (Р.termDays > 0 И Р.termDays <= 1)
        ИЛИ (Р.totalUnits <> Неопределено И Р.totalUnits = 1);
    Возврат Р;
КонецФункции

// Уже купленный следующий / неактивированный абонемент того же клиента (или Неопределено).
// ТекущийValidFrom — дата начала текущего (чтобы отличить «купили заранее»).
Функция СледующийАбонементКлиентаJSON(Контрагент, ТекущееЧленство, ТекущийСрок, ТекущийValidFrom = Неопределено)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Ч.Ссылка КАК Членство,
    |    Ч.Дата КАК ДатаДок,
    |    Ч.ДатаРучнойАктивации КАК ДатаРучнойАктивации,
    |    Ч.Номенклатура КАК Номенклатура
    |ИЗ
    |    Документ.ЧленствоПакетУслуг КАК Ч
    |ГДЕ
    |    Ч.Контрагент = &Контрагент
    |    И Ч.Проведен
    |    И НЕ Ч.ПометкаУдаления
    |    И НЕ Ч.Архивный
    |    И Ч.Ссылка <> &Текущее
    |УПОРЯДОЧИТЬ ПО
    |    Ч.Дата УБЫВ";
    Запрос.УстановитьПараметр("Контрагент", Контрагент);
    Запрос.УстановитьПараметр("Текущее", ТекущееЧленство);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Возврат Неопределено;
    КонецПопытки;

    Сегодня = НачалоДня(ТекущаяДатаСеанса());

    Пока Выборка.Следующий() Цикл
        Членство = Выборка.Членство;

        Мета = МетаЧленстваДляПродления(Членство, Неопределено, Неопределено);
        Если Мета.oneOff = Истина Тогда
            Продолжить;
        КонецЕсли;

        Итоги = ИтогиЧленстваПоСсылке(Членство);

        ДатаАктИтоги = '00010101';
        ДатаРучн = Выборка.ДатаРучнойАктивации;
        Срок = '00010101';
        СтатусТекст = "";
        Если Итоги <> Неопределено Тогда
            ДатаАктИтоги = Итоги.ДатаАктивации;
            Срок = Итоги.СрокДействия;
            СтатусТекст = Итоги.Статус;
        КонецЕсли;

        Статус = СтатусЧленстваJSON(СтатусТекст);
        Если Статус = "EXPIRED" Тогда
            Продолжить;
        КонецЕсли;

        // Не подставляем ДатаДок в дату активации — иначе «купили заранее» не распознать.
        ЕстьАктивация = ЗначениеЗаполнено(ДатаАктИтоги) ИЛИ ЗначениеЗаполнено(ДатаРучн);
        ДатаАктДляОтвета = ДатаАктИтоги;
        Если НЕ ЗначениеЗаполнено(ДатаАктДляОтвета) Тогда
            ДатаАктДляОтвета = ДатаРучн;
        КонецЕсли;

        ЭтоСледующий = Ложь;
        Если Статус = "PENDING" Тогда
            ЭтоСледующий = Истина;
        ИначеЕсли НЕ ЕстьАктивация
            И ЗначениеЗаполнено(Выборка.ДатаДок)
            И (НЕ ЗначениеЗаполнено(ТекущийValidFrom) ИЛИ Выборка.ДатаДок > ТекущийValidFrom) Тогда
            // Купили заранее, ещё не активировали.
            ЭтоСледующий = Истина;
        ИначеЕсли ЗначениеЗаполнено(Срок) И ЗначениеЗаполнено(ТекущийСрок) И Срок > ТекущийСрок Тогда
            ЭтоСледующий = Истина;
        ИначеЕсли ЗначениеЗаполнено(ДатаАктДляОтвета) И ДатаАктДляОтвета > Сегодня
            И (НЕ ЗначениеЗаполнено(ТекущийСрок) ИЛИ ДатаАктДляОтвета >= ТекущийСрок) Тогда
            ЭтоСледующий = Истина;
        КонецЕсли;

        Если НЕ ЭтоСледующий Тогда
            Продолжить;
        КонецЕсли;

        DocId = "";
        Попытка
            DocId = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Членство);
        Исключение
            DocId = Строка(Членство);
        КонецПопытки;

        Наименование = "";
        Попытка
            Наименование = СокрЛП(Строка(Выборка.Номенклатура));
        Исключение
        КонецПопытки;
        Если ПустаяСтрока(Наименование) Тогда
            Наименование = Строка(Членство);
        КонецЕсли;

        СтатусОтв = Статус;
        Если ПустаяСтрока(СтатусОтв) ИЛИ (НЕ ЕстьАктивация) Тогда
            СтатусОтв = "PENDING";
        КонецЕсли;

        Р = Новый Структура;
        Р.Вставить("docId", DocId);
        Р.Вставить("name", Наименование);
        Р.Вставить("status", СтатусОтв);
        Р.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаАктДляОтвета));
        Р.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(Срок));
        Возврат Р;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

#КонецОбласти
