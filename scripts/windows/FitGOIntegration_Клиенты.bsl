#Область ПрограммныйИнтерфейс

Функция НайтиКонтрагентаПоТелефону(Телефон) Экспорт
    Нормализованный = "";
    Хвост = "";
    Попытка
        Нормализованный = FitGOIntegrationОбщегоНазначения.НормализоватьТелефон(Телефон);
        Хвост = FitGOIntegrationОбщегоНазначения.ХвостТелефона(Телефон);
    Исключение
    КонецПопытки;

    // Локальный разбор цифр — не зависеть от формата НормализоватьТелефон (+375 / 80 / пробелы)
    Цифры = ТолькоЦифрыТелефона(Телефон);
    Если ПустаяСтрока(Нормализованный) Тогда
        Нормализованный = Цифры;
    КонецЕсли;
    Если ПустаяСтрока(Хвост) Тогда
        Хвост = Прав(Цифры, 9);
    КонецЕсли;
    Если ПустаяСтрока(Хвост) Тогда
        Возврат Неопределено;
    КонецЕсли;

    Контрагент = НайтиЧерезКонтактнуюИнформацию(Нормализованный, Хвост);
    Если ЗначениеЗаполнено(Контрагент) Тогда
        Возврат Контрагент;
    КонецЕсли;

    // Ещё раз с «сырыми» цифрами (если нормализатор вернул другой формат)
    Если Нормализованный <> Цифры И НЕ ПустаяСтрока(Цифры) Тогда
        Контрагент = НайтиЧерезКонтактнуюИнформацию(Цифры, Прав(Цифры, 9));
        Если ЗначениеЗаполнено(Контрагент) Тогда
            Возврат Контрагент;
        КонецЕсли;
    КонецЕсли;

    Возврат НайтиЧерезРеквизитыКонтрагента(Нормализованный, Хвост);
КонецФункции

Функция ТолькоЦифрыТелефона(Значение)
    Исх = Строка(Значение);
    Цифры = "";
    Для Индекс = 1 По СтрДлина(Исх) Цикл
        СимволСтр = Сред(Исх, Индекс, 1);
        Если СтрНайти("0123456789", СимволСтр) > 0 Тогда
            Цифры = Цифры + СимволСтр;
        КонецЕсли;
    КонецЦикла;
    Возврат Цифры;
КонецФункции

Функция НайтиКонтрагентаПоВнешнемуИд(ВнешнийИд) Экспорт
    Попытка
        Возврат Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ДанныеКлиентаJSON(Контрагент) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("externalId", FitGOIntegrationОбщегоНазначения.UUIDСсылка(Контрагент));
    Данные.Вставить("firstName", Строка(Контрагент.Имя));
    Данные.Вставить("lastName", Строка(Контрагент.Фамилия));
    Данные.Вставить("phone", ТелефонКонтрагента(Контрагент));

    Если ЗначениеЗаполнено(Контрагент.Отчество) Тогда
        Данные.Вставить("middleName", Строка(Контрагент.Отчество));
    КонецЕсли;

    Email = EmailКонтрагента(Контрагент);
    Если ЗначениеЗаполнено(Email) Тогда
        Данные.Вставить("email", Email);
    КонецЕсли;

    Возврат Данные;
КонецФункции

Функция АктивныйАбонементJSON(Контрагент) Экспорт
    // 1) Источник истины по сроку/статусу — РС.ЧленстваПакетыУслугИтоги
    Итоги = ИтогиЧленстваПоКлиенту(Контрагент);
    Членство = Неопределено;
    Если Итоги <> Неопределено Тогда
        Членство = Итоги.Членство;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Членство) Тогда
        Членство = НайтиЧленство(Контрагент);
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Членство) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Итоги = Неопределено Тогда
        Итоги = ИтогиЧленстваПоСсылке(Членство);
    КонецЕсли;

    Наименование = "";
    ДатаНачала = '00010101';
    ДатаОкончания = '00010101';
    СтатусТекст = "";
    Архивный = Ложь;
    Попытка
        Наименование = СокрЛП(Строка(Членство.Номенклатура));
        Архивный = Членство.Архивный;
        ДатаНачала = Членство.ДатаРучнойАктивации;
        Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
            ДатаНачала = Членство.Дата;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(Наименование) Тогда
        Наименование = Строка(Членство);
    КонецЕсли;

    Если Итоги <> Неопределено Тогда
        Если ЗначениеЗаполнено(Итоги.ДатаАктивации) Тогда
            ДатаНачала = Итоги.ДатаАктивации;
        КонецЕсли;
        Если ЗначениеЗаполнено(Итоги.СрокДействия) Тогда
            ДатаОкончания = Итоги.СрокДействия;
        КонецЕсли;
        СтатусТекст = Итоги.Статус;
    КонецЕсли;

    // Запас: периодический регистр статусов
    Если ПустаяСтрока(СтатусТекст) Тогда
        СтатусТекст = СтатусЧленстваИзРегистра(Членство);
    КонецЕсли;

    // Запас: расчёт из реквизитов документа (если Итоги пусты)
    Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
        Попытка
            СрокДатой = Членство.СрокДействияДатой;
            Если ЗначениеЗаполнено(СрокДатой) Тогда
                ДатаОкончания = СрокДатой;
            Иначе
                ДатаОкончания = ДобавитьСрок(
                    ДатаНачала,
                    Членство.СрокДействия,
                    ВРег(Строка(Членство.СрокДействияТип)));
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЕсли;

    Статус = СтатусЧленстваJSON(СтатусТекст);
    Если Архивный И Статус = "ACTIVE" Тогда
        Статус = "EXPIRED";
    КонецЕсли;
    Если Статус = "ACTIVE"
        И ЗначениеЗаполнено(ДатаОкончания)
        И ДатаОкончания < НачалоДня(ТекущаяДатаСеанса()) Тогда
        Статус = "EXPIRED";
    КонецЕсли;

    Остатки = ОстаткиЧленства(Членство);

    Ид = "";
    Попытка
        Ид = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Членство);
    Исключение
        Ид = Строка(Членство);
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("id", Ид);
    Результат.Вставить("name", Наименование);
    Результат.Вставить("status", Статус);
    Результат.Вставить("validFrom", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаНачала));
    Результат.Вставить("validUntil", FitGOIntegrationОбщегоНазначения.ISOДата(ДатаОкончания));

    Если Остатки.Посещения <> Неопределено Тогда
        Результат.Вставить("visitsRemaining", Остатки.Посещения);
    ИначеЕсли Итоги <> Неопределено
        И Итоги.КоличествоОстаток <> Неопределено
        И Остатки.Услуги.Количество() = 0 Тогда
        // В Итоги.КоличествоОстаток часто сумма квот услуг — не путать с посещениями клуба
        Результат.Вставить("visitsRemaining", Итоги.КоличествоОстаток);
    КонецЕсли;
    // Квоты SPA: объединяем строки из активного абонемента и других пакетов
    // (блок массажей и т.п.) — иначе getMembership видит только один документ.
    УслугиОбъед = ОбъединитьКвотыУслугПакетов(Контрагент, Членство, Остатки.Услуги);
    Если УслугиОбъед.Количество() > 0 Тогда
        Результат.Вставить("services", УслугиОбъед);
    КонецЕсли;

    Деньги = СчетаИДолгиКлиента(Контрагент);
    // Всегда отдаём числа (в т.ч. 0) — UI показывает остаток и долг явно
    Результат.Вставить("accountBalance",
        ?(Деньги.accountBalance <> Неопределено, Деньги.accountBalance, 0));
    Результат.Вставить("debtAmount",
        ?(Деньги.debtAmount <> Неопределено, Деньги.debtAmount, 0));
    Результат.Вставить("currency", "BYN");

    ДобавитьПоляЗаморозки(Результат, Членство, Остатки, Статус);

    Возврат Результат;
КонецФункции

// Создаёт и проводит документ «Операция с членством…» с видом Заморозка.
// Возврат: Структура с ключами ok (Булево), error (Строка), membership (Структура|Неопределено).
Функция ЗаморозитьАбонемент(Контрагент, Дней, ДатаС = Неопределено) Экспорт

    Ответ = Новый Структура;
    Ответ.Вставить("ok", Ложь);
    Ответ.Вставить("error", "");
    Ответ.Вставить("membership", Неопределено);

    Если Дней = Неопределено ИЛИ Дней < 1 Тогда
        Ответ.error = "days must be >= 1";
        Возврат Ответ;
    КонецЕсли;
    Если ДатаС = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДатаС) Тогда
        ДатаС = НачалоДня(ТекущаяДатаСеанса());
    Иначе
        ДатаС = НачалоДня(ДатаС);
    КонецЕсли;
    Если ДатаС < НачалоДня(ТекущаяДатаСеанса()) Тогда
        Ответ.error = "fromDate cannot be in the past";
        Возврат Ответ;
    КонецЕсли;

    Текущий = АктивныйАбонементJSON(Контрагент);
    Если Текущий = Неопределено Тогда
        Ответ.error = "Membership not found";
        Возврат Ответ;
    КонецЕсли;
    Если Текущий.Свойство("freezeAllowed") И Текущий.freezeAllowed <> Истина Тогда
        Ответ.error = "Freeze is not available for this membership";
        Возврат Ответ;
    КонецЕсли;
    Остаток = 0;
    Если Текущий.Свойство("freezeDaysRemaining") Тогда
        Остаток = Текущий.freezeDaysRemaining;
    КонецЕсли;
    Если Дней > Остаток Тогда
        Ответ.error = "days exceed freezeDaysRemaining";
        Возврат Ответ;
    КонецЕсли;
    Если Текущий.Свойство("status") И ВРег(Строка(Текущий.status)) = "FROZEN" Тогда
        Ответ.error = "Membership is already frozen";
        Возврат Ответ;
    КонецЕсли;

    Членство = Неопределено;
    Итоги = ИтогиЧленстваПоКлиенту(Контрагент);
    Если Итоги <> Неопределено Тогда
        Членство = Итоги.Членство;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Членство) Тогда
        Членство = НайтиЧленство(Контрагент);
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Членство) Тогда
        Ответ.error = "Membership not found";
        Возврат Ответ;
    КонецЕсли;

    ДокМд = НайтиМетаданныеОперацииСЧленством();
    Если ДокМд = Неопределено Тогда
        Ответ.error = "Freeze operation document not found in metadata";
        Возврат Ответ;
    КонецЕсли;

    Попытка
        Док = Документы[ДокМд.Имя].СоздатьДокумент();
        Док.Дата = ТекущаяДатаСеанса();
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "КОНТРАГЕНТ,КЛИЕНТ", Контрагент);
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "ЧЛЕНСТВ,ПАКЕТ", Членство);
        УстановитьОперациюЗаморозка(Док, ДокМд);
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "ДАТАС,ДАТАНАЧАЛ,НАЧАЛО", ДатаС);
        ЗаполнитьРеквизитЧисломПоМаске(Док, ДокМд, "ДНЕЙ,СРОК,НАСРОК", Дней);
        ДатаПо = ДатаС + Дней * 86400;
        ЗаполнитьРеквизитДокументаПоМаске(Док, ДокМд, "ДАТАПО,ДАТАОКОНЧ,ОКОНЧАНИЕ", ДатаПо);
        Док.Записать(РежимЗаписиДокумента.Проведение);
    Исключение
        Ответ.error = FitGOКраткоОшибку(ИнформацияОбОшибке());
        Возврат Ответ;
    КонецПопытки;

    Ответ.ok = Истина;
    Ответ.membership = АктивныйАбонементJSON(Контрагент);
    Возврат Ответ;
КонецФункции

// Списание 1 ед. услуги из пакета членства (SPA QUOTA).
// Подтверждено вручную 2026-09-17 (док 00000111666): «Посещение салона красоты»
// списывает «Массаж классический общий» из VIP. Не путать с Документ.Посещение (зал).
Функция СписатьУслугуЧленства(Контрагент, ServiceName, BookingRef, OccurredAt = Неопределено, DurationMin = 0, EmployeeName = "", EmployeeCode = "") Экспорт

    Ответ = Новый Структура;
    Ответ.Вставить("ok", Ложь);
    Ответ.Вставить("error", "");
    Ответ.Вставить("membership", Неопределено);

    ИмяУслуги = СокрЛП(Строка(ServiceName));
    Если ПустаяСтрока(ИмяУслуги) Тогда
        Ответ.error = "serviceName required";
        Возврат Ответ;
    КонецЕсли;

    // Ищем пакет с остатком услуги: VIP-абонемент ИЛИ отдельный блок массажей.
    Найденный = НайтиЧленствоСУслугой(Контрагент, ИмяУслуги);
    Если Найденный = Неопределено Тогда
        Ответ.error = "Service not found in membership package: " + ИмяУслуги;
        Возврат Ответ;
    КонецЕсли;
    Членство = Найденный.Членство;
    УслугаСегмент = Найденный.УслугаСегмент;

    ОстатокДо = Неопределено;
    Безлимит = Ложь;
    Если УслугаСегмент.Свойство("unlimited") И УслугаСегмент.unlimited = Истина Тогда
        Безлимит = Истина;
    ИначеЕсли УслугаСегмент.Свойство("remaining") Тогда
        ОстатокДо = УслугаСегмент.remaining;
        Если ОстатокДо <= 0 Тогда
            Ответ.error = "No quota remaining for service: " + ИмяУслуги;
            Возврат Ответ;
        КонецЕсли;
    КонецЕсли;

    ДатаДок = ТекущаяДатаСеанса();
    Если OccurredAt <> Неопределено И ЗначениеЗаполнено(OccurredAt) Тогда
        ДатаДок = OccurredAt;
    КонецЕсли;

    Номенклатура = НайтиНоменклатуруПоИмени(ИмяУслуги);
    Если Номенклатура = Неопределено Тогда
        Номенклатура = УслугаСегмент.Ссылка;
    КонецЕсли;

    Мин = ?(DurationMin > 0, DurationMin, 60);
    Рез = ПопыткаСписатьЧерезПосещениеСалона(
        Контрагент, Членство, Номенклатура, УслугаСегмент.Ссылка,
        ДатаДок, BookingRef, Мин, Безлимит, ОстатокДо, ИмяУслуги,
        EmployeeName, EmployeeCode);
    Если Рез.ok Тогда
        Ответ.ok = Истина;
        Ответ.membership = АктивныйАбонементJSONСДокСсылкой(Контрагент, Рез);
        Возврат Ответ;
    КонецЕсли;

    Ответ.error = "Salon visit consume failed: " + Рез.error
        + " | meta=" + ИмяМетаданныхПосещенияСалона()
        + " | docs=" + СписокДокументовСалонКлючи()
        + " | historicWriters=" + СписокРегистраторовДвиженийУслуг(Членство);
    Возврат Ответ;
КонецФункции

Функция СписокРегистраторовДвиженийУслуг(Членство)

    Части = Новый Массив;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 30
    |    ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(Движения.Регистратор)) КАК Предст
    |ИЗ
    |    РегистрНакопления.ЧленстваПакетыУслуг КАК Движения
    |ГДЕ
    |    Движения.Основание = &Членство
    |    И Движения.УслугаСегмент <> НЕОПРЕДЕЛЕНО";
    Запрос.УстановитьПараметр("Членство", Членство);
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Части.Добавить(Строка(Выборка.Предст));
        КонецЦикла;
    Исключение
        Возврат "query-failed";
    КонецПопытки;
    Если Части.Количество() = 0 Тогда
        Возврат "(none)";
    КонецЕсли;
    Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ИмяМетаданныхПосещенияСалона()
    Мд = НайтиМетаданныеПосещенияСалона();
    Если Мд = Неопределено Тогда
        Возврат "(not found)";
    КонецЕсли;
    Возврат Мд.ПолноеИмя();
КонецФункции

Функция НайтиМетаданныеПосещенияСалона()

    // UI «Посещение салона красоты» в Forma часто = Документ.Занятие (historicWriters).
    Кандидаты = Новый Массив;
    Кандидаты.Добавить("Документ.ПосещениеСалонаКрасоты");
    Кандидаты.Добавить("Документ.ПосещениеСалона");
    Кандидаты.Добавить("Документ.СалонПосещение");
    Кандидаты.Добавить("Документ.Занятие");
    Кандидаты.Добавить("Документ.ПерсональноеЗанятие");
    Для Каждого ПолноеИмя Из Кандидаты Цикл
        Мд = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
        Если Мд <> Неопределено Тогда
            Возврат Мд;
        КонецЕсли;
    КонецЦикла;

    Попытка
        ЛучшийПоСинониму = Неопределено;
        Для Каждого Мд Из Метаданные.Документы Цикл
            Имя = ВРег(Мд.Имя);
            Син = ВРег(Мд.Синоним);
            Если СтрНайти(Син, "ПОСЕЩЕНИЕ САЛОНА") > 0 ИЛИ СтрНайти(Син, "САЛОНА КРАСОТЫ") > 0 Тогда
                Возврат Мд;
            КонецЕсли;
            Если СтрНайти(Син, "КРАСОТ") > 0 ИЛИ СтрНайти(Имя, "КРАСОТ") > 0
                ИЛИ СтрНайти(Син, "САЛОН") > 0 ИЛИ СтрНайти(Имя, "САЛОН") > 0 Тогда
                Если ЛучшийПоСинониму = Неопределено Тогда
                    ЛучшийПоСинониму = Мд;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Если ЛучшийПоСинониму <> Неопределено Тогда
            Возврат ЛучшийПоСинониму;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Возврат Неопределено;

КонецФункции

// Диагностика: имена документов с ключевыми словами (в текст ошибки).
Функция СписокДокументовСалонКлючи()
    Части = Новый Массив;
    Попытка
        Для Каждого Мд Из Метаданные.Документы Цикл
            Имя = ВРег(Мд.Имя);
            Син = ВРег(Мд.Синоним);
            Если СтрНайти(Имя, "САЛОН") > 0 ИЛИ СтрНайти(Син, "САЛОН") > 0
                ИЛИ СтрНайти(Имя, "КРАСОТ") > 0 ИЛИ СтрНайти(Син, "КРАСОТ") > 0
                ИЛИ СтрНайти(Имя, "ЗАНЯТ") > 0 ИЛИ СтрНайти(Син, "ЗАНЯТ") > 0
                ИЛИ СтрНайти(Имя, "ПОСЕЩ") > 0 ИЛИ СтрНайти(Син, "ПОСЕЩ") > 0 Тогда
                Части.Добавить(Мд.Имя + "(" + Мд.Синоним + ")");
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;
    Если Части.Количество() = 0 Тогда
        Возврат "(none)";
    КонецЕсли;
    Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ПопыткаСписатьЧерезПосещениеСалона(Контрагент, Членство, Номенклатура, Сегмент, ДатаДок, BookingRef, DurationMin, Безлимит, ОстатокДо, ИмяУслуги, EmployeeName = "", EmployeeCode = "")

    Р = Новый Структура("ok,error,docId,docNumber", Ложь, "", "", "");
    ДокМд = НайтиМетаданныеПосещенияСалона();
    Если ДокМд = Неопределено Тогда
        Р.error = "Документ «Посещение салона красоты» not found in metadata";
        Возврат Р;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(ДатаДок) ИЛИ Год(ДатаДок) < 2000 Тогда
        ДатаДок = ТекущаяДатаСеанса();
    КонецЕсли;
    Если DurationMin = Неопределено ИЛИ DurationMin < 1 Тогда
        DurationMin = 60;
    КонецЕсли;
    ДатаКон = ДатаДок + DurationMin * 60;

    УслугаШапка = ?(Номенклатура <> Неопределено, Номенклатура, Сегмент);
    УслугаСегментСписания = ?(Сегмент <> Неопределено, Сегмент, Номенклатура);

    Попытка
        Док = Документы[ДокМд.Имя].СоздатьДокумент();
        Док.Дата = ДатаДок;

        // Дамп 2026-09-18: ручное списание админом — форма «Посещение салона красоты»,
        // статусы UI: Запланировано → Проводится → Выполнено → Отменено.
        // Поле ИдентификаторЗанятия — тип УникальныйИдентификатор (с дефисами), как у групповых.
        // Hex без дефисов → в поле пишется 00000000-… и форма салона падает.
        УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "ТипЗанятия", "ПосещениеСалонаКрасоты");
        // Сначала «Выполнено» (как UI админа), fallback «Проведено».
        УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "СтатусЗанятия", "Выполнено");
        Если НЕ ЗначениеЗаполнено(Док.СтатусЗанятия) Тогда
            УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "СтатусЗанятия", "Проведено");
        КонецЕсли;
        УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "ТипСписания", "ЗаписанИПрибыл");
        Если НЕ ЗначениеЗаполнено(Док.ТипСписания) Тогда
            УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "ТипСписания", "Записан и прибыл");
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Док.ТипСписания) Тогда
            УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "ТипСписания", "ВсегдаКромеРаннейОтмены");
        КонецЕсли;

        Попытка
            Док.ДатаВремяНачала = ДатаДок;
        Исключение
        КонецПопытки;
        Попытка
            Док.ДатаВремяОкончания = ДатаКон;
        Исключение
        КонецПопытки;
        Попытка
            Док.Комментарий = "FitGO SPA bookingRef=" + СокрЛП(Строка(BookingRef));
        Исключение
        КонецПопытки;
        Попытка
            Док.Номенклатура = УслугаШапка;
        Исключение
        КонецПопытки;
        Попытка
            Док.КоличествоОказываемыхУслуг = 1;
        Исключение
        КонецПопытки;
        Попытка
            Док.ЗаписьСалонаПодтверждена = Истина;
        Исключение
        КонецПопытки;
        // Тип реквизита — УникальныйИдентификатор. Пишем тип, не строку hex.
        Попытка
            Док.ИдентификаторЗанятия = Новый УникальныйИдентификатор;
        Исключение
        КонецПопытки;
        Попытка
            Док.ВсегоКлиентовЗаписано = 1;
        Исключение
        КонецПопытки;
        Попытка
            Док.ВсегоКлиентовПосетило = 1;
        Исключение
        КонецПопытки;
        Попытка
            Док.ВсегоКлиентовПосетилоПоДаннымТренера = 1;
        Исключение
        КонецПопытки;

        // Помещение: всегда «Массажный кабинет» для SPA / анализа состава тела (код 000000006).
        // Сотрудник: из слота FitGO (employeeName/Code), иначе «Универсальный».
        УстановитьСотрудникаИПомещениеСалон(Док, ДокМд, EmployeeName, EmployeeCode);

        // QUOTA (Безлимит=Ложь): списание из пакета, ОснованиеОплаты = членство.
        // PAID (Безлимит=Истина): платный визит, оплата на ресепшене — без основания-членства,
        //   без списания квоты; строка ТЧ нужна только чтобы форма салона не падала на [0].
        КвотныйРежим = (НЕ Безлимит) И ЗначениеЗаполнено(Членство);

        Если (НЕ Безлимит) И НЕ ЗначениеЗаполнено(Членство) Тогда
            Р.error = ДокМд.Имя + ":ОснованиеОплаты (членство) required for quota write-off";
            Возврат Р;
        КонецЕсли;
        Если НЕ ЗаполнитьСоставЗанятияСалон(Док, Контрагент, ?(КвотныйРежим, Членство, Неопределено), УслугаСегментСписания, ДатаДок) Тогда
            Р.error = ДокМд.Имя + ":СоставЗанятия empty after fill (form needs row [0])";
            Возврат Р;
        КонецЕсли;
        Если Док.СоставЗанятия.Количество() < 1
            ИЛИ (КвотныйРежим И НЕ ЗначениеЗаполнено(Док.СоставЗанятия[0].ОснованиеОплаты)) Тогда
            Р.error = ДокМд.Имя + ":СоставЗанятия[0] invalid before write";
            Возврат Р;
        КонецЕсли;

        Док.Дата = ДатаДок;
        Док.Записать(РежимЗаписиДокумента.Проведение);

        // Проведение типовой конфигурации может очистить ТЧ — тогда форма салона падает на [0].
        Попытка
            ДокПроверка = Док.Ссылка.ПолучитьОбъект();
            ТЧПуста = (ДокПроверка.СоставЗанятия.Количество() < 1);
            Если КвотныйРежим И НЕ ТЧПуста Тогда
                ТЧПуста = НЕ ЗначениеЗаполнено(ДокПроверка.СоставЗанятия[0].ОснованиеОплаты);
            КонецЕсли;
            ИдПлох = Ложь;
            Попытка
                ИдСтр = Строка(ДокПроверка.ИдентификаторЗанятия);
                ИдПлох = ПустаяСтрока(ИдСтр) ИЛИ СтрНачинаетсяС(ИдСтр, "00000000");
            Исключение
            КонецПопытки;
            Если ТЧПуста ИЛИ ИдПлох Тогда
                Попытка
                    Если ДокПроверка.Проведен Тогда
                        ДокПроверка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
                    КонецЕсли;
                    ДокПроверка.Удалить();
                Исключение
                    Попытка
                        ДокПроверка.УстановитьПометкуУдаления(Истина);
                    Исключение
                    КонецПопытки;
                КонецПопытки;
                Р.error = ДокМд.Имя + ":" + ?(ИдПлох, "ИдентификаторЗанятия empty/zero", "СоставЗанятия empty")
                    + " after post (rolled back; form would crash)";
                Возврат Р;
            КонецЕсли;
        Исключение
        КонецПопытки;
    Исключение
        Р.error = ДокМд.Имя + ":" + FitGOКраткоОшибку(ИнформацияОбОшибке())
            + " | date=" + Формат(ДатаДок, "ДФ=yyyy-MM-ddTHH:mm:ss");
        Возврат Р;
    КонецПопытки;

    НомерДок = "";
    Попытка
        НомерДок = СокрЛП(Строка(Док.Номер));
    Исключение
    КонецПопытки;

    Если НЕ Безлимит И ОстатокДо <> Неопределено Тогда
        МоментКвоты = ДатаДок;
        Если МоментКвоты < ТекущаяДатаСеанса() Тогда
            МоментКвоты = ТекущаяДатаСеанса();
        КонецЕсли;
        Если НЕ КвотаУслугиУменьшилась(Контрагент, Членство, ИмяУслуги, ОстатокДо, МоментКвоты, Док.Ссылка) Тогда
            Р.error = ДокМд.Имя + ":posted but quota unchanged"
                + " | num=" + НомерДок
                + " | service=" + СокрЛП(Строка(УслугаШапка))
                + " | tip=ТипЗанятия=ПосещениеСалонаКрасоты Статус=Проведено ТЧ=СоставЗанятия";
            Возврат Р;
        КонецЕсли;
    КонецЕсли;
    Р.ok = Истина;
    Р.docNumber = НомерДок;
    // Тот же id, что отдаёт class-sessions (ИдентификаторЗанятия), иначе UUID ссылки.
    Попытка
        ИдЗанятия = Строка(Док.ИдентификаторЗанятия);
        Если НЕ ПустаяСтрока(ИдЗанятия) И НЕ СтрНачинаетсяС(ИдЗанятия, "00000000") Тогда
            Р.docId = ИдЗанятия;
        КонецЕсли;
    Исключение
    КонецПопытки;
    Если ПустаяСтрока(Р.docId) Тогда
        Попытка
            Р.docId = Строка(Док.Ссылка.УникальныйИдентификатор());
        Исключение
        КонецПопытки;
    КонецЕсли;
    Возврат Р;
КонецФункции

Процедура УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, ИмяРеквизита, ИмяЗначения)
    Попытка
        Для Каждого Рекв Из ДокМд.Реквизиты Цикл
            Если Рекв.Имя <> ИмяРеквизита Тогда
                Продолжить;
            КонецЕсли;
            Для Каждого Тип Из Рекв.Тип.Типы() Цикл
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого ЗнПереч Из МдПереч.ЗначенияПеречисления Цикл
                    Если ВРег(ЗнПереч.Имя) = ВРег(ИмяЗначения)
                        ИЛИ ВРег(ЗнПереч.Синоним) = ВРег(ИмяЗначения) Тогда
                        Док[Рекв.Имя] = Перечисления[МдПереч.Имя][ЗнПереч.Имя];
                        Возврат;
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    Исключение
    КонецПопытки;
КонецПроцедуры

// ФормаПосещенияСалонаКрасоты падает на Занятие.СоставЗанятия[0] если ТЧ пустая.
// Членство = Неопределено → платный визит (оплата на ресепшене): строка без списания квоты.
// Членство заполнено → списание из пакета (ОснованиеОплаты + СписаниеЗанятияРазрешено).
// Возврат: Истина если добавлена строка с Контрагент (в квотном режиме — и с ОснованиеОплаты).
Функция ЗаполнитьСоставЗанятияСалон(Док, Контрагент, Членство, УслугаСегментСписания, ДатаДок)

    Квотный = ЗначениеЗаполнено(Членство);

    Попытка
        СтрокаТЧ = Док.СоставЗанятия.Добавить();
    Исключение
        Возврат Ложь;
    КонецПопытки;

    Попытка
        СтрокаТЧ.Контрагент = Контрагент;
    Исключение
        Возврат Ложь;
    КонецПопытки;
    Попытка
        СтрокаТЧ.КонтрагентСписания = Контрагент;
    Исключение
    КонецПопытки;
    Если Квотный Тогда
        Попытка
            СтрокаТЧ.ОснованиеОплаты = Членство;
        Исключение
            Возврат Ложь;
        КонецПопытки;
        Если УслугаСегментСписания <> Неопределено Тогда
            Попытка
                СтрокаТЧ.УслугаСегментСписания = УслугаСегментСписания;
            Исключение
            КонецПопытки;
        КонецЕсли;
    КонецЕсли;
    Попытка
        СтрокаТЧ.Количество = 1;
    Исключение
    КонецПопытки;
    Попытка
        СтрокаТЧ.ДатаПрибытия = ДатаДок;
    Исключение
    КонецПопытки;
    Попытка
        СтрокаТЧ.ДатаЗаписи = ДатаДок;
    Исключение
    КонецПопытки;
    Попытка
        // PAID: без списания квоты — иначе проведение чистит строку.
        СтрокаТЧ.СписаниеЗанятияРазрешено = Квотный;
    Исключение
    КонецПопытки;
    Попытка
        СтрокаТЧ.СписаниеПодтвержденоКлиентом = Квотный;
    Исключение
    КонецПопытки;
    Попытка
        Для Каждого Рекв Из Док.Метаданные().ТабличныеЧасти.СоставЗанятия.Реквизиты Цикл
            Если ВРег(Рекв.Имя) <> "СТАТУСПРИБЫТИЯ" Тогда
                Продолжить;
            КонецЕсли;
            Для Каждого Тип Из Рекв.Тип.Типы() Цикл
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого ЗнПереч Из МдПереч.ЗначенияПеречисления Цикл
                    ИмяЗн = ВРег(ЗнПереч.Имя);
                    СинЗн = ВРег(ЗнПереч.Синоним);
                    Если СтрНайти(ИмяЗн, "ПРИБ") > 0 ИЛИ СтрНайти(СинЗн, "ПРИБ") > 0
                        ИЛИ СтрНайти(ИмяЗн, "ПОСЕТ") > 0 ИЛИ СтрНайти(ИмяЗн, "ПРИШ") > 0 Тогда
                        СтрокаТЧ.СтатусПрибытия = Перечисления[МдПереч.Имя][ЗнПереч.Имя];
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Попытка
        ЕстьСтрока = Док.СоставЗанятия.Количество() > 0
            И ЗначениеЗаполнено(Док.СоставЗанятия[0].Контрагент);
        Если Квотный Тогда
            Возврат ЕстьСтрока И ЗначениеЗаполнено(Док.СоставЗанятия[0].ОснованиеОплаты);
        КонецЕсли;
        Возврат ЕстьСтрока;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// Статус FitGO SPA «Занятие» по bookingRef — для синхронизации отмен из 1С.
Функция СтатусFitGOSpaЗанятияJSON(BookingRef) Экспорт

    Р = Новый Структура("found,cancelled,posted,deletionMark,status,num,comment", Ложь, Ложь, Ложь, Ложь, "", "", "");
    Ref = СокрЛП(Строка(BookingRef));
    Если ПустаяСтрока(Ref) Тогда
        Р.cancelled = Истина;
        Возврат Р;
    КонецЕсли;

    ДокМд = НайтиМетаданныеПосещенияСалона();
    Если ДокМд = Неопределено Тогда
        // Метаданные недоступны — не помечаем отмену (иначе FitGO покажет ложную ошибку).
        Возврат Р;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 3
    |    Док.Ссылка КАК Ссылка,
    |    Док.Номер КАК Номер,
    |    Док.Проведен КАК Проведен,
    |    Док.ПометкаУдаления КАК ПометкаУдаления,
    |    Док.Комментарий КАК Комментарий
    |ИЗ
    |    Документ." + ДокМд.Имя + " КАК Док
    |ГДЕ
    |    Док.Комментарий ПОДОБНО &Коммент
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата УБЫВ";
    Запрос.УстановитьПараметр("Коммент", "%bookingRef=" + Ref + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        // Ошибка запроса — не считаем отменой (иначе FitGO «отменит» при сбое 1С)
        Возврат Р;
    КонецПопытки;

    Если НЕ Выборка.Следующий() Тогда
        // Нет документа с bookingRef в комментарии — не значит «отменено».
        // Занятие могло быть создано/проведено вручную в 1С без метки FitGO,
        // либо crmDocRef в приложении уже UUID документа, а не id записи.
        // FitGO сам решает по matched-сессии / consumedInCrmAt.
        Возврат Р;
    КонецЕсли;

    Р.found = Истина;
    Р.num = Строка(Выборка.Номер);
    Р.posted = Выборка.Проведен;
    Р.deletionMark = Выборка.ПометкаУдаления;
    Р.comment = Строка(Выборка.Комментарий);

    СтатусСтр = "";
    Попытка
        Об = Выборка.Ссылка.ПолучитьОбъект();
        СтатусСтр = Строка(Об.СтатусЗанятия);
    Исключение
    КонецПопытки;
    Р.status = СтатусСтр;

    Если Выборка.ПометкаУдаления
        ИЛИ СтрНайти(ВРег(СтатусСтр), "ОТМЕН") > 0
        ИЛИ СтрНайти(ВРег(Р.comment), "CANCELLED BY FITGO") > 0 Тогда
        Р.cancelled = Истина;
    КонецЕсли;

    Возврат Р;
КонецФункции

// Долги / оказанные услуги с конкретным специалистом (FitGO /super-admin/debts).
// Быстрый путь: один запрос по Документ.Продажа.ТЧ (Исполнитель в строке) —
// без ПолучитьОбъект на каждый документ и без обхода всех занятий.
// paymentStatus: DEBT | PAID (реквизиты оплаты документа, иначе остаток по документу в расчётах).
Функция ДолгиУслугСпециалистовJSON(FromStr, ToStr, EmployeeCode = "") Экспорт

    Результат = Новый Массив;

    КодФильтр = СокрЛП(Строка(EmployeeCode));
    Если ПустаяСтрока(КодФильтр) Тогда
        // Без фильтра по сотруднику — тяжёлый скан всего клуба; FitGO обязан передавать код.
        Возврат Результат;
    КонецЕсли;

    ДатаС = Дата(1, 1, 1);
    ДатаПо = Дата(1, 1, 1);
    Попытка
        ЧастиС = СтрРазделить(СокрЛП(Строка(FromStr)), "-");
        Если ЧастиС.Количество() >= 3 Тогда
            ДатаС = Дата(Число(ЧастиС[0]), Число(ЧастиС[1]), Число(ЧастиС[2]));
        КонецЕсли;
        ЧастиПо = СтрРазделить(СокрЛП(Строка(ToStr)), "-");
        Если ЧастиПо.Количество() >= 3 Тогда
            ДатаПо = Дата(Число(ЧастиПо[0]), Число(ЧастиПо[1]), Число(ЧастиПо[2]));
            ДатаПо = КонецДня(ДатаПо);
        КонецЕсли;
    Исключение
        Возврат Результат;
    КонецПопытки;
    Если ДатаС = Дата(1, 1, 1) Или ДатаПо = Дата(1, 1, 1) Тогда
        Возврат Результат;
    КонецЕсли;
    Если ДатаПо < ДатаС Тогда
        Возврат Результат;
    КонецЕсли;
    // Жёсткий потолок: не больше 31 календарного дня включительно (полный месяц).
    Если (НачалоДня(ДатаПо) - НачалоДня(ДатаС)) > 30 * 86400 Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого ДокМд Из МетаданныеДокументовПродажиСпециалистов() Цикл
        Карта = КартаПолейТЧПродажиСпециалиста(ДокМд);
        Если Карта = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Строки = ВыбратьСтрокиПродажСпециалистовЗапросом(ДокМд, Карта, ДатаС, ДатаПо, КодФильтр);
        Исключение
            Продолжить;
        КонецПопытки;
        Для Каждого СтрокаJSON Из Строки Цикл
            Результат.Добавить(СтрокаJSON);
        КонецЦикла;
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция МетаданныеДокументовПродажиСпециалистов()

    Список = Новый Массив;
    Уже = Новый Соответствие;
    Имена = Новый Массив;
    Имена.Добавить("Документ.Продажа");
    Имена.Добавить("Документ.ПродажаУслуг");
    Имена.Добавить("Документ.РеализацияТоваровУслуг");
    Имена.Добавить("Документ.РеализацияУслуг");

    Для Каждого ПолноеИмя Из Имена Цикл
        Мд = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
        Если Мд = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Если Уже.Получить(Мд.ПолноеИмя()) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Уже.Вставить(Мд.ПолноеИмя(), Истина);
        Список.Добавить(Мд);
    КонецЦикла;

    Попытка
        Для Каждого Мд Из Метаданные.Документы Цикл
            Син = ВРег(Мд.Синоним + " " + Мд.Имя);
            Если СтрНайти(Син, "ПРОДАЖ") = 0 И СтрНайти(Син, "РЕАЛИЗАЦ") = 0 Тогда
                Продолжить;
            КонецЕсли;
            Если Уже.Получить(Мд.ПолноеИмя()) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Уже.Вставить(Мд.ПолноеИмя(), Истина);
            Список.Добавить(Мд);
        КонецЦикла;
    Исключение
    КонецПопытки;

    Возврат Список;
КонецФункции

// Находит ТЧ с Исполнителем + номенклатурой и имена реквизитов шапки (клиент, оплата).
Функция КартаПолейТЧПродажиСпециалиста(ДокМд)

    ИмяКлиента = "";
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если ИмяВерх = "КЛИЕНТ" Или ИмяВерх = "КОНТРАГЕНТ" Или ИмяВерх = "ПОКУПАТЕЛЬ" Тогда
            ИмяКлиента = Рекв.Имя;
            Если ИмяВерх = "КЛИЕНТ" Тогда
                Прервать;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(ИмяКлиента) Тогда
        ИмяКлиента = "Клиент";
    КонецЕсли;

    ИмяОплачен = "";
    ИмяСуммаДок = "";
    ИмяСуммаОпл = "";
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если ПустаяСтрока(ИмяОплачен)
            И (ИмяВерх = "ОПЛАЧЕН" Или ИмяВерх = "ОПЛАЧЕНО" Или ИмяВерх = "ПОЛНОСТЬЮОПЛАЧЕН"
                Или ИмяВерх = "ОПЛАТАПОЛНОСТЬЮ" Или ИмяВерх = "ДОКУМЕНТОПЛАЧЕН" Или ИмяВерх = "ПРИЗНАКОПЛАТЫ") Тогда
            ИмяОплачен = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяСуммаДок)
            И (ИмяВерх = "СУММАДОКУМЕНТА" Или ИмяВерх = "СУММА") Тогда
            ИмяСуммаДок = Рекв.Имя;
        КонецЕсли;
        Если ПустаяСтрока(ИмяСуммаОпл)
            И (ИмяВерх = "СУММАОПЛАТЫ" Или ИмяВерх = "ОПЛАЧЕНО" Или ИмяВерх = "СУММАОПЛАЧЕНО") Тогда
            ИмяСуммаОпл = Рекв.Имя;
        КонецЕсли;
    КонецЦикла;

    Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
        ИмяИсп = "";
        ИмяНом = "";
        ИмяСум = "";
        ИмяЦен = "";
        ИмяКол = "";
        Для Каждого Рекв Из ТЧ.Реквизиты Цикл
            ИмяВерх = ВРег(Рекв.Имя);
            Если ПустаяСтрока(ИмяИсп)
                И (ИмяВерх = "ИСПОЛНИТЕЛЬ" Или ИмяВерх = "СОТРУДНИК" Или ИмяВерх = "ТРЕНЕР"
                    Или ИмяВерх = "СПЕЦИАЛИСТ" Или ИмяВерх = "СОТРУДНИКТРЕНЕР") Тогда
                ИмяИсп = Рекв.Имя;
            КонецЕсли;
            Если ПустаяСтрока(ИмяНом)
                И (ИмяВерх = "НОМЕНКЛАТУРА" Или ИмяВерх = "УСЛУГА" Или ИмяВерх = "ТОВАР" Или ИмяВерх = "СЕГМЕНТУСЛУГ") Тогда
                ИмяНом = Рекв.Имя;
            КонецЕсли;
            Если ПустаяСтрока(ИмяСум)
                И (ИмяВерх = "ВСЕГО" Или ИмяВерх = "СУММА" Или ИмяВерх = "СУММАВСЕГО" Или ИмяВерх = "СУММАСНДС") Тогда
                ИмяСум = Рекв.Имя;
            КонецЕсли;
            Если ПустаяСтрока(ИмяЦен)
                И (ИмяВерх = "ЦЕНА" Или ИмяВерх = "ЦЕНАРОЗНИЧНАЯ" Или ИмяВерх = "РОЗНИЧНАЯЦЕНА") Тогда
                ИмяЦен = Рекв.Имя;
            КонецЕсли;
            Если ПустаяСтрока(ИмяКол)
                И (ИмяВерх = "КОЛИЧЕСТВО" Или ИмяВерх = "КОЛВО" Или ИмяВерх = "КОЛ") Тогда
                ИмяКол = Рекв.Имя;
            КонецЕсли;
        КонецЦикла;
        Если ПустаяСтрока(ИмяИсп) Или ПустаяСтрока(ИмяНом) Тогда
            Продолжить;
        КонецЕсли;

        Карта = Новый Структура;
        Карта.Вставить("ИмяТЧ", ТЧ.Имя);
        Карта.Вставить("ИмяИсп", ИмяИсп);
        Карта.Вставить("ИмяНом", ИмяНом);
        Карта.Вставить("ИмяСум", ИмяСум);
        Карта.Вставить("ИмяЦен", ИмяЦен);
        Карта.Вставить("ИмяКол", ИмяКол);
        Карта.Вставить("ИмяКлиента", ИмяКлиента);
        Карта.Вставить("ИмяОплачен", ИмяОплачен);
        Карта.Вставить("ИмяСуммаДок", ИмяСуммаДок);
        Карта.Вставить("ИмяСуммаОпл", ИмяСуммаОпл);
        Возврат Карта;
    КонецЦикла;

    Возврат Неопределено;
КонецФункции

Функция ВыбратьСтрокиПродажСпециалистовЗапросом(ДокМд, Карта, ДатаС, ДатаПо, КодФильтр)

    Результат = Новый Массив;
    ИмяДок = ДокМд.Имя;
    ИмяТЧ = Карта.ИмяТЧ;

    Поля = Новый Массив;
    Поля.Добавить("Док.Ссылка КАК Ссылка");
    Поля.Добавить("Док.Дата КАК Дата");
    Поля.Добавить("Док.Номер КАК Номер");
    Поля.Добавить("ТЧ.НомерСтроки КАК НомерСтроки");
    Поля.Добавить("Док." + Карта.ИмяКлиента + " КАК Клиент");
    Поля.Добавить("ПРЕДСТАВЛЕНИЕ(Док." + Карта.ИмяКлиента + ") КАК ИмяКлиента");
    Поля.Добавить("ТЧ." + Карта.ИмяИсп + " КАК Исполнитель");
    Поля.Добавить("ПРЕДСТАВЛЕНИЕ(ТЧ." + Карта.ИмяИсп + ") КАК ИмяИсполнителя");
    Поля.Добавить("ТЧ." + Карта.ИмяИсп + ".Код КАК КодИсполнителя");
    Поля.Добавить("ТЧ." + Карта.ИмяНом + " КАК Номенклатура");
    Поля.Добавить("ПРЕДСТАВЛЕНИЕ(ТЧ." + Карта.ИмяНом + ") КАК ИмяУслуги");

    Если НЕ ПустаяСтрока(Карта.ИмяСум) Тогда
        Поля.Добавить("ТЧ." + Карта.ИмяСум + " КАК СуммаСтроки");
    Иначе
        Поля.Добавить("0 КАК СуммаСтроки");
    КонецЕсли;
    Если НЕ ПустаяСтрока(Карта.ИмяЦен) Тогда
        Поля.Добавить("ТЧ." + Карта.ИмяЦен + " КАК Цена");
    Иначе
        Поля.Добавить("0 КАК Цена");
    КонецЕсли;
    Если НЕ ПустаяСтрока(Карта.ИмяКол) Тогда
        Поля.Добавить("ТЧ." + Карта.ИмяКол + " КАК Количество");
    Иначе
        Поля.Добавить("1 КАК Количество");
    КонецЕсли;
    Если НЕ ПустаяСтрока(Карта.ИмяОплачен) Тогда
        Поля.Добавить("Док." + Карта.ИмяОплачен + " КАК Оплачен");
    Иначе
        Поля.Добавить("НЕОПРЕДЕЛЕНО КАК Оплачен");
    КонецЕсли;
    Если НЕ ПустаяСтрока(Карта.ИмяСуммаДок) Тогда
        Поля.Добавить("Док." + Карта.ИмяСуммаДок + " КАК СуммаДокумента");
    Иначе
        Поля.Добавить("0 КАК СуммаДокумента");
    КонецЕсли;
    Если НЕ ПустаяСтрока(Карта.ИмяСуммаОпл) Тогда
        Поля.Добавить("Док." + Карта.ИмяСуммаОпл + " КАК СуммаОплаты");
    Иначе
        Поля.Добавить("НЕОПРЕДЕЛЕНО КАК СуммаОплаты");
    КонецЕсли;

    Текст =
    "ВЫБРАТЬ
    |    " + СтрСоединить(Поля, ",
    |    ") + "
    |ИЗ
    |    Документ." + ИмяДок + "." + ИмяТЧ + " КАК ТЧ
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ." + ИмяДок + " КАК Док
    |        ПО ТЧ.Ссылка = Док.Ссылка
    |ГДЕ
    |    Док.Дата МЕЖДУ &ДатаС И &ДатаПо
    |    И Док.Проведен = ИСТИНА
    |    И Док.ПометкаУдаления = ЛОЖЬ
    |    И ТЧ." + Карта.ИмяИсп + " <> НЕОПРЕДЕЛЕНО
    |    И ТЧ." + Карта.ИмяИсп + ".Код <> """"";
    Если НЕ ПустаяСтрока(КодФильтр) Тогда
        Текст = Текст + "
    |    И ТЧ." + Карта.ИмяИсп + ".Код = &КодСотрудника";
    КонецЕсли;
    Текст = Текст + "
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата УБЫВ,
    |    Док.Номер,
    |    ТЧ.НомерСтроки";

    Запрос = Новый Запрос;
    Запрос.Текст = Текст;
    Запрос.УстановитьПараметр("ДатаС", ДатаС);
    Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
    Если НЕ ПустаяСтрока(КодФильтр) Тогда
        Запрос.УстановитьПараметр("КодСотрудника", КодФильтр);
    КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    // Ссылки документов для пакетной проверки долга по расчётам (если нет явной оплаты).
    ДокументыБезФлага = Новый Массив;
    УжеДок = Новый Соответствие;
    Буфер = Новый Массив;

    Пока Выборка.Следующий() Цикл
        ИмяСотр = СокрЛП(Строка(Выборка.ИмяИсполнителя));
        Если ПустаяСтрока(ИмяСотр) Или ИмяСотр = "-" Или ИмяСотр = "- -"
            Или СтрНайти(ВРег(ИмяСотр), "УНИВЕРСАЛЬН") > 0 Тогда
            Продолжить;
        КонецЕсли;

        Сумма = 0;
        Попытка
            Сумма = Число(Выборка.СуммаСтроки);
        Исключение
        КонецПопытки;
        Если Сумма <= 0 Тогда
            Попытка
                Цена = Число(Выборка.Цена);
                Кол = Число(Выборка.Количество);
                Если Цена > 0 Тогда
                    Сумма = Цена * ?(Кол > 0, Кол, 1);
                КонецЕсли;
            Исключение
            КонецПопытки;
        КонецЕсли;

        ExtId = "";
        Если ЗначениеЗаполнено(Выборка.Клиент) Тогда
            Попытка
                ExtId = Строка(Выборка.Клиент.УникальныйИдентификатор());
            Исключение
                Попытка
                    ExtId = FitGOIntegrationОбщегоНазначения.UUIDСсылка(Выборка.Клиент);
                Исключение
                КонецПопытки;
            КонецПопытки;
        КонецЕсли;

        СтатусОплаты = СтатусОплатыИзПолейПродажи(
            Выборка.Оплачен, Выборка.СуммаДокумента, Выборка.СуммаОплаты);

        СтрБуф = Новый Структура;
        СтрБуф.Вставить("Ссылка", Выборка.Ссылка);
        СтрБуф.Вставить("Клиент", Выборка.Клиент);
        СтрБуф.Вставить("externalId", ExtId);
        СтрБуф.Вставить("clientName", ?(ПустаяСтрока(СокрЛП(Строка(Выборка.ИмяКлиента))), "—", СокрЛП(Строка(Выборка.ИмяКлиента))));
        СтрБуф.Вставить("serviceName", ?(ПустаяСтрока(СокрЛП(Строка(Выборка.ИмяУслуги))), "Услуга", СокрЛП(Строка(Выборка.ИмяУслуги))));
        СтрБуф.Вставить("occurredAt", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
        СтрБуф.Вставить("amount", Сумма);
        СтрБуф.Вставить("employeeCode", СокрЛП(Строка(Выборка.КодИсполнителя)));
        СтрБуф.Вставить("employeeName", ИмяСотр);
        СтрБуф.Вставить("docRef", Строка(Выборка.Номер) + "#" + Формат(Выборка.НомерСтроки, "ЧГ=0"));
        СтрБуф.Вставить("paymentStatus", СтатусОплаты);
        СтрБуф.Вставить("нуженОстаток", СтатусОплаты = "");
        Буфер.Добавить(СтрБуф);

        Если СтатусОплаты = "" И УжеДок.Получить(Выборка.Ссылка) = Неопределено Тогда
            УжеДок.Вставить(Выборка.Ссылка, Истина);
            ДокументыБезФлага.Добавить(Выборка.Ссылка);
        КонецЕсли;
    КонецЦикла;

    ДолгиПоДок = ОстаткиДолгаПоДокументамПродажи(ДокументыБезФлага);
    // Если измерение регистра не совпало — карта пустая; тогда долг клиента (кэш).
    ДолгиПоКлиенту = Новый Соответствие;

    Для Каждого СтрБуф Из Буфер Цикл
        Статус = СтрБуф.paymentStatus;
        Если СтрБуф.нуженОстаток Тогда
            Остаток = ДолгиПоДок.Получить(СтрБуф.Ссылка);
            Если Остаток <> Неопределено Тогда
                Если Число(Остаток) > 0.01 Тогда
                    Статус = "DEBT";
                Иначе
                    Статус = "PAID";
                КонецЕсли;
            Иначе
                Статус = СтатусОплатыПоДолгуКлиентаКэш(СтрБуф.Клиент, ДолгиПоКлиенту);
            КонецЕсли;
        КонецЕсли;

        СтрокаJSON = Новый Структура;
        СтрокаJSON.Вставить("externalId", СтрБуф.externalId);
        СтрокаJSON.Вставить("clientName", СтрБуф.clientName);
        СтрокаJSON.Вставить("serviceName", СтрБуф.serviceName);
        СтрокаJSON.Вставить("occurredAt", СтрБуф.occurredAt);
        СтрокаJSON.Вставить("amount", СтрБуф.amount);
        СтрокаJSON.Вставить("currency", "BYN");
        СтрокаJSON.Вставить("employeeCode", СтрБуф.employeeCode);
        СтрокаJSON.Вставить("employeeName", СтрБуф.employeeName);
        СтрокаJSON.Вставить("docRef", СтрБуф.docRef);
        СтрокаJSON.Вставить("paymentStatus", Статус);
        Результат.Добавить(СтрокаJSON);
    КонецЦикла;

    Возврат Результат;
КонецФункции

// Разовые ПТ из Документ.Продажа с заполненным Исполнителем (оказаны при продаже).
// Без фильтра по сотруднику — только строки, похожие на персональную тренировку.
// Query period ≤ 31 day. Response: array like specialist-service-debts.
Функция ПродажиПтИсполнителейJSON(FromStr, ToStr) Экспорт

    Результат = Новый Массив;

    ДатаС = Дата(1, 1, 1);
    ДатаПо = Дата(1, 1, 1);
    Попытка
        ЧастиС = СтрРазделить(СокрЛП(Строка(FromStr)), "-");
        Если ЧастиС.Количество() >= 3 Тогда
            ДатаС = Дата(Число(ЧастиС[0]), Число(ЧастиС[1]), Число(ЧастиС[2]));
        КонецЕсли;
        ЧастиПо = СтрРазделить(СокрЛП(Строка(ToStr)), "-");
        Если ЧастиПо.Количество() >= 3 Тогда
            ДатаПо = Дата(Число(ЧастиПо[0]), Число(ЧастиПо[1]), Число(ЧастиПо[2]));
            ДатаПо = КонецДня(ДатаПо);
        КонецЕсли;
    Исключение
        Возврат Результат;
    КонецПопытки;
    Если ДатаС = Дата(1, 1, 1) Или ДатаПо = Дата(1, 1, 1) Тогда
        Возврат Результат;
    КонецЕсли;
    Если ДатаПо < ДатаС Тогда
        Возврат Результат;
    КонецЕсли;
    Если (НачалоДня(ДатаПо) - НачалоДня(ДатаС)) > 30 * 86400 Тогда
        Возврат Результат;
    КонецЕсли;

    Для Каждого ДокМд Из МетаданныеДокументовПродажиСпециалистов() Цикл
        Карта = КартаПолейТЧПродажиСпециалиста(ДокМд);
        Если Карта = Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Строки = ВыбратьСтрокиПродажСпециалистовЗапросом(ДокМд, Карта, ДатаС, ДатаПо, "");
        Исключение
            Продолжить;
        КонецПопытки;
        Для Каждого СтрокаJSON Из Строки Цикл
            ИмяУсл = "";
            Попытка
                ИмяУсл = НРег(СокрЛП(Строка(СтрокаJSON.serviceName)));
            Исключение
            КонецПопытки;
            Если НЕ ЭтоНазваниеПерсональнойТренировки(ИмяУсл) Тогда
                Продолжить;
            КонецЕсли;
            Если СтрНайти(ИмяУсл, "соляр") > 0 Тогда
                Продолжить;
            КонецЕсли;
            Результат.Добавить(СтрокаJSON);
        КонецЦикла;
    КонецЦикла;

    Возврат Результат;
КонецФункции

Функция ЭтоНазваниеПерсональнойТренировки(ИмяНрег)
    С = СокрЛП(Строка(ИмяНрег));
    Если ПустаяСтрока(С) Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрНайти(С, "соляр") > 0 Или СтрНайти(С, "массаж") > 0
        Или СтрНайти(С, "абонемент") > 0 Или СтрНайти(С, "вип") > 0 Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрНайти(С, "тренер") > 0 Или СтрНайти(С, "персонал") > 0
        Или СтрНайти(С, "индивидуал") > 0 Или СтрНайти(С, "занятие с") > 0
        Или СтрНайти(С, "персональн") > 0 Или СтрНайти(С, "индив") > 0
        Или С = "пт" Или Лев(С, 3) = "пт " Или СтрНайти(С, " пт") > 0 Тогда
        Возврат Истина;
    КонецЕсли;
    Возврат Ложь;
КонецФункции

// Кэш: один вызов СчетаИДолгиКлиента на клиента за прогон отчёта.
Функция СтатусОплатыПоДолгуКлиентаКэш(Клиент, КэшДолгов)

    Если НЕ ЗначениеЗаполнено(Клиент) Тогда
        Возврат "PAID";
    КонецЕсли;
    Зн = КэшДолгов.Получить(Клиент);
    Если Зн = Неопределено Тогда
        Долг = 0;
        Попытка
            Деньги = СчетаИДолгиКлиента(Клиент);
            Если Деньги.debtAmount <> Неопределено Тогда
                Долг = Число(Деньги.debtAmount);
            КонецЕсли;
        Исключение
            Долг = 0;
        КонецПопытки;
        КэшДолгов.Вставить(Клиент, Долг);
        Зн = Долг;
    КонецЕсли;
    Если Число(Зн) > 0.01 Тогда
        Возврат "DEBT";
    КонецЕсли;
    Возврат "PAID";
КонецФункции

// "" = не удалось определить по полям документа → смотреть остаток по расчётам.
Функция СтатусОплатыИзПолейПродажи(Оплачен, СуммаДокумента, СуммаОплаты)

    Если ТипЗнч(Оплачен) = Тип("Булево") Тогда
        Возврат ?(Оплачен, "PAID", "DEBT");
    КонецЕсли;
    Если Оплачен <> Неопределено И Оплачен <> NULL Тогда
        СтрСт = ВРег(СокрЛП(Строка(Оплачен)));
        Если НЕ ПустаяСтрока(СтрСт) Тогда
            Если СтрНайти(СтрСт, "НЕ ОПЛАЧ") > 0 Или СтрНайти(СтрСт, "ДОЛГ") > 0
                Или СтрНайти(СтрСт, "ЧАСТИЧ") > 0 Тогда
                Возврат "DEBT";
            КонецЕсли;
            Если СтрНайти(СтрСт, "ОПЛАЧ") > 0 Или СтрНайти(СтрСт, "PAID") > 0 Тогда
                Возврат "PAID";
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    СуммаДок = 0;
    Попытка
        Если СуммаДокумента <> Неопределено И СуммаДокумента <> NULL Тогда
            СуммаДок = Число(СуммаДокумента);
        КонецЕсли;
    Исключение
    КонецПопытки;

    Если СуммаОплаты <> Неопределено И СуммаОплаты <> NULL Тогда
        СуммаОпл = 0;
        Попытка
            СуммаОпл = Число(СуммаОплаты);
        Исключение
            СуммаОпл = 0;
        КонецПопытки;
        Если СуммаДок > 0 Тогда
            Если СуммаОпл + 0.01 >= СуммаДок Тогда
                Возврат "PAID";
            КонецЕсли;
            Возврат "DEBT";
        КонецЕсли;
    КонецЕсли;

    Возврат "";
КонецФункции

// Пакетно: остаток долга по документам продажи (измерение Документ/ДокументРасчетов и т.п.).
Функция ОстаткиДолгаПоДокументамПродажи(СписокДокументов)

    Карта = Новый Соответствие;
    Если СписокДокументов = Неопределено Или СписокДокументов.Количество() = 0 Тогда
        Возврат Карта;
    КонецЕсли;

    ИменаИзм = Новый Массив;
    ИменаИзм.Добавить("ДокументРасчетов");
    ИменаИзм.Добавить("Документ");
    ИменаИзм.Добавить("Сделка");
    ИменаИзм.Добавить("Заказ");
    Попытка
        Мд = Метаданные.РегистрыНакопления.РасчетыСПокупателями;
        Для Каждого Изм Из Мд.Измерения Цикл
            ИмяВерх = ВРег(Изм.Имя);
            Если СтрНайти(ИмяВерх, "ДОКУМЕНТ") > 0 Или СтрНайти(ИмяВерх, "СДЕЛК") > 0 Или СтрНайти(ИмяВерх, "ЗАКАЗ") > 0 Тогда
                Если НЕ ИмяУжеВМассиве(ИменаИзм, Изм.Имя) Тогда
                    ИменаИзм.Добавить(Изм.Имя);
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    Исключение
    КонецПопытки;

    Для Каждого ИмяИзм Из ИменаИзм Цикл
        Текст =
        "ВЫБРАТЬ
        |    Остатки." + ИмяИзм + " КАК Документ,
        |    СУММА(Остатки.СуммаОстаток) КАК Остаток
        |ИЗ
        |    РегистрНакопления.РасчетыСПокупателями.Остатки(, " + ИмяИзм + " В (&Документы)) КАК Остатки
        |СГРУППИРОВАТЬ ПО
        |    Остатки." + ИмяИзм;
        Запрос = Новый Запрос;
        Запрос.Текст = Текст;
        Запрос.УстановитьПараметр("Документы", СписокДокументов);
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
            Пока Выборка.Следующий() Цикл
                Если НЕ ЗначениеЗаполнено(Выборка.Документ) Тогда
                    Продолжить;
                КонецЕсли;
                Ост = 0;
                Попытка
                    Ост = Число(Выборка.Остаток);
                Исключение
                КонецПопытки;
                // Долг клиента обычно отрицательный остаток → берём модуль; либо положительный «наш долг им» не считаем.
                Если Ост < 0 Тогда
                    Карта.Вставить(Выборка.Документ, -Ост);
                ИначеЕсли Ост > 0 Тогда
                    Карта.Вставить(Выборка.Документ, Ост);
                Иначе
                    Карта.Вставить(Выборка.Документ, 0);
                КонецЕсли;
            КонецЦикла;
            Если Карта.Количество() > 0 Тогда
                Возврат Карта;
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Возврат Карта;
КонецФункции

// Отмена SPA-записи FitGO: найти Документ.Занятие по bookingRef в комментарии,
// отменить проведение (возврат движений квоты) и поставить статус «Отменено».
Функция ОтменитьFitGOSpaЗанятие(Контрагент, BookingRef) Экспорт

    Ответ = Новый Структура("ok,error,membership,num", Ложь, "", Неопределено, "");
    Ref = СокрЛП(Строка(BookingRef));
    Если ПустаяСтрока(Ref) Тогда
        Ответ.error = "bookingRef required";
        Возврат Ответ;
    КонецЕсли;

    ДокМд = НайтиМетаданныеПосещенияСалона();
    Если ДокМд = Неопределено Тогда
        Ответ.error = "Документ.Занятие not found";
        Возврат Ответ;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 5
    |    Док.Ссылка КАК Ссылка,
    |    Док.Номер КАК Номер,
    |    Док.Дата КАК Дата
    |ИЗ
    |    Документ." + ДокМд.Имя + " КАК Док
    |ГДЕ
    |    Док.Комментарий ПОДОБНО &Коммент
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата УБЫВ";
    Запрос.УстановитьПараметр("Коммент", "%bookingRef=" + Ref + "%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Ответ.error = FitGOКраткоОшибку(ИнформацияОбОшибке());
        Возврат Ответ;
    КонецПопытки;

    Если НЕ Выборка.Следующий() Тогда
        Ответ.error = "FitGO SPA visit not found for bookingRef=" + Ref;
        Возврат Ответ;
    КонецЕсли;

    Попытка
        Док = Выборка.Ссылка.ПолучитьОбъект();
        Ответ.num = Строка(Выборка.Номер);

        // Статус «Отменено» (как в UI салона)
        УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "СтатусЗанятия", "Отменено");
        Если НЕ ЗначениеЗаполнено(Док.СтатусЗанятия) Тогда
            УстановитьЗначениеПеречисленияПоИмени(Док, ДокМд, "СтатусЗанятия", "Отменен");
        КонецЕсли;

        Попытка
            Док.Комментарий = СокрЛП(Строка(Док.Комментарий)) + " | cancelled by FitGO";
        Исключение
        КонецПопытки;

        Если Док.Проведен Тогда
            Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
        Иначе
            Док.Записать(РежимЗаписиДокумента.Запись);
        КонецЕсли;
    Исключение
        Ответ.error = "Cancel visit failed: " + FitGOКраткоОшибку(ИнформацияОбОшибке());
        Возврат Ответ;
    КонецПопытки;

    Ответ.ok = Истина;
    Ответ.membership = АктивныйАбонементJSON(Контрагент);
    Возврат Ответ;
КонецФункции

// Битые FitGO SPA «Занятие»: пустой СоставЗанятия → форма салона падает на [0].
// Чистит объектным API (без открытия формы). Вызов из консоли:
//   Сообщить(FitGOIntegrationКлиенты.ОчиститьБитыеFitGOSpaЗанятия());
Функция ОчиститьБитыеFitGOSpaЗанятия(Контрагент = Неопределено) Экспорт

    Результат = Новый Структура("ok,marked,skipped,error", Ложь, 0, 0, "");
    ДокМд = НайтиМетаданныеПосещенияСалона();
    Если ДокМд = Неопределено Тогда
        Результат.error = "Документ.Занятие not found";
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Если Контрагент = Неопределено Тогда
        Запрос.Текст =
        "ВЫБРАТЬ
        |    Док.Ссылка КАК Ссылка
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |ГДЕ
        |    Док.Комментарий ПОДОБНО &Коммент";
    Иначе
        Запрос.Текст =
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    Док.Ссылка КАК Ссылка
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |        ЛЕВОЕ СОЕДИНЕНИЕ Документ." + ДокМд.Имя + ".СоставЗанятия КАК Стр
        |        ПО Стр.Ссылка = Док.Ссылка
        |ГДЕ
        |    Док.Комментарий ПОДОБНО &Коммент
        |    И (Стр.Контрагент = &Контрагент ИЛИ Стр.Контрагент ЕСТЬ NULL)";
        Запрос.УстановитьПараметр("Контрагент", Контрагент);
    КонецЕсли;
    Запрос.УстановитьПараметр("Коммент", "%FitGO SPA%");

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        // Без соединения по ТЧ — только по комментарию
        Запрос.Текст =
        "ВЫБРАТЬ
        |    Док.Ссылка КАК Ссылка
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |ГДЕ
        |    Док.Комментарий ПОДОБНО &Коммент";
        Запрос.УстановитьПараметр("Коммент", "%FitGO SPA%");
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
        Исключение
            Результат.error = FitGOКраткоОшибку(ИнформацияОбОшибке());
            Возврат Результат;
        КонецПопытки;
    КонецПопытки;

    Пока Выборка.Следующий() Цикл
        Попытка
            Док = Выборка.Ссылка.ПолучитьОбъект();
            // Удаляем ВСЕ FitGO SPA-пробы: нулевой UUID / пометка удаления / пустая ТЧ
            // ломают форму салона; стандартное «Удаление помеченных» открывает форму → краш.
            Битый = Ложь;
            Попытка
                Битый = (Док.СоставЗанятия.Количество() < 1);
            Исключение
                Битый = Истина;
            КонецПопытки;
            Попытка
                ИдСтр = Строка(Док.ИдентификаторЗанятия);
                Если ПустаяСтрока(ИдСтр)
                    ИЛИ СтрНачинаетсяС(ИдСтр, "00000000") Тогда
                    Битый = Истина;
                КонецЕсли;
            Исключение
            КонецПопытки;
            Попытка
                Если Док.ПометкаУдаления Тогда
                    Битый = Истина;
                КонецЕсли;
            Исключение
            КонецПопытки;
            // Все probe-* тоже сносим (тест), даже если выглядят «целыми».
            Попытка
                Если СтрНайти(Строка(Док.Комментарий), "bookingRef=probe-") > 0 Тогда
                    Битый = Истина;
                КонецЕсли;
            Исключение
            КонецПопытки;
            Если НЕ Битый Тогда
                Результат.skipped = Результат.skipped + 1;
                Продолжить;
            КонецЕсли;
            Если Док.Проведен Тогда
                Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
            КонецЕсли;
            Док.Удалить();
            Результат.marked = Результат.marked + 1;
        Исключение
            Попытка
                Док.УстановитьПометкуУдаления(Истина);
            Исключение
            КонецПопытки;
            Результат.skipped = Результат.skipped + 1;
        КонецПопытки;
    КонецЦикла;

    Результат.ok = Истина;
    Возврат Результат;
КонецФункции

// Диагностика: дамп салонных «Занятий» (реальные ручные vs FitGO SPA) для сравнения,
// почему ФормаПосещенияСалонаКрасоты падает на Занятие.СоставЗанятия[0].
Функция ДампСалонныхЗанятийJSON(Контрагент = Неопределено) Экспорт

    Результат = Новый Структура("ok,docType,tabularSections,docs,error", Ложь, "", Новый Массив, Новый Массив, "");
    ДокМд = НайтиМетаданныеПосещенияСалона();
    Если ДокМд = Неопределено Тогда
        Результат.error = "Документ.Занятие not found";
        Возврат Результат;
    КонецЕсли;
    Результат.docType = ДокМд.Имя;

    Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
        Результат.tabularSections.Добавить(ТЧ.Имя);
    КонецЦикла;

    // 1) Все FitGO SPA (включая помеченные на удаление)
    // 2) Несколько свежих любых (для сравнения)
    Запросы = Новый Массив;
    Запросы.Добавить(
        "ВЫБРАТЬ ПЕРВЫЕ 30
        |    Док.Ссылка КАК Ссылка,
        |    Док.Дата КАК Дата,
        |    Док.Номер КАК Номер,
        |    Док.Комментарий КАК Комментарий,
        |    Док.Проведен КАК Проведен,
        |    Док.ПометкаУдаления КАК ПометкаУдаления
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |ГДЕ
        |    Док.Комментарий ПОДОБНО &Коммент
        |УПОРЯДОЧИТЬ ПО
        |    Док.Дата УБЫВ");
    // Ручной эталон: 00000111666 (массаж админом)
    Запросы.Добавить(
        "ВЫБРАТЬ ПЕРВЫЕ 5
        |    Док.Ссылка КАК Ссылка,
        |    Док.Дата КАК Дата,
        |    Док.Номер КАК Номер,
        |    Док.Комментарий КАК Комментарий,
        |    Док.Проведен КАК Проведен,
        |    Док.ПометкаУдаления КАК ПометкаУдаления
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |ГДЕ
        |    Док.Номер = &НомерЭталон
        |    ИЛИ Док.Номер ПОДОБНО &НомерМаска");
    Запросы.Добавить(
        "ВЫБРАТЬ ПЕРВЫЕ 15
        |    Док.Ссылка КАК Ссылка,
        |    Док.Дата КАК Дата,
        |    Док.Номер КАК Номер,
        |    Док.Комментарий КАК Комментарий,
        |    Док.Проведен КАК Проведен,
        |    Док.ПометкаУдаления КАК ПометкаУдаления
        |ИЗ
        |    Документ." + ДокМд.Имя + " КАК Док
        |УПОРЯДОЧИТЬ ПО
        |    Док.Дата УБЫВ");

    Уже = Новый Соответствие;
    ВзятоFitGO = 0;
    ВзятоСалон = 0;
    ВзятоЛюбых = 0;
    ОшибкиЗапросов = Новый Массив;

    Для Индекс = 0 По Запросы.ВГраница() Цикл
        Запрос = Новый Запрос;
        Запрос.Текст = Запросы[Индекс];
        Если Индекс = 0 Тогда
            Запрос.УстановитьПараметр("Коммент", "%FitGO SPA%");
        ИначеЕсли Индекс = 1 Тогда
            Запрос.УстановитьПараметр("НомерЭталон", "00000111666");
            Запрос.УстановитьПараметр("НомерМаска", "%111666%");
        КонецЕсли;
        Попытка
            Выборка = Запрос.Выполнить().Выбрать();
        Исключение
            ОшибкиЗапросов.Добавить(Строка(Индекс) + ":" + FitGOКраткоОшибку(ИнформацияОбОшибке()));
            Продолжить;
        КонецПопытки;

        Пока Выборка.Следующий() Цикл
            Ключ = Строка(Выборка.Ссылка);
            Если Уже.Получить(Ключ) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;

            Попытка
                Об = Выборка.Ссылка.ПолучитьОбъект();
            Исключение
                Продолжить;
            КонецПопытки;

            Комм = "";
            Попытка
                Комм = Строка(Выборка.Комментарий);
            Исключение
                Попытка
                    Комм = Строка(Об.Комментарий);
                Исключение
                КонецПопытки;
            КонецПопытки;
            ЭтоFitGO = (СтрНайти(Комм, "FitGO SPA") > 0);

            ТипСтр = "";
            Попытка
                ТипСтр = Строка(Об.ТипЗанятия);
            Исключение
            КонецПопытки;
            ЭтоСалон = (СтрНайти(ВРег(ТипСтр), "САЛОН") > 0)
                ИЛИ (СтрНайти(ВРег(ТипСтр), "КРАСОТ") > 0);

            Брать = Ложь;
            Если ЭтоFitGO Тогда
                Если ВзятоFitGO < 15 Тогда
                    Брать = Истина;
                    ВзятоFitGO = ВзятоFitGO + 1;
                КонецЕсли;
            ИначеЕсли ЭтоСалон ИЛИ СтрНайти(Строка(Выборка.Номер), "111666") > 0 Тогда
                Если ВзятоСалон < 8 Тогда
                    Брать = Истина;
                    ВзятоСалон = ВзятоСалон + 1;
                КонецЕсли;
            ИначеЕсли ВзятоЛюбых < 5 Тогда
                Брать = Истина;
                ВзятоЛюбых = ВзятоЛюбых + 1;
            КонецЕсли;
            Если НЕ Брать Тогда
                Продолжить;
            КонецЕсли;
            Уже.Вставить(Ключ, Истина);

            Д = Новый Структура;
            Попытка
                Д.Вставить("num", Строка(Выборка.Номер));
            Исключение
            КонецПопытки;
            Д.Вставить("date", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
            Д.Вставить("isFitGO", ЭтоFitGO);
            Д.Вставить("isSalon", ЭтоСалон);
            Д.Вставить("type", ТипСтр);
            Д.Вставить("comment", Комм);
            Попытка
                Д.Вставить("posted", Выборка.Проведен);
            Исключение
            КонецПопытки;
            Попытка
                Д.Вставить("deletionMark", Выборка.ПометкаУдаления);
            Исключение
            КонецПопытки;

            Счётчики = Новый Структура;
            Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
                Попытка
                    Счётчики.Вставить(ТЧ.Имя, Об[ТЧ.Имя].Количество());
                Исключение
                КонецПопытки;
            КонецЦикла;
            Д.Вставить("tsCounts", Счётчики);

            СоставМассив = Новый Массив;
            Попытка
                Для Каждого Стр Из Об.СоставЗанятия Цикл
                    Р = Новый Структура;
                    Для Каждого Рекв Из ДокМд.ТабличныеЧасти.СоставЗанятия.Реквизиты Цикл
                        Попытка
                            Р.Вставить(Рекв.Имя, Строка(Стр[Рекв.Имя]));
                        Исключение
                        КонецПопытки;
                    КонецЦикла;
                    СоставМассив.Добавить(Р);
                КонецЦикла;
            Исключение
                Д.Вставить("составErr", FitGOКраткоОшибку(ИнформацияОбОшибке()));
            КонецПопытки;
            Д.Вставить("составЗанятия", СоставМассив);

            Шапка = Новый Структура;
            Для Каждого ИмяРекв Из СтрРазделить(
                "Номенклатура,Сотрудник,Помещение,ИдентификаторЗанятия,СтатусЗанятия,ТипСписания,ДатаВремяНачала,ДатаВремяОкончания,КоличествоОказываемыхУслуг,ЗаписьСалонаПодтверждена,ВсегоКлиентовЗаписано,ВсегоКлиентовПосетило",
                ",") Цикл
                Попытка
                    Шапка.Вставить(ИмяРекв, Строка(Об[ИмяРекв]));
                Исключение
                КонецПопытки;
            КонецЦикла;
            Д.Вставить("header", Шапка);

            Результат.docs.Добавить(Д);
        КонецЦикла;
    КонецЦикла;

    Результат.Вставить("takenFitGO", ВзятоFitGO);
    Результат.Вставить("takenSalon", ВзятоСалон);
    Результат.Вставить("takenOther", ВзятоЛюбых);
    Результат.Вставить("queryErrors", ОшибкиЗапросов);
    Результат.ok = Истина;
    Возврат Результат;
КонецФункции

Процедура УстановитьПризнакиВыполненоБулево(Док, ДокМд)
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ВЫПОЛН") = 0 И СтрНайти(ИмяВерх, "ЗАВЕРШ") = 0
            И СтрНайти(ИмяВерх, "ПРОВЕД") = 0 Тогда
            Продолжить;
        КонецЕсли;
        Попытка
            Если Рекв.Тип.СодержитТип(Тип("Булево")) Тогда
                Док[Рекв.Имя] = Истина;
            КонецЕсли;
        Исключение
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьКлиентаВТЧЕслиЕсть(Док, ДокМд, Контрагент)
    Попытка
        Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
            ИмяТЧ = ВРег(ТЧ.Имя);
            Если СтрНайти(ИмяТЧ, "КЛИЕНТ") = 0 И СтрНайти(ИмяТЧ, "УЧАСТНИК") = 0
                И СтрНайти(ИмяТЧ, "СОСТАВ") = 0 Тогда
                Продолжить;
            КонецЕсли;
            Если СтрНайти(ИмяТЧ, "УСЛУГ") > 0 Тогда
                Продолжить;
            КонецЕсли;
            СтрокаТЧ = Док[ТЧ.Имя].Добавить();
            ЗаполнитьРеквизитСтрокиТЧПоМаске(СтрокаТЧ, ТЧ, "КОНТРАГЕНТ,КЛИЕНТ", Контрагент);
            Возврат;
        КонецЦикла;
    Исключение
    КонецПопытки;
КонецПроцедуры

Функция ДампСтруктурыДокумента(ДокМд)
    Части = Новый Массив;
    Попытка
        РеквИмена = Новый Массив;
        Для Каждого Рекв Из ДокМд.Реквизиты Цикл
            РеквИмена.Добавить(Рекв.Имя);
        КонецЦикла;
        Части.Добавить("attrs=" + СтрСоединить(РеквИмена, ","));
        ТЧИмена = Новый Массив;
        Для Каждого ТЧ Из ДокМд.ТабличныеЧасти Цикл
            Колонки = Новый Массив;
            Для Каждого Рекв Из ТЧ.Реквизиты Цикл
                Колонки.Добавить(Рекв.Имя);
            КонецЦикла;
            ТЧИмена.Добавить(ТЧ.Имя + "[" + СтрСоединить(Колонки, ",") + "]");
        КонецЦикла;
        Части.Добавить("ts=" + СтрСоединить(ТЧИмена, ";"));
    Исключение
        Возврат "dump-failed";
    КонецПопытки;
    Возврат СтрСоединить(Части, " | ");
КонецФункции

Функция ДампПеречисленийВидов(ДокМд)
    Части = Новый Массив;
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ВИД") = 0 И СтрНайти(ИмяВерх, "ТИП") = 0
            И СтрНайти(ИмяВерх, "СТАТУС") = 0 Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого Тип Из Рекв.Тип.Типы() Цикл
            Попытка
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                ИменаЗн = Новый Массив;
                Для Каждого ЗнПереч Из МдПереч.ЗначенияПеречисления Цикл
                    ИменаЗн.Добавить(ЗнПереч.Имя);
                КонецЦикла;
                Части.Добавить(Рекв.Имя + ":" + СтрСоединить(ИменаЗн, "/"));
            Исключение
            КонецПопытки;
        КонецЦикла;
    КонецЦикла;
    Если Части.Количество() = 0 Тогда
        Возврат "(none)";
    КонецЕсли;
    Возврат СтрСоединить(Части, "; ");
КонецФункции

Функция ОписаниеДокументаПоНомеру(НомерДок)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Занятие.Ссылка КАК Ссылка,
    |    Занятие.Номер КАК Номер,
    |    Занятие.Дата КАК Дата,
    |    ПРЕДСТАВЛЕНИЕ(ТИПЗНАЧЕНИЯ(Занятие.Ссылка)) КАК ТипПредст
    |ИЗ
    |    Документ.Занятие КАК Занятие
    |ГДЕ
    |    Занятие.Номер ПОДОБНО &Номер";
    Запрос.УстановитьПараметр("Номер", "%" + СокрЛП(НомерДок) + "%");
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Если Выборка.Следующий() Тогда
            Возврат Выборка.ТипПредст + "#" + Строка(Выборка.Номер)
                + "@" + Формат(Выборка.Дата, "ДФ=yyyy-MM-dd");
        КонецЕсли;
    Исключение
        Возврат "query-failed";
    КонецПопытки;
    Возврат "not-found";
КонецФункции

Процедура УстановитьСтатусВыполненоСалон(Док, ДокМд)

    Ключи = Новый Массив;
    Ключи.Добавить("ВЫПОЛН");
    Ключи.Добавить("ЗАВЕРШ");

    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "СТАТУС") = 0 И СтрНайти(ИмяВерх, "СОСТОЯН") = 0 Тогда
            Продолжить;
        КонецЕсли;
        Для Каждого Тип Из Рекв.Тип.Типы() Цикл
            Попытка
                МдПереч = Метаданные.НайтиПоТипу(Тип);
                Если МдПереч = Неопределено Тогда
                    Продолжить;
                КонецЕсли;
                Для Каждого Зн Из МдПереч.ЗначенияПеречисления Цикл
                    ИмяЗн = ВРег(Зн.Имя);
                    СинЗн = ВРег(Зн.Синоним);
                    Для Каждого К Из Ключи Цикл
                        Если СтрНайти(ИмяЗн, К) > 0 ИЛИ СтрНайти(СинЗн, К) > 0 Тогда
                            Док[Рекв.Имя] = Перечисления[МдПереч.Имя][Зн.Имя];
                            Возврат;
                        КонецЕсли;
                    КонецЦикла;
               КонецЦикла;
            Исключение
            КонецПопытки;
       КонецЦикла;
   КонецЦикла;

КонецПроцедуры

// Вид услуги на карточке = «Салон» — проставляем в документ занятия, если есть такой реквизит/перечисление.
Процедура УстановитьВидУслугиСалон(Док, ДокМд)

    Ключи = Новый Массив;
