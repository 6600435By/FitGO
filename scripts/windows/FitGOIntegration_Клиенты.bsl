Процедура ЗаполнитьРеквизитДокументаПоМаскеТип(Док, ДокМд, МаскаВерх, Значение)

    Маски = СтрРазделить(МаскаВерх, ",");
    Для Каждого Рекв Из ДокМд.Реквизиты Цикл
        ИмяВерх = ВРег(Рекв.Имя);
        Если СтрНайти(ИмяВерх, "ПРИЗНАК") > 0 Тогда
            Продолжить; // не писать строки/ссылки в булевы «Признак*»
        КонецЕсли;
        Для Каждого М Из Маски Цикл
            М = СокрЛП(М);
            Если СтрНайти(ИмяВерх, М) > 0 Тогда
                Если НЕ РеквизитСовместимСоЗначением(Рекв, Значение) Тогда
                    Продолжить;
                КонецЕсли;
                Попытка
                    Док[Рекв.Имя] = Значение;
                    Возврат;
                Исключение
                КонецПопытки;
            КонецЕсли;
       КонецЦикла;
   КонецЦикла;

