Функция АгрегатДняВJSON(Агрегат)
    Элемент = Новый Структура;
    Элемент.Вставить("date", Агрегат.date);
    Элемент.Вставить("salesCount", Агрегат.salesCount);
    Элемент.Вставить("grossAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Агрегат.grossAmount));
    Элемент.Вставить("refundAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Агрегат.refundAmount));
    Элемент.Вставить("netAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Агрегат.grossAmount - Агрегат.refundAmount));
    Элемент.Вставить("bySaleType", ОкруглитьСтруктуруДенег(Агрегат.bySaleType));
    Возврат Элемент;
КонецФункции

Функция ОкруглитьСтруктуруДенег(СтруктураДенег)
    Результат = Новый Структура;
    Для Каждого КлючИЗначение Из СтруктураДенег Цикл
        Результат.Вставить(КлючИЗначение.Ключ, FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(КлючИЗначение.Значение));
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Сотрудник с документа оплаты/продажи: Сотрудник → Ответственный → Автор.
Функция СотрудникИзДокумента(ДокументСсылка)
    Результат = Новый Структура("Код,Имя", "", "");
    Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
        Возврат Результат;
    КонецЕсли;
    Сотр = Неопределено;
    Попытка
        Сотр = ДокументСсылка.Сотрудник;
    Исключение
    КонецПопытки;
    Если НЕ ЗначениеЗаполнено(Сотр) Тогда
        Попытка
            Сотр = ДокументСсылка.Ответственный;
        Исключение
        КонецПопытки;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Сотр) Тогда
        Попытка
            Сотр = ДокументСсылка.Автор;
        Исключение
        КонецПопытки;
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Сотр) Тогда
        Возврат Результат;
    КонецЕсли;
    Попытка
        Результат.Код = СокрЛП(Строка(Сотр.Код));
    Исключение
        Результат.Код = "";
    КонецПопытки;
    Результат.Имя = Строка(Сотр);
    Возврат Результат;
КонецФункции

Функция СоответствиеВСтруктуруДенег(СоответствиеДенег)
    Результат = Новый Структура;
    Для Каждого Пара Из СоответствиеДенег Цикл
        Результат.Вставить(Пара.Ключ, FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Пара.Значение));
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Уникальные клиенто-дни входа в зал (Документ.Посещение), не SPA/ПТ.
// Пара (Контрагент, календарный день ДатаПрихода) — как «сколько людей × дней»,
// без двойного счёта нескольких документов входа за один день.
// FitGO обзор: fallback, если ClubHallVisit ещё пуст после sync.
Функция ПолучитьКоличествоПосещений(ДатаНачала, ДатаОкончания) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    КОЛИЧЕСТВО(*) КАК Количество
    |ИЗ
    |    (ВЫБРАТЬ РАЗЛИЧНЫЕ
    |        Посещение.Контрагент КАК Клиент,
    |        НАЧАЛОПЕРИОДА(Посещение.ДатаПрихода, ДЕНЬ) КАК День
    |    ИЗ
    |        Документ.Посещение КАК Посещение
    |    ГДЕ
    |        НЕ Посещение.ПометкаУдаления
    |        И НЕ Посещение.ПризнакОтменен
    |        И Посещение.ДатаПрихода >= &ДатаНачала
    |        И Посещение.ДатаПрихода <= &ДатаОкончания
    |        И Посещение.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
    |    ) КАК УникКлиентДень";
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    Выборка = Запрос.Выполнить().Выбрать();
    Количество = 0;
    Если Выборка.Следующий() И Выборка.Количество <> Null Тогда
        Количество = Выборка.Количество;
    КонецЕсли;
    Результат = Новый Структура;
    Результат.Вставить("count", Количество);
    Результат.Вставить("source", "Документ.Посещение");
    Результат.Вставить("metric", "unique_client_days");
    Возврат Результат;
КонецФункции

#КонецОбласти

// Рассрочки: открытые продажи (в FFS это Документ.Реализация, синоним «Продажа»).
// План — РегистрСведений.СхемыРассрочек (ДатаПлатежа / СуммаПлатежа, НеИспользовать),
// записи подчинены документу продажи.
// Факт — остаток долга по продаже в РасчетыСПокупателями (Долг + Рассрочка):
// оплачено = сумма графика − остаток, раскладывается по платежам от раннего к позднему.
// В ответ попадают только продажи с ненулевым остатком.
Функция ПолучитьРассрочки() Экспорт
    Мета = НайтиМетаданныеРассрочки();
    Результат = Новый Структура;
    Результат.Вставить("items", Новый Массив);
    Результат.Вставить("meta", Мета);
    Если НЕ Мета.ok Тогда
        Результат.Вставить("error", Мета.error);
        Возврат Результат;
    КонецЕсли;

    ПолеКлиент = "NULL";
    Если Мета.hasClient Тогда
        ПолеКлиент = "Док.Контрагент";
    КонецЕсли;
    ПолеШаблон = "NULL";
    Если НЕ ПустаяСтрока(Мета.attrTemplate) Тогда
        ПолеШаблон = "Док." + Мета.attrTemplate;
    КонецЕсли;
    УсловиеПропуска = "";
    Если НЕ ПустаяСтрока(Мета.colSkip) Тогда
        УсловиеПропуска = "
        |    И ЕСТЬNULL(С." + Мета.colSkip + ", ЛОЖЬ) = ЛОЖЬ";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.Основание КАК Продажа,
    |    -СУММА(Остатки.СуммаОстаток) КАК Долг
    |ПОМЕСТИТЬ ВТДолг
    |ИЗ
    |    РегистрНакопления.РасчетыСПокупателями.Остатки(
    |        &Момент,
    |        ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
    |            ИЛИ ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Рассрочка)) КАК Остатки
    |ГДЕ
    |    Остатки.Основание ССЫЛКА Документ." + Мета.document + "
    |
    |СГРУППИРОВАТЬ ПО
    |    Остатки.Основание
    |
    |ИМЕЮЩИЕ
    |    СУММА(Остатки.СуммаОстаток) < -0.009
    |
    |ИНДЕКСИРОВАТЬ ПО
    |    Продажа
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |    Док.Ссылка КАК Ссылка,
    |    Док.Номер КАК Номер,
    |    Док.Дата КАК Дата,
    |    " + ПолеКлиент + " КАК Контрагент,
    |    " + ПолеШаблон + " КАК Шаблон,
    |    ВТДолг.Долг КАК Долг,
    |    С." + Мета.colPlanDate + " КАК ДатаПлан,
    |    С." + Мета.colPlanAmount + " КАК СуммаПлан
    |ИЗ
    |    РегистрСведений." + Мета.register + " КАК С
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДолг КАК ВТДолг
    |        ПО С." + Мета.linkField + " = ВТДолг.Продажа
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ." + Мета.document + " КАК Док
    |        ПО (Док.Ссылка = ВТДолг.Продажа)
    |ГДЕ
    |    НЕ Док.ПометкаУдаления
    |    И Док.Проведен" + УсловиеПропуска + "
    |
    |УПОРЯДОЧИТЬ ПО
    |    Док.Дата,
    |    Док.Ссылка,
    |    ДатаПлан";
    Запрос.УстановитьПараметр("Момент", КонецДня(ТекущаяДатаСеанса()));
    Выборка = Запрос.Выполнить().Выбрать();

    Элементы = Новый Массив;
    ТекСсылка = Неопределено;
    Шапка = Неопределено;
    Строки = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Если Выборка.Ссылка <> ТекСсылка Тогда
            ДобавитьРассрочку(Элементы, Шапка, Строки);
            ТекСсылка = Выборка.Ссылка;
            Шапка = Новый Структура("Ссылка,Номер,Дата,Контрагент,Шаблон,Долг",
                Выборка.Ссылка, Выборка.Номер, Выборка.Дата, Выборка.Контрагент, Выборка.Шаблон,
                ?(Выборка.Долг = Null, 0, Выборка.Долг));
            Строки = Новый Массив;
        КонецЕсли;
        Если НЕ ЗначениеЗаполнено(Выборка.ДатаПлан) Тогда
            Продолжить;
        КонецЕсли;
        СуммаПлан = 0;
        Попытка
            СуммаПлан = Число(Выборка.СуммаПлан);
        Исключение
        КонецПопытки;
        Строки.Добавить(Новый Структура("ДатаПлан,СуммаПлан", Выборка.ДатаПлан, СуммаПлан));
    КонецЦикла;
    ДобавитьРассрочку(Элементы, Шапка, Строки);

    Результат.Вставить("items", Элементы);
    Результат.Вставить("total", Элементы.Количество());
    Возврат Результат;
КонецФункции

Процедура ДобавитьРассрочку(Элементы, Шапка, Строки)
    Если Шапка = Неопределено ИЛИ Строки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Итог = 0;
    Для Каждого Стр Из Строки Цикл
        Итог = Итог + Стр.СуммаПлан;
    КонецЦикла;
    ОстатокОплаты = Итог - Шапка.Долг;
    Если ОстатокОплаты < 0 Тогда
        ОстатокОплаты = 0;
    КонецЕсли;

    Платежи = Новый Массив;
    N = 0;
    Для Каждого Стр Из Строки Цикл
        N = N + 1;
        Факт = Мин(ОстатокОплаты, Макс(Стр.СуммаПлан, 0));
        ОстатокОплаты = ОстатокОплаты - Факт;
        Пл = Новый Структура;
        Пл.Вставить("n", N);
        Пл.Вставить("planDate", FitGOAnalyticsОбщегоНазначения.ISOДата(Стр.ДатаПлан));
        Пл.Вставить("planAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Стр.СуммаПлан));
        Пл.Вставить("factDate", Неопределено);
        Пл.Вставить("factAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Факт));
        Платежи.Добавить(Пл);
    КонецЦикла;

    КлиентИмя = "";
    Телефон = "";
    КлиентИд = "";
    Если ЗначениеЗаполнено(Шапка.Контрагент) Тогда
        КлиентИд = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Шапка.Контрагент);
        КлиентИмя = Строка(Шапка.Контрагент);
        Попытка
            Телефон = Строка(Шапка.Контрагент.Телефон);
        Исключение
        КонецПопытки;
    КонецЕсли;

    ШаблонИмя = "";
    Если ЗначениеЗаполнено(Шапка.Шаблон) Тогда
        ШаблонИмя = Строка(Шапка.Шаблон);
    КонецЕсли;

    Элемент = Новый Структура;
    Элемент.Вставить("saleDocumentId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Шапка.Ссылка));
    Элемент.Вставить("number", СокрЛП(Шапка.Номер));
    Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДата(Шапка.Дата));
    Элемент.Вставить("clientExternalId", КлиентИд);
    Элемент.Вставить("clientName", КлиентИмя);
    Элемент.Вставить("phone", Телефон);
    Элемент.Вставить("templateName", ШаблонИмя);
    Элемент.Вставить("total", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Итог));
    Элемент.Вставить("remaining", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Шапка.Долг));
    Элемент.Вставить("payments", Платежи);
    Элементы.Добавить(Элемент);
КонецПроцедуры

Функция НайтиМетаданныеРассрочки()
    // В расширении нельзя писать Метаданные.Документы.Реализация — падает с исключением.
    // Только .Найти(...). В FFS документ продажи = «Реализация» (синоним «Продажа»).
    Р = Новый Структура("ok,error,document,hasClient,attrTemplate,register,linkField,colPlanDate,colPlanAmount,colSkip,diag",
        Ложь, "", "", Ложь, "", "", "", "", "", "", Неопределено);

    МД = Метаданные.Документы.Найти("Реализация");
    Если МД = Неопределено Тогда
        МД = Метаданные.Документы.Найти("Продажа");
    КонецЕсли;
    Если МД = Неопределено Тогда
        Р.error = "Нет Документ.Реализация / Документ.Продажа";
        Возврат Р;
    КонецЕсли;
    Р.document = МД.Имя;
    Р.hasClient = МД.Реквизиты.Найти("Контрагент") <> Неопределено;
    Если МД.Реквизиты.Найти("ШаблонРассрочки") <> Неопределено Тогда
        Р.attrTemplate = "ШаблонРассрочки";
    КонецЕсли;

    Рег = Метаданные.РегистрыСведений.Найти("СхемыРассрочек");
    Если Рег = Неопределено Тогда
        Р.error = "Нет РегистрСведений.СхемыРассрочек";
        Р.diag = ДиагностикаМетаданныхРассрочки(МД);
        Возврат Р;
    КонецЕсли;
    Р.register = Рег.Имя;

    ТипДок = Тип("ДокументСсылка." + МД.Имя);
    Для Каждого Поле Из Рег.Измерения Цикл
        Если Поле.Тип.СодержитТип(ТипДок) Тогда
            Р.linkField = Поле.Имя;
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(Р.linkField) Тогда
        Для Каждого Поле Из Рег.Реквизиты Цикл
            Если Поле.Тип.СодержитТип(ТипДок) Тогда
                Р.linkField = Поле.Имя;
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если ПустаяСтрока(Р.linkField)
        И Рег.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
        Р.linkField = "Регистратор";
    КонецЕсли;
    Если ПустаяСтрока(Р.linkField) Тогда
        Р.error = "РегистрСведений.СхемыРассрочек не связан с Документ." + МД.Имя;
        Р.diag = ДиагностикаМетаданныхРассрочки(МД);
        Возврат Р;
    КонецЕсли;

    Р.colPlanDate = НайтиПолеРегистра(Рег, "ДатаПлатежа");
    Если ПустаяСтрока(Р.colPlanDate) И Рег.ПериодичностьРегистраСведений
        <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
        Р.colPlanDate = "Период";
    КонецЕсли;
    Р.colPlanAmount = НайтиПолеРегистра(Рег, "СуммаПлатежа");
    Р.colSkip = НайтиПолеРегистра(Рег, "НеИспользовать");
    Если ПустаяСтрока(Р.colPlanDate) ИЛИ ПустаяСтрока(Р.colPlanAmount) Тогда
        Р.error = "В РегистрСведений.СхемыРассрочек нет ДатаПлатежа / СуммаПлатежа";
        Р.diag = ДиагностикаМетаданныхРассрочки(МД);
        Возврат Р;
    КонецЕсли;

    Р.ok = Истина;
    Возврат Р;
КонецФункции

Функция НайтиПолеРегистра(Рег, Имя)
    Если Рег.Измерения.Найти(Имя) <> Неопределено
        ИЛИ Рег.Ресурсы.Найти(Имя) <> Неопределено
        ИЛИ Рег.Реквизиты.Найти(Имя) <> Неопределено Тогда
        Возврат Имя;
    КонецЕсли;
    Возврат "";
КонецФункции

// Для ответа с ошибкой: реквизиты документа про рассрочку и регистры-кандидаты на график.
Функция ДиагностикаМетаданныхРассрочки(МД)
    Д = Новый Структура;
    Д.Вставить("document", МД.Имя);
    Рекв = Новый Массив;
    Для Каждого Р Из МД.Реквизиты Цикл
        ИмяВ = ВРег(Р.Имя);
        Если СтрНайти(ИмяВ, "РАССРОЧ") > 0 ИЛИ СтрНайти(ИмяВ, "ШАБЛОН") > 0 Тогда
            Рекв.Добавить(Р.Имя + " :: " + ОписаниеТиповМД(Р.Тип));
        КонецЕсли;
    КонецЦикла;
    Д.Вставить("attrs", Рекв);

    ТипДок = Тип("ДокументСсылка." + МД.Имя);
    Регистры = Новый Массив;
    Для Каждого Рег Из Метаданные.РегистрыСведений Цикл
        ИмяВ = ВРег(Рег.Имя);
        Подходит = СтрНайти(ИмяВ, "РАССРОЧ") > 0 ИЛИ СтрНайти(ИмяВ, "ГРАФИК") > 0;
        Если НЕ Подходит Тогда
            Для Каждого Изм Из Рег.Измерения Цикл
                Если Изм.Тип.СодержитТип(ТипДок) Тогда
                    Подходит = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если НЕ Подходит Тогда
            Продолжить;
        КонецЕсли;
        Регистры.Добавить(Рег.ПолноеИмя()
            + " | mode: " + Строка(Рег.РежимЗаписи)
            + " | period: " + Строка(Рег.ПериодичностьРегистраСведений)
            + " | dims: " + ОписаниеПолейМД(Рег.Измерения)
            + " | res: " + ОписаниеПолейМД(Рег.Ресурсы)
            + " | attrs: " + ОписаниеПолейМД(Рег.Реквизиты));
    КонецЦикла;
    Д.Вставить("registers", Регистры);
    Возврат Д;
КонецФункции

// «Имя(Тип1/Тип2),…» для коллекции объектов метаданных (реквизиты, измерения, ресурсы).
Функция ОписаниеПолейМД(Коллекция)
    Части = Новый Массив;
    Для Каждого Поле Из Коллекция Цикл
        Части.Добавить(Поле.Имя + "(" + ОписаниеТиповМД(Поле.Тип) + ")");
    КонецЦикла;
    Возврат СтрСоединить(Части, ",");
КонецФункции

Функция ОписаниеТиповМД(ОписаниеТипов)
    Типы = ОписаниеТипов.Типы();
    Если Типы.Количество() > 3 Тогда
        Возврат "составной";
    КонецЕсли;
    Имена = Новый Массив;
    Для Каждого Т Из Типы Цикл
        МДТ = Метаданные.НайтиПоТипу(Т);
        Имена.Добавить(?(МДТ = Неопределено, Строка(Т), МДТ.Имя));
    КонецЦикла;
    Возврат СтрСоединить(Имена, "/");
КонецФункции

// Сводка абонементов клуба на дату «to» (+ отток за период from…to).
// Источник: РегистрСведений.ЧленстваПакетыУслугИтоги (как в FitGOIntegration).
// Один лёгкий запрос — для кэша ClubMembersSummary / аналитики «Клиентская база».
Функция ПолучитьСводкуАбонементов(ДатаНачала, ДатаОкончания) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("active", 0);
    Результат.Вставить("frozen", 0);
    Результат.Вставить("expiring7", 0);
    Результат.Вставить("expiring30", 0);
    Результат.Вставить("endedInPeriod", 0);
    Результат.Вставить("endedClientIds", Новый Массив);
    Результат.Вставить("asOf", Формат(ДатаОкончания, "ДФ=yyyy-MM-dd"));
    Результат.Вставить("from", Формат(ДатаНачала, "ДФ=yyyy-MM-dd"));

    Если Метаданные.РегистрыСведений.Найти("ЧленстваПакетыУслугИтоги") = Неопределено Тогда
        Результат.Вставить("error", "Нет РегистрСведений.ЧленстваПакетыУслугИтоги");
        Возврат Результат;
    КонецЕсли;

    ДатаНа = НачалоДня(ДатаОкончания);
    ДатаДо7 = КонецДня(ДатаОкончания + 7 * 86400);
    ДатаДо30 = КонецДня(ДатаОкончания + 30 * 86400);
    ПериодС = НачалоДня(ДатаНачала);
    ПериодПо = КонецДня(ДатаОкончания);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Итоги.ЧленствоПакетУслуг.Контрагент КАК Контрагент,
    |    Итоги.Статус КАК Статус,
    |    Итоги.СрокДействия КАК СрокДействия
    |ИЗ
    |    РегистрСведений.ЧленстваПакетыУслугИтоги КАК Итоги
    |ГДЕ
    |    НЕ Итоги.ЧленствоПакетУслуг.ПометкаУдаления";
    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
    Исключение
        Результат.Вставить("error", ОписаниеОшибки());
        Возврат Результат;
    КонецПопытки;

    Актив = 0;
    Замороз = 0;
    Истекает7 = 0;
    Истекает30 = 0;
    Закончились = 0;
    КлиентыКонец = Новый Массив;
    УжеКлиент = Новый Соответствие;

    Пока Выборка.Следующий() Цикл
        СтатусТекст = ВРег(СокрЛП(Строка(Выборка.Статус)));
        ЭтоЗамороз = СтрНайти(СтатусТекст, "ЗАМОРОЖ") > 0;
        ЭтоИстек = СтрНайти(СтатусТекст, "ИСТЕК") > 0
            ИЛИ СтрНайти(СтатусТекст, "ЗАКРЫТ") > 0
            ИЛИ СтрНайти(СтатусТекст, "ПРОСРОЧ") > 0
            ИЛИ СтрНайти(СтатусТекст, "АРХИВ") > 0
            ИЛИ СтрНайти(СтатусТекст, "НЕДЕЙСТВ") > 0;
        ЭтоАктив = (НЕ ЭтоЗамороз) И (НЕ ЭтоИстек)
            И (СтрНайти(СтатусТекст, "АКТИВ") > 0
                ИЛИ СтрНайти(СтатусТекст, "ДЕЙСТВ") > 0
                ИЛИ ПустаяСтрока(СтатусТекст));

        Срок = Выборка.СрокДействия;
        Если ЭтоАктив И ЗначениеЗаполнено(Срок) И Срок < ДатаНа Тогда
            ЭтоАктив = Ложь;
            ЭтоИстек = Истина;
        КонецЕсли;

        Если ЭтоЗамороз Тогда
            Замороз = Замороз + 1;
        ИначеЕсли ЭтоАктив Тогда
            Актив = Актив + 1;
            Если ЗначениеЗаполнено(Срок) Тогда
                Если Срок >= ДатаНа И Срок <= ДатаДо7 Тогда
                    Истекает7 = Истекает7 + 1;
                КонецЕсли;
                Если Срок >= ДатаНа И Срок <= ДатаДо30 Тогда
                    Истекает30 = Истекает30 + 1;
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;

        Если ЗначениеЗаполнено(Срок) И Срок >= ПериодС И Срок <= ПериодПо Тогда
            Закончились = Закончились + 1;
            Если КлиентыКонец.Количество() < 500 И ЗначениеЗаполнено(Выборка.Контрагент) Тогда
                Ид = "";
                Попытка
                    Ид = Строка(Выборка.Контрагент.УникальныйИдентификатор());
                Исключение
                    Ид = Строка(Выборка.Контрагент);
                КонецПопытки;
                Если НЕ ПустаяСтрока(Ид) И УжеКлиент.Получить(Ид) = Неопределено Тогда
                    УжеКлиент.Вставить(Ид, Истина);
                    КлиентыКонец.Добавить(Ид);
                КонецЕсли;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;

    Результат.active = Актив;
    Результат.frozen = Замороз;
    Результат.expiring7 = Истекает7;
    Результат.expiring30 = Истекает30;
    Результат.endedInPeriod = Закончились;
    Результат.endedClientIds = КлиентыКонец;
    Возврат Результат;
КонецФункции
