// Общий модуль FitGOAnalyticsПродажи (сервер)
// База: Ffix_ПродажиАдминов (ПродажиСебестоимость + РасчетыСПокупателями)
//
// БИЗНЕС-ПРАВИЛО ПРЕМИЙ (docs/ADMIN_BONUS_LOGIC.md):
// - membership (Абонементы+КП): премия на СМЕНУ, / КоличествоПродавцов (пара);
// - service/product (Массаж, Солярий, Магазин): % на КОНКРЕТНОГО админа, без деления;
// - абонемент: атрибуция по дате ПРОДАЖИ, не оплаты другой смены.
//
// Текущий запрос — УПРОЩЁННЫЙ. Для совпадения с отчётом перенести полный SKD из Template.xml.

#Область ПрограммныйИнтерфейс

Функция ПолучитьПродажи(ДатаНачала, ДатаОкончания, Сотрудник, SaleType, Страница, РазмерСтраницы) Экспорт
    Настройки = FitGOAnalyticsНастройки.ПолучитьНастройкиСегментов();
    Таблица = ВыполнитьЗапросПродаж(ДатаНачала, ДатаОкончания, Сотрудник, SaleType, Настройки);

    Элементы = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Элементы.Добавить(СтрокаПродажиВJSON(Строка, Настройки));
    КонецЦикла;

    // Движения лицевого счёта (взнос / начисление в абонементе / сгорание) — только без фильтра saleType.
    Если ПустаяСтрока(SaleType) Тогда
        ДвиженияЛС = ВыполнитьЗапросДвиженийЛицевогоСчета(ДатаНачала, ДатаОкончания, Сотрудник);
        Для Каждого Движение Из ДвиженияЛС Цикл
            ЭлементЛС = ДвижениеЛицевогоСчетаВJSON(Движение);
            Если ЭлементЛС <> Неопределено Тогда
                Элементы.Добавить(ЭлементЛС);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;

    Возврат СтраницаМассива(Элементы, Страница, РазмерСтраницы);
КонецФункции

// Как «Сводный отчет по выручке»: регистр РасчетыСПокупателями за период,
// без отбора по номенклатуре и сотрудникам.
// Оплаты от клиентов = приход Долг/Рассрочка по типу ДС.
// Взнос на ЛС = приход ЛицевойСчет с типом ДС (нал/карта/безнал).
// Возвраты = СуммаПриход < 0 (как в FFS) ИЛИ расход Долг/ЛС при СписаниеДенежныхСредств
// (тип ДС на шапке часто пуст — не отбрасывать).
Функция ПолучитьДвиженияВыручки(ДатаНачала, ДатаОкончания, Страница, РазмерСтраницы) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Расчеты.Период КАК Период,
    |    Расчеты.Регистратор КАК Регистратор,
    |    Расчеты.Контрагент КАК Контрагент,
    |    Расчеты.Основание КАК Основание,
    |    Расчеты.ТипРасчета КАК ТипРасчета,
    |    Расчеты.СуммаПриход КАК СуммаПриход,
    |    Расчеты.СуммаРасход КАК СуммаРасход,
    |    Расчеты.Регистратор.ТипДенежныхСредств КАК ТипДенежныхСредств
    |ИЗ
    |    РегистрНакопления.РасчетыСПокупателями.ОстаткиИОбороты(
    |        &ДатаНачала,
    |        &ДатаОкончания,
    |        Регистратор,
    |        ,
    |        ) КАК Расчеты
    |ГДЕ
    |    (Расчеты.СуммаПриход <> 0 ИЛИ Расчеты.СуммаРасход <> 0)";
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

    Таблица = Запрос.Выполнить().Выгрузить();
    Элементы = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Элемент = ДвижениеВыручкиВJSON(Строка);
        Если Элемент <> Неопределено Тогда
            Элементы.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;

    Возврат СтраницаМассива(Элементы, Страница, РазмерСтраницы);
КонецФункции

// Открытый долг клиентов на момент ДатаОстатков (Долг + Рассрочка).
// Знак как в карточке Forma «Оплатить X» / FitGOIntegration СчетаИДолгиКлиента:
// клиентский долг = отрицательный СуммаОстаток → |сумма|.
// Положительные остатки (переплата / «наш долг им» / хвосты удалённых) в долг не входят.
// Сотрудник — из реквизитов основания, иначе из регистра ПродажиСебестоимость
// (как отчёт «Неоплаченные продажи» по продавцу). Опциональный фильтр Сотрудник.
Функция ПолучитьОстаткиДолга(ДатаОстатков, Сотрудник = Неопределено) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Остатки.Контрагент КАК Контрагент,
    |    Остатки.Основание КАК Основание,
    |    Остатки.СуммаОстаток КАК СуммаОстаток
    |ИЗ
    |    РегистрНакопления.РасчетыСПокупателями.Остатки(
    |        &Момент,
    |        ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
    |            ИЛИ ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Рассрочка)) КАК Остатки
    |ГДЕ
    |    Остатки.СуммаОстаток < -0.009";
    Запрос.УстановитьПараметр("Момент", КонецДня(ДатаОстатков));

    Таблица = Запрос.Выполнить().Выгрузить();

    // Пакетно: автор продажи по ДокументПродажи (реквизит Сотрудник на основании часто пуст).
    Основания = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Если ЗначениеЗаполнено(Строка.Основание) Тогда
            Основания.Добавить(Строка.Основание);
        КонецЕсли;
    КонецЦикла;
    СотрудникиПоОснованию = СотрудникиПродажПоОснованиям(Основания);

    КодФильтра = "";
    Если ЗначениеЗаполнено(Сотрудник) Тогда
        Попытка
            КодФильтра = СокрЛП(Строка(Сотрудник.Код));
        Исключение
            КодФильтра = "";
        КонецПопытки;
    КонецЕсли;

    Элементы = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        Сумма = FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(-Строка.СуммаОстаток);
        Если Сумма <= 0 Тогда
            Продолжить;
        КонецЕсли;

        // Удалённое основание — не долг к взысканию (в карточке Forma тоже не показывается).
        Попытка
            Если ЗначениеЗаполнено(Строка.Основание)
                И Строка.Основание.ПометкаУдаления Тогда
                Продолжить;
            КонецЕсли;
        Исключение
        КонецПопытки;
        Попытка
            Если ЗначениеЗаполнено(Строка.Основание)
                И СтрНайти(НРег(Строка(Строка.Основание)), "удален") > 0 Тогда
                Продолжить;
            КонецЕсли;
        Исключение
        КонецПопытки;

        ОснованиеИд = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Основание);
        КонтрагентИд = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент);
        Если ПустаяСтрока(ОснованиеИд) Тогда
            ОснованиеИд = КонтрагентИд;
        КонецЕсли;

        ДатаПродажи = ДатаОстатков;
        ИмяПродукта = "Долг";
        Попытка
            Если ЗначениеЗаполнено(Строка.Основание) Тогда
                ДатаПродажи = Строка.Основание.Дата;
                ИмяПродукта = Строка(Строка.Основание);
            КонецЕсли;
        Исключение
        КонецПопытки;

        СотрудникДок = СотрудникИзДокумента(Строка.Основание);
        Если ПустаяСтрока(СотрудникДок.Код) И ЗначениеЗаполнено(Строка.Основание) Тогда
            ИзРегистра = СотрудникиПоОснованию.Получить(Строка.Основание);
            Если ИзРегистра <> Неопределено Тогда
                СотрудникДок = ИзРегистра;
            КонецЕсли;
        КонецЕсли;

        Если НЕ ПустаяСтрока(КодФильтра) Тогда
            Если СокрЛП(СотрудникДок.Код) <> КодФильтра Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;

        Ключ = ОснованиеИд + ":debt:" + КонтрагентИд;

        Элемент = Новый Структура;
        Элемент.Вставить("saleDocumentId", Ключ);
        Элемент.Вставить("documentId", ОснованиеИд);
        Элемент.Вставить("operationType", "unpaid");
        Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(ДатаПродажи));
        Элемент.Вставить("amount", Сумма);
        Элемент.Вставить("saleAmount", Сумма);
        Элемент.Вставить("paidAmount", 0);
        Элемент.Вставить("refundAmount", 0);
        Элемент.Вставить("cash", 0);
        Элемент.Вставить("card", 0);
        Элемент.Вставить("cashless", 0);
        Элемент.Вставить("personalAccount", 0);
        Элемент.Вставить("paymentMethod", "unknown");
        Элемент.Вставить("saleType", "service");
        Элемент.Вставить("productName", ИмяПродукта);
        Элемент.Вставить("clientExternalId", КонтрагентИд);
        Элемент.Вставить("clientName", Строка(Строка.Контрагент));
        Элемент.Вставить("employeeExternalId", СотрудникДок.Код);
        Элемент.Вставить("employeeName", СотрудникДок.Имя);
        Элемент.Вставить("countsTowardIncome", Ложь);
        Элемент.Вставить("countsTowardMotivation", Ложь);
        Элементы.Добавить(Элемент);
    КонецЦикла;

    Возврат СтраницаМассива(Элементы, 1, 0);
КонецФункции

// Автор строк продаж по документам-основаниям (для остатков долга).
Функция СотрудникиПродажПоОснованиям(Основания)
    Результат = Новый Соответствие;
    Если Основания = Неопределено Или Основания.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Продажи.ДокументПродажи КАК ДокументПродажи,
    |    Продажи.Сотрудник КАК Сотрудник
    |ИЗ
    |    РегистрНакопления.ПродажиСебестоимость КАК Продажи
    |ГДЕ
    |    Продажи.ДокументПродажи В (&Основания)
    |    И Продажи.Сотрудник <> НЕОПРЕДЕЛЕНО";
    Запрос.УстановитьПараметр("Основания", Основания);

    Попытка
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Если Результат.Получить(Выборка.ДокументПродажи) <> Неопределено Тогда
                Продолжить;
            КонецЕсли;
            Если НЕ ЗначениеЗаполнено(Выборка.Сотрудник) Тогда
                Продолжить;
            КонецЕсли;
            Код = "";
            Попытка
                Код = СокрЛП(Строка(Выборка.Сотрудник.Код));
            Исключение
                Код = "";
            КонецПопытки;
            Если ПустаяСтрока(Код) Тогда
                Продолжить;
            КонецЕсли;
            Результат.Вставить(Выборка.ДокументПродажи, Новый Структура("Код,Имя", Код, Строка(Выборка.Сотрудник)));
        КонецЦикла;
    Исключение
        // регистр/синоним может отличаться — долг всё равно отдаём без сотрудника
    КонецПопытки;

    Возврат Результат;
КонецФункции

// Журнал регистрации за период событий (не период документа).
// Удаление и изменение документов: FitGO гасит строку по UUID и перечитывает только день документа.
Функция ПолучитьИзмененияЖурнала(ДатаНачала, ДатаОкончания) Экспорт
    События = Новый Массив;
    События.Добавить("_$Data$_.Delete");
    События.Добавить("_$Data$_.Update");

    Отбор = Новый Структура;
    Отбор.Вставить("ДатаНачала", НачалоДня(ДатаНачала));
    Отбор.Вставить("ДатаОкончания", КонецДня(ДатаОкончания));
    Отбор.Вставить("Событие", События);

    Таблица = Новый ТаблицаЗначений;
    ВыгрузитьЖурналРегистрации(Таблица, Отбор);

    Элементы = Новый Массив;
    Виденные = Новый Соответствие;
    Для Каждого СтрокаЖурнала Из Таблица Цикл
        ПолноеИмя = "";
        Попытка
            ПолноеИмя = СтрокаЖурнала.Метаданные.ПолноеИмя();
        Исключение
            ПолноеИмя = Строка(СтрокаЖурнала.Метаданные);
        КонецПопытки;
        Если СтрНайти(ПолноеИмя, "Документ.") <> 1 Тогда
            Продолжить;
        КонецЕсли;

        Ид = "";
        Попытка
            Ид = Строка(СтрокаЖурнала.Данные.УникальныйИдентификатор());
        Исключение
            Ид = "";
        КонецПопытки;
        Если ПустаяСтрока(Ид) Тогда
            Продолжить;
        КонецЕсли;

        ЭтоУдаление = СтрНайти(Строка(СтрокаЖурнала.Событие), "Delete") > 0;
        Действие = ?(ЭтоУдаление, "delete", "update");
        Ключ = Ид + ":" + Действие;
        Если Виденные[Ключ] <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Виденные.Вставить(Ключ, Истина);

        ДатаДокумента = СтрокаЖурнала.Дата;
        Попытка
            Если ЗначениеЗаполнено(СтрокаЖурнала.Данные.Дата) Тогда
                ДатаДокумента = СтрокаЖурнала.Данные.Дата;
            КонецЕсли;
        Исключение
        КонецПопытки;

        Элемент = Новый Структура;
        Элемент.Вставить("saleDocumentId", Ид);
        Элемент.Вставить("documentId", Ид);
        Элемент.Вставить("operationType", Действие);
        Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(ДатаДокумента));
        Элемент.Вставить("amount", 0);
        Элемент.Вставить("saleType", "service");
        Элемент.Вставить("productName", ПолноеИмя);
        Элементы.Добавить(Элемент);
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("items", Элементы);
    Результат.Вставить("page", 1);
    Результат.Вставить("pageSize", Элементы.Количество());
    Результат.Вставить("total", Элементы.Количество());
    Возврат Результат;
КонецФункции

Функция СтраницаМассива(Элементы, Страница, РазмерСтраницы)
    Всего = Элементы.Количество();
    // Размер 0 — весь массив одним ответом.
    Если РазмерСтраницы <= 0 Тогда
        Результат = Новый Структура;
        Результат.Вставить("items", Элементы);
        Результат.Вставить("page", 1);
        Результат.Вставить("pageSize", Всего);
        Результат.Вставить("total", Всего);
        Возврат Результат;
    КонецЕсли;

    Начало = (Страница - 1) * РазмерСтраницы;
    КонецИндекса = Мин(Начало + РазмерСтраницы, Всего) - 1;
    СтраницаЭлементов = Новый Массив;
    Если Начало <= КонецИндекса И КонецИндекса >= 0 Тогда
        Для Индекс = Начало По КонецИндекса Цикл
            СтраницаЭлементов.Добавить(Элементы[Индекс]);
        КонецЦикла;
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("items", СтраницаЭлементов);
    Результат.Вставить("page", Страница);
    Результат.Вставить("pageSize", РазмерСтраницы);
    Результат.Вставить("total", Всего);
    Возврат Результат;
КонецФункции

Функция ДвижениеВыручкиВJSON(Строка)
    ЭтоДолг = Строка.ТипРасчета = Перечисления.ТипыРасчетов.Долг
        Или Строка.ТипРасчета = Перечисления.ТипыРасчетов.Рассрочка;
    ЭтоЛС = Строка.ТипРасчета = Перечисления.ТипыРасчетов.ЛицевойСчет;
    Если НЕ ЭтоДолг И НЕ ЭтоЛС Тогда
        Возврат Неопределено;
    КонецЕсли;

    ИмяТипа = "";
    Попытка
        ИмяТипа = НРег(Строка(ТипЗнч(Строка.Регистратор)));
    Исключение
    КонецПопытки;
    // Документ.СписаниеДенежныхСредств — возврат клиенту (касса), не сгорание ЛС.
    ЭтоСписаниеДС = СтрНайти(ИмяТипа, "списаниеденежных") > 0
        Или СтрНайти(ИмяТипа, "возвратклиенту") > 0
        Или СтрНайти(ИмяТипа, "возвратденежных") > 0;

    Cash = 0;
    Card = 0;
    Cashless = 0;
    ЕстьТипДС = ЗначениеЗаполнено(Строка.ТипДенежныхСредств);
    Если Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные Тогда
        Cash = 1;
    ИначеЕсли Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.ПлатежнаяКарта Тогда
        Card = 1;
    ИначеЕсли Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.БезНаличные Тогда
        Cashless = 1;
    КонецЕсли;
    ДеньгиВзноса = Cash + Card + Cashless;

    OperationType = "";
    Amount = 0;
    PaidAmount = 0;
    RefundAmount = 0;
    PersonalAccount = 0;
    ProductName = "";

    // Возврат в FFS / «ОтчетПоВыручке»: СуммаПриход < 0 ИЛИ расход по долгу
    // (СписаниеДенежныхСредств часто без ТипДенежныхСредств на шапке — раньше отбрасывали).
    Если ЭтоДолг И Строка.СуммаПриход < 0 Тогда
        OperationType = "refund";
        RefundAmount = -Строка.СуммаПриход;
        Amount = Строка.СуммаПриход;
        ProductName = "Возврат";
    ИначеЕсли ЭтоДолг И Строка.СуммаРасход > 0 И (ЕстьТипДС Или ЭтоСписаниеДС) Тогда
        OperationType = "refund";
        Amount = -Строка.СуммаРасход;
        RefundAmount = Строка.СуммаРасход;
        ProductName = "Возврат";
    ИначеЕсли ЭтоДолг И Строка.СуммаПриход > 0 И ЕстьТипДС И ДеньгиВзноса > 0 Тогда
        OperationType = "payment";
        Amount = Строка.СуммаПриход;
        PaidAmount = Amount;
        ProductName = "Оплата от клиента";
    ИначеЕсли ЭтоДолг И Строка.СуммаПриход > 0 И ЕстьТипДС Тогда
        // Тип ДС есть, но не нал/карта/безнал — в сводном отчёте это оплата с ЛС (119).
        OperationType = "payment";
        Amount = Строка.СуммаПриход;
        PaidAmount = Amount;
        PersonalAccount = Amount;
        ProductName = "Оплата от клиента";
        Cash = 0;
        Card = 0;
        Cashless = 0;
    ИначеЕсли ЭтоЛС И Строка.СуммаПриход > 0 И ЕстьТипДС И ДеньгиВзноса > 0 Тогда
        OperationType = "personal_deposit";
        Amount = Строка.СуммаПриход;
        PaidAmount = Amount;
        ProductName = "Взнос на лицевой счет";
    ИначеЕсли ЭтоЛС И Строка.СуммаПриход > 0 Тогда
        // Без типа ДС или тип ДС без нал/карты/безнала — зачисление при продаже абонемента.
        OperationType = "personal_credit";
        Amount = Строка.СуммаПриход;
        PersonalAccount = Amount;
        ProductName = "Прочие поступления";
        Cash = 0;
        Card = 0;
        Cashless = 0;
    ИначеЕсли ЭтоЛС И Строка.СуммаРасход > 0 И ЭтоСписаниеДС Тогда
        OperationType = "refund";
        Amount = -Строка.СуммаРасход;
        RefundAmount = Строка.СуммаРасход;
        ProductName = "Возврат";
    ИначеЕсли ЭтоЛС И Строка.СуммаРасход > 0 И ЕстьТипДС И Cashless > 0 И Cash = 0 И Card = 0 Тогда
        // Сводный «ОтчетПоВыручке»: сгорание ЛС в колонке «Безналичные».
        OperationType = "personal_burn";
        Amount = -Строка.СуммаРасход;
        PersonalAccount = Amount;
        ProductName = "Сгорание лицевого счета";
        Cash = 0;
        Card = 0;
        Cashless = 0;
    ИначеЕсли ЭтоЛС И Строка.СуммаРасход > 0 И ЕстьТипДС Тогда
        // Выдача нал/картой с ЛС клиенту.
        OperationType = "refund";
        Amount = -Строка.СуммаРасход;
        RefundAmount = Строка.СуммаРасход;
        ProductName = "Возврат";
    ИначеЕсли ЭтоЛС И Строка.СуммаРасход > 0 Тогда
        // Без типа ДС: сгорание остатка / обнуление, либо оплата продажи с ЛС.
        // Пакетные списания 23:59 с основанием-абонементом — Nest отфильтрует по времени.
        ЭтоЯвноеСгорание = СтрНайти(ИмяТипа, "сгоран") > 0
            Или СтрНайти(ИмяТипа, "обнулен") > 0
            Или СтрНайти(ИмяТипа, "корректир") > 0
            Или СтрНайти(ИмяТипа, "истеч") > 0
            Или СтрНайти(ИмяТипа, "аннул") > 0
            // Документ.ЗакрытиеДня — списание остатка/пакета с ЛС (как в карточке клиента).
            Или СтрНайти(ИмяТипа, "закрытиедня") > 0
            Или СтрНайти(ИмяТипа, "закрытидня") > 0;
        ЕстьОснованиеПродажи = ЗначениеЗаполнено(Строка.Основание)
            И Строка.Основание <> Строка.Регистратор;
        Если ЭтоЯвноеСгорание Или НЕ ЕстьОснованиеПродажи Тогда
            OperationType = "personal_burn";
            Amount = -Строка.СуммаРасход;
            PersonalAccount = Amount;
            ProductName = "Сгорание лицевого счета";
        Иначе
            // Оплата продажи с лицевого счёта.
            OperationType = "payment";
            Amount = Строка.СуммаРасход;
            PaidAmount = Amount;
            PersonalAccount = Amount;
            ProductName = "Оплата от клиента";
            Cash = 0;
            Card = 0;
            Cashless = 0;
        КонецЕсли;
    Иначе
        Возврат Неопределено;
    КонецЕсли;

    Если OperationType = "payment" Или OperationType = "personal_deposit" Или OperationType = "refund" Тогда
        База = ?(RefundAmount > 0, RefundAmount, Amount);
        Cash = Cash * База;
        Card = Card * База;
        Cashless = Cashless * База;
    Иначе
        Cash = 0;
        Card = 0;
        Cashless = 0;
    КонецЕсли;

    PaymentMethod = "unknown";
    Если Cash > 0 И Card = 0 И Cashless = 0 Тогда
        PaymentMethod = "cash";
    ИначеЕсли Card > 0 И Cash = 0 И Cashless = 0 Тогда
        PaymentMethod = "card";
    ИначеЕсли Cashless > 0 И Cash = 0 И Card = 0 Тогда
        PaymentMethod = "cashless";
    ИначеЕсли PersonalAccount <> 0 Тогда
        PaymentMethod = "personalAccount";
    КонецЕсли;

    // Основание обязательно в ключе: один документ оплаты гасит несколько продаж
    // одного клиента → несколько строк с одинаковым Регистратор+Контрагент+Период.
    ОснованиеИд = "";
    Попытка
        ОснованиеИд = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Основание);
    Исключение
        ОснованиеИд = Строка(Строка.Основание);
    КонецПопытки;

    Ключ = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Регистратор)
        + ":cash:" + Строка(Строка.ТипРасчета)
        + ":" + FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент)
        + ":" + ОснованиеИд
        + ":" + Формат(Строка.Период, "ДФ=yyyyMMddHHmmss")
        + ":" + OperationType;

    Элемент = Новый Структура;
    Элемент.Вставить("saleDocumentId", Ключ);
    Элемент.Вставить("documentId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Регистратор));
    Элемент.Вставить("operationType", OperationType);
    Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    Если OperationType = "payment" Или OperationType = "personal_deposit" Или OperationType = "refund" Тогда
        Элемент.Вставить("paidAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    КонецЕсли;
    Элемент.Вставить("amount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Amount));
    Элемент.Вставить("saleAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(?(Amount > 0, Amount, 0)));
    Элемент.Вставить("paidAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(PaidAmount));
    Элемент.Вставить("refundAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(RefundAmount));
    Элемент.Вставить("cash", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Cash));
    Элемент.Вставить("card", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Card));
    Элемент.Вставить("cashless", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Cashless));
    Элемент.Вставить("personalAccount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(PersonalAccount));
    Элемент.Вставить("paymentMethod", PaymentMethod);
    Элемент.Вставить("saleType", "service");
    Элемент.Вставить("productName", ProductName);
    Элемент.Вставить("clientExternalId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент));
    Элемент.Вставить("clientName", Строка(Строка.Контрагент));
    СотрудникДок = СотрудникИзДокумента(Строка.Регистратор);
    Если ПустаяСтрока(СотрудникДок.Код) И ЗначениеЗаполнено(Строка.Основание) Тогда
        СотрудникДок = СотрудникИзДокумента(Строка.Основание);
    КонецЕсли;
    Элемент.Вставить("employeeExternalId", СотрудникДок.Код);
    Элемент.Вставить("employeeName", СотрудникДок.Имя);
    Элемент.Вставить("countsTowardIncome", OperationType = "payment" Или OperationType = "personal_deposit");
    Элемент.Вставить("countsTowardMotivation", Ложь);
    Возврат Элемент;
КонецФункции

Функция ПолучитьСтатистикуСотрудников(ДатаНачала, ДатаОкончания, SaleType) Экспорт
    Настройки = FitGOAnalyticsНастройки.ПолучитьНастройкиСегментов();
    Таблица = ВыполнитьЗапросПродаж(ДатаНачала, ДатаОкончания, Неопределено, SaleType, Настройки);

    Агрегаты = Новый Соответствие;
    Для Каждого Строка Из Таблица Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) Тогда
            Продолжить;
        КонецЕсли;
        Ключ = Строка(Строка.Сотрудник.УникальныйИдентификатор());
        Если Агрегаты[Ключ] = Неопределено Тогда
            Агрегаты.Вставить(Ключ, НовыйАгрегатСотрудника(Строка));
            ДобавитьВАгрегатСотрудника(Агрегаты[Ключ], Строка, Настройки);
        Иначе
            ДобавитьВАгрегатСотрудника(Агрегаты[Ключ], Строка, Настройки);
        КонецЕсли;
    КонецЦикла;

    Элементы = Новый Массив;
    Для Каждого Пара Из Агрегаты Цикл
        Элементы.Добавить(АгрегатСотрудникаВJSON(Пара.Значение));
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("from", FitGOAnalyticsОбщегоНазначения.ISOДата(ДатаНачала));
    Результат.Вставить("to", FitGOAnalyticsОбщегоНазначения.ISOДата(ДатаОкончания));
    Результат.Вставить("items", Элементы);
    Возврат Результат;
КонецФункции

Функция ПолучитьСтатистикуПоДням(ДатаНачала, ДатаОкончания, SaleType) Экспорт
    Настройки = FitGOAnalyticsНастройки.ПолучитьНастройкиСегментов();
    Таблица = ВыполнитьЗапросПродаж(ДатаНачала, ДатаОкончания, Неопределено, SaleType, Настройки);

    Агрегаты = Новый Соответствие;
    Для Каждого Строка Из Таблица Цикл
        Ключ = FitGOAnalyticsОбщегоНазначения.ISOДата(НачалоДня(Строка.Период));
        Если Агрегаты[Ключ] = Неопределено Тогда
            Агрегаты.Вставить(Ключ, НовыйАгрегатДня(Ключ));
        КонецЕсли;
        ДобавитьВАгрегатДня(Агрегаты[Ключ], Строка, Настройки);
    КонецЦикла;

    Элементы = Новый Массив;
    Для Каждого Пара Из Агрегаты Цикл
        Элементы.Добавить(АгрегатДняВJSON(Пара.Значение));
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("items", Элементы);
    Возврат Результат;
КонецФункции

Функция ПолучитьВыручкуЗаПериод(ДатаНачала, ДатаОкончания, SaleType, GroupBy) Экспорт
    Настройки = FitGOAnalyticsНастройки.ПолучитьНастройкиСегментов();
    Таблица = ВыполнитьЗапросПродаж(ДатаНачала, ДатаОкончания, Неопределено, SaleType, Настройки);

    Итог = Новый Структура;
    Итог.Вставить("grossAmount", 0);
    Итог.Вставить("refundAmount", 0);
    Итог.Вставить("netAmount", 0);
    Итог.Вставить("byPaymentMethod", Новый Структура("cash, card, cashless", 0, 0, 0));
    Итог.Вставить("bySaleType", Новый Структура("membership, service, product", 0, 0, 0));
    Итог.Вставить("byDay", Новый Соответствие);

    Для Каждого Строка Из Таблица Цикл
        Сумма = Строка.ПродажаСтоимость;
        // Имя переменной не «Возврат» — в BSL это зарезервированное слово (return).
        СуммаВозврата = Строка.ВозвратСтоимость;
        Итог.grossAmount = Итог.grossAmount + Сумма;
        Итог.refundAmount = Итог.refundAmount + СуммаВозврата;
        Итог.netAmount = Итог.netAmount + Сумма - СуммаВозврата;

        Тип = КлючСводкиSaleType(ОпределитьSaleType(Строка, Настройки));
        Итог.bySaleType[Тип] = Итог.bySaleType[Тип] + Сумма - СуммаВозврата;

        Способ = ОпределитьСпособОплаты(Строка);
        Итог.byPaymentMethod[Способ] = Итог.byPaymentMethod[Способ] + Строка.ОплатаСтрокиВПериоде;

        Если GroupBy = "day" Тогда
            День = FitGOAnalyticsОбщегоНазначения.ISOДата(НачалоДня(Строка.Период));
            Если Итог.byDay[День] = Неопределено Тогда
                Итог.byDay.Вставить(День, 0);
            КонецЕсли;
            Итог.byDay[День] = Итог.byDay[День] + Сумма - СуммаВозврата;
        КонецЕсли;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("from", FitGOAnalyticsОбщегоНазначения.ISOДата(ДатаНачала));
    Результат.Вставить("to", FitGOAnalyticsОбщегоНазначения.ISOДата(ДатаОкончания));
    Результат.Вставить("grossAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Итог.grossAmount));
    Результат.Вставить("refundAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Итог.refundAmount));
    Результат.Вставить("netAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Итог.netAmount));
    Результат.Вставить("byPaymentMethod", ОкруглитьСтруктуруДенег(Итог.byPaymentMethod));
    Результат.Вставить("bySaleType", ОкруглитьСтруктуруДенег(Итог.bySaleType));

    Если GroupBy = "day" Тогда
        Результат.Вставить("byDay", СоответствиеВСтруктуруДенег(Итог.byDay));
    КонецЕсли;

    Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапросПродаж(ДатаНачала, ДатаОкончания, Сотрудник, SaleType, Настройки)
    // Как в FFS_ПродажиАдминов:
    // - отчёт «Оплата с учетом возврата» = оплаты за период, в т.ч. по старым продажам;
    // - абонементы без фильтра «Сотрудник ∈ админы» (атрибуция на смену в FitGO).
    Админы = FitGOAnalyticsНастройки.СотрудникиАдминистраторы(Настройки);
    Номенклатура = FitGOAnalyticsНастройки.РазрешённаяНоменклатура(Настройки);
    НоменклатураАбонементы = FitGOAnalyticsНастройки.НоменклатураПоСегменту(
        Настройки.СегментНоменклатурыАбонементыИКП);

    Если Номенклатура.Количество() = 0 Тогда
        Возврат Новый ТаблицаЗначений;
    КонецЕсли;

    // Продажи ищем с запасом назад: оплата 22.09 может относиться к карте месяцы назад.
    ДатаНачалаПродаж = ДобавитьМесяц(ДатаНачала, -24);

    Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапросаПродаж();
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
    Запрос.УстановитьПараметр("ДатаНачалаПродаж", ДатаНачалаПродаж);
    Запрос.УстановитьПараметр("Админы", Админы);
    Запрос.УстановитьПараметр("ЕстьАдмины", Админы.Количество() > 0);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Запрос.УстановитьПараметр("НоменклатураАбонементы", НоменклатураАбонементы);
    Запрос.УстановитьПараметр("ФильтрСотрудник", ЗначениеЗаполнено(Сотрудник));
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);

    Попытка
        Таблица = Запрос.Выполнить().Выгрузить();
    Исключение
        ВызватьИсключение "FitGOAnalytics запрос продаж: " + ОписаниеОшибки();
    КонецПопытки;

    Если НЕ ПустаяСтрока(SaleType) Тогда
        Отфильтрованная = Таблица.СкопироватьКолонки();
        Для Каждого Строка Из Таблица Цикл
            Если ОпределитьSaleType(Строка, Настройки) = SaleType Тогда
                Новая = Отфильтрованная.Добавить();
                ЗаполнитьЗначенияСвойств(Новая, Строка);
            КонецЕсли;
        КонецЦикла;
        Возврат Отфильтрованная;
    КонецЕсли;

    Возврат Таблица;
КонецФункции

Функция ТекстЗапросаПродаж()
    // Как FFS «Оплата с учетом возврата»:
    //   доля строки = Стоимость * ОплатаВПериоде / СуммаДокумента
    // Оплаты: только Долг/Рассрочка (иначе дубли ×2).
    Возврат
    "ВЫБРАТЬ
    |    Продажи.Период КАК Период,
    |    Продажи.ДокументПродажи КАК ДокументПродажи,
    |    Продажи.Контрагент КАК Контрагент,
    |    Продажи.Номенклатура КАК Номенклатура,
    |    Продажи.Сотрудник КАК Сотрудник,
    |    Продажи.ЧленствоПакетУслуг КАК ЧленствоПакетУслуг,
    |    ВЫБОР
    |        КОГДА Продажи.СтоимостьОборот >= 0
    |            ТОГДА Продажи.СтоимостьОборот
    |        ИНАЧЕ 0
    |    КОНЕЦ КАК ПродажаСтоимость,
    |    ВЫБОР
    |        КОГДА Продажи.СтоимостьОборот < 0
    |            ТОГДА -Продажи.СтоимостьОборот
    |        ИНАЧЕ 0
    |    КОНЕЦ КАК ВозвратСтоимость,
    |    ЕСТЬNULL(Оплаты.ОплаченоВПериоде, 0) КАК ОплаченоВПериоде,
    |    ЕСТЬNULL(Оплаты.ОплаченоНаличные, 0) КАК ОплаченоНаличные,
    |    ЕСТЬNULL(Оплаты.ОплаченоПлатежнаяКарта, 0) КАК ОплаченоПлатежнаяКарта,
    |    ЕСТЬNULL(Оплаты.ОплаченоБезналичные, 0) КАК ОплаченоБезналичные,
    |    ЕСТЬNULL(ОплатыЛС.ОплаченоЛицевойСчет, 0) КАК ОплаченоЛицевойСчет,
    |    ЕСТЬNULL(СуммаДокумента.Стоимость, 0) КАК СуммаДокумента,
    |    ВЫБОР
    |        КОГДА ЕСТЬNULL(Оплаты.ОплаченоВПериоде, 0) > 0
    |            И ЕСТЬNULL(СуммаДокумента.Стоимость, 0) > 0
    |        ТОГДА ВЫБОР
    |            КОГДА (ВЫБОР
    |                    КОГДА Продажи.СтоимостьОборот >= 0
    |                        ТОГДА Продажи.СтоимостьОборот
    |                    ИНАЧЕ 0
    |                КОНЕЦ * Оплаты.ОплаченоВПериоде / СуммаДокумента.Стоимость)
    |                > (ВЫБОР
    |                    КОГДА Продажи.СтоимостьОборот >= 0
    |                        ТОГДА Продажи.СтоимостьОборот
    |                    ИНАЧЕ 0
    |                КОНЕЦ)
    |            ТОГДА ВЫБОР
    |                    КОГДА Продажи.СтоимостьОборот >= 0
    |                        ТОГДА Продажи.СтоимостьОборот
    |                    ИНАЧЕ 0
    |                КОНЕЦ
    |            ИНАЧЕ ВЫБОР
    |                    КОГДА Продажи.СтоимостьОборот >= 0
    |                        ТОГДА Продажи.СтоимостьОборот
    |                    ИНАЧЕ 0
    |                КОНЕЦ * Оплаты.ОплаченоВПериоде / СуммаДокумента.Стоимость
    |        КОНЕЦ
    |        ИНАЧЕ 0
    |    КОНЕЦ КАК ОплатаСтрокиВПериоде,
    |    Оплаты.ДатаОплатыВПериоде КАК ДатаОплатыВПериоде,
    |    Оплаты.ДатаОплаты КАК ДатаОплаты
    |ИЗ
    |    РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачалаПродаж, &ДатаОкончания, Секунда, ) КАК Продажи
    |        ЛЕВОЕ СОЕДИНЕНИЕ (
    |            ВЫБРАТЬ
    |                Расчеты.Основание КАК Основание,
    |                Расчеты.Контрагент КАК Контрагент,
    |                СУММА(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                        И Расчеты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                    ТОГДА Расчеты.СуммаПриход
    |                    ИНАЧЕ 0 КОНЕЦ) КАК ОплаченоВПериоде,
    |                СУММА(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                        И Расчеты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                        И Расчеты.Регистратор.ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.Наличные)
    |                    ТОГДА Расчеты.СуммаПриход ИНАЧЕ 0 КОНЕЦ) КАК ОплаченоНаличные,
    |                СУММА(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                        И Расчеты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                        И Расчеты.Регистратор.ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.ПлатежнаяКарта)
    |                    ТОГДА Расчеты.СуммаПриход ИНАЧЕ 0 КОНЕЦ) КАК ОплаченоПлатежнаяКарта,
    |                СУММА(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                        И Расчеты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                        И Расчеты.Регистратор.ТипДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ТипыДенежныхСредств.БезНаличные)
    |                    ТОГДА Расчеты.СуммаПриход ИНАЧЕ 0 КОНЕЦ) КАК ОплаченоБезналичные,
    |                МАКСИМУМ(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                        И Расчеты.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                    ТОГДА Расчеты.Период
    |                    ИНАЧЕ NULL КОНЕЦ) КАК ДатаОплатыВПериоде,
    |                МАКСИМУМ(ВЫБОР
    |                    КОГДА Расчеты.СуммаПриход > 0
    |                    ТОГДА Расчеты.Период
    |                    ИНАЧЕ NULL КОНЕЦ) КАК ДатаОплаты
    |            ИЗ
    |                РегистрНакопления.РасчетыСПокупателями.ОстаткиИОбороты(
    |                    &ДатаНачалаПродаж,
    |                    &ДатаОкончания,
    |                    Регистратор,
    |                    ,
    |                    ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
    |                        ИЛИ ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Рассрочка)) КАК Расчеты
    |            СГРУППИРОВАТЬ ПО
    |                Расчеты.Основание,
    |                Расчеты.Контрагент) КАК Оплаты
    |        ПО Продажи.ДокументПродажи = Оплаты.Основание
    |            И Продажи.Контрагент = Оплаты.Контрагент
    |        ЛЕВОЕ СОЕДИНЕНИЕ (
    |            ВЫБРАТЬ
    |                РасчетыЛС.Регистратор КАК ДокументПродажи,
    |                РасчетыЛС.Контрагент КАК Контрагент,
    |                СУММА(ВЫБОР
    |                    КОГДА РасчетыЛС.СуммаРасход > 0
    |                        И РасчетыЛС.Период МЕЖДУ &ДатаНачала И &ДатаОкончания
    |                    ТОГДА РасчетыЛС.СуммаРасход
    |                    ИНАЧЕ 0 КОНЕЦ) КАК ОплаченоЛицевойСчет
    |            ИЗ
    |                РегистрНакопления.РасчетыСПокупателями.ОстаткиИОбороты(
    |                    &ДатаНачалаПродаж,
    |                    &ДатаОкончания,
    |                    Регистратор,
    |                    ,
    |                    ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.ЛицевойСчет)) КАК РасчетыЛС
    |            СГРУППИРОВАТЬ ПО
    |                РасчетыЛС.Регистратор,
    |                РасчетыЛС.Контрагент) КАК ОплатыЛС
    |        ПО Продажи.ДокументПродажи = ОплатыЛС.ДокументПродажи
    |            И Продажи.Контрагент = ОплатыЛС.Контрагент
    |        ЛЕВОЕ СОЕДИНЕНИЕ (
    |            ВЫБРАТЬ
    |                ПродажиДок.ДокументПродажи КАК ДокументПродажи,
    |                ПродажиДок.Контрагент КАК Контрагент,
    |                СУММА(ВЫБОР
    |                    КОГДА ПродажиДок.Стоимость > 0
    |                    ТОГДА ПродажиДок.Стоимость
    |                    ИНАЧЕ 0 КОНЕЦ) КАК Стоимость
    |            ИЗ
    |                РегистрНакопления.ПродажиСебестоимость КАК ПродажиДок
    |            ГДЕ
    |                ПродажиДок.Стоимость > 0
    |            СГРУППИРОВАТЬ ПО
    |                ПродажиДок.ДокументПродажи,
    |                ПродажиДок.Контрагент) КАК СуммаДокумента
    |        ПО Продажи.ДокументПродажи = СуммаДокумента.ДокументПродажи
    |            И Продажи.Контрагент = СуммаДокумента.Контрагент
    |ГДЕ
    |    Продажи.Номенклатура В (&Номенклатура)
    |    И (НЕ &ФильтрСотрудник ИЛИ Продажи.Сотрудник = &Сотрудник)
    |    И (
    |        (Продажи.Период МЕЖДУ &ДатаНачала И &ДатаОкончания)
    |        ИЛИ (Оплаты.ДатаОплатыВПериоде ЕСТЬ НЕ NULL)
    |    )
    |    И (
    |        (Продажи.Сотрудник В (&Админы) И &ЕстьАдмины
    |            И НЕ Продажи.Номенклатура В (&НоменклатураАбонементы))
    |        ИЛИ Продажи.Номенклатура В (&НоменклатураАбонементы)
    |    )
    |    И Продажи.СтоимостьОборот <> 0";
КонецФункции

// Сводка bySaleType знает только membership | service | product.
// Строка продажи отдаёт massage | solarium | training отдельно.
Функция КлючСводкиSaleType(Тип)
    Если Тип = "massage" Или Тип = "solarium" Или Тип = "service" Тогда
        Возврат "service";
    КонецЕсли;
    Если Тип = "training" Или Тип = "membership" Тогда
        Возврат "membership";
    КонецЕсли;
    Возврат "product";
КонецФункции

Функция ОпределитьSaleType(Строка, Настройки)
    // ВАЖНО: сначала сегменты. ЧленствоПакетУслуг заполнен и у пакетов солярия
    // («Солярий 30/60») — из‑за этого раньше всё уходило в membership.
    Номенклатура = Строка.Номенклатура;

    Если НоменклатураВСегменте(Номенклатура, Настройки.СегментНоменклатурыМагазин) Тогда
        Возврат "product";
    КонецЕсли;
    Если НоменклатураВСегменте(Номенклатура, Настройки.СегментНоменклатурыМассаж) Тогда
        Возврат "massage";
    КонецЕсли;
    Если НоменклатураВСегменте(Номенклатура, Настройки.СегментНоменклатурыСолярий) Тогда
        Возврат "solarium";
    КонецЕсли;
    // До абонементов: пакет реформера остаётся membership, если его нет в «Тренировки».
    Если НоменклатураВСегменте(Номенклатура, Настройки.СегментНоменклатурыТренировки) Тогда
        Возврат "training";
    КонецЕсли;
    Если НоменклатураВСегменте(Номенклатура, Настройки.СегментНоменклатурыАбонементыИКП) Тогда
        Возврат "membership";
    КонецЕсли;

    // Fallback: пакет услуг, не попавший в сегменты массаж/солярий/магазин
    Если ЗначениеЗаполнено(Строка.ЧленствоПакетУслуг) Тогда
        Имя = НРег(Строка(Номенклатура));
        Если СтрНайти(Имя, "соляри") > 0 Тогда
            Возврат "service";
        КонецЕсли;
        Если СтрНайти(Имя, "массаж") > 0 Или СтрНайти(Имя, "спа") > 0 Тогда
            Возврат "service";
        КонецЕсли;
        Возврат "membership";
    КонецЕсли;

    Возврат "service";
КонецФункции

Функция НоменклатураВСегменте(Номенклатура, Сегмент)
    Если НЕ ЗначениеЗаполнено(Сегмент) Или НЕ ЗначениеЗаполнено(Номенклатура) Тогда
        Возврат Ложь;
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    1
    |ИЗ
    |    РегистрСведений.СоставСегментов КАК СоставСегментов
    |ГДЕ
    |    СоставСегментов.Сегмент = &Сегмент
    |    И СоставСегментов.ОбъектСегмента = &Номенклатура";

    Запрос.УстановитьПараметр("Сегмент", Сегмент);
    Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
    Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции

Функция ОпределитьСпособОплаты(Строка)
    Нал = Строка.ОплаченоНаличные;
    Карта = Строка.ОплаченоПлатежнаяКарта;
    Безнал = Строка.ОплаченоБезналичные;
    Лицевой = 0;
    Попытка
        Лицевой = Строка.ОплаченоЛицевойСчет;
    Исключение
        Лицевой = 0;
    КонецПопытки;
    Количество = 0;
    Если Нал > 0 Тогда Количество = Количество + 1; КонецЕсли;
    Если Карта > 0 Тогда Количество = Количество + 1; КонецЕсли;
    Если Безнал > 0 Тогда Количество = Количество + 1; КонецЕсли;
    Если Лицевой > 0 Тогда Количество = Количество + 1; КонецЕсли;
    Если Количество > 1 Тогда Возврат "mixed"; КонецЕсли;
    Если Карта > 0 Тогда Возврат "card"; КонецЕсли;
    Если Нал > 0 Тогда Возврат "cash"; КонецЕсли;
    Если Безнал > 0 Тогда Возврат "cashless"; КонецЕсли;
    Если Лицевой > 0 Тогда Возврат "personalAccount"; КонецЕсли;
    Если Строка.ОплаченоВПериоде > 0 Или Лицевой > 0 Тогда Возврат "unknown"; КонецЕсли;
    Возврат "unknown";
КонецФункции

Функция ОпределитьAttributionMode(SaleType)
    Если SaleType = "membership" Тогда
        Возврат "shiftShare";
    КонецЕсли;
    Возврат "individual";
КонецФункции

Функция РазмерСмены(SaleType)
  // TODO: из ВТ КоличествоПродавцов в Template.xml; пока фиксированная пара
    Если SaleType = "membership" Тогда
        Возврат 2;
    КонецЕсли;
    Возврат 1;
КонецФункции

Функция ВычислитьAmountAttributed(Строка, Настройки)
    // Для сверки с «Оплата с учетом возврата» — доля оплаты в периоде (не полная продажа).
    База = Строка.ОплатаСтрокиВПериоде;
    Если База = 0 Тогда
        База = Строка.ПродажаСтоимость - Строка.ВозвратСтоимость;
    КонецЕсли;
    SaleType = ОпределитьSaleType(Строка, Настройки);
    Если SaleType = "membership" Тогда
        Возврат База / РазмерСмены(SaleType);
    КонецЕсли;
    Возврат База;
КонецФункции

Функция СтрокаПродажиВJSON(Строка, Настройки)
    SaleType = ОпределитьSaleType(Строка, Настройки);
    AttributionMode = ОпределитьAttributionMode(SaleType);
    ShiftSize = РазмерСмены(SaleType);
    AmountAttributed = ВычислитьAmountAttributed(Строка, Настройки);

    // amount = доля оплаты в периоде (как колонка отчёта FFS), иначе стоимость продажи
    Если Строка.ОплатаСтрокиВПериоде > 0 Тогда
        СуммаДляFitGO = Строка.ОплатаСтрокиВПериоде;
    Иначе
        СуммаДляFitGO = Строка.ПродажаСтоимость;
    КонецЕсли;

    ОплаченоЛС = 0;
    Попытка
        ОплаченоЛС = Строка.ОплаченоЛицевойСчет;
    Исключение
        ОплаченоЛС = 0;
    КонецПопытки;

    // Доля строки в оплатах документа (нал/карта/безнал/ЛС).
    Коэффициент = 0;
    БазаДокумента = Строка.ОплаченоВПериоде + ОплаченоЛС;
    Если БазаДокумента > 0 И Строка.СуммаДокумента > 0 И Строка.ПродажаСтоимость > 0 Тогда
        Коэффициент = Строка.ПродажаСтоимость / Строка.СуммаДокумента;
    ИначеЕсли Строка.ОплатаСтрокиВПериоде > 0 И Строка.ОплаченоВПериоде > 0 Тогда
        Коэффициент = Строка.ОплатаСтрокиВПериоде / Строка.ОплаченоВПериоде;
    КонецЕсли;

    Cash = ОкруглитьДолю(Строка.ОплаченоНаличные, Коэффициент);
    Card = ОкруглитьДолю(Строка.ОплаченоПлатежнаяКарта, Коэффициент);
    Cashless = ОкруглитьДолю(Строка.ОплаченоБезналичные, Коэффициент);
    PersonalAccount = ОкруглитьДолю(ОплаченоЛС, Коэффициент);
    PaidAmount = Строка.ОплатаСтрокиВПериоде + PersonalAccount;

    OperationType = "sale";
    Если Строка.ВозвратСтоимость > 0 И Строка.ПродажаСтоимость = 0 Тогда
        OperationType = "refund";
    ИначеЕсли PaidAmount <= 0 И Строка.ПродажаСтоимость > 0 Тогда
        OperationType = "unpaid";
    ИначеЕсли PaidAmount > 0 Тогда
        OperationType = "payment";
    КонецЕсли;

    Элемент = Новый Структура;
    // Уникальный ключ строки (документ может иметь несколько номенклатур)
    КлючСтроки = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.ДокументПродажи)
        + ":" + FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Номенклатура)
        + ":" + Формат(Строка.Период, "ДФ=yyyyMMddHHmmss");
    Элемент.Вставить("saleDocumentId", КлючСтроки);
    Элемент.Вставить("documentId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.ДокументПродажи));
    Элемент.Вставить("operationType", OperationType);
    Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    Если ЗначениеЗаполнено(Строка.ДатаОплатыВПериоде) И PaidAmount > 0 Тогда
        Элемент.Вставить("paidAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.ДатаОплатыВПериоде));
    ИначеЕсли PaidAmount > 0 И ЗначениеЗаполнено(Строка.ДатаОплаты) Тогда
        Элемент.Вставить("paidAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.ДатаОплаты));
    КонецЕсли;
    Элемент.Вставить("amount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(СуммаДляFitGO));
    Элемент.Вставить("saleAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Строка.ПродажаСтоимость));
    Элемент.Вставить("amountAttributed", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(AmountAttributed));
    Элемент.Вставить("attributionMode", AttributionMode);
    Элемент.Вставить("shiftSize", ShiftSize);
    Элемент.Вставить("paidAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(PaidAmount));
    Элемент.Вставить("refundAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Строка.ВозвратСтоимость));
    Элемент.Вставить("cash", Cash);
    Элемент.Вставить("card", Card);
    Элемент.Вставить("cashless", Cashless);
    Элемент.Вставить("personalAccount", PersonalAccount);
    Элемент.Вставить("paymentMethod", ОпределитьСпособОплаты(Строка));
    Элемент.Вставить("saleType", SaleType);
    Элемент.Вставить("productName", Строка(Строка.Номенклатура));
    Элемент.Вставить("clientExternalId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент));
    Элемент.Вставить("clientName", Строка(Строка.Контрагент));
    Если ЗначениеЗаполнено(Строка.Сотрудник) Тогда
        Элемент.Вставить("employeeExternalId", СокрЛП(Строка(Строка.Сотрудник.Код)));
        Элемент.Вставить("employeeName", Строка(Строка.Сотрудник));
    Иначе
        Элемент.Вставить("employeeExternalId", "");
        Элемент.Вставить("employeeName", "");
    КонецЕсли;
    Элемент.Вставить("countsTowardIncome", OperationType = "payment" Или OperationType = "refund");
    Элемент.Вставить("countsTowardMotivation", OperationType = "payment");
    Возврат Элемент;
КонецФункции

Функция ОкруглитьДолю(СуммаДокумента, Коэффициент)
    Если СуммаДокумента <= 0 Или Коэффициент <= 0 Тогда
        Возврат 0;
    КонецЕсли;
    Возврат FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(СуммаДокумента * Коэффициент);
КонецФункции

Функция ВыполнитьЗапросДвиженийЛицевогоСчета(ДатаНачала, ДатаОкончания, Сотрудник)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Расчеты.Период КАК Период,
    |    Расчеты.Регистратор КАК Регистратор,
    |    Расчеты.Контрагент КАК Контрагент,
    |    Расчеты.Основание КАК Основание,
    |    Расчеты.СуммаПриход КАК СуммаПриход,
    |    Расчеты.СуммаРасход КАК СуммаРасход,
    |    Расчеты.Регистратор.ТипДенежныхСредств КАК ТипДенежныхСредств
    |ИЗ
    |    РегистрНакопления.РасчетыСПокупателями.ОстаткиИОбороты(
    |        &ДатаНачала,
    |        &ДатаОкончания,
    |        Регистратор,
    |        ,
    |        ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.ЛицевойСчет)) КАК Расчеты
    |ГДЕ
    |    (Расчеты.СуммаПриход <> 0 ИЛИ Расчеты.СуммаРасход <> 0)";
    Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
    Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

    Попытка
        Таблица = Запрос.Выполнить().Выгрузить();
    Исключение
        Возврат Новый Массив;
    КонецПопытки;

    Результат = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        // Оплата услуг с ЛС (Расход + Основание = документ продажи) уже в строках продаж.
        // Сгорание часто тоже имеет Основание (абонемент) — отличаем по типу регистратора.
        Если Строка.СуммаРасход > 0 И ЗначениеЗаполнено(Строка.Основание) Тогда
            ИмяТипа = "";
            Попытка
                ИмяТипа = НРег(Строка(ТипЗнч(Строка.Регистратор)));
            Исключение
                ИмяТипа = "";
            КонецПопытки;
            ЭтоСписание = СтрНайти(ИмяТипа, "списан") > 0
                Или СтрНайти(ИмяТипа, "корректир") > 0
                Или СтрНайти(ИмяТипа, "закрыт") > 0;
            Если НЕ ЭтоСписание Тогда
                Продолжить;
            КонецЕсли;
        КонецЕсли;
        Результат.Добавить(Строка);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ДвижениеЛицевогоСчетаВJSON(Строка)
    OperationType = "personal_credit";
    Amount = 0;
    Cash = 0;
    Card = 0;
    Cashless = 0;
    PersonalAccount = 0;
    ProductName = "";

    Если Строка.СуммаПриход > 0 Тогда
        Amount = Строка.СуммаПриход;
        // Взнос живыми деньгами: есть тип ДС и нет основания-продажи (или основание = сам документ).
        ОснованиеПродажа = ЗначениеЗаполнено(Строка.Основание)
            И Строка.Основание <> Строка.Регистратор;
        Если ОснованиеПродажа Тогда
            // Начисление на ЛС при продаже абонемента («Прочие поступления»).
            OperationType = "personal_credit";
            PersonalAccount = Amount;
            ProductName = "Прочие поступления (начисление на ЛС)";
        ИначеЕсли ЗначениеЗаполнено(Строка.ТипДенежныхСредств) Тогда
            OperationType = "personal_deposit";
            Если Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.Наличные Тогда
                Cash = Amount;
            ИначеЕсли Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.ПлатежнаяКарта Тогда
                Card = Amount;
            ИначеЕсли Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.БезНаличные Тогда
                Cashless = Amount;
            Иначе
                Cash = Amount;
            КонецЕсли;
            ProductName = "Взнос на лицевой счет";
        Иначе
            OperationType = "personal_credit";
            PersonalAccount = Amount;
            ProductName = "Прочие поступления (начисление на ЛС)";
        КонецЕсли;
    ИначеЕсли Строка.СуммаРасход > 0 Тогда
        // Сгорание остатка ЛС. Оплату продажи с ЛС здесь не отдаём (есть в scope=cash).
        ИмяТипа = "";
        Попытка
            ИмяТипа = НРег(Строка(ТипЗнч(Строка.Регистратор)));
        Исключение
            ИмяТипа = "";
        КонецПопытки;
        ЭтоЯвноеСгорание = СтрНайти(ИмяТипа, "сгоран") > 0
            Или СтрНайти(ИмяТипа, "обнулен") > 0
            Или СтрНайти(ИмяТипа, "корректир") > 0
            Или СтрНайти(ИмяТипа, "истеч") > 0
            Или СтрНайти(ИмяТипа, "аннул") > 0
            Или СтрНайти(ИмяТипа, "закрытиедня") > 0
            Или СтрНайти(ИмяТипа, "закрытидня") > 0;
        ЭтоБезнал = ЗначениеЗаполнено(Строка.ТипДенежныхСредств)
            И Строка.ТипДенежныхСредств = Перечисления.ТипыДенежныхСредств.БезНаличные;
        ЕстьОснованиеПродажи = ЗначениеЗаполнено(Строка.Основание)
            И Строка.Основание <> Строка.Регистратор;
        Если ЭтоЯвноеСгорание Или ЭтоБезнал Или НЕ ЕстьОснованиеПродажи Тогда
            OperationType = "personal_burn";
            Amount = -Строка.СуммаРасход;
            PersonalAccount = Amount;
            ProductName = "Сгорание лицевого счета";
        Иначе
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;

    PaymentMethod = "personalAccount";
    Если Cash > 0 И Card = 0 И Cashless = 0 Тогда
        PaymentMethod = "cash";
    ИначеЕсли Card > 0 И Cash = 0 И Cashless = 0 Тогда
        PaymentMethod = "card";
    ИначеЕсли Cashless > 0 И Cash = 0 И Card = 0 Тогда
        PaymentMethod = "cashless";
    ИначеЕсли (Cash + Card + Cashless) > 0 Тогда
        PaymentMethod = "mixed";
    КонецЕсли;

    Ключ = FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Регистратор)
        + ":pa:" + FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент)
        + ":" + Формат(Строка.Период, "ДФ=yyyyMMddHHmmss")
        + ":" + OperationType;

    Элемент = Новый Структура;
    Элемент.Вставить("saleDocumentId", Ключ);
    Элемент.Вставить("documentId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Регистратор));
    Элемент.Вставить("operationType", OperationType);
    Элемент.Вставить("soldAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    Если OperationType = "personal_deposit" Тогда
        Элемент.Вставить("paidAt", FitGOAnalyticsОбщегоНазначения.ISOДатаВремя(Строка.Период));
    КонецЕсли;
    Элемент.Вставить("amount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Amount));
    Элемент.Вставить("saleAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(?(Amount > 0, Amount, 0)));
    Элемент.Вставить("paidAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(?(OperationType = "personal_deposit", Amount, 0)));
    Элемент.Вставить("refundAmount", 0);
    Элемент.Вставить("cash", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Cash));
    Элемент.Вставить("card", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Card));
    Элемент.Вставить("cashless", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Cashless));
    Элемент.Вставить("personalAccount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(PersonalAccount));
    Элемент.Вставить("paymentMethod", PaymentMethod);
    Элемент.Вставить("saleType", "service");
    Элемент.Вставить("productName", ProductName);
    Элемент.Вставить("clientExternalId", FitGOAnalyticsОбщегоНазначения.UUIDСсылка(Строка.Контрагент));
    Элемент.Вставить("clientName", Строка(Строка.Контрагент));
    СотрудникДок = СотрудникИзДокумента(Строка.Регистратор);
    Если ПустаяСтрока(СотрудникДок.Код) И ЗначениеЗаполнено(Строка.Основание) Тогда
        СотрудникДок = СотрудникИзДокумента(Строка.Основание);
    КонецЕсли;
    Элемент.Вставить("employeeExternalId", СотрудникДок.Код);
    Элемент.Вставить("employeeName", СотрудникДок.Имя);
    Элемент.Вставить("countsTowardIncome", OperationType = "personal_deposit");
    Элемент.Вставить("countsTowardMotivation", OperationType = "personal_deposit");
    Возврат Элемент;
КонецФункции

Функция НовыйАгрегатСотрудника(Строка)
    Агрегат = Новый Структура;
    Агрегат.Вставить("employee", Строка.Сотрудник);
    Агрегат.Вставить("salesCount", 0);
    Агрегат.Вставить("salesAmount", 0);
    Агрегат.Вставить("refundAmount", 0);
    Агрегат.Вставить("bySaleType", Новый Структура("membership, service, product", 0, 0, 0));
    Возврат Агрегат;
КонецФункции

Процедура ДобавитьВАгрегатСотрудника(Агрегат, Строка, Настройки)
    Агрегат.salesCount = Агрегат.salesCount + 1;
    Атрибутированная = ВычислитьAmountAttributed(Строка, Настройки);
    Агрегат.salesAmount = Агрегат.salesAmount + Атрибутированная;
    Тип = КлючСводкиSaleType(ОпределитьSaleType(Строка, Настройки));
    Агрегат.bySaleType[Тип] = Агрегат.bySaleType[Тип] + Атрибутированная;
КонецПроцедуры

Функция АгрегатСотрудникаВJSON(Агрегат)
    Элемент = Новый Структура;
    Элемент.Вставить("employeeExternalId", СокрЛП(Строка(Агрегат.employee.Код)));
    Элемент.Вставить("employeeName", Строка(Агрегат.employee));
    Элемент.Вставить("salesCount", Агрегат.salesCount);
    Элемент.Вставить("salesAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Агрегат.salesAmount));
    Элемент.Вставить("refundAmount", 0);
    Элемент.Вставить("netAmount", FitGOAnalyticsОбщегоНазначения.ОкруглитьДеньги(Агрегат.salesAmount));
    Элемент.Вставить("bySaleType", ОкруглитьСтруктуруДенег(Агрегат.bySaleType));
    Возврат Элемент;
КонецФункции

Функция НовыйАгрегатДня(День)
    Агрегат = Новый Структура;
    Агрегат.Вставить("date", День);
    Агрегат.Вставить("salesCount", 0);
    Агрегат.Вставить("grossAmount", 0);
    Агрегат.Вставить("refundAmount", 0);
