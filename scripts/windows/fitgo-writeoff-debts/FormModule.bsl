// Модуль формы FitGO_СписаниеСтарыхДолгов
// Реквизиты на ОБЪЕКТЕ: ГодСписания, ДатаНачала, ДатаОкончания, ЛимитСтрок, Лог
// Команды: ПрименитьГод, ПросмотрПометки, Пометить, ОтменитьПометки,
//          Просмотр, Списать, ОтменитьFitGO
//
// Порядок: 1) Пометить — неоплаченные продажи без использования уходят целиком;
//          2) Списать — оставшимся (использованным / частично оплаченным) прощается долг.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.ГодСписания = 0 Тогда
		Объект.ГодСписания = 2019;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПрименитьГодНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьГод(Команда)
	ПрименитьГодНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьГодНаСервере()

	Если Объект.ГодСписания > 0 Тогда
		Об = РеквизитФормыВЗначение("Объект");
		Д = Об.ДатыПоГоду(Объект.ГодСписания);
		Объект.ДатаНачала = Д.ДатаНачала;
		Объект.ДатаОкончания = Д.ДатаОкончания;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Просмотр(Команда)
	Текст = ВыполнитьНаСервере(Истина);
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура Списать(Команда)

	ТекстВопроса =
		"Создать и провести СписаниеЗадолженности за продажи "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "Продажи и занятия останутся, остатки пакетов не закрываются."
		+ Символы.ПС
		+ "Перед этим «Просмотр» и проверка суммы.";
	Если Объект.ЛимитСтрок > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Лимит строк: " + Объект.ЛимитСтрок;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("СписатьПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СписатьПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ВыполнитьНаСервере(Ложь);
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьFitGO(Команда)

	ТекстВопроса = "Отменить проведение всех СписаниеЗадолженности с комментарием FitGO за "
		+ Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "(отменяется по дате ДОКУМЕНТА списания = сегодня, не по году продаж)";

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОтменитьFitGOПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьFitGOПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОтменитьFitGOНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПросмотрПометки(Команда)
	Текст = ПометитьНаСервере(Истина);
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура Пометить(Команда)

	ТекстВопроса =
		"Пометить на удаление неоплаченные продажи "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "Уйдут долг и пакет. Использованные 1С пометить не даст — они останутся для «Списать»."
		+ Символы.ПС
		+ "«Удаление помеченных» НЕ запускать.";
	Если Объект.ЛимитСтрок > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Лимит строк: " + Объект.ЛимитСтрок;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПометитьПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ПометитьНаСервере(Ложь);
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПометки(Команда)

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОтменитьПометкиПослеВопроса", ЭтотОбъект),
		"Снять пометку и провести заново ВСЕ продажи, помеченные этой обработкой (за любые даты)?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПометкиПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОтменитьПометкиНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаСервере
Функция ПометитьНаСервере(ТолькоПросмотр)

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ПометитьПродажи(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ЛимитСтрок,
		ТолькоПросмотр);

КонецФункции

&НаСервере
Функция ОтменитьПометкиНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ОтменитьПометкиFitGO();

КонецФункции

&НаСервере
Функция ВыполнитьНаСервере(ТолькоПросмотр)

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ВыполнитьСписание(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ЛимитСтрок,
		ТолькоПросмотр);

КонецФункции

&НаСервере
Функция ОтменитьFitGOНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Сегодня = ТекущаяДатаСеанса();
	Возврат Об.ОтменитьСписанияFitGO(НачалоДня(Сегодня), КонецДня(Сегодня));

КонецФункции
