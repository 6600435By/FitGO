// Модуль формы FitGO_СписаниеСтарыхДолгов
// Реквизиты на ОБЪЕКТЕ: ГодСписания, ДатаНачала, ДатаОкончания, ЛимитСтрок, Лог,
//   СчетКлуба, ДатаОплатыИзДоговора
// Команды: ПрименитьГод, ПросмотрПометки, Пометить, ОтменитьПометки,
//          Просмотр, Списать, ОтменитьFitGO,
//          ПросмотрКорпо, ОплатитьКорпо, ОтменитьКорпоFitGO, ПробаМетаданныхКорпо
//
// Порядок: 1) Пометить — неоплаченные продажи без использования уходят целиком;
//          2) Списать — оставшимся (использованным / частично оплаченным) прощается долг;
//          3) Оплатить корпо — ПоступлениеДенежныхСредств по каждому корп. договору.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.ГодСписания = 0 Тогда
		Объект.ГодСписания = 2019;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ПрименитьГодНаСервере();
	КонецЕсли;
	// Зачисление на дату начала договора (не «сегодня»). Снять галку → дата = конец периода.
	Объект.ДатаОплатыИзДоговора = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьГод(Команда)
	ПрименитьГодНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьГодНаСервере()

	Если Объект.ГодСписания > 0 Тогда
		Об = РеквизитФормыВЗначение("Объект");
		Д = Об.ДатыПоГоду(Объект.ГодСписания);
		Объект.ДатаНачала = Д.ДатаНачала;
		Объект.ДатаОкончания = Д.ДатаОкончания;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Просмотр(Команда)
	Текст = ВыполнитьНаСервере(Истина);
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура Списать(Команда)

	ТекстВопроса =
		"Создать и провести СписаниеЗадолженности за продажи "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "Продажи и занятия останутся, остатки пакетов не закрываются."
		+ Символы.ПС
		+ "Перед этим «Просмотр» и проверка суммы.";
	Если Объект.ЛимитСтрок > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Лимит строк: " + Объект.ЛимитСтрок;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("СписатьПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СписатьПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ВыполнитьНаСервере(Ложь);
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьFitGO(Команда)

	ТекстВопроса = "Отменить проведение всех СписаниеЗадолженности с комментарием FitGO за "
		+ Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "(отменяется по дате ДОКУМЕНТА списания = сегодня, не по году продаж)";

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОтменитьFitGOПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьFitGOПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОтменитьFitGOНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПросмотрПометки(Команда)
	Текст = ПометитьНаСервере(Истина);
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура Пометить(Команда)

	ТекстВопроса =
		"Пометить на удаление неоплаченные продажи "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "Уйдут долг и пакет. Использованные 1С пометить не даст — они останутся для «Списать»."
		+ Символы.ПС
		+ "«Удаление помеченных» НЕ запускать.";
	Если Объект.ЛимитСтрок > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Лимит строк: " + Объект.ЛимитСтрок;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПометитьПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПометитьПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ПометитьНаСервере(Ложь);
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПометки(Команда)

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОтменитьПометкиПослеВопроса", ЭтотОбъект),
		"Снять пометку и провести заново ВСЕ продажи, помеченные этой обработкой (за любые даты)?",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПометкиПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОтменитьПометкиНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПросмотрКорпо(Команда)
	Текст = ОплатитьКорпоНаСервере(Истина);
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьКорпо(Команда)

	ТекстВопроса =
		"Создать и провести ПоступлениеДенежныхСредств (безнал, оплата по корп. договору) "
		+ "за период "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "По одному документу на каждый договор с неоплаченными продажами."
		+ Символы.ПС
		+ ?(Объект.ДатаОплатыИзДоговора,
			"Дата документа = дата начала договора (зачисление «тогда»).",
			"Дата документа = конец периода продаж.")
		+ Символы.ПС
		+ "Это попадает в безнал/выручку — только если деньги уже были / согласовали с бухгалтерией."
		+ Символы.ПС
		+ "Сначала «3. Просмотр корпо».";
	Если Объект.ЛимитСтрок > 0 Тогда
		ТекстВопроса = ТекстВопроса + Символы.ПС + "Лимит договоров: " + Объект.ЛимитСтрок;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОплатитьКорпоПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОплатитьКорпоПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОплатитьКорпоНаСервере(Ложь);
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьКорпоFitGO(Команда)

	ТекстВопроса =
		"Отменить проведение ПоступлениеДенежныхСредств с комментарием FitGO за период продаж "
		+ Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy") + " — "
		+ Формат(Объект.ДатаОкончания, "ДФ=dd.MM.yyyy") + "?"
		+ Символы.ПС
		+ "(по метке в комментарии; дата документа может быть датой начала договора)";

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ОтменитьКорпоFitGOПослеВопроса", ЭтотОбъект),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьКорпоFitGOПослеВопроса(Результат, ДопПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Текст = ОтменитьКорпоFitGOНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);

КонецПроцедуры

&НаКлиенте
Процедура ПробаМетаданныхКорпо(Команда)
	Текст = ПробаМетаданныхКорпоНаСервере();
	Объект.Лог = Текст;
	Сообщить(Текст);
КонецПроцедуры

&НаСервере
Функция ПометитьНаСервере(ТолькоПросмотр)

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ПометитьПродажи(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ЛимитСтрок,
		ТолькоПросмотр);

КонецФункции

&НаСервере
Функция ОтменитьПометкиНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ОтменитьПометкиFitGO();

КонецФункции

&НаСервере
Функция ВыполнитьНаСервере(ТолькоПросмотр)

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ВыполнитьСписание(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.ЛимитСтрок,
		ТолькоПросмотр);

КонецФункции

&НаСервере
Функция ОтменитьFitGOНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Сегодня = ТекущаяДатаСеанса();
	Возврат Об.ОтменитьСписанияFitGO(НачалоДня(Сегодня), КонецДня(Сегодня));

КонецФункции

&НаСервере
Функция ОплатитьКорпоНаСервере(ТолькоПросмотр)

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ВыполнитьОплатуКорпо(
		Объект.ДатаНачала,
		Объект.ДатаОкончания,
		Объект.СчетКлуба,
		Объект.ЛимитСтрок,
		ТолькоПросмотр,
		Объект.ДатаОплатыИзДоговора);

КонецФункции

&НаСервере
Функция ОтменитьКорпоFitGOНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ОтменитьОплатыКорпоFitGO(Объект.ДатаНачала, Объект.ДатаОкончания);

КонецФункции

&НаСервере
Функция ПробаМетаданныхКорпоНаСервере()

	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.ПробаМетаданныхКорпо();

КонецФункции
