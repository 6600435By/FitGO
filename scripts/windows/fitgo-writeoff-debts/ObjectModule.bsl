// Модуль объекта внешней обработки FitGO_СписаниеСтарыхДолгов
// Продажи периода → Документ.СписаниеЗадолженности (продажа и занятия остаются).
// Реквизиты объекта: ГодСписания, ДатаНачала, ДатаОкончания, ЛимитСтрок, Лог
// ВАЖНО: не использовать имя «Лог» для локальных переменных — это реквизит (Строка).
//
// Сумма к списанию (как рецепция «Оплатить», не как Отчет.НеоплаченныеПродажи):
//   - только отрицательный остаток ТипРасчета = Долг по основанию-продаже;
//   - не больше |общего баланса клиента| по всем основаниям и типам, иначе
//     списание создаст «Долг перед клиентом» (инцидент 2026-09-26, Бределев);
//   - клиент с балансом >= 0 пропускается целиком.
// Остаток пакета списание не закрывает: неиспользованные пакеты — отдельный шаг.
//
// Пометка на удаление (ПометитьПродажи): ни одной оплаты по продаже — продажа
// снимается с проведения и помечается, уходят и долг, и пакет. Если услуга уже
// использована, 1С не даст снять проведение — такие остаются для «Списать».
// Помеченные получают в Комментарий метку МеткаПометки() для отката.
// «Удаление помеченных» НЕ запускать.
//
// Продажи с заполненным Справочник.КорпоративныеДоговоры в поле Договор
// не помечаем и не списываем — их закрывает акт + поступление ДС от организации
// (см. README, раздел «Корпоративные договоры»).

#Область ПрограммныйИнтерфейс

Функция ПометитьПродажи(ДатаНачала, ДатаОкончания, ЛимитСтрок, ТолькоПросмотр) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ПОМЕТКА продаж: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ?(ТолькоПросмотр, " [ПРОСМОТР]", " [ЗАПИСЬ]"));

	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: ДатаНачала > ДатаОкончания");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Таблица = ПолучитьНеоплаченныеПродажи(ДатаНачала, ДатаОкончания);
	ПолностьюНеоплачены = Таблица.НайтиСтроки(Новый Структура("БылиОплаты", Ложь));
	СОплатами = Таблица.НайтиСтроки(Новый Структура("БылиОплаты", Истина));

	СуммаК = 0;
	Для Каждого Стр Из ПолностьюНеоплачены Цикл
		СуммаК = СуммаК + Стр.Задолженность;
	КонецЦикла;
	ДобавитьСтрокуЛога(СтрокиЛога, "Без единой оплаты (к пометке): " + ПолностьюНеоплачены.Количество()
		+ " на " + Формат(СуммаК, "ЧДЦ=2; ЧН=0"));
	ДобавитьСтрокуЛога(СтрокиЛога, "Частично оплачены (не трогаем, потом «Списать»): " + СОплатами.Количество());

	Если Не ЕстьКомментарийУРеализации() Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ВНИМАНИЕ: у Документ.Реализация нет реквизита Комментарий — откат кнопкой невозможен, сохраните этот лог.");
	КонецЕсли;

	Если ТолькоПросмотр Тогда
		Н = 0;
		Для Каждого Стр Из ПолностьюНеоплачены Цикл
			Н = Н + 1;
			Если Н > 50 Тогда
				ДобавитьСтрокуЛога(СтрокиЛога, "... ещё " + (ПолностьюНеоплачены.Количество() - 50) + " строк");
				Прервать;
			КонецЕсли;
			ДобавитьСтрокуЛога(СтрокиЛога, СтрокаПродажи(Стр));
		КонецЦикла;
		ДобавитьСтрокуЛога(СтрокиЛога, "РЕЖИМ ПРОСМОТРА: ничего не помечено. Нажмите «Пометить».");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Помечено = 0;
	Использованы = 0;
	Обработано = 0;
	Для Каждого Стр Из ПолностьюНеоплачены Цикл
		Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "Достигнут ЛимитСтрок=" + ЛимитСтрок);
			Прервать;
		КонецЕсли;
		Обработано = Обработано + 1;
		Попытка
			ПометитьДокумент(Стр.ДокументПродажи);
			Помечено = Помечено + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "DEL " + СтрокаПродажи(Стр));
		Исключение
			// Сообщения платформы («основание для Занятие») — ожидаемый SKIP, не авария.
			Попытка
				ПолучитьСообщенияПользователю(Истина);
			Исключение
			КонецПопытки;
			Использованы = Использованы + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "SKIP (занятие/блокировка) " + СтрокаПродажи(Стр));
		КонецПопытки;
	КонецЦикла;

	ИтогТекст = "ИТОГО: помечено=" + Помечено
		+ " | пропущено (есть занятие и т.п.)=" + Использованы
		+ " | их потом закроет «Списать»";
	СтрокиЛога.Вставить(1, ИтогТекст);
	ДобавитьСтрокуЛога(СтрокиЛога, ИтогТекст);
	Если Использованы > 0 Тогда
		ДобавитьСтрокуЛога(СтрокиЛога,
			"Сообщения «основание для Занятие» — норма: продажа использована, пометку нельзя. Не ошибка.");
	КонецЕсли;
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

Функция ОтменитьПометкиFitGO() Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ОТКАТ пометок FitGO (" + МеткаПометки() + ")");

	Если Не ЕстьКомментарийУРеализации() Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: у Документ.Реализация нет Комментария — откат вручную по логу пометки.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Реализация КАК Док
	|ГДЕ
	|	Док.ПометкаУдаления
	|	И Док.Комментарий ПОДОБНО &Метка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата";
	Запрос.УстановитьПараметр("Метка", "%" + МеткаПометки() + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Восстановлено = 0;
	Ошибки = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.Комментарий = СокрЛП(СтрЗаменить(Об.Комментарий, МеткаПометки(), ""));
			Об.ПометкаУдаления = Ложь;
			Об.Записать(РежимЗаписиДокумента.Проведение);
			Восстановлено = Восстановлено + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "RESTORE " + Строка(Выборка.Ссылка));
		Исключение
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Строка(Выборка.Ссылка) + ": "
				+ ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого восстановлено=" + Восстановлено + " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

// ТолькоПросмотр = Истина → документы не создаются, только текст в результат.
Функция ВыполнитьСписание(ДатаНачала, ДатаОкончания, ЛимитСтрок, ТолькоПросмотр) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ?(ТолькоПросмотр, " [ПРОСМОТР]", " [ЗАПИСЬ]"));

	Если Метаданные.Документы.Найти("СписаниеЗадолженности") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: Документ.СписаниеЗадолженности не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: ДатаНачала > ДатаОкончания");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Исходная = ПолучитьДолги(ДатаНачала, ДатаОкончания);
	ДобавитьСтрокуЛога(СтрокиЛога, "Продаж с долгом (тип «Долг»): " + Исходная.Количество());

	Таблица = Исходная.СкопироватьКолонки();
	Пропущенные = Исходная.СкопироватьКолонки();
	ЛимитКлиента = Новый Соответствие;
	Для Каждого Стр Из Исходная Цикл
		Лимит = ЛимитКлиента.Получить(Стр.Контрагент);
		Если Лимит = Неопределено Тогда
			Лимит = ?(Стр.БалансКлиента < 0, -Стр.БалансКлиента, 0);
		КонецЕсли;
		Сумма = Мин(Стр.Задолженность, Лимит);
		Если Сумма > 0.009 Тогда
			Нов = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нов, Стр);
			Нов.Задолженность = Окр(Сумма, 2);
			Лимит = Лимит - Нов.Задолженность;
		Иначе
			ЗаполнитьЗначенияСвойств(Пропущенные.Добавить(), Стр);
		КонецЕсли;
		ЛимитКлиента.Вставить(Стр.Контрагент, Лимит);
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "К списанию: " + Таблица.Количество()
		+ " строк на " + Формат(Таблица.Итог("Задолженность"), "ЧДЦ=2; ЧН=0"));
	ДобавитьСтрокуЛога(СтрокиЛога, "Пропущено (долг перекрыт деньгами клиента на других основаниях): "
		+ Пропущенные.Количество() + " строк на "
		+ Формат(Пропущенные.Итог("Задолженность"), "ЧДЦ=2; ЧН=0"));

	Если Таблица.Количество() = 0 Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "Нечего списывать.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если ТолькоПросмотр Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "--- к списанию ---");
		ДобавитьСтрокиТаблицы(СтрокиЛога, Таблица, 50);
		Если Пропущенные.Количество() > 0 Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "--- пропущено (баланс клиента в скобках) ---");
			ДобавитьСтрокиТаблицы(СтрокиЛога, Пропущенные, 20);
		КонецЕсли;
		ДобавитьСтрокуЛога(СтрокиЛога, "РЕЖИМ ПРОСМОТРА: документы не созданы. Нажмите «Списать».");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	ТекКлиент = Неопределено;
	ТекСЕ = Неопределено;
	ДокОбъект = Неопределено;
	Создано = 0;
	СтрокВДоках = 0;
	Ошибки = 0;
	Обработано = 0;

	Для Каждого Стр Из Таблица Цикл

		Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "Достигнут ЛимитСтрок=" + ЛимитСтрок);
			Прервать;
		КонецЕсли;

		НуженНовый = (ДокОбъект = Неопределено)
			Или (Стр.Контрагент <> ТекКлиент)
			Или (Стр.СтруктурнаяЕдиница <> ТекСЕ);

		Если НуженНовый Тогда
			Если ДокОбъект <> Неопределено Тогда
				РезультатЗаписи = ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания);
				Если РезультатЗаписи.Ок Тогда
					Создано = Создано + 1;
					ДобавитьСтрокуЛога(СтрокиЛога, "OK " + РезультатЗаписи.Текст);
				Иначе
					Ошибки = Ошибки + 1;
					ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + РезультатЗаписи.Текст);
				КонецЕсли;
			КонецЕсли;

			ДокОбъект = Документы.СписаниеЗадолженности.СоздатьДокумент();
			ДокОбъект.Дата = ТекущаяДатаСеанса();
			ДокОбъект.СтруктурнаяЕдиница = Стр.СтруктурнаяЕдиница;
			Попытка
				ДокОбъект.Контрагент = Стр.Контрагент;
			Исключение
			КонецПопытки;
			ДокОбъект.РасшифровкаСписания.Очистить();
			ТекКлиент = Стр.Контрагент;
			ТекСЕ = Стр.СтруктурнаяЕдиница;
		КонецЕсли;

		Нов = ДокОбъект.РасшифровкаСписания.Добавить();
		Нов.ДокументОснования = Стр.ДокументПродажи;
		Попытка
			Нов.СуммаДокумента = Стр.СуммаДокумента;
		Исключение
		КонецПопытки;
		Нов.СуммаСписания = Стр.Задолженность;

		СтрокВДоках = СтрокВДоках + 1;
		Обработано = Обработано + 1;

	КонецЦикла;

	Если ДокОбъект <> Неопределено И ДокОбъект.РасшифровкаСписания.Количество() > 0 Тогда
		РезультатЗаписи = ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания);
		Если РезультатЗаписи.Ок Тогда
			Создано = Создано + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "OK " + РезультатЗаписи.Текст);
		Иначе
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + РезультатЗаписи.Текст);
		КонецЕсли;
	КонецЕсли;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого: документов=" + Создано + " строк=" + СтрокВДоках + " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

Функция ДатыПоГоду(Год) Экспорт
	Р = Новый Структура("ДатаНачала,ДатаОкончания");
	Если Год > 0 Тогда
		Р.ДатаНачала = Дата(Год, 1, 1);
		Р.ДатаОкончания = Дата(Год, 12, 31);
	КонецЕсли;
	Возврат Р;
КонецФункции

// Отмена проведения документов с комментарием «FitGO: списание…» за период дат документов.
// Нужно после ошибочного прогона: списание увеличило «Долг перед клиентом» вместо гашения.
Функция ОтменитьСписанияFitGO(ДатаНачала, ДатаОкончания) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ОТМЕНА FitGO-списаний: "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " .. "
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));

	Если Метаданные.Документы.Найти("СписаниеЗадолженности") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: документ не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.СуммаДокумента КАК СуммаДокумента,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.СписаниеЗадолженности КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.Дата >= &ДатаНачала
	|	И Док.Дата <= &ДатаОкончания
	|	И Док.Комментарий ПОДОБНО &Коммент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Коммент", "%FitGO: списание%");

	Выборка = Запрос.Выполнить().Выбрать();
	Отменено = 0;
	Ошибки = 0;
	Сумма = 0;

	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Отменено = Отменено + 1;
			Сумма = Сумма + Выборка.СуммаДокумента;
			ДобавитьСтрокуЛога(СтрокиЛога, "UNPOST "
				+ Выборка.Номер + " "
				+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
				+ " сумма=" + Формат(Выборка.СуммаДокумента, "ЧДЦ=2; ЧН=0")
				+ " | " + СокрЛП(Выборка.Комментарий));
		Исключение
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Выборка.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого отменено=" + Отменено
		+ " сумма=" + Формат(Сумма, "ЧДЦ=2; ЧН=0")
		+ " ошибок=" + Ошибки);
	ДобавитьСтрокуЛога(СтрокиЛога,
		"После отмены проверьте карточку клиента и Отчет.НеоплаченныеПродажи. Не списывайте снова, пока не сверены поля документа вручную.");
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДолги(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Контрагент КАК Контрагент,
	|	П.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата КАК ДатаПродажи,
	|	П.ДокументПродажи.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
	|ГДЕ
	|	П.Регистратор ССЫЛКА Документ.Реализация
	|	И П.ДокументПродажи.Дата >= &ДатаНачала
	|	И П.ДокументПродажи.Дата <= &ДатаОкончания
	|	И НЕ (
	|		ТИПЗНАЧЕНИЯ(П.ДокументПродажи.Договор) = ТИП(Справочник.КорпоративныеДоговоры)
	|			И П.ДокументПродажи.Договор <> ЗНАЧЕНИЕ(Справочник.КорпоративныеДоговоры.ПустаяСсылка)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.ДокументПродажи,
	|	П.Контрагент,
	|	П.СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата,
	|	П.ДокументПродажи.СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * СУММА(О.СуммаОстаток) КАК Задолженность,
	|	О.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
	|				И Основание В
	|					(ВЫБРАТЬ
	|						ВТПродажи.ДокументПродажи
	|					ИЗ
	|						ВТПродажи)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Основание
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.СуммаОстаток) < -0.009
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Б.Контрагент КАК Контрагент,
	|	СУММА(Б.СуммаОстаток) КАК Баланс
	|ПОМЕСТИТЬ ВТ_Баланс
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			Контрагент В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТПродажи.Контрагент
	|				ИЗ
	|					ВТПродажи)) КАК Б
	|
	|СГРУППИРОВАТЬ ПО
	|	Б.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
	|	ВТПродажи.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
	|	ВТПродажи.Контрагент КАК Контрагент,
	|	ВТПродажи.СуммаДокумента КАК СуммаДокумента,
	|	ВТ_Остатки.Задолженность КАК Задолженность,
	|	ЕСТЬNULL(ВТ_Баланс.Баланс, 0) КАК БалансКлиента
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Баланс КАК ВТ_Баланс
	|		ПО ВТПродажи.Контрагент = ВТ_Баланс.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТПродажи.Контрагент,
	|	ВТПродажи.ДатаПродажи,
	|	ВТПродажи.СтруктурнаяЕдиница";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Продажи периода с долгом типа «Долг». БылиОплаты = по основанию есть движения
// расчётов от других документов (оплата, возврат, списание) — такие не помечаем,
// иначе оплата останется без продажи и превратится в «Долг перед клиентом».
// Корпоративные договоры исключены — их закрывает акт + поступление ДС.
Функция ПолучитьНеоплаченныеПродажи(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Контрагент КАК Контрагент,
	|	П.ДокументПродажи.Дата КАК ДатаПродажи
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
	|ГДЕ
	|	П.Регистратор ССЫЛКА Документ.Реализация
	|	И П.ДокументПродажи.Дата >= &ДатаНачала
	|	И П.ДокументПродажи.Дата <= &ДатаОкончания
	|	И НЕ (
	|		ТИПЗНАЧЕНИЯ(П.ДокументПродажи.Договор) = ТИП(Справочник.КорпоративныеДоговоры)
	|			И П.ДокументПродажи.Договор <> ЗНАЧЕНИЕ(Справочник.КорпоративныеДоговоры.ПустаяСсылка)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.ДокументПродажи,
	|	П.Контрагент,
	|	П.ДокументПродажи.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * СУММА(О.СуммаОстаток) КАК Задолженность,
	|	О.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
	|				И Основание В
	|					(ВЫБРАТЬ
	|						ВТПродажи.ДокументПродажи
	|					ИЗ
	|						ВТПродажи)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Основание
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.СуммаОстаток) < -0.009
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Оплаты
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями КАК Д
	|ГДЕ
	|	Д.Активность
	|	И Д.Основание В
	|			(ВЫБРАТЬ
	|				ВТ_Остатки.Основание
	|			ИЗ
	|				ВТ_Остатки)
	|	И Д.Регистратор <> Д.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
	|	ВТПродажи.Контрагент КАК Контрагент,
	|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
	|	ВТ_Остатки.Задолженность КАК Задолженность,
	|	НЕ ВТ_Оплаты.Основание ЕСТЬ NULL КАК БылиОплаты
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оплаты КАК ВТ_Оплаты
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Оплаты.Основание
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТПродажи.Контрагент,
	|	ВТПродажи.ДатаПродажи";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПометитьДокумент(Ссылка)
	Об = Ссылка.ПолучитьОбъект();
	Если ЕстьКомментарийУРеализации() Тогда
		Об.Комментарий = СокрЛП(Об.Комментарий + " " + МеткаПометки());
	КонецЕсли;
	Об.ПометкаУдаления = Истина;
	Если Об.Проведен Тогда
		Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Об.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

Функция МеткаПометки()
	Возврат "[FitGO: пометка старого долга]";
КонецФункции

Функция ЕстьКомментарийУРеализации()
	Мд = Метаданные.Документы.Найти("Реализация");
	Возврат Мд <> Неопределено И Мд.Реквизиты.Найти("Комментарий") <> Неопределено;
КонецФункции

Функция СтрокаПродажи(Стр)
	Возврат Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
		+ " | " + Строка(Стр.Контрагент)
		+ " | " + Строка(Стр.ДокументПродажи)
		+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0");
КонецФункции

Функция ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания)

	Р = Новый Структура("Ок,Текст", Ложь, "");
	Попытка
		ДокОбъект.Комментарий = "FitGO: списание долгов "
			+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
			+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Р.Ок = Истина;
		Р.Текст = Строка(ДокОбъект.Ссылка)
			+ " строк=" + ДокОбъект.РасшифровкаСписания.Количество()
			+ " сумма=" + Формат(ДокОбъект.СуммаДокумента, "ЧДЦ=2; ЧН=0");
	Исключение
		Р.Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Р;

КонецФункции

Процедура ДобавитьСтрокуЛога(СтрокиЛога, Текст)
	СтрокиЛога.Добавить(Текст);
КонецПроцедуры

Процедура ДобавитьСтрокиТаблицы(СтрокиЛога, Таблица, Показать)
	Н = 0;
	Для Каждого Стр Из Таблица Цикл
		Н = Н + 1;
		Если Н > Показать Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "... ещё " + (Таблица.Количество() - Показать) + " строк");
			Прервать;
		КонецЕсли;
		ДобавитьСтрокуЛога(СтрокиЛога, Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
			+ " | " + Строка(Стр.Контрагент)
			+ " (" + Формат(Стр.БалансКлиента, "ЧДЦ=2; ЧН=0") + ")"
			+ " | " + Строка(Стр.ДокументПродажи)
			+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0"));
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
