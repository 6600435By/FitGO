// Модуль объекта внешней обработки FitGO_СписаниеСтарыхДолгов
// Продажи периода → Документ.СписаниеЗадолженности (продажа и занятия остаются).
// Реквизиты объекта: ГодСписания, ДатаНачала, ДатаОкончания, ЛимитСтрок, Лог,
//   СчетКлуба, ДатаОплатыИзДоговора (Булево: дата Поступления = дата начала договора)
// ВАЖНО: не использовать имя «Лог» для локальных переменных — это реквизит (Строка).
//
// Сумма к списанию (как рецепция «Оплатить», не как Отчет.НеоплаченныеПродажи):
//   - только отрицательный остаток ТипРасчета = Долг по основанию-продаже;
//   - не больше |общего баланса клиента| по всем основаниям и типам, иначе
//     списание создаст «Долг перед клиентом» (инцидент 2026-09-26, Бределев);
//   - клиент с балансом >= 0 пропускается целиком.
// Остаток пакета списание не закрывает: неиспользованные пакеты — отдельный шаг.
//
// Пометка на удаление (ПометитьПродажи): ни одной оплаты по продаже — продажа
// снимается с проведения и помечается, уходят и долг, и пакет. Если услуга уже
// использована, 1С не даст снять проведение — такие остаются для «Списать».
// Помеченные получают в Комментарий метку МеткаПометки() для отката.
// «Удаление помеченных» НЕ запускать.
//
// Продажи с заполненным Справочник.КорпоративныеДоговоры в поле Договор
// не помечаем и не списываем физлицам — их закрывает шаг 3:
// Документ.ПоступлениеДенежныхСредств (безнал, операция «Оплата по корпоративному/
// страховому/кредитному договору»), по одному документу на договор+СЕ.
// Форма в UI: «Оплата от страховой компании безналичными средствами».

#Область ПрограммныйИнтерфейс

Функция ПометитьПродажи(ДатаНачала, ДатаОкончания, ЛимитСтрок, ТолькоПросмотр) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ПОМЕТКА продаж: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ?(ТолькоПросмотр, " [ПРОСМОТР]", " [ЗАПИСЬ]"));

	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: ДатаНачала > ДатаОкончания");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Таблица = ПолучитьНеоплаченныеПродажи(ДатаНачала, ДатаОкончания);
	ПолностьюНеоплачены = Таблица.НайтиСтроки(Новый Структура("БылиОплаты", Ложь));
	СОплатами = Таблица.НайтиСтроки(Новый Структура("БылиОплаты", Истина));

	СуммаК = 0;
	Для Каждого Стр Из ПолностьюНеоплачены Цикл
		СуммаК = СуммаК + Стр.Задолженность;
	КонецЦикла;
	ДобавитьСтрокуЛога(СтрокиЛога, "Без единой оплаты (к пометке): " + ПолностьюНеоплачены.Количество()
		+ " на " + Формат(СуммаК, "ЧДЦ=2; ЧН=0"));
	ДобавитьСтрокуЛога(СтрокиЛога, "Частично оплачены (не трогаем, потом «Списать»): " + СОплатами.Количество());

	Если Не ЕстьКомментарийУРеализации() Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ВНИМАНИЕ: у Документ.Реализация нет реквизита Комментарий — откат кнопкой невозможен, сохраните этот лог.");
	КонецЕсли;

	Если ТолькоПросмотр Тогда
		Н = 0;
		Для Каждого Стр Из ПолностьюНеоплачены Цикл
			Н = Н + 1;
			Если Н > 50 Тогда
				ДобавитьСтрокуЛога(СтрокиЛога, "... ещё " + (ПолностьюНеоплачены.Количество() - 50) + " строк");
				Прервать;
			КонецЕсли;
			ДобавитьСтрокуЛога(СтрокиЛога, СтрокаПродажи(Стр));
		КонецЦикла;
		ДобавитьСтрокуЛога(СтрокиЛога, "РЕЖИМ ПРОСМОТРА: ничего не помечено. Нажмите «Пометить».");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Помечено = 0;
	Использованы = 0;
	Обработано = 0;
	Для Каждого Стр Из ПолностьюНеоплачены Цикл
		Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "Достигнут ЛимитСтрок=" + ЛимитСтрок);
			Прервать;
		КонецЕсли;
		Обработано = Обработано + 1;
		Попытка
			ПометитьДокумент(Стр.ДокументПродажи);
			Помечено = Помечено + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "DEL " + СтрокаПродажи(Стр));
		Исключение
			// Сообщения платформы («основание для Занятие») — ожидаемый SKIP, не авария.
			Попытка
				ПолучитьСообщенияПользователю(Истина);
			Исключение
			КонецПопытки;
			Использованы = Использованы + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "SKIP (занятие/блокировка) " + СтрокаПродажи(Стр));
		КонецПопытки;
	КонецЦикла;

	ИтогТекст = "ИТОГО: помечено=" + Помечено
		+ " | пропущено (есть занятие и т.п.)=" + Использованы
		+ " | их потом закроет «Списать»";
	СтрокиЛога.Вставить(1, ИтогТекст);
	ДобавитьСтрокуЛога(СтрокиЛога, ИтогТекст);
	Если Использованы > 0 Тогда
		ДобавитьСтрокуЛога(СтрокиЛога,
			"Сообщения «основание для Занятие» — норма: продажа использована, пометку нельзя. Не ошибка.");
	КонецЕсли;
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

Функция ОтменитьПометкиFitGO() Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ОТКАТ пометок FitGO (" + МеткаПометки() + ")");

	Если Не ЕстьКомментарийУРеализации() Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: у Документ.Реализация нет Комментария — откат вручную по логу пометки.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Реализация КАК Док
	|ГДЕ
	|	Док.ПометкаУдаления
	|	И Док.Комментарий ПОДОБНО &Метка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата";
	Запрос.УстановитьПараметр("Метка", "%" + МеткаПометки() + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Восстановлено = 0;
	Ошибки = 0;
	Пока Выборка.Следующий() Цикл
		Попытка
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.Комментарий = СокрЛП(СтрЗаменить(Об.Комментарий, МеткаПометки(), ""));
			Об.ПометкаУдаления = Ложь;
			Об.Записать(РежимЗаписиДокумента.Проведение);
			Восстановлено = Восстановлено + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "RESTORE " + Строка(Выборка.Ссылка));
		Исключение
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Строка(Выборка.Ссылка) + ": "
				+ ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого восстановлено=" + Восстановлено + " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

// ТолькоПросмотр = Истина → документы не создаются, только текст в результат.
Функция ВыполнитьСписание(ДатаНачала, ДатаОкончания, ЛимитСтрок, ТолькоПросмотр) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "Период: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ?(ТолькоПросмотр, " [ПРОСМОТР]", " [ЗАПИСЬ]"));

	Если Метаданные.Документы.Найти("СписаниеЗадолженности") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: Документ.СписаниеЗадолженности не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: ДатаНачала > ДатаОкончания");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Исходная = ПолучитьДолги(ДатаНачала, ДатаОкончания);
	ДобавитьСтрокуЛога(СтрокиЛога, "Продаж с долгом (тип «Долг»): " + Исходная.Количество());

	Таблица = Исходная.СкопироватьКолонки();
	Пропущенные = Исходная.СкопироватьКолонки();
	ЛимитКлиента = Новый Соответствие;
	Для Каждого Стр Из Исходная Цикл
		Лимит = ЛимитКлиента.Получить(Стр.Контрагент);
		Если Лимит = Неопределено Тогда
			Лимит = ?(Стр.БалансКлиента < 0, -Стр.БалансКлиента, 0);
		КонецЕсли;
		Сумма = Мин(Стр.Задолженность, Лимит);
		Если Сумма > 0.009 Тогда
			Нов = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(Нов, Стр);
			Нов.Задолженность = Окр(Сумма, 2);
			Лимит = Лимит - Нов.Задолженность;
		Иначе
			ЗаполнитьЗначенияСвойств(Пропущенные.Добавить(), Стр);
		КонецЕсли;
		ЛимитКлиента.Вставить(Стр.Контрагент, Лимит);
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "К списанию: " + Таблица.Количество()
		+ " строк на " + Формат(Таблица.Итог("Задолженность"), "ЧДЦ=2; ЧН=0"));
	ДобавитьСтрокуЛога(СтрокиЛога, "Пропущено (долг перекрыт деньгами клиента на других основаниях): "
		+ Пропущенные.Количество() + " строк на "
		+ Формат(Пропущенные.Итог("Задолженность"), "ЧДЦ=2; ЧН=0"));

	Если Таблица.Количество() = 0 Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "Нечего списывать.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если ТолькоПросмотр Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "--- к списанию ---");
		ДобавитьСтрокиТаблицы(СтрокиЛога, Таблица, 50);
		Если Пропущенные.Количество() > 0 Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "--- пропущено (баланс клиента в скобках) ---");
			ДобавитьСтрокиТаблицы(СтрокиЛога, Пропущенные, 20);
		КонецЕсли;
		ДобавитьСтрокуЛога(СтрокиЛога, "РЕЖИМ ПРОСМОТРА: документы не созданы. Нажмите «Списать».");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	ТекКлиент = Неопределено;
	ТекСЕ = Неопределено;
	ДокОбъект = Неопределено;
	Создано = 0;
	СтрокВДоках = 0;
	Ошибки = 0;
	Обработано = 0;

	Для Каждого Стр Из Таблица Цикл

		Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "Достигнут ЛимитСтрок=" + ЛимитСтрок);
			Прервать;
		КонецЕсли;

		НуженНовый = (ДокОбъект = Неопределено)
			Или (Стр.Контрагент <> ТекКлиент)
			Или (Стр.СтруктурнаяЕдиница <> ТекСЕ);

		Если НуженНовый Тогда
			Если ДокОбъект <> Неопределено Тогда
				РезультатЗаписи = ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания);
				Если РезультатЗаписи.Ок Тогда
					Создано = Создано + 1;
					ДобавитьСтрокуЛога(СтрокиЛога, "OK " + РезультатЗаписи.Текст);
				Иначе
					Ошибки = Ошибки + 1;
					ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + РезультатЗаписи.Текст);
				КонецЕсли;
			КонецЕсли;

			ДокОбъект = Документы.СписаниеЗадолженности.СоздатьДокумент();
			ДокОбъект.Дата = ТекущаяДатаСеанса();
			ДокОбъект.СтруктурнаяЕдиница = Стр.СтруктурнаяЕдиница;
			Попытка
				ДокОбъект.Контрагент = Стр.Контрагент;
			Исключение
			КонецПопытки;
			ДокОбъект.РасшифровкаСписания.Очистить();
			ТекКлиент = Стр.Контрагент;
			ТекСЕ = Стр.СтруктурнаяЕдиница;
		КонецЕсли;

		Нов = ДокОбъект.РасшифровкаСписания.Добавить();
		Нов.ДокументОснования = Стр.ДокументПродажи;
		Попытка
			Нов.СуммаДокумента = Стр.СуммаДокумента;
		Исключение
		КонецПопытки;
		Нов.СуммаСписания = Стр.Задолженность;

		СтрокВДоках = СтрокВДоках + 1;
		Обработано = Обработано + 1;

	КонецЦикла;

	Если ДокОбъект <> Неопределено И ДокОбъект.РасшифровкаСписания.Количество() > 0 Тогда
		РезультатЗаписи = ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания);
		Если РезультатЗаписи.Ок Тогда
			Создано = Создано + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "OK " + РезультатЗаписи.Текст);
		Иначе
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + РезультатЗаписи.Текст);
		КонецЕсли;
	КонецЕсли;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого: документов=" + Создано + " строк=" + СтрокВДоках + " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

Функция ДатыПоГоду(Год) Экспорт
	Р = Новый Структура("ДатаНачала,ДатаОкончания");
	Если Год > 0 Тогда
		Р.ДатаНачала = Дата(Год, 1, 1);
		Р.ДатаОкончания = Дата(Год, 12, 31);
	КонецЕсли;
	Возврат Р;
КонецФункции

// Шаг 3: неоплаченные продажи по КорпоративныеДоговоры → ПоступлениеДенежныхСредств.
// ЛимитСтрок = лимит документов оплаты (договоров), 0 = все.
// СчетКлуба обязателен при записи (реквизит обработки, р/с клуба «Корпо» и т.п.).
// ДатаОплатыИзДоговора = Истина → дата документа = дата начала договора (зачисление «тогда»);
//   Ложь → дата документа = конец выбранного периода продаж.
Функция ВыполнитьОплатуКорпо(ДатаНачала, ДатаОкончания, СчетКлуба, ЛимитСтрок, ТолькоПросмотр, ДатаОплатыИзДоговора) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "КОРПО-ОПЛАТА: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
		+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
		+ ?(ТолькоПросмотр, " [ПРОСМОТР]", " [ЗАПИСЬ]")
		+ ?(ДатаОплатыИзДоговора, " | дата док.=начало договора", " | дата док.=конец периода"));

	Если ДатаНачала > ДатаОкончания Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: ДатаНачала > ДатаОкончания");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если Метаданные.Документы.Найти("ПоступлениеДенежныхСредств") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: Документ.ПоступлениеДенежныхСредств не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если Метаданные.Справочники.Найти("КорпоративныеДоговоры") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: Справочник.КорпоративныеДоговоры не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Если Не ТолькоПросмотр И Не ЗначениеЗаполнено(СчетКлуба) Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: укажите СчетКлуба (р/с клуба для безнала)");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Таблица = ПолучитьНеоплаченныеКорпоПродажи(ДатаНачала, ДатаОкончания);
	ДобавитьСтрокуЛога(СтрокиЛога, "Продаж с долгом по корп. договорам: " + Таблица.Количество()
		+ " на " + Формат(Таблица.Итог("Задолженность"), "ЧДЦ=2; ЧН=0"));

	Если Таблица.Количество() = 0 Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "Нечего оплачивать.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	// Группы: Договор + СтруктурнаяЕдиница (один документ оплаты на группу).
	Группы = Новый Соответствие;
	ПорядокГрупп = Новый Массив;
	Для Каждого Стр Из Таблица Цикл
		Ключ = Строка(Стр.Договор) + Символы.ПС + Строка(Стр.СтруктурнаяЕдиница);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура;
			Группа.Вставить("Договор", Стр.Договор);
			Группа.Вставить("СтруктурнаяЕдиница", Стр.СтруктурнаяЕдиница);
			Группа.Вставить("Строки", Новый Массив);
			Группа.Вставить("Сумма", 0);
			Группы.Вставить(Ключ, Группа);
			ПорядокГрупп.Добавить(Ключ);
		КонецЕсли;
		Группа.Строки.Добавить(Стр);
		Группа.Сумма = Группа.Сумма + Стр.Задолженность;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Договоров (групп к оплате): " + ПорядокГрупп.Количество());

	Если ТолькоПросмотр Тогда
		Н = 0;
		Для Каждого Ключ Из ПорядокГрупп Цикл
			Н = Н + 1;
			Если Н > 40 Тогда
				ДобавитьСтрокуЛога(СтрокиЛога, "... ещё " + (ПорядокГрупп.Количество() - 40) + " договоров");
				Прервать;
			КонецЕсли;
			Г = Группы.Получить(Ключ);
			Орг = КонтрагентКорпоДоговора(Г.Договор);
			ДатаДок = ДатаДокументаОплатыКорпо(Г.Договор, ДатаОкончания, ДатаОплатыИзДоговора);
			ДобавитьСтрокуЛога(СтрокиЛога, Формат(Н, "ЧГ=0") + ") "
				+ Строка(Г.Договор)
				+ " | орг=" + Строка(Орг)
				+ " | СЕ=" + Строка(Г.СтруктурнаяЕдиница)
				+ " | продаж=" + Г.Строки.Количество()
				+ " | сумма=" + Формат(Г.Сумма, "ЧДЦ=2; ЧН=0")
				+ " | дата док.=" + Формат(ДатаДок, "ДФ=dd.MM.yyyy"));
			К = 0;
			Для Каждого Стр Из Г.Строки Цикл
				К = К + 1;
				Если К > 5 Тогда
					ДобавитьСтрокуЛога(СтрокиЛога, "    ... ещё " + (Г.Строки.Количество() - 5) + " продаж");
					Прервать;
				КонецЕсли;
				ДобавитьСтрокуЛога(СтрокиЛога, "    "
					+ Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
					+ " | " + Строка(Стр.Клиент)
					+ " | " + Строка(Стр.ДокументПродажи)
					+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0"));
			КонецЦикла;
		КонецЦикла;
		ДобавитьСтрокуЛога(СтрокиЛога, "РЕЖИМ ПРОСМОТРА: документы не созданы. Нажмите «3. Оплатить корпо».");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	КартаДок = КартаМетаданныхПоступления();
	Если Не КартаДок.Ок Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА метаданных: " + КартаДок.Текст);
		ДобавитьСтрокуЛога(СтрокиЛога, "Сначала «Проба метаданных корпо» — пришлите лог.");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Создано = 0;
	Ошибки = 0;
	Обработано = 0;
	СуммаВсего = 0;

	Для Каждого Ключ Из ПорядокГрупп Цикл

		Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "Достигнут ЛимитСтрок=" + ЛимитСтрок + " (договоров)");
			Прервать;
		КонецЕсли;
		Обработано = Обработано + 1;

		Г = Группы.Получить(Ключ);
		Результат = СоздатьПровестиОплатуКорпо(
			Г, СчетКлуба, ДатаНачала, ДатаОкончания, КартаДок, ДатаОплатыИзДоговора);
		Если Результат.Ок Тогда
			Создано = Создано + 1;
			СуммаВсего = СуммаВсего + Г.Сумма;
			ДобавитьСтрокуЛога(СтрокиЛога, "OK " + Результат.Текст);
		Иначе
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Строка(Г.Договор) + ": " + Результат.Текст);
		КонецЕсли;

	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого: документов=" + Создано
		+ " сумма=" + Формат(СуммаВсего, "ЧДЦ=2; ЧН=0")
		+ " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

// Отмена по метке периода продаж в комментарии (не по дате документа):
// при ДатаОплатыИзДоговора документы датированы началом договора и могут быть вне выбранного года.
Функция ОтменитьОплатыКорпоFitGO(ДатаНачала, ДатаОкончания) Экспорт

	СтрокиЛога = Новый Массив;
	МеткаПериода = МеткаОплатыКорпо() + " "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
	ДобавитьСтрокуЛога(СтрокиЛога, "ОТМЕНА FitGO-корпо-оплат по комментарию: " + МеткаПериода);

	Если Метаданные.Документы.Найти("ПоступлениеДенежныхСредств") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: документ не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.ПоступлениеДенежныхСредств КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.Комментарий ПОДОБНО &Коммент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Запрос.УстановитьПараметр("Коммент", "%" + МеткаПериода + "%");

	Выборка = Запрос.Выполнить().Выбрать();
	Отменено = 0;
	Ошибки = 0;
	Сумма = 0;

	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			СуммаДок = 0;
			Попытка
				СуммаДок = ДокОбъект.СуммаДокумента;
			Исключение
				Попытка
					СуммаДок = ДокОбъект.Сумма;
				Исключение
				КонецПопытки;
			КонецПопытки;
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Отменено = Отменено + 1;
			Сумма = Сумма + СуммаДок;
			ДобавитьСтрокуЛога(СтрокиЛога, "UNPOST "
				+ Выборка.Номер + " "
				+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
				+ " сумма=" + Формат(СуммаДок, "ЧДЦ=2; ЧН=0"));
		Исключение
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Выборка.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого отменено=" + Отменено
		+ " сумма=" + Формат(Сумма, "ЧДЦ=2; ЧН=0")
		+ " ошибок=" + Ошибки);
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

// Дамп реквизитов/ТЧ ПоступлениеДенежныхСредств и КорпоративныеДоговоры — если оплата падает.
Функция ПробаМетаданныхКорпо() Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ПРОБА МЕТАДАННЫХ КОРПО");

	МдДок = Метаданные.Документы.Найти("ПоступлениеДенежныхСредств");
	Если МдДок = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "Документ.ПоступлениеДенежныхСредств — НЕТ");
	Иначе
		ДобавитьСтрокуЛога(СтрокиЛога, "Документ.ПоступлениеДенежныхСредств:");
		Для Каждого Р Из МдДок.Реквизиты Цикл
			ДобавитьСтрокуЛога(СтрокиЛога, "  рекв." + Р.Имя + " = " + Строка(Р.Тип));
		КонецЦикла;
		Для Каждого ТЧ Из МдДок.ТабличныеЧасти Цикл
			ДобавитьСтрокуЛога(СтрокиЛога, "  ТЧ." + ТЧ.Имя + ":");
			Для Каждого К Из ТЧ.Реквизиты Цикл
				ДобавитьСтрокуЛога(СтрокиЛога, "    ." + К.Имя + " = " + Строка(К.Тип));
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	МдСпр = Метаданные.Справочники.Найти("КорпоративныеДоговоры");
	Если МдСпр = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "Справочник.КорпоративныеДоговоры — НЕТ");
	Иначе
		ДобавитьСтрокуЛога(СтрокиЛога, "Справочник.КорпоративныеДоговоры:");
		Для Каждого Р Из МдСпр.Реквизиты Цикл
			ДобавитьСтрокуЛога(СтрокиЛога, "  ." + Р.Имя + " = " + Строка(Р.Тип));
		КонецЦикла;
	КонецЕсли;

	Карта = КартаМетаданныхПоступления();
	ДобавитьСтрокуЛога(СтрокиЛога, "Карта: Ок=" + Карта.Ок + " | " + Карта.Текст);

	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

// Отмена проведения документов с комментарием «FitGO: списание…» за период дат документов.
// Нужно после ошибочного прогона: списание увеличило «Долг перед клиентом» вместо гашения.
Функция ОтменитьСписанияFitGO(ДатаНачала, ДатаОкончания) Экспорт

	СтрокиЛога = Новый Массив;
	ДобавитьСтрокуЛога(СтрокиЛога, "ОТМЕНА FitGO-списаний: "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " .. "
		+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy"));

	Если Метаданные.Документы.Найти("СписаниеЗадолженности") = Неопределено Тогда
		ДобавитьСтрокуЛога(СтрокиЛога, "ОШИБКА: документ не найден");
		Возврат СтрСоединить(СтрокиЛога, Символы.ПС);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.СуммаДокумента КАК СуммаДокумента,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.СписаниеЗадолженности КАК Док
	|ГДЕ
	|	Док.Проведен
	|	И Док.Дата >= &ДатаНачала
	|	И Док.Дата <= &ДатаОкончания
	|	И Док.Комментарий ПОДОБНО &Коммент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Коммент", "%FitGO: списание%");

	Выборка = Запрос.Выполнить().Выбрать();
	Отменено = 0;
	Ошибки = 0;
	Сумма = 0;

	Пока Выборка.Следующий() Цикл
		Попытка
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Отменено = Отменено + 1;
			Сумма = Сумма + Выборка.СуммаДокумента;
			ДобавитьСтрокуЛога(СтрокиЛога, "UNPOST "
				+ Выборка.Номер + " "
				+ Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
				+ " сумма=" + Формат(Выборка.СуммаДокумента, "ЧДЦ=2; ЧН=0")
				+ " | " + СокрЛП(Выборка.Комментарий));
		Исключение
			Ошибки = Ошибки + 1;
			ДобавитьСтрокуЛога(СтрокиЛога, "ERR " + Выборка.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДобавитьСтрокуЛога(СтрокиЛога, "Итого отменено=" + Отменено
		+ " сумма=" + Формат(Сумма, "ЧДЦ=2; ЧН=0")
		+ " ошибок=" + Ошибки);
	ДобавитьСтрокуЛога(СтрокиЛога,
		"После отмены проверьте карточку клиента и Отчет.НеоплаченныеПродажи. Не списывайте снова, пока не сверены поля документа вручную.");
	Возврат СтрСоединить(СтрокиЛога, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДолги(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Контрагент КАК Контрагент,
	|	П.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата КАК ДатаПродажи,
	|	П.ДокументПродажи.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
	|ГДЕ
	|	П.Регистратор ССЫЛКА Документ.Реализация
	|	И П.ДокументПродажи.Дата >= &ДатаНачала
	|	И П.ДокументПродажи.Дата <= &ДатаОкончания
	|	И НЕ (
	|		ТИПЗНАЧЕНИЯ(П.ДокументПродажи.Договор) = ТИП(Справочник.КорпоративныеДоговоры)
	|			И П.ДокументПродажи.Договор <> ЗНАЧЕНИЕ(Справочник.КорпоративныеДоговоры.ПустаяСсылка)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.ДокументПродажи,
	|	П.Контрагент,
	|	П.СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата,
	|	П.ДокументПродажи.СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * СУММА(О.СуммаОстаток) КАК Задолженность,
	|	О.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
	|				И Основание В
	|					(ВЫБРАТЬ
	|						ВТПродажи.ДокументПродажи
	|					ИЗ
	|						ВТПродажи)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Основание
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.СуммаОстаток) < -0.009
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Б.Контрагент КАК Контрагент,
	|	СУММА(Б.СуммаОстаток) КАК Баланс
	|ПОМЕСТИТЬ ВТ_Баланс
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			Контрагент В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТПродажи.Контрагент
	|				ИЗ
	|					ВТПродажи)) КАК Б
	|
	|СГРУППИРОВАТЬ ПО
	|	Б.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
	|	ВТПродажи.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
	|	ВТПродажи.Контрагент КАК Контрагент,
	|	ВТПродажи.СуммаДокумента КАК СуммаДокумента,
	|	ВТ_Остатки.Задолженность КАК Задолженность,
	|	ЕСТЬNULL(ВТ_Баланс.Баланс, 0) КАК БалансКлиента
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Баланс КАК ВТ_Баланс
	|		ПО ВТПродажи.Контрагент = ВТ_Баланс.Контрагент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТПродажи.Контрагент,
	|	ВТПродажи.ДатаПродажи,
	|	ВТПродажи.СтруктурнаяЕдиница";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Продажи периода с долгом типа «Долг». БылиОплаты = по основанию есть движения
// расчётов от других документов (оплата, возврат, списание) — такие не помечаем,
// иначе оплата останется без продажи и превратится в «Долг перед клиентом».
// Корпоративные договоры исключены — их закрывает акт + поступление ДС.
Функция ПолучитьНеоплаченныеПродажи(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Контрагент КАК Контрагент,
	|	П.ДокументПродажи.Дата КАК ДатаПродажи
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
	|ГДЕ
	|	П.Регистратор ССЫЛКА Документ.Реализация
	|	И П.ДокументПродажи.Дата >= &ДатаНачала
	|	И П.ДокументПродажи.Дата <= &ДатаОкончания
	|	И НЕ (
	|		ТИПЗНАЧЕНИЯ(П.ДокументПродажи.Договор) = ТИП(Справочник.КорпоративныеДоговоры)
	|			И П.ДокументПродажи.Договор <> ЗНАЧЕНИЕ(Справочник.КорпоративныеДоговоры.ПустаяСсылка)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	П.ДокументПродажи,
	|	П.Контрагент,
	|	П.ДокументПродажи.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * СУММА(О.СуммаОстаток) КАК Задолженность,
	|	О.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
	|				И Основание В
	|					(ВЫБРАТЬ
	|						ВТПродажи.ДокументПродажи
	|					ИЗ
	|						ВТПродажи)) КАК О
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Основание
	|
	|ИМЕЮЩИЕ
	|	СУММА(О.СуммаОстаток) < -0.009
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Д.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Оплаты
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями КАК Д
	|ГДЕ
	|	Д.Активность
	|	И Д.Основание В
	|			(ВЫБРАТЬ
	|				ВТ_Остатки.Основание
	|			ИЗ
	|				ВТ_Остатки)
	|	И Д.Регистратор <> Д.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
	|	ВТПродажи.Контрагент КАК Контрагент,
	|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
	|	ВТ_Остатки.Задолженность КАК Задолженность,
	|	НЕ ВТ_Оплаты.Основание ЕСТЬ NULL КАК БылиОплаты
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оплаты КАК ВТ_Оплаты
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Оплаты.Основание
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТПродажи.Контрагент,
	|	ВТПродажи.ДатаПродажи";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ПометитьДокумент(Ссылка)
	Об = Ссылка.ПолучитьОбъект();
	Если ЕстьКомментарийУРеализации() Тогда
		Об.Комментарий = СокрЛП(Об.Комментарий + " " + МеткаПометки());
	КонецЕсли;
	Об.ПометкаУдаления = Истина;
	Если Об.Проведен Тогда
		Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Об.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
КонецПроцедуры

Функция МеткаПометки()
	Возврат "[FitGO: пометка старого долга]";
КонецФункции

Функция ЕстьКомментарийУРеализации()
	Мд = Метаданные.Документы.Найти("Реализация");
	Возврат Мд <> Неопределено И Мд.Реквизиты.Найти("Комментарий") <> Неопределено;
КонецФункции

Функция СтрокаПродажи(Стр)
	Возврат Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
		+ " | " + Строка(Стр.Контрагент)
		+ " | " + Строка(Стр.ДокументПродажи)
		+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0");
КонецФункции

Функция ЗаписатьДокумент(ДокОбъект, ДатаНачала, ДатаОкончания)

	Р = Новый Структура("Ок,Текст", Ложь, "");
	Попытка
		ДокОбъект.Комментарий = "FitGO: списание долгов "
			+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
			+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Р.Ок = Истина;
		Р.Текст = Строка(ДокОбъект.Ссылка)
			+ " строк=" + ДокОбъект.РасшифровкаСписания.Количество()
			+ " сумма=" + Формат(ДокОбъект.СуммаДокумента, "ЧДЦ=2; ЧН=0");
	Исключение
		Р.Текст = ОписаниеОшибки();
	КонецПопытки;
	Возврат Р;

КонецФункции

Процедура ДобавитьСтрокуЛога(СтрокиЛога, Текст)
	СтрокиЛога.Добавить(Текст);
КонецПроцедуры

Процедура ДобавитьСтрокиТаблицы(СтрокиЛога, Таблица, Показать)
	Н = 0;
	Для Каждого Стр Из Таблица Цикл
		Н = Н + 1;
		Если Н > Показать Тогда
			ДобавитьСтрокуЛога(СтрокиЛога, "... ещё " + (Таблица.Количество() - Показать) + " строк");
			Прервать;
		КонецЕсли;
		ДобавитьСтрокуЛога(СтрокиЛога, Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
			+ " | " + Строка(Стр.Контрагент)
			+ " (" + Формат(Стр.БалансКлиента, "ЧДЦ=2; ЧН=0") + ")"
			+ " | " + Строка(Стр.ДокументПродажи)
			+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0"));
	КонецЦикла;
КонецПроцедуры

Функция МеткаОплатыКорпо()
	Возврат "FitGO: оплата корпо";
КонецФункции

// Неоплаченные продажи периода с заполненным КорпоративныеДоговоры.
// Корпо часто без остатка «Долг» у физлица («Нет долга» на карточке) —
// считаем задолженность = СуммаДокумента − сумма приходов по основанию в расчётах.
Функция ПолучитьНеоплаченныеКорпоПродажи(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	П.ДокументПродажи КАК ДокументПродажи,
	|	П.Контрагент КАК Клиент,
	|	П.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата КАК ДатаПродажи,
	|	П.ДокументПродажи.Договор КАК Договор,
	|	П.ДокументПродажи.СуммаДокумента КАК СуммаДокумента
	|ПОМЕСТИТЬ ВТПродажи
	|ИЗ
	|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
	|ГДЕ
	|	П.Регистратор ССЫЛКА Документ.Реализация
	|	И П.ДокументПродажи.Дата >= &ДатаНачала
	|	И П.ДокументПродажи.Дата <= &ДатаОкончания
	|	И ТИПЗНАЧЕНИЯ(П.ДокументПродажи.Договор) = ТИП(Справочник.КорпоративныеДоговоры)
	|	И П.ДокументПродажи.Договор <> ЗНАЧЕНИЕ(Справочник.КорпоративныеДоговоры.ПустаяСсылка)
	|	И НЕ П.ДокументПродажи.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	П.ДокументПродажи,
	|	П.Контрагент,
	|	П.СтруктурнаяЕдиница,
	|	П.ДокументПродажи.Дата,
	|	П.ДокументПродажи.Договор,
	|	П.ДокументПродажи.СуммаДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	О.Основание КАК Основание,
	|	СУММА(О.СуммаПриход) КАК Оплачено
	|ПОМЕСТИТЬ ВТ_Оплаты
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.ОстаткиИОбороты(
	|			,
	|			,
	|			Регистратор,
	|			,
	|			Основание В
	|				(ВЫБРАТЬ
	|					ВТПродажи.ДокументПродажи
	|				ИЗ
	|					ВТПродажи)) КАК О
	|ГДЕ
	|	О.СуммаПриход > 0
	|	И О.Регистратор <> О.Основание
	|
	|СГРУППИРОВАТЬ ПО
	|	О.Основание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	-1 * СУММА(Ост.СуммаОстаток) КАК ЗадолженностьОстаток,
	|	Ост.Основание КАК Основание
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.РасчетыСПокупателями.Остатки(
	|			,
	|			ТипРасчета = ЗНАЧЕНИЕ(Перечисление.ТипыРасчетов.Долг)
	|				И Основание В
	|					(ВЫБРАТЬ
	|						ВТПродажи.ДокументПродажи
	|					ИЗ
	|						ВТПродажи)) КАК Ост
	|
	|СГРУППИРОВАТЬ ПО
	|	Ост.Основание
	|
	|ИМЕЮЩИЕ
	|	СУММА(Ост.СуммаОстаток) < -0.009
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
	|	ВТПродажи.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
	|	ВТПродажи.Клиент КАК Клиент,
	|	ВТПродажи.Договор КАК Договор,
	|	ВТПродажи.СуммаДокумента КАК СуммаДокумента,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВТ_Остатки.ЗадолженностьОстаток, 0) > 0.009
	|			ТОГДА ВТ_Остатки.ЗадолженностьОстаток
	|		ИНАЧЕ ВТПродажи.СуммаДокумента - ЕСТЬNULL(ВТ_Оплаты.Оплачено, 0)
	|	КОНЕЦ КАК Задолженность
	|ИЗ
	|	ВТПродажи КАК ВТПродажи
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Оплаты КАК ВТ_Оплаты
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Оплаты.Основание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТ_Остатки.ЗадолженностьОстаток, 0) > 0.009
	|				ТОГДА ВТ_Остатки.ЗадолженностьОстаток
	|			ИНАЧЕ ВТПродажи.СуммаДокумента - ЕСТЬNULL(ВТ_Оплаты.Оплачено, 0)
	|		КОНЕЦ > 0.009
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТПродажи.Договор,
	|	ВТПродажи.СтруктурнаяЕдиница,
	|	ВТПродажи.ДатаПродажи";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция КонтрагентКорпоДоговора(Договор)

	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить("Контрагент");
	Имена.Добавить("Организация");
	Имена.Добавить("ЮрЛицо");
	Имена.Добавить("СтраховаяКомпания");
	Имена.Добавить("КредитнаяОрганизация");
	Имена.Добавить("Владелец");

	Мд = Метаданные.Справочники.Найти("КорпоративныеДоговоры");
	Если Мд <> Неопределено Тогда
		Для Каждого Имя Из Имена Цикл
			Если Мд.Реквизиты.Найти(Имя) <> Неопределено Или Имя = "Владелец" Тогда
				Попытка
					Зн = Договор[Имя];
					Если ЗначениеЗаполнено(Зн) Тогда
						Возврат Зн;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция КартаМетаданныхПоступления()

	Р = Новый Структура;
	Р.Вставить("Ок", Ложь);
	Р.Вставить("Текст", "");
	Р.Вставить("ИмяТЧ", "");
	Р.Вставить("КолонкаДокумент", "");
	Р.Вставить("КолонкаСумма", "");
	Р.Вставить("КолонкаКлиент", "");
	Р.Вставить("РеквОперация", "");
	Р.Вставить("РеквСчет", "");
	Р.Вставить("РеквСумма", "");
	Р.Вставить("РеквТипДС", "");
	Р.Вставить("РеквСтатья", "");
	Р.Вставить("ЗначениеОперации", Неопределено);
	Р.Вставить("ЗначениеТипДС", Неопределено);
	Р.Вставить("ЗначениеСтатья", Неопределено);

	Мд = Метаданные.Документы.Найти("ПоступлениеДенежныхСредств");
	Если Мд = Неопределено Тогда
		Р.Текст = "нет документа ПоступлениеДенежныхСредств";
		Возврат Р;
	КонецЕсли;

	// Тип ДС
	Если Мд.Реквизиты.Найти("ТипДенежныхСредств") <> Неопределено Тогда
		Р.РеквТипДС = "ТипДенежныхСредств";
		Попытка
			Р.ЗначениеТипДС = Перечисления.ТипыДенежныхСредств.БезНаличные;
		Исключение
			Р.ЗначениеТипДС = НайтиЗначениеПеречисления("ТипыДенежныхСредств", "безнал");
		КонецПопытки;
	КонецЕсли;

	// Операция / ВидОперации
	Для Каждого Имя Из СтрРазделить("Операция,ВидОперации,ХозяйственнаяОперация", ",") Цикл
		Если Мд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.РеквОперация = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Р.РеквОперация) Тогда
		Р.ЗначениеОперации = НайтиЗначениеОперацииКорпо(Мд.Реквизиты[Р.РеквОперация].Тип);
	КонецЕсли;

	// Счёт клуба
	Для Каждого Имя Из СтрРазделить("СчетОрганизации,БанковскийСчет,Счет,РасчетныйСчет,СчетКасса", ",") Цикл
		Если Мд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.РеквСчет = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Сумма шапки
	Для Каждого Имя Из СтрРазделить("СуммаДокумента,Сумма,СуммаПлатежа", ",") Цикл
		Если Мд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.РеквСумма = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Статья ДДС
	Для Каждого Имя Из СтрРазделить("СтатьяДДС,СтатьяДвиженияДенежныхСредств,Статья", ",") Цикл
		Если Мд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.РеквСтатья = Имя;
			Р.ЗначениеСтатья = НайтиСтатьюДДСКорпо();
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// ТЧ с продажами
	ЛучшаяТЧ = "";
	ЛучшийСкор = -1;
	Для Каждого ТЧ Из Мд.ТабличныеЧасти Цикл
		ИмяНРег = НРег(ТЧ.Имя);
		Скор = 0;
		Если СтрНайти(ИмяНРег, "расшифров") > 0 Тогда
			Скор = Скор + 5;
		КонецЕсли;
		Если СтрНайти(ИмяНРег, "оплат") > 0 Или СтрНайти(ИмяНРег, "платеж") > 0 Тогда
			Скор = Скор + 3;
		КонецЕсли;
		Если СтрНайти(ИмяНРег, "продаж") > 0 Тогда
			Скор = Скор + 4;
		КонецЕсли;
		ЕстьДок = Ложь;
		ЕстьСумма = Ложь;
		Для Каждого К Из ТЧ.Реквизиты Цикл
			КН = НРег(К.Имя);
			Если КН = "документ" Или КН = "основание" Или КН = "документоснования"
				Или КН = "документпродажи" Или КН = "продажа" Или КН = "заказ" Тогда
				ЕстьДок = Истина;
			КонецЕсли;
			Если КН = "сумма" Или КН = "суммаплатежа" Или КН = "суммаоплаты" Тогда
				ЕстьСумма = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьДок Тогда
			Скор = Скор + 10;
		КонецЕсли;
		Если ЕстьСумма Тогда
			Скор = Скор + 5;
		КонецЕсли;
		Если Скор > ЛучшийСкор Тогда
			ЛучшийСкор = Скор;
			ЛучшаяТЧ = ТЧ.Имя;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ЛучшаяТЧ) Или ЛучшийСкор < 10 Тогда
		Р.Текст = "не найдена ТЧ с колонкой документа продажи (скор=" + ЛучшийСкор + ")";
		Возврат Р;
	КонецЕсли;
	Р.ИмяТЧ = ЛучшаяТЧ;

	ТЧМд = Мд.ТабличныеЧасти[ЛучшаяТЧ];
	Для Каждого Имя Из СтрРазделить("Документ,Основание,ДокументОснования,ДокументПродажи,Продажа,Заказ", ",") Цикл
		Если ТЧМд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.КолонкаДокумент = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Сумма,СуммаПлатежа,СуммаОплаты,СуммаРасчетов", ",") Цикл
		Если ТЧМд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.КолонкаСумма = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Контрагент,Клиент,Участник", ",") Цикл
		Если ТЧМд.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Р.КолонкаКлиент = Имя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Р.КолонкаДокумент) Или Не ЗначениеЗаполнено(Р.КолонкаСумма) Тогда
		Р.Текст = "в ТЧ." + ЛучшаяТЧ + " нет колонок документ/сумма";
		Возврат Р;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Р.РеквОперация) Или Р.ЗначениеОперации = Неопределено Тогда
		Р.Текст = "не найдена операция «корпоративн/страхово/кредитн» (рекв=" + Р.РеквОперация + ")";
		Возврат Р;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Р.РеквСчет) Тогда
		Р.Текст = "не найден реквизит счёта клуба";
		Возврат Р;
	КонецЕсли;

	Р.Ок = Истина;
	Р.Текст = "ТЧ=" + Р.ИмяТЧ
		+ " док=" + Р.КолонкаДокумент
		+ " сумма=" + Р.КолонкаСумма
		+ " опер=" + Р.РеквОперация + "/" + Строка(Р.ЗначениеОперации)
		+ " счет=" + Р.РеквСчет
		+ " типДС=" + Р.РеквТипДС;
	Возврат Р;

КонецФункции

Функция НайтиЗначениеОперацииКорпо(ОписаниеТипов)

	// Нельзя брать первое «страхов» — попадает «Возврат оплаты страховой компании».
	// Нужна «Оплата по корпоративному/страховому/кредитному договору».
	Лучшее = Неопределено;
	ЛучшийСкор = -1;

	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		Мд = Метаданные.НайтиПоТипу(Тип);
		Если Мд = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Перечисления.Найти(Мд.Имя) <> Мд Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ЗнМд Из Мд.ЗначенияПеречисления Цикл
			Предст = НРег(ЗнМд.Имя + " " + ЗнМд.Синоним);
			Если СтрНайти(Предст, "возврат") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Скор = 0;
			Если СтрНайти(Предст, "оплат") > 0 Тогда
				Скор = Скор + 20;
			КонецЕсли;
			Если СтрНайти(Предст, "корпоратив") > 0 Тогда
				Скор = Скор + 10;
			КонецЕсли;
			Если СтрНайти(Предст, "страхов") > 0 Тогда
				Скор = Скор + 5;
			КонецЕсли;
			Если СтрНайти(Предст, "кредитн") > 0 Тогда
				Скор = Скор + 5;
			КонецЕсли;
			Если СтрНайти(Предст, "договор") > 0 Тогда
				Скор = Скор + 3;
			КонецЕсли;
			Если Скор > ЛучшийСкор Тогда
				ЛучшийСкор = Скор;
				Лучшее = Перечисления[Мд.Имя][ЗнМд.Имя];
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ЛучшийСкор < 20 Тогда
		// Без «оплат» — слишком рискованно (возврат и т.п.).
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лучшее;

КонецФункции

Функция НайтиЗначениеПеречисления(ИмяПеречисления, Подстрока)

	Мд = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если Мд = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Под = НРег(Подстрока);
	Для Каждого ЗнМд Из Мд.ЗначенияПеречисления Цикл
		Предст = НРег(ЗнМд.Имя + " " + ЗнМд.Синоним);
		Если СтрНайти(Предст, "возврат") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Предст, Под) > 0 Тогда
			Возврат Перечисления[ИмяПеречисления][ЗнМд.Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НайтиСтатьюДДСКорпо()

	ИменаСпр = Новый Массив;
	ИменаСпр.Добавить("СтатьиДвиженияДенежныхСредств");
	ИменаСпр.Добавить("СтатьиДДС");

	Лучшее = Неопределено;
	ЛучшийСкор = -1;

	Для Каждого ИмяСпр Из ИменаСпр Цикл
		Если Метаданные.Справочники.Найти(ИмяСпр) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Выборка = Справочники[ИмяСпр].Выбрать();
			Пока Выборка.Следующий() Цикл
				Если Выборка.ПометкаУдаления Тогда
					Продолжить;
				КонецЕсли;
				Предст = НРег(Строка(Выборка.Ссылка));
				Если СтрНайти(Предст, "возврат") > 0 Тогда
					Продолжить;
				КонецЕсли;
				Скор = 0;
				Если СтрНайти(Предст, "оплат") > 0 Тогда
					Скор = Скор + 20;
				КонецЕсли;
				Если СтрНайти(Предст, "корпоратив") > 0 Тогда
					Скор = Скор + 10;
				КонецЕсли;
				Если СтрНайти(Предст, "страхов") > 0 Тогда
					Скор = Скор + 5;
				КонецЕсли;
				Если СтрНайти(Предст, "кредитн") > 0 Тогда
					Скор = Скор + 5;
				КонецЕсли;
				Если Скор > ЛучшийСкор Тогда
					ЛучшийСкор = Скор;
					Лучшее = Выборка.Ссылка;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Если ЛучшийСкор < 20 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лучшее;

КонецФункции

Функция ДатаНачалаКорпоДоговора(Договор)

	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имена = Новый Массив;
	Имена.Добавить("ДатаНачала");
	Имена.Добавить("ДатаДоговора");
	Имена.Добавить("Дата");
	Имена.Добавить("ДатаНачалаДействия");
	Имена.Добавить("НачалоДействия");
	Имена.Добавить("ДатаЗаключения");
	Имена.Добавить("ДатаОформления");

	Мд = Метаданные.Справочники.Найти("КорпоративныеДоговоры");
	Для Каждого Имя Из Имена Цикл
		Если Мд <> Неопределено И Мд.Реквизиты.Найти(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Зн = Договор[Имя];
			Если ТипЗнч(Зн) = Тип("Дата") И ЗначениеЗаполнено(Зн) Тогда
				Возврат НачалоДня(Зн);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ДатаДокументаОплатыКорпо(Договор, ДатаОкончанияПериода, ДатаОплатыИзДоговора)

	Если ДатаОплатыИзДоговора Тогда
		Д = ДатаНачалаКорпоДоговора(Договор);
		Если ЗначениеЗаполнено(Д) Тогда
			Возврат Д;
		КонецЕсли;
	КонецЕсли;
	Возврат НачалоДня(ДатаОкончанияПериода);

КонецФункции

Функция СоздатьПровестиОплатуКорпо(Группа, СчетКлуба, ДатаНачала, ДатаОкончания, Карта, ДатаОплатыИзДоговора)

	Р = Новый Структура("Ок,Текст", Ложь, "");

	Орг = КонтрагентКорпоДоговора(Группа.Договор);
	Если Не ЗначениеЗаполнено(Орг) Тогда
		Р.Текст = "у договора нет контрагента (организация)";
		Возврат Р;
	КонецЕсли;

	ДатаДок = ДатаДокументаОплатыКорпо(Группа.Договор, ДатаОкончания, ДатаОплатыИзДоговора);

	Попытка
		Док = Документы.ПоступлениеДенежныхСредств.СоздатьДокумент();
		Док.Дата = ДатаДок;
		Док.СтруктурнаяЕдиница = Группа.СтруктурнаяЕдиница;

		Если ЗначениеЗаполнено(Карта.РеквТипДС) И Карта.ЗначениеТипДС <> Неопределено Тогда
			Док[Карта.РеквТипДС] = Карта.ЗначениеТипДС;
		КонецЕсли;
		Док[Карта.РеквОперация] = Карта.ЗначениеОперации;
		Док.Контрагент = Орг;
		Попытка
			Док.Договор = Группа.Договор;
		Исключение
		КонецПопытки;
		Док[Карта.РеквСчет] = СчетКлуба;

		Если ЗначениеЗаполнено(Карта.РеквСтатья) И Карта.ЗначениеСтатья <> Неопределено Тогда
			Док[Карта.РеквСтатья] = Карта.ЗначениеСтатья;
		КонецЕсли;

		ТЧ = Док[Карта.ИмяТЧ];
		ТЧ.Очистить();
		Для Каждого Стр Из Группа.Строки Цикл
			Нов = ТЧ.Добавить();
			Нов[Карта.КолонкаДокумент] = Стр.ДокументПродажи;
			Нов[Карта.КолонкаСумма] = Стр.Задолженность;
			Если ЗначениеЗаполнено(Карта.КолонкаКлиент) Тогда
				Попытка
					Нов[Карта.КолонкаКлиент] = Стр.Клиент;
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(Карта.РеквСумма) Тогда
			Док[Карта.РеквСумма] = Группа.Сумма;
		КонецЕсли;

		Док.Комментарий = МеткаОплатыКорпо() + " "
			+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
			+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");

		Док.Записать(РежимЗаписиДокумента.Проведение);
		Р.Ок = Истина;
		Р.Текст = Строка(Док.Ссылка)
			+ " | " + Строка(Группа.Договор)
			+ " | дата=" + Формат(ДатаДок, "ДФ=dd.MM.yyyy")
			+ " | строк=" + ТЧ.Количество()
			+ " | сумма=" + Формат(Группа.Сумма, "ЧДЦ=2; ЧН=0");
	Исключение
		Р.Текст = ОписаниеОшибки();
	КонецПопытки;

	Возврат Р;

КонецФункции

#КонецОбласти
