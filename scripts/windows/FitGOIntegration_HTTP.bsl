// Модуль HTTP-сервиса FitGOIntegration
// Корневой URL: fitgo, шаблон: v1
// Тестовый клиент: phone=375296600435 — docs/TEST_CLIENT.md
//
// URL-шаблоны (свойство «Шаблон», не «Имя») — все с префиксом /v1:
//   GET  /v1/health
//   GET  /v1/client
//   GET  /v1/membership
//   POST /v1/membership/freeze  → обработчик FreezePOST
//   GET  /v1/visits
//   GET  /v1/card
//
// В конфигураторе:
//   Имя шаблона: freeze
//   Шаблон:      /v1/membership/freeze   (без /v1 приложение метод не найдёт: Nest ходит на .../hs/fitgo/v1)
//   Метод POST → Обработчик: FreezePOST
//
// У расширения снять флаг «Защита от опасных действий»: проведение документа заморозки
// создаёт COM-объект WinHttp (рассылки), иначе в HTTP-сервисе будет 500 «Предупреждение безопасности».
//
// Вставить целиком в модуль HTTP-сервиса FitGOIntegration в расширении.

Функция HealthGET(Запрос)
    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(200, Новый Структура("status", "ok"));
КонецФункции

Функция ClientGET(Запрос)
    Если НЕ FitGOIntegrationОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Контрагент = РазрешитьКонтрагента(Запрос);
    Если Контрагент = Неопределено Тогда
        Если НЕ ЗначениеЗаполнено(Запрос.ПараметрыЗапроса.Получить("phone"))
            И НЕ ЗначениеЗаполнено(Запрос.ПараметрыЗапроса.Получить("externalId")) Тогда
            Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(400, "phone or externalId required");
        КонецЕсли;
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(
        200,
        FitGOIntegrationКлиенты.ДанныеКлиентаJSON(Контрагент));
КонецФункции

Функция MembershipGET(Запрос)
    Если НЕ FitGOIntegrationОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Контрагент = РазрешитьКонтрагента(Запрос);
    Если Контрагент = Неопределено Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Абонемент = FitGOIntegrationКлиенты.АктивныйАбонементJSON(Контрагент);
    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(200, Абонемент);
КонецФункции

Функция FreezePOST(Запрос)
    Если НЕ FitGOIntegrationОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    ТелоСтрока = Запрос.ПолучитьТелоКакСтроку();
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(ТелоСтрока);
    Данные = Неопределено;
    Попытка
        Данные = ПрочитатьJSON(Чтение);
    Исключение
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(400, "Invalid JSON body");
    КонецПопытки;
    Чтение.Закрыть();

    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(400, "JSON object required");
    КонецЕсли;

    ExternalId = "";
    Phone = "";
    Дней = 0;
    ДатаС = Неопределено;
    Если Данные.Свойство("externalId") Тогда
        ExternalId = СокрЛП(Строка(Данные.externalId));
    КонецЕсли;
    Если Данные.Свойство("phone") Тогда
        Phone = СокрЛП(Строка(Данные.phone));
    КонецЕсли;
    Если Данные.Свойство("days") Тогда
        Попытка
            Дней = Число(Данные.days);
        Исключение
            Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(400, "days must be a number");
        КонецПопытки;
    КонецЕсли;
    Если Данные.Свойство("fromDate") И ЗначениеЗаполнено(Данные.fromDate) Тогда
        Попытка
            ДатаС = ПрочитатьДатуJSON(Строка(Данные.fromDate), ФорматДатыJSON.ISO);
        Исключение
            Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(400, "fromDate must be ISO date YYYY-MM-DD");
        КонецПопытки;
    КонецЕсли;

    Контрагент = Неопределено;
    Если НЕ ПустаяСтрока(ExternalId) Тогда
        Контрагент = FitGOIntegrationКлиенты.НайтиКонтрагентаПоВнешнемуИд(ExternalId);
    КонецЕсли;
    Если Контрагент = Неопределено И НЕ ПустаяСтрока(Phone) Тогда
        Контрагент = FitGOIntegrationКлиенты.НайтиКонтрагентаПоТелефону(Phone);
    КонецЕсли;
    Если Контрагент = Неопределено Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Результат = FitGOIntegrationКлиенты.ЗаморозитьАбонемент(Контрагент, Дней, ДатаС);
    Если НЕ Результат.ok Тогда
        Код = 400;
        Сообщение = Результат.error;
        Если СтрНайти(ВРег(Сообщение), "NOT FOUND") > 0 Тогда
            Код = 404;
        ИначеЕсли СтрНайти(ВРег(Сообщение), "NOT AVAILABLE") > 0
            ИЛИ СтрНайти(ВРег(Сообщение), "ALREADY FROZEN") > 0 Тогда
            Код = 409;
        КонецЕсли;
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(Код, Сообщение);
    КонецЕсли;

    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(200, Результат.membership);
КонецФункции

Функция VisitsGET(Запрос)
    Если НЕ FitGOIntegrationОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Контрагент = РазрешитьКонтрагента(Запрос);
    Если Контрагент = Неопределено Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Визиты = FitGOIntegrationКлиенты.ВизитыJSON(
        Контрагент,
        Запрос.ПараметрыЗапроса.Получить("from"),
        Запрос.ПараметрыЗапроса.Получить("to"));

    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(200, Визиты);
КонецФункции

Функция CardGET(Запрос)
    Если НЕ FitGOIntegrationОбщегоНазначения.ПроверитьАвторизациюFitGO(Запрос) Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(401, "Unauthorized");
    КонецЕсли;

    Контрагент = РазрешитьКонтрагента(Запрос);
    Если Контрагент = Неопределено Тогда
        Возврат FitGOIntegrationОбщегоНазначения.ОтветОшибки(404, "Client not found");
    КонецЕсли;

    Карта = FitGOIntegrationКлиенты.КартаДоступаJSON(Контрагент);
    Возврат FitGOIntegrationОбщегоНазначения.ОтветJSON(200, Карта);
КонецФункции

Функция РазрешитьКонтрагента(Запрос)
    ВнешнийИд = Запрос.ПараметрыЗапроса.Получить("externalId");
    Телефон = Запрос.ПараметрыЗапроса.Получить("phone");

    Если ЗначениеЗаполнено(ВнешнийИд) Тогда
        Возврат FitGOIntegrationКлиенты.НайтиКонтрагентаПоВнешнемуИд(ВнешнийИд);
    ИначеЕсли ЗначениеЗаполнено(Телефон) Тогда
        Возврат FitGOIntegrationКлиенты.НайтиКонтрагентаПоТелефону(Телефон);
    КонецЕсли;

    Возврат Неопределено;
КонецФункции
