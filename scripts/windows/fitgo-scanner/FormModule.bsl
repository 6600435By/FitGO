// Модуль формы FitGO_DataScanner
// Реквизиты лежат на ОБЪЕКТЕ обработки: Телефон, ВнешнийИд, ПутьОтчёта, Статус
// Обращение: Объект.Телефон и т.д.
// Кнопка команды → Сканировать

&НаКлиенте
Процедура Сканировать(Команда)
	Объект.Статус = СканироватьНаСервере(
		Объект.Телефон,
		Объект.ВнешнийИд,
		Объект.ПутьОтчёта);
КонецПроцедуры

&НаСервере
Функция СканироватьНаСервере(Знач Т, Знач Г, Знач П)
	Об = РеквизитФормыВЗначение("Объект");
	Возврат Об.СканироватьВФайл(Т, Г, П);
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(Объект.Телефон) Тогда
		Объект.Телефон = "375296600435";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ВнешнийИд) Тогда
		Объект.ВнешнийИд = "ff94bf6a-b4d2-11e8-80e9-7085c20c362e";
	КонецЕсли;
	Если ПустаяСтрока(Объект.ПутьОтчёта) Тогда
		Объект.ПутьОтчёта = "C:\fitgo-probe\results\fitgo-scan.json";
	КонецЕсли;
КонецПроцедуры
