// FitGO_DataScanner v3 (metadata-first) — Forma (ФитнесКлуб_ПРОФ) → FitGO
// Ничего не пишет в ИБ. Запуск: Директор → открыть .epf → Сканировать.
//
// Идея: не угадывать имена полей, а спросить их у платформы.
//   1) Клиент по GUID (или телефону)
//   2) Последнее Посещение → Основание → Основание.Метаданные(): тип + все реквизиты со значениями
//   3) РегистрНакопления.ЧленстваПакетыУслуг: измерения/ресурсы + Остатки по ссылке основания
// Результат — в поле Статус (сводка) и в JSON (подробно).

#Область Константы

Функция ТелПоУмолчанию()
	Возврат "375296600435";
КонецФункции

Функция GuidПоУмолчанию()
	Возврат "ff94bf6a-b4d2-11e8-80e9-7085c20c362e";
КонецФункции

Функция ПутьJSONПоУмолчанию()
	Возврат "C:\fitgo-probe\results\fitgo-scan.json";
КонецФункции

Функция ИмяРегистра()
	Возврат "ЧленстваПакетыУслуг";
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СканироватьВФайл(Телефон = "", ВнешнийИд = "", ПутьФайла = "") Экспорт

	Телефон = СокрЛП(Строка(Телефон));
	Если ПустаяСтрока(Телефон) Тогда
		Телефон = ТелПоУмолчанию();
	КонецЕсли;
	ВнешнийИд = СокрЛП(Строка(ВнешнийИд));
	Если СтрДлина(ВнешнийИд) <> 36 Тогда
		ВнешнийИд = GuidПоУмолчанию();
	КонецЕсли;
	ПутьФайла = СокрЛП(Строка(ПутьФайла));
	Если ПустаяСтрока(ПутьФайла) Тогда
		ПутьФайла = ПутьJSONПоУмолчанию();
	КонецЕсли;

	Отчёт = СобратьОтчёт(Телефон, ВнешнийИд);

	ОшибкаФайла = "";
	Попытка
		СохранитьОтчётВФайл(Отчёт, ПутьФайла);
	Исключение
		ОшибкаФайла = КраткоОшибку(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Сводка(Отчёт, ПутьФайла, ОшибкаФайла);

КонецФункции

#КонецОбласти

#Область Сканер

Функция СобратьОтчёт(Телефон, ВнешнийИд)

	О = Новый Структура;
	О.Вставить("scannedAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	О.Вставить("scanner", "FitGO_DataScanner");
	О.Вставить("version", "3.1-meta");
	О.Вставить("phone", Телефон);
	О.Вставить("externalId", ВнешнийИд);
	О.Вставить("configName", Безопасно_ИмяКонфигурации());
	О.Вставить("lookup", Новый Массив);
	О.Вставить("client", Новый Структура);
	О.Вставить("visitDocAttributes", ИменаРеквизитов("Документ.Посещение"));
	О.Вставить("lastVisit", Новый Структура);
	О.Вставить("membership", Новый Структура);
	О.Вставить("register", Новый Структура);
	О.Вставить("balance", Новый Массив);
	О.Вставить("recommendations", Новый Массив);

	Контрагент = НайтиКлиента(Телефон, ВнешнийИд, О.lookup);
	Если Контрагент = Неопределено Тогда
		О.recommendations.Добавить("Клиент не найден — см. lookup");
		Возврат О;
	КонецЕсли;
	О.client.Вставить("name", Строка(Контрагент));
	О.client.Вставить("id", Строка(Контрагент.УникальныйИдентификатор()));

	Основание = ПоследнееОснование(Контрагент, О.lastVisit);

	Если Основание <> Неопределено Тогда
		О.membership = ДампОбъекта(Основание);
	КонецЕсли;

	О.register = ДампРегистра(ИмяРегистра());
	О.balance = ОстаткиПоОснованию(ИмяРегистра(), О.register, Основание, Контрагент);

	// Где лежит рассчитанная дата окончания: все регистры, у которых есть измерение типа членства
	О.Вставить("registersByType", РегистрыПоТипу(Основание));
	О.Вставить("commonModules", ОбщиеМодулиПоИмени("ЧЛЕНСТВ"));

	О.recommendations = Рекомендации(О);
	Возврат О;

КонецФункции

// ---------- клиент ----------

Функция НайтиКлиента(Телефон, ВнешнийИд, Лог)

	Попытка
		Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Лог.Добавить("ok:guid");
			Возврат Ссылка;
		КонецЕсли;
		Лог.Добавить("miss:guid");
	Исключение
		Лог.Добавить("err:guid:" + КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;

	Хвост = Прав(ТолькоЦифры(Телефон), 9);
	Если ПустаяСтрока(Хвост) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 КИ.Объект КАК К
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ КИ.Объект ССЫЛКА Справочник.Контрагенты
	|	И (КИ.НомерТелефона ПОДОБНО &М ИЛИ КИ.Представление ПОДОБНО &М)");
	Запрос.УстановитьПараметр("М", "%" + Хвост + "%");
	Попытка
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			Лог.Добавить("ok:phone");
			Возврат Выб.К;
		КонецЕсли;
		Лог.Добавить("miss:phone");
	Исключение
		Лог.Добавить("err:phone:" + КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// ---------- посещение → основание ----------

Функция ПоследнееОснование(Контрагент, Инфо)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка, П.ДатаПрихода КАК Д, П.Основание КАК О
	|ИЗ Документ.Посещение КАК П
	|ГДЕ П.Контрагент = &К И НЕ П.ПометкаУдаления И П.Основание <> НЕОПРЕДЕЛЕНО
	|УПОРЯДОЧИТЬ ПО П.ДатаПрихода УБЫВ");
	Запрос.УстановитьПараметр("К", Контрагент);

	Попытка
		Выб = Запрос.Выполнить().Выбрать();
		Если НЕ Выб.Следующий() Тогда
			Инфо.Вставить("result", "empty");
			Возврат Неопределено;
		КонецЕсли;
		Инфо.Вставить("result", "ok");
		Инфо.Вставить("visitDate", Формат(Выб.Д, "ДФ=yyyy-MM-dd HH:mm"));
		Инфо.Вставить("visitRef", Строка(Выб.Ссылка));
		Инфо.Вставить("osnovanie", Строка(Выб.О));
		Инфо.Вставить("osnovanieType", Строка(ТипЗнч(Выб.О)));
		Если ЗначениеЗаполнено(Выб.О) Тогда
			Возврат Выб.О;
		КонецЕсли;
	Исключение
		Инфо.Вставить("result", "error");
		Инфо.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ---------- дамп объекта по метаданным ----------

Функция ДампОбъекта(Ссылка)

	Д = Новый Структура;
	Д.Вставить("presentation", Строка(Ссылка));
	Д.Вставить("type", Строка(ТипЗнч(Ссылка)));
	Д.Вставить("fullName", "");
	Д.Вставить("id", "");
	Д.Вставить("standard", Новый Массив);
	Д.Вставить("attributes", Новый Массив);
	Д.Вставить("tabularSections", Новый Массив);
	Д.Вставить("dateFields", Новый Массив);

	Попытка
		Д.id = Строка(Ссылка.УникальныйИдентификатор());
	Исключение
	КонецПопытки;

	Мд = Неопределено;
	Попытка
		Мд = Ссылка.Метаданные();
		Д.fullName = Мд.ПолноеИмя();
	Исключение
		Д.Вставить("error", КраткоОшибку(ИнформацияОбОшибке()));
		Возврат Д;
	КонецПопытки;

	// Стандартные реквизиты (Дата, Номер, Код, Наименование, Владелец, ПометкаУдаления, Проведен...)
	Для Каждого ИмяСтд Из СтрРазделить("Дата,Номер,Код,Наименование,Владелец,Родитель,Проведен,ПометкаУдаления", ",") Цикл
		ДобавитьПоле(Д.standard, Д.dateFields, Ссылка, ИмяСтд, "");
	КонецЦикла;

	Для Каждого Р Из Мд.Реквизиты Цикл
		ДобавитьПоле(Д.attributes, Д.dateFields, Ссылка, Р.Имя, ТипыСтрокой(Р.Тип));
	КонецЦикла;

	Попытка
		Для Каждого ТЧ Из Мд.ТабличныеЧасти Цикл
			Т = Новый Структура("name,columns", ТЧ.Имя, Новый Массив);
			Для Каждого Р Из ТЧ.Реквизиты Цикл
				Т.columns.Добавить(Р.Имя + ":" + ТипыСтрокой(Р.Тип));
			КонецЦикла;
			Д.tabularSections.Добавить(Т);
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Д;

КонецФункции

Процедура ДобавитьПоле(Массив, ДатыМассив, Ссылка, Имя, ТипМд)

	Значение = Неопределено;
	Попытка
		Значение = Ссылка[Имя];
	Исключение
		Возврат; // такого поля нет
	КонецПопытки;

	П = Новый Структура;
	П.Вставить("name", Имя);
	П.Вставить("type", ?(ПустаяСтрока(ТипМд), Строка(ТипЗнч(Значение)), ТипМд));
	П.Вставить("value", ЗначениеСтрокой(Значение));
	Массив.Добавить(П);

	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		ДатыМассив.Добавить(Имя + "=" + Формат(Значение, "ДФ=yyyy-MM-dd"));
	КонецЕсли;

КонецПроцедуры

// ---------- регистр ----------

Функция ДампРегистра(Имя)

	Р = Новый Структура;
	Р.Вставить("name", Имя);
	Р.Вставить("exists", Ложь);
	Р.Вставить("kind", "");
	Р.Вставить("dimensions", Новый Массив);
	Р.Вставить("resources", Новый Массив);
	Р.Вставить("attributes", Новый Массив);

	Мд = Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + Имя);
	Если Мд = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р.exists = Истина;
	Попытка
		Р.kind = Строка(Мд.ВидРегистра);
	Исключение
	КонецПопытки;
	Для Каждого Изм Из Мд.Измерения Цикл
		Р.dimensions.Добавить(Изм.Имя + ":" + ТипыСтрокой(Изм.Тип));
	КонецЦикла;
	Для Каждого Рс Из Мд.Ресурсы Цикл
		Р.resources.Добавить(Рс.Имя + ":" + ТипыСтрокой(Рс.Тип));
	КонецЦикла;
	Для Каждого Рк Из Мд.Реквизиты Цикл
		Р.attributes.Добавить(Рк.Имя + ":" + ТипыСтрокой(Рк.Тип));
	КонецЦикла;
	Возврат Р;

КонецФункции

// Остатки: сначала по ссылке основания (измерение подбирается по типу), затем по клиенту.
Функция ОстаткиПоОснованию(ИмяРег, МдРег, Основание, Контрагент)

	Результат = Новый Массив;
	Если НЕ МдРег.exists Тогда
		Возврат Результат;
	КонецЕсли;

	Мд = Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + ИмяРег);

	Для Каждого Изм Из Мд.Измерения Цикл
		Значение = Неопределено;
		Если Основание <> Неопределено И Изм.Тип.СодержитТип(ТипЗнч(Основание)) Тогда
			Значение = Основание;
		ИначеЕсли Изм.Тип.СодержитТип(ТипЗнч(Контрагент)) Тогда
			Значение = Контрагент;
		КонецЕсли;
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Блок = Новый Структура;
		Блок.Вставить("byDimension", Изм.Имя);
		Блок.Вставить("filterValue", Строка(Значение));
		Блок.Вставить("result", "");
		Блок.Вставить("rows", Новый Массив);

		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 5 * ИЗ РегистрНакопления." + ИмяРег + ".Остатки(&Сейчас, " + Изм.Имя + " = &З) КАК Т");
		Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("З", Значение);
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Блок.result = ?(Таб.Количество() = 0, "empty", "ok");
			Для Каждого Стр Из Таб Цикл
				Ряд = Новый Массив;
				Для Каждого Кол Из Таб.Колонки Цикл
					Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
				КонецЦикла;
				Блок.rows.Добавить(Ряд);
			КонецЦикла;
		Исключение
			Блок.result = "error";
			Блок.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
		Результат.Добавить(Блок);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все РегистрыСведений / РегистрыНакопления с измерением типа Основания → последние строки по этому членству.
// Цель: найти регистр с датой окончания/состоянием членства без угадывания имён.
Функция РегистрыПоТипу(Основание)

	Список = Новый Массив;
	Если Основание = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	ТипОсн = ТипЗнч(Основание);

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);

	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Мд Из Коллекция Цикл
			ИмяИзм = "";
			Для Каждого Изм Из Мд.Измерения Цикл
				Попытка
					Если Изм.Тип.СодержитТип(ТипОсн) Тогда
						ИмяИзм = Изм.Имя;
						Прервать;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
			Если ПустаяСтрока(ИмяИзм) Тогда
				Продолжить;
			КонецЕсли;

			Блок = Новый Структура;
			Блок.Вставить("fullName", Мд.ПолноеИмя());
			Блок.Вставить("dimension", ИмяИзм);
			Блок.Вставить("dimensions", Новый Массив);
			Блок.Вставить("resources", Новый Массив);
			Блок.Вставить("result", "");
			Блок.Вставить("rows", Новый Массив);
			Для Каждого Изм Из Мд.Измерения Цикл
				Блок.dimensions.Добавить(Изм.Имя + ":" + ТипыСтрокой(Изм.Тип));
			КонецЦикла;
			Для Каждого Рс Из Мд.Ресурсы Цикл
				Блок.resources.Добавить(Рс.Имя + ":" + ТипыСтрокой(Рс.Тип));
			КонецЦикла;
			Попытка
				Для Каждого Рк Из Мд.Реквизиты Цикл
					Блок.resources.Добавить(Рк.Имя + ":" + ТипыСтрокой(Рк.Тип));
				КонецЦикла;
			Исключение
			КонецПопытки;

			ВыполнитьВыборкуРегистра(Блок, Мд.ПолноеИмя(), ИмяИзм, Основание);
			Список.Добавить(Блок);
		КонецЦикла;
	КонецЦикла;

	Возврат Список;

КонецФункции

Процедура ВыполнитьВыборкуРегистра(Блок, ПолноеИмя, ИмяИзм, Значение)

	Тексты = Новый Массив;
	Тексты.Добавить("ВЫБРАТЬ ПЕРВЫЕ 3 * ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т." + ИмяИзм + " = &З УПОРЯДОЧИТЬ ПО Т.Период УБЫВ");
	Тексты.Добавить("ВЫБРАТЬ ПЕРВЫЕ 3 * ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т." + ИмяИзм + " = &З");

	Для Каждого Текст Из Тексты Цикл
		Запрос = Новый Запрос(Текст);
		Запрос.УстановитьПараметр("З", Значение);
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Блок.result = ?(Таб.Количество() = 0, "empty", "ok");
			Для Каждого Стр Из Таб Цикл
				Ряд = Новый Массив;
				Для Каждого Кол Из Таб.Колонки Цикл
					Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
				КонецЦикла;
				Блок.rows.Добавить(Ряд);
			КонецЦикла;
			Возврат;
		Исключение
			Блок.result = "error";
			Блок.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ОбщиеМодулиПоИмени(Фрагмент)

	Список = Новый Массив;
	Попытка
		Для Каждого Мд Из Метаданные.ОбщиеМодули Цикл
			Если СтрНайти(ВРег(Мд.Имя), Фрагмент) > 0 Тогда
				Список.Добавить(Мд.Имя);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Список;

КонецФункции

// ---------- рекомендации ----------

Функция Рекомендации(О)

	Р = Новый Массив;

	Если О.visitDocAttributes.Найти("ПризнакОтменен") = Неопределено Тогда
		Р.Добавить("В Документ.Посещение НЕТ реквизита ПризнакОтменен — убрать 'И НЕ Посещение.ПризнакОтменен' из запросов FitGOIntegration");
	КонецЕсли;

	Если О.Свойство("registersByType") Тогда
		Для Каждого Рг Из О.registersByType Цикл
			Если Рг.result <> "ok" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Поле Из Рг.rows[0] Цикл
				ВерхРег = ВРег(Поле);
				Если СтрНайти(ВерхРег, "ОКОНЧ") > 0 ИЛИ СтрНайти(ВерхРег, "СРОК") > 0 ИЛИ СтрНайти(ВерхРег, "СОСТОЯН") > 0 ИЛИ СтрНайти(ВерхРег, "СТАТУС") > 0 Тогда
					Р.Добавить("Кандидат на validUntil/status: " + Рг.fullName + " → " + Поле);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если О.membership.Свойство("fullName") И НЕ ПустаяСтрока(О.membership.fullName) Тогда
		Р.Добавить("membership → " + О.membership.fullName + " (через Посещение.Основание)");
		Если О.membership.dateFields.Количество() > 0 Тогда
			Р.Добавить("Поля дат членства: " + СтрСоединить(О.membership.dateFields, "; "));
		Иначе
			Р.Добавить("У основания нет заполненных дат — срок брать из регистра (balance)");
		КонецЕсли;
	Иначе
		Р.Добавить("Основание посещения не получено — смотрите lastVisit");
	КонецЕсли;

	ЕстьОстатки = Ложь;
	Для Каждого Б Из О.balance Цикл
		Если Б.result = "ok" Тогда
			ЕстьОстатки = Истина;
			Р.Добавить("Остатки регистра найдены по измерению «" + Б.byDimension + "» — брать срок/остаток из balance");
		КонецЕсли;
	КонецЦикла;
	Если О.register.exists И НЕ ЕстьОстатки Тогда
		Р.Добавить("Остатки регистра пусты/ошибка — для /membership использовать только Посещение.Основание");
	КонецЕсли;

	Возврат Р;

КонецФункции

#КонецОбласти

#Область Вывод

Функция Сводка(О, Путь, ОшибкаФайла)

	Т = "";
	Если ПустаяСтрока(ОшибкаФайла) Тогда
		Т = Т + "OK " + Путь + Символы.ПС;
	Иначе
		Т = Т + "FILE ERROR " + ОшибкаФайла + Символы.ПС;
	КонецЕсли;

	Если О.client.Свойство("name") Тогда
		Т = Т + "client: " + О.client.name + Символы.ПС;
	Иначе
		Т = Т + "client: NOT FOUND " + СтрСоединить(О.lookup, ", ") + Символы.ПС;
		Возврат Т;
	КонецЕсли;

	Если О.lastVisit.Свойство("osnovanieType") Тогда
		Т = Т + "visit " + О.lastVisit.visitDate + " → " + О.lastVisit.osnovanieType + Символы.ПС;
		Т = Т + "membership: " + О.lastVisit.osnovanie + Символы.ПС;
	Иначе
		Т = Т + "visit: " + ?(О.lastVisit.Свойство("result"), О.lastVisit.result, "?") + Символы.ПС;
	КонецЕсли;

	Если О.membership.Свойство("fullName") Тогда
		Т = Т + "type: " + О.membership.fullName + Символы.ПС;
		Т = Т + "dates: " + СтрСоединить(О.membership.dateFields, "; ") + Символы.ПС;
		Имена = Новый Массив;
		Для Каждого А Из О.membership.attributes Цикл
			Имена.Добавить(А.name);
		КонецЦикла;
		Т = Т + "attrs: " + СтрСоединить(Имена, ", ") + Символы.ПС;
	КонецЕсли;

	Если О.register.exists Тогда
		Т = Т + "register dims: " + СтрСоединить(О.register.dimensions, "; ") + Символы.ПС;
		Т = Т + "register res: " + СтрСоединить(О.register.resources, "; ") + Символы.ПС;
	КонецЕсли;
	Для Каждого Б Из О.balance Цикл
		Т = Т + "balance[" + Б.byDimension + "]=" + Б.result;
		Если Б.result = "ok" И Б.rows.Количество() > 0 Тогда
			Т = Т + " " + СтрСоединить(Б.rows[0], "; ");
		КонецЕсли;
		Т = Т + Символы.ПС;
	КонецЦикла;

	Если О.Свойство("registersByType") Тогда
		Для Каждого Р Из О.registersByType Цикл
			Т = Т + "reg " + Р.fullName + " [" + Р.dimension + "] " + Р.result;
			Если Р.result = "ok" И Р.rows.Количество() > 0 Тогда
				Т = Т + Символы.ПС + "    " + Лев(СтрСоединить(Р.rows[0], "; "), 400);
			КонецЕсли;
			Т = Т + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если О.Свойство("commonModules") И О.commonModules.Количество() > 0 Тогда
		Т = Т + "modules: " + СтрСоединить(О.commonModules, ", ") + Символы.ПС;
	КонецЕсли;

	Для Каждого Стр Из О.recommendations Цикл
		Т = Т + "- " + Стр + Символы.ПС;
	КонецЦикла;

	Возврат Т;

КонецФункции

Процедура СохранитьОтчётВФайл(Отчёт, ПутьФайла)

	Поз = 0;
	Для Индекс = 1 По СтрДлина(ПутьФайла) Цикл
		С = Сред(ПутьФайла, Индекс, 1);
		Если С = "\" ИЛИ С = "/" Тогда
			Поз = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Поз > 1 Тогда
		Попытка
			СоздатьКаталог(Лев(ПутьФайла, Поз - 1));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Отчёт);
	ТекстJSON = Запись.Закрыть();

	Док = Новый ТекстовыйДокумент;
	Док.УстановитьТекст(ТекстJSON);
	Док.Записать(ПутьФайла, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ИменаРеквизитов(ПолноеИмя)

	Список = Новый Массив;
	Мд = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мд = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Попытка
		Для Каждого Р Из Мд.Реквизиты Цикл
			Список.Добавить(Р.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Список;

КонецФункции

Функция ТипыСтрокой(ОписаниеТипов)

	Части = Новый Массив;
	Попытка
		Для Каждого Т Из ОписаниеТипов.Типы() Цикл
			Части.Добавить(Строка(Т));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат СтрСоединить(Части, "|");

КонецФункции

// Только JSON-совместимые значения: строки/числа/булево. Ссылки и перечисления — строкой.
Функция ЗначениеСтрокой(Значение)

	Тип = ТипЗнч(Значение);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=yyyy-MM-dd HH:mm:ss"), "");
	ИначеЕсли Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧДЦ=2");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;
	Попытка
		Возврат Лев(Строка(Значение), 200);
	Исключение
		Возврат "<" + Строка(Тип) + ">";
	КонецПопытки;

КонецФункции

Функция ТолькоЦифры(Значение)

	Исх = Строка(Значение);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Исх) Цикл
		С = Сред(Исх, Индекс, 1);
		Если СтрНайти("0123456789", С) > 0 Тогда
			Цифры = Цифры + С;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;

КонецФункции

Функция Безопасно_ИмяКонфигурации()
	Попытка
		Возврат Метаданные.Имя;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция КраткоОшибку(Инф)
	Попытка
		Возврат Лев(КраткоеПредставлениеОшибки(Инф), 160);
	Исключение
		Возврат "err";
	КонецПопытки;
КонецФункции

