// FitGO_DataScanner v3 (metadata-first) — Forma (ФитнесКлуб_ПРОФ) → FitGO
// Ничего не пишет в ИБ. Запуск: Директор → открыть .epf → Сканировать.
//
// Идея: не угадывать имена полей, а спросить их у платформы.
//   1) Клиент по GUID (или телефону)
//   2) Последнее Посещение → Основание → Основание.Метаданные(): тип + все реквизиты со значениями
//   3) РегистрНакопления.ЧленстваПакетыУслуг: измерения/ресурсы + Остатки по ссылке основания
// Результат — в поле Статус (сводка) и в JSON (подробно).

#Область Константы

Функция ТелПоУмолчанию()
	Возврат "375296600435";
КонецФункции

Функция GuidПоУмолчанию()
	Возврат "ff94bf6a-b4d2-11e8-80e9-7085c20c362e";
КонецФункции

Функция ПутьJSONПоУмолчанию()
	Возврат "C:\fitgo-probe\results\fitgo-scan.json";
КонецФункции

Функция ИмяРегистра()
	Возврат "ЧленстваПакетыУслуг";
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция СканироватьВФайл(Телефон = "", ВнешнийИд = "", ПутьФайла = "") Экспорт

	Телефон = СокрЛП(Строка(Телефон));
	Если ПустаяСтрока(Телефон) Тогда
		Телефон = ТелПоУмолчанию();
	КонецЕсли;
	ВнешнийИд = СокрЛП(Строка(ВнешнийИд));
	Если СтрДлина(ВнешнийИд) <> 36 Тогда
		ВнешнийИд = GuidПоУмолчанию();
	КонецЕсли;
	ПутьФайла = СокрЛП(Строка(ПутьФайла));
	Если ПустаяСтрока(ПутьФайла) Тогда
		ПутьФайла = ПутьJSONПоУмолчанию();
	КонецЕсли;

	Отчёт = СобратьОтчёт(Телефон, ВнешнийИд);

	ОшибкаФайла = "";
	Попытка
		СохранитьОтчётВФайл(Отчёт, ПутьФайла);
	Исключение
		ОшибкаФайла = КраткоОшибку(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Сводка(Отчёт, ПутьФайла, ОшибкаФайла);

КонецФункции

#КонецОбласти

#Область Сканер

Функция СобратьОтчёт(Телефон, ВнешнийИд)

	О = Новый Структура;
	О.Вставить("scannedAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	О.Вставить("scanner", "FitGO_DataScanner");
	О.Вставить("version", "3.3-meta");
	О.Вставить("phone", Телефон);
	О.Вставить("externalId", ВнешнийИд);
	О.Вставить("configName", Безопасно_ИмяКонфигурации());
	О.Вставить("lookup", Новый Массив);
	О.Вставить("client", Новый Структура);
	О.Вставить("visitDocAttributes", ИменаРеквизитов("Документ.Посещение"));
	О.Вставить("lastVisit", Новый Структура);
	О.Вставить("membership", Новый Структура);
	О.Вставить("register", Новый Структура);
	О.Вставить("balance", Новый Массив);
	О.Вставить("recommendations", Новый Массив);

	Контрагент = НайтиКлиента(Телефон, ВнешнийИд, О.lookup);
	Если Контрагент = Неопределено Тогда
		О.recommendations.Добавить("Клиент не найден — см. lookup");
		Возврат О;
	КонецЕсли;
	О.client.Вставить("name", Строка(Контрагент));
	О.client.Вставить("id", Строка(Контрагент.УникальныйИдентификатор()));
	О.Вставить("clientDump", ДампОбъекта(Контрагент));
	О.Вставить("phoneHits", ГдеЛежитТелефон(Контрагент, Прав(ТолькоЦифры(Телефон), 7)));

	Основание = ПоследнееОснование(Контрагент, О.lastVisit);

	Если Основание <> Неопределено Тогда
		О.membership = ДампОбъекта(Основание);
	КонецЕсли;

	О.register = ДампРегистра(ИмяРегистра());
	О.balance = ОстаткиПоОснованию(ИмяРегистра(), О.register, Основание, Контрагент);

	// Где лежит рассчитанная дата окончания: все регистры, у которых есть измерение типа членства
	О.Вставить("registersByType", РегистрыПоТипу(Основание));
	О.Вставить("commonModules", ОбщиеМодулиПоИмени("ЧЛЕНСТВ"));
	О.Вставить("money", ДеньгиКлиентаПробы(Контрагент));
	О.Вставить("moneyCatalogs", КаталогиПоИмени("ЛИЦЕВ,ЗАДОЛЖ,БОНУС,ВЗАИМОРАСЧ"));

	О.recommendations = Рекомендации(О);
	Возврат О;

КонецФункции

// ---------- клиент ----------

Функция НайтиКлиента(Телефон, ВнешнийИд, Лог)

	Попытка
		Ссылка = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(ВнешнийИд));
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Лог.Добавить("ok:guid");
			Возврат Ссылка;
		КонецЕсли;
		Лог.Добавить("miss:guid");
	Исключение
		Лог.Добавить("err:guid:" + КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;

	Хвост = Прав(ТолькоЦифры(Телефон), 9);
	Если ПустаяСтрока(Хвост) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 КИ.Объект КАК К
	|ИЗ РегистрСведений.КонтактнаяИнформация КАК КИ
	|ГДЕ КИ.Объект ССЫЛКА Справочник.Контрагенты
	|	И (КИ.НомерТелефона ПОДОБНО &М ИЛИ КИ.Представление ПОДОБНО &М)");
	Запрос.УстановитьПараметр("М", "%" + Хвост + "%");
	Попытка
		Выб = Запрос.Выполнить().Выбрать();
		Если Выб.Следующий() Тогда
			Лог.Добавить("ok:phone");
			Возврат Выб.К;
		КонецЕсли;
		Лог.Добавить("miss:phone");
	Исключение
		Лог.Добавить("err:phone:" + КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// ---------- посещение → основание ----------

Функция ПоследнееОснование(Контрагент, Инфо)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 П.Ссылка КАК Ссылка, П.ДатаПрихода КАК Д, П.Основание КАК О
	|ИЗ Документ.Посещение КАК П
	|ГДЕ П.Контрагент = &К И НЕ П.ПометкаУдаления И П.Основание <> НЕОПРЕДЕЛЕНО
	|УПОРЯДОЧИТЬ ПО П.ДатаПрихода УБЫВ");
	Запрос.УстановитьПараметр("К", Контрагент);

	Попытка
		Выб = Запрос.Выполнить().Выбрать();
		Если НЕ Выб.Следующий() Тогда
			Инфо.Вставить("result", "empty");
			Возврат Неопределено;
		КонецЕсли;
		Инфо.Вставить("result", "ok");
		Инфо.Вставить("visitDate", Формат(Выб.Д, "ДФ=yyyy-MM-dd HH:mm"));
		Инфо.Вставить("visitRef", Строка(Выб.Ссылка));
		Инфо.Вставить("osnovanie", Строка(Выб.О));
		Инфо.Вставить("osnovanieType", Строка(ТипЗнч(Выб.О)));
		Если ЗначениеЗаполнено(Выб.О) Тогда
			Возврат Выб.О;
		КонецЕсли;
	Исключение
		Инфо.Вставить("result", "error");
		Инфо.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// ---------- дамп объекта по метаданным ----------

Функция ДампОбъекта(Ссылка)

	Д = Новый Структура;
	Д.Вставить("presentation", Строка(Ссылка));
	Д.Вставить("type", Строка(ТипЗнч(Ссылка)));
	Д.Вставить("fullName", "");
	Д.Вставить("id", "");
	Д.Вставить("standard", Новый Массив);
	Д.Вставить("attributes", Новый Массив);
	Д.Вставить("tabularSections", Новый Массив);
	Д.Вставить("dateFields", Новый Массив);

	Попытка
		Д.id = Строка(Ссылка.УникальныйИдентификатор());
	Исключение
	КонецПопытки;

	Мд = Неопределено;
	Попытка
		Мд = Ссылка.Метаданные();
		Д.fullName = Мд.ПолноеИмя();
	Исключение
		Д.Вставить("error", КраткоОшибку(ИнформацияОбОшибке()));
		Возврат Д;
	КонецПопытки;

	// Стандартные реквизиты (Дата, Номер, Код, Наименование, Владелец, ПометкаУдаления, Проведен...)
	Для Каждого ИмяСтд Из СтрРазделить("Дата,Номер,Код,Наименование,Владелец,Родитель,Проведен,ПометкаУдаления", ",") Цикл
		ДобавитьПоле(Д.standard, Д.dateFields, Ссылка, ИмяСтд, "");
	КонецЦикла;

	Для Каждого Р Из Мд.Реквизиты Цикл
		ДобавитьПоле(Д.attributes, Д.dateFields, Ссылка, Р.Имя, ТипыСтрокой(Р.Тип));
	КонецЦикла;

	Попытка
		Для Каждого ТЧ Из Мд.ТабличныеЧасти Цикл
			Т = Новый Структура("name,columns", ТЧ.Имя, Новый Массив);
			Для Каждого Р Из ТЧ.Реквизиты Цикл
				Т.columns.Добавить(Р.Имя + ":" + ТипыСтрокой(Р.Тип));
			КонецЦикла;
			Д.tabularSections.Добавить(Т);
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат Д;

КонецФункции

Процедура ДобавитьПоле(Массив, ДатыМассив, Ссылка, Имя, ТипМд)

	Значение = Неопределено;
	Попытка
		Значение = Ссылка[Имя];
	Исключение
		Возврат; // такого поля нет
	КонецПопытки;

	П = Новый Структура;
	П.Вставить("name", Имя);
	П.Вставить("type", ?(ПустаяСтрока(ТипМд), Строка(ТипЗнч(Значение)), ТипМд));
	П.Вставить("value", ЗначениеСтрокой(Значение));
	Массив.Добавить(П);

	Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
		ДатыМассив.Добавить(Имя + "=" + Формат(Значение, "ДФ=yyyy-MM-dd"));
	КонецЕсли;

КонецПроцедуры

// ---------- регистр ----------

Функция ДампРегистра(Имя)

	Р = Новый Структура;
	Р.Вставить("name", Имя);
	Р.Вставить("exists", Ложь);
	Р.Вставить("kind", "");
	Р.Вставить("dimensions", Новый Массив);
	Р.Вставить("resources", Новый Массив);
	Р.Вставить("attributes", Новый Массив);

	Мд = Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + Имя);
	Если Мд = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р.exists = Истина;
	Попытка
		Р.kind = Строка(Мд.ВидРегистра);
	Исключение
	КонецПопытки;
	Для Каждого Изм Из Мд.Измерения Цикл
		Р.dimensions.Добавить(Изм.Имя + ":" + ТипыСтрокой(Изм.Тип));
	КонецЦикла;
	Для Каждого Рс Из Мд.Ресурсы Цикл
		Р.resources.Добавить(Рс.Имя + ":" + ТипыСтрокой(Рс.Тип));
	КонецЦикла;
	Для Каждого Рк Из Мд.Реквизиты Цикл
		Р.attributes.Добавить(Рк.Имя + ":" + ТипыСтрокой(Рк.Тип));
	КонецЦикла;
	Возврат Р;

КонецФункции

// Остатки: сначала по ссылке основания (измерение подбирается по типу), затем по клиенту.
Функция ОстаткиПоОснованию(ИмяРег, МдРег, Основание, Контрагент)

	Результат = Новый Массив;
	Если НЕ МдРег.exists Тогда
		Возврат Результат;
	КонецЕсли;

	Мд = Метаданные.НайтиПоПолномуИмени("РегистрНакопления." + ИмяРег);

	Для Каждого Изм Из Мд.Измерения Цикл
		Значение = Неопределено;
		Если Основание <> Неопределено И Изм.Тип.СодержитТип(ТипЗнч(Основание)) Тогда
			Значение = Основание;
		ИначеЕсли Изм.Тип.СодержитТип(ТипЗнч(Контрагент)) Тогда
			Значение = Контрагент;
		КонецЕсли;
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Блок = Новый Структура;
		Блок.Вставить("byDimension", Изм.Имя);
		Блок.Вставить("filterValue", Строка(Значение));
		Блок.Вставить("result", "");
		Блок.Вставить("rows", Новый Массив);

		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 5 * ИЗ РегистрНакопления." + ИмяРег + ".Остатки(&Сейчас, " + Изм.Имя + " = &З) КАК Т");
		Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("З", Значение);
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Блок.result = ?(Таб.Количество() = 0, "empty", "ok");
			Для Каждого Стр Из Таб Цикл
				Ряд = Новый Массив;
				Для Каждого Кол Из Таб.Колонки Цикл
					Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
				КонецЦикла;
				Блок.rows.Добавить(Ряд);
			КонецЦикла;
		Исключение
			Блок.result = "error";
			Блок.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
		Результат.Добавить(Блок);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все РегистрыСведений / РегистрыНакопления с измерением типа Основания → последние строки по этому членству.
// Цель: найти регистр с датой окончания/состоянием членства без угадывания имён.
Функция РегистрыПоТипу(Основание)

	Список = Новый Массив;
	Если Основание = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	ТипОсн = ТипЗнч(Основание);

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);

	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Мд Из Коллекция Цикл
			ИмяИзм = "";
			Для Каждого Изм Из Мд.Измерения Цикл
				Попытка
					Если Изм.Тип.СодержитТип(ТипОсн) Тогда
						ИмяИзм = Изм.Имя;
						Прервать;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
			Если ПустаяСтрока(ИмяИзм) Тогда
				Продолжить;
			КонецЕсли;

			Блок = Новый Структура;
			Блок.Вставить("fullName", Мд.ПолноеИмя());
			Блок.Вставить("dimension", ИмяИзм);
			Блок.Вставить("dimensions", Новый Массив);
			Блок.Вставить("resources", Новый Массив);
			Блок.Вставить("result", "");
			Блок.Вставить("rows", Новый Массив);
			Для Каждого Изм Из Мд.Измерения Цикл
				Блок.dimensions.Добавить(Изм.Имя + ":" + ТипыСтрокой(Изм.Тип));
			КонецЦикла;
			Для Каждого Рс Из Мд.Ресурсы Цикл
				Блок.resources.Добавить(Рс.Имя + ":" + ТипыСтрокой(Рс.Тип));
			КонецЦикла;
			Попытка
				Для Каждого Рк Из Мд.Реквизиты Цикл
					Блок.resources.Добавить(Рк.Имя + ":" + ТипыСтрокой(Рк.Тип));
				КонецЦикла;
			Исключение
			КонецПопытки;

			ВыполнитьВыборкуРегистра(Блок, Мд.ПолноеИмя(), ИмяИзм, Основание);
			Список.Добавить(Блок);
		КонецЦикла;
	КонецЦикла;

	Возврат Список;

КонецФункции

Процедура ВыполнитьВыборкуРегистра(Блок, ПолноеИмя, ИмяИзм, Значение)

	Тексты = Новый Массив;
	Тексты.Добавить("ВЫБРАТЬ ПЕРВЫЕ 3 * ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т." + ИмяИзм + " = &З УПОРЯДОЧИТЬ ПО Т.Период УБЫВ");
	Тексты.Добавить("ВЫБРАТЬ ПЕРВЫЕ 3 * ИЗ " + ПолноеИмя + " КАК Т ГДЕ Т." + ИмяИзм + " = &З");

	Для Каждого Текст Из Тексты Цикл
		Запрос = Новый Запрос(Текст);
		Запрос.УстановитьПараметр("З", Значение);
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Блок.result = ?(Таб.Количество() = 0, "empty", "ok");
			Для Каждого Стр Из Таб Цикл
				Ряд = Новый Массив;
				Для Каждого Кол Из Таб.Колонки Цикл
					Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
				КонецЦикла;
				Блок.rows.Добавить(Ряд);
			КонецЦикла;
			Возврат;
		Исключение
			Блок.result = "error";
			Блок.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция ОбщиеМодулиПоИмени(Фрагмент)

	Список = Новый Массив;
	Попытка
		Для Каждого Мд Из Метаданные.ОбщиеМодули Цикл
			Если СтрНайти(ВРег(Мд.Имя), Фрагмент) > 0 Тогда
				Список.Добавить(Мд.Имя);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Список;

КонецФункции

Функция КаталогиПоИмени(СписокФрагментов)

	Список = Новый Массив;
	Фрагменты = СтрРазделить(СписокФрагментов, ",");
	Попытка
		Для Каждого Мд Из Метаданные.Справочники Цикл
			ИмяВ = ВРег(Мд.Имя);
			Для Каждого Фр Из Фрагменты Цикл
				Если СтрНайти(ИмяВ, СокрЛП(Фр)) > 0 Тогда
					Список.Добавить(Мд.ПолноеИмя());
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Список;

КонецФункции

// Лицевые / задолженность: регистры с измерением типа Контрагент и именем/ресурсом «деньги».
Функция ДеньгиКлиентаПробы(Контрагент)

	Результат = Новый Структура;
	Результат.Вставить("candidates", Новый Массив);
	Результат.Вставить("pickedBalance", Неопределено);
	Результат.Вставить("pickedDebt", Неопределено);
	Результат.Вставить("accounts", Новый Массив);

	ТипКлиента = ТипЗнч(Контрагент);
	Ключи = СтрРазделить("ЛИЦЕВ,ЗАДОЛЖ,ДОЛГ,БОНУС,ВЗАИМОРАСЧ,ДЕНЕЖН,АВАНС", ",");

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыСведений);

	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Мд Из Коллекция Цикл
			ИмяВ = ВРег(Мд.Имя);
			Интересен = Ложь;
			Для Каждого Кл Из Ключи Цикл
				Если СтрНайти(ИмяВ, Кл) > 0 Тогда
					Интересен = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			ИмяИзмКлиент = "";
			Для Каждого Изм Из Мд.Измерения Цикл
				Попытка
					Если Изм.Тип.СодержитТип(ТипКлиента) Тогда
						ИмяИзмКлиент = Изм.Имя;
						Прервать;
					КонецЕсли;
				Исключение
				КонецПопытки;
			КонецЦикла;
			Если ПустаяСтрока(ИмяИзмКлиент) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ Интересен Тогда
				// всё равно пробуем РН с ресурсом Сумма + измерение клиент
				ЕстьСумма = Ложь;
				Для Каждого Рс Из Мд.Ресурсы Цикл
					Если СтрНайти(ВРег(Рс.Имя), "СУММ") > 0 Тогда
						ЕстьСумма = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ ЕстьСумма Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			Блок = Новый Структура;
			Блок.Вставить("fullName", Мд.ПолноеИмя());
			Блок.Вставить("clientDimension", ИмяИзмКлиент);
			Блок.Вставить("dimensions", Новый Массив);
			Блок.Вставить("resources", Новый Массив);
			Блок.Вставить("result", "");
			Блок.Вставить("rows", Новый Массив);
			Для Каждого Изм Из Мд.Измерения Цикл
				Блок.dimensions.Добавить(Изм.Имя + ":" + ТипыСтрокой(Изм.Тип));
			КонецЦикла;
			Для Каждого Рс Из Мд.Ресурсы Цикл
				Блок.resources.Добавить(Рс.Имя + ":" + ТипыСтрокой(Рс.Тип));
			КонецЦикла;

			ВыполнитьОстаткиИлиВыборку(Блок, Мд, ИмяИзмКлиент, Контрагент);
			Результат.candidates.Добавить(Блок);

			Если Блок.result = "ok" Тогда
				Для Каждого Ряд Из Блок.rows Цикл
					Для Каждого Акк Из РазобратьДенежныйРяд(Блок.fullName, Ряд) Цикл
						Результат.accounts.Добавить(Акк);
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Полная сводка без ПЕРВЫЕ 20 — иначе долг «Чай»×N обрезается (карточка 524.85 vs sample 176).
	Результат.Вставить("settlementTotals", СводкаРасчетовСПокупателями(Контрагент));
	ВыбратьЛицевойИДолг(Результат);
	Возврат Результат;

КонецФункции

// Все остатки РасчетыСПокупателями: плюсы/минусы Долг и лицевой (без лимита строк).
Функция СводкаРасчетовСПокупателями(Контрагент)

	Сводка = Новый Структура;
	Сводка.Вставить("ok", Ложь);
	Сводка.Вставить("face", 0);
	Сводка.Вставить("debtPos", 0);
	Сводка.Вставить("debtAbsNeg", 0);
	Сводка.Вставить("debtNet", 0);
	Сводка.Вставить("countPos", 0);
	Сводка.Вставить("countNeg", 0);
	Сводка.Вставить("countFace", 0);
	Сводка.Вставить("rowCount", 0);
	Сводка.Вставить("detail", "");

	Тексты = Новый Массив;
	Тексты.Добавить("ВЫБРАТЬ * ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(&Сейчас, Контрагент = &К) КАК Т");
	Тексты.Добавить("ВЫБРАТЬ * ИЗ РегистрНакопления.РасчетыСПокупателями.Остатки(, Контрагент = &К) КАК Т");

	Таб = Неопределено;
	Для Каждого Текст Из Тексты Цикл
		Запрос = Новый Запрос(Текст);
		Запрос.УстановитьПараметр("К", Контрагент);
		Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Сводка.detail = Лев(Текст, 100);
			Прервать;
		Исключение
			Сводка.detail = КраткоОшибку(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	Если Таб = Неопределено Тогда
		Возврат Сводка;
	КонецЕсли;

	Сводка.ok = Истина;
	Сводка.rowCount = Таб.Количество();
	Для Каждого Стр Из Таб Цикл
		Ряд = Новый Массив;
		Для Каждого Кол Из Таб.Колонки Цикл
			Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
		КонецЦикла;
		Для Каждого Акк Из РазобратьДенежныйРяд("РегистрНакопления.РасчетыСПокупателями", Ряд) Цикл
			Если Акк.isAccount Тогда
				Сводка.face = Сводка.face + Акк.amount;
				Сводка.countFace = Сводка.countFace + 1;
			ИначеЕсли Акк.isDebt Тогда
				Сводка.debtNet = Сводка.debtNet + Акк.amount;
				Если Акк.amount > 0 Тогда
					Сводка.debtPos = Сводка.debtPos + Акк.amount;
					Сводка.countPos = Сводка.countPos + 1;
				ИначеЕсли Акк.amount < 0 Тогда
					Сводка.debtAbsNeg = Сводка.debtAbsNeg + (-Акк.amount);
					Сводка.countNeg = Сводка.countNeg + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Сводка;

КонецФункции

Процедура ВыполнитьОстаткиИлиВыборку(Блок, Мд, ИмяИзм, Контрагент)

	Полное = Мд.ПолноеИмя();
	Тексты = Новый Массив;
	Если СтрНайти(Полное, "РегистрНакопления.") = 1 Тогда
		Тексты.Добавить(
		"ВЫБРАТЬ ПЕРВЫЕ 20 * ИЗ " + Полное + ".Остатки(&Сейчас, " + ИмяИзм + " = &К) КАК Т");
		Тексты.Добавить(
		"ВЫБРАТЬ ПЕРВЫЕ 20 * ИЗ " + Полное + ".Остатки(, " + ИмяИзм + " = &К) КАК Т");
	КонецЕсли;
	Тексты.Добавить("ВЫБРАТЬ ПЕРВЫЕ 20 * ИЗ " + Полное + " КАК Т ГДЕ Т." + ИмяИзм + " = &К");

	Для Каждого Текст Из Тексты Цикл
		Запрос = Новый Запрос(Текст);
		Запрос.УстановитьПараметр("К", Контрагент);
		Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
		Попытка
			Таб = Запрос.Выполнить().Выгрузить();
			Блок.result = ?(Таб.Количество() = 0, "empty", "ok");
			Блок.Вставить("query", Лев(Текст, 120));
			Для Каждого Стр Из Таб Цикл
				Ряд = Новый Массив;
				Для Каждого Кол Из Таб.Колонки Цикл
					Ряд.Добавить(Кол.Имя + "=" + ЗначениеСтрокой(Стр[Кол.Имя]));
				КонецЦикла;
				Блок.rows.Добавить(Ряд);
			КонецЦикла;
			Возврат;
		Исключение
			Блок.result = "error";
			Блок.Вставить("detail", КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Возвращает Массив структур {register,kind,amount,isDebt,isAccount} (0..N на ряд).
Функция РазобратьДенежныйРяд(ИмяРег, Ряд)

	ЭтоРасчеты = СтрНайти(ВРег(ИмяРег), "РАСЧЕТЫСПОКУПАТЕЛЯМИ") > 0;
	СуммаОбщая = Неопределено;
	ВидИзм = "";
	ЛицевРесурс = Неопределено;
	ДолгРесурс = Неопределено;

	Для Каждого Яч Из Ряд Цикл
		Части = СтрРазделить(Яч, "=");
		Если Части.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ИмяП = ВРег(Части[0]);
		ЗначП = Сред(Яч, СтрДлина(Части[0]) + 2);

		Если СтрНайти(ИмяП, "ЛИЦЕВ") > 0 Тогда
			Попытка
				ЛицевРесурс = Число(СтрЗаменить(ЗначП, " ", ""));
			Исключение
			КонецПопытки;
		ИначеЕсли ИмяП = "ДОЛГ" ИЛИ СтрНайти(ИмяП, "ДОЛГ") = 1 Тогда
			Попытка
				ДолгРесурс = Число(СтрЗаменить(ЗначП, " ", ""));
			Исключение
			КонецПопытки;
		ИначеЕсли СтрНайти(ИмяП, "СУММ") > 0 ИЛИ СтрНайти(ИмяП, "ОСТАТОК") > 0 Тогда
			Попытка
				СуммаОбщая = Число(СтрЗаменить(ЗначП, " ", ""));
			Исключение
			КонецПопытки;
		КонецЕсли;

		Если СтрНайти(ИмяП, "ВИД") > 0 ИЛИ СтрНайти(ИмяП, "ТИПРАСЧ") > 0 ИЛИ СтрНайти(ИмяП, "СЧЕТРАСЧ") > 0 Тогда
			Если НЕ ПустаяСтрока(ЗначП) И СтрНайти("0123456789", Лев(ЗначП, 1)) = 0 Тогда
				ВидИзм = ЗначП;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Если ЛицевРесурс <> Неопределено Тогда
		Результат.Добавить(НовыйДенАкк(ИмяРег, "Лицевой счет", ЛицевРесурс, Ложь, Истина));
	КонецЕсли;
	Если ДолгРесурс <> Неопределено Тогда
		Результат.Добавить(НовыйДенАкк(ИмяРег, "Долг", ДолгРесурс, Истина, Ложь));
	КонецЕсли;
	Если Результат.Количество() = 0 И СуммаОбщая <> Неопределено Тогда
		ВидВ = ВРег(ВидИзм);
		ЭтоДолг = СтрНайти(ВидВ, "ДОЛГ") > 0
			ИЛИ (НЕ ЭтоРасчеты И (СтрНайти(ВРег(ИмяРег), "ЗАДОЛЖ") > 0 ИЛИ СтрНайти(ВРег(ИмяРег), "ВЗАИМОРАСЧ") > 0));
		ЭтоЛиц = СтрНайти(ВидВ, "ЛИЦЕВ") > 0 ИЛИ СтрНайти(ВидВ, "БОНУС") > 0 ИЛИ СтрНайти(ВидВ, "ОСНОВ") > 0;
		Если ЭтоРасчеты И НЕ ЭтоДолг И НЕ ЭтоЛиц Тогда
			// без явного вида — не брать (иначе Долг=176 уезжает в balance)
			Возврат Результат;
		КонецЕсли;
		Если ЭтоДолг ИЛИ ЭтоЛиц ИЛИ НЕ ЭтоРасчеты Тогда
			Результат.Добавить(НовыйДенАкк(ИмяРег, ВидИзм, СуммаОбщая, ЭтоДолг, ЭтоЛиц));
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НовыйДенАкк(ИмяРег, Вид, Сумма, ЭтоДолг, ЭтоЛиц)
	А = Новый Структура;
	А.Вставить("register", ИмяРег);
	А.Вставить("kind", Вид);
	А.Вставить("amount", Сумма);
	А.Вставить("isDebt", ЭтоДолг);
	А.Вставить("isAccount", ЭтоЛиц);
	Возврат А;
КонецФункции

Процедура ВыбратьЛицевойИДолг(Результат)

	// Лицевой: из полной сводки (если есть), иначе sample accounts
	Сводка = Неопределено;
	Попытка
		Сводка = Результат.settlementTotals;
	Исключение
	КонецПопытки;

	Если Сводка <> Неопределено И Сводка.ok И Сводка.countFace > 0 Тогда
		Результат.pickedBalance = Новый Структура("amount,kind,register",
			Сводка.face, "Лицевой счет", "РегистрНакопления.РасчетыСПокупателями");
	Иначе
		Положительные = Новый Массив;
		ВсеЛицевые = Новый Массив;
		Для Каждого А Из Результат.accounts Цикл
			Если А.isAccount Тогда
				ВсеЛицевые.Добавить(А);
				Если А.amount > 0 Тогда
					Положительные.Добавить(А);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Положительные.Количество() > 0 Тогда
			Лучший = Положительные[0];
			Для Каждого А Из Положительные Цикл
				Если А.amount > Лучший.amount Тогда
					Лучший = А;
				КонецЕсли;
			КонецЦикла;
			Результат.pickedBalance = Лучший;
		ИначеЕсли ВсеЛицевые.Количество() > 0 Тогда
			Результат.pickedBalance = ВсеЛицевые[0];
		КонецЕсли;
	КонецЕсли;

	// Долг карточки «Оплатить X» (Forma): остатки вида Долг с минусом → |сумма|.
	// Куделко: absNeg=524.85 (199 строк «Чай»…), pos=176 — в кнопку оплаты не входит.
	Если Сводка <> Неопределено И Сводка.ok И (Сводка.countPos > 0 ИЛИ Сводка.countNeg > 0) Тогда
		Если Сводка.debtAbsNeg > 0 Тогда
			СуммаДолга = Сводка.debtAbsNeg;
			Правило = "sumAbsNeg";
		Иначе
			СуммаДолга = Сводка.debtPos;
			Правило = "sumPos";
		КонецЕсли;
		Результат.pickedDebt = Новый Структура("amount,register,rule,debtPos,debtAbsNeg,debtNet,countPos,countNeg",
			СуммаДолга, "РегистрНакопления.РасчетыСПокупателями", Правило,
			Сводка.debtPos, Сводка.debtAbsNeg, Сводка.debtNet, Сводка.countPos, Сводка.countNeg);
	КонецЕсли;

КонецПроцедуры

// ---------- где лежит телефон ----------

// Ищет хвост телефона в реквизитах, табличных частях контрагента и в РС.КонтактнаяИнформация.
Функция ГдеЛежитТелефон(Контрагент, Хвост)

	Хиты = Новый Массив;
	Если ПустаяСтрока(Хвост) Тогда
		Возврат Хиты;
	КонецЕсли;

	Мд = Неопределено;
	Попытка
		Мд = Контрагент.Метаданные();
	Исключение
		Возврат Хиты;
	КонецПопытки;

	// Реквизиты
	Для Каждого Р Из Мд.Реквизиты Цикл
		Попытка
			Значение = Контрагент[Р.Имя];
			Если ТипЗнч(Значение) = Тип("Строка") И СтрНайти(ТолькоЦифры(Значение), Хвост) > 0 Тогда
				Хиты.Добавить("attr:" + Р.Имя + "=" + Лев(Значение, 60));
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	// Табличные части
	Для Каждого ТЧ Из Мд.ТабличныеЧасти Цикл
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ " + Мд.ПолноеИмя() + "." + ТЧ.Имя + " КАК Т ГДЕ Т.Ссылка = &К");
			Запрос.УстановитьПараметр("К", Контрагент);
			Таб = Запрос.Выполнить().Выгрузить();
			Для Каждого Стр Из Таб Цикл
				Для Каждого Кол Из Таб.Колонки Цикл
					Значение = Стр[Кол.Имя];
					Если ТипЗнч(Значение) = Тип("Строка") И СтрНайти(ТолькоЦифры(Значение), Хвост) > 0 Тогда
						Хиты.Добавить("ts:" + ТЧ.Имя + "." + Кол.Имя + "=" + Лев(Значение, 60));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Исключение
			Хиты.Добавить("err:ts:" + ТЧ.Имя + ":" + КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	// РС.КонтактнаяИнформация (если есть)
	Если Метаданные.НайтиПоПолномуИмени("РегистрСведений.КонтактнаяИнформация") <> Неопределено Тогда
		Попытка
			Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ РегистрСведений.КонтактнаяИнформация КАК Т ГДЕ Т.Объект = &К");
			Запрос.УстановитьПараметр("К", Контрагент);
			Таб = Запрос.Выполнить().Выгрузить();
			Хиты.Добавить("reg:КонтактнаяИнформация rows=" + Формат(Таб.Количество(), "ЧГ=0"));
			Для Каждого Стр Из Таб Цикл
				Для Каждого Кол Из Таб.Колонки Цикл
					Значение = Стр[Кол.Имя];
					Если ТипЗнч(Значение) = Тип("Строка") И СтрНайти(ТолькоЦифры(Значение), Хвост) > 0 Тогда
						Хиты.Добавить("reg:КонтактнаяИнформация." + Кол.Имя + "=" + Лев(Значение, 60));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Исключение
			Хиты.Добавить("err:reg:КонтактнаяИнформация:" + КраткоОшибку(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Хиты.Добавить("reg:КонтактнаяИнформация ABSENT");
	КонецЕсли;

	Возврат Хиты;

КонецФункции

// ---------- рекомендации ----------

Функция Рекомендации(О)

	Р = Новый Массив;

	Если О.visitDocAttributes.Найти("ПризнакОтменен") = Неопределено Тогда
		Р.Добавить("В Документ.Посещение НЕТ реквизита ПризнакОтменен — убрать 'И НЕ Посещение.ПризнакОтменен' из запросов FitGOIntegration");
	КонецЕсли;

	Если О.Свойство("registersByType") Тогда
		Для Каждого Рг Из О.registersByType Цикл
			Если Рг.result <> "ok" Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Рг.fullName, "ЧленстваПакетыУслугИтоги") > 0 Тогда
				Р.Вставить(0, "ИСТОЧНИК validUntil/status: РегистрСведений.ЧленстваПакетыУслугИтоги (FitGOIntegration)");
			КонецЕсли;
			Для Каждого Поле Из Рг.rows[0] Цикл
				ВерхРег = ВРег(Поле);
				Если СтрНайти(ВерхРег, "ОКОНЧ") > 0 ИЛИ СтрНайти(ВерхРег, "СРОК") > 0 ИЛИ СтрНайти(ВерхРег, "СОСТОЯН") > 0 ИЛИ СтрНайти(ВерхРег, "СТАТУС") > 0 Тогда
					Р.Добавить("Кандидат на validUntil/status: " + Рг.fullName + " → " + Поле);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если О.membership.Свойство("fullName") И НЕ ПустаяСтрока(О.membership.fullName) Тогда
		Р.Добавить("membership → " + О.membership.fullName + " (через Посещение.Основание)");
		Если О.membership.dateFields.Количество() > 0 Тогда
			Р.Добавить("Поля дат членства: " + СтрСоединить(О.membership.dateFields, "; "));
		Иначе
			Р.Добавить("У основания нет заполненных дат — срок брать из регистра (balance)");
		КонецЕсли;
	Иначе
		Р.Добавить("Основание посещения не получено — смотрите lastVisit");
	КонецЕсли;

	Если О.Свойство("money") Тогда
		Если О.money.pickedBalance <> Неопределено Тогда
			Р.Добавить("accountBalance ← " + О.money.pickedBalance.register
				+ " kind=" + Строка(О.money.pickedBalance.kind)
				+ " amount=" + Формат(О.money.pickedBalance.amount, "ЧДЦ=2; ЧН=0; ЧГ=0"));
		Иначе
			Р.Добавить("Лицевой счёт не найден — смотрите money.candidates");
		КонецЕсли;
		Если О.money.pickedDebt <> Неопределено Тогда
			Р.Добавить("debtAmount ← " + Формат(О.money.pickedDebt.amount, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " rule=" + Строка(О.money.pickedDebt.rule)
				+ " (pos=" + Формат(О.money.pickedDebt.debtPos, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " absNeg=" + Формат(О.money.pickedDebt.debtAbsNeg, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " net=" + Формат(О.money.pickedDebt.debtNet, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " rows+/-=" + Строка(О.money.pickedDebt.countPos) + "/" + Строка(О.money.pickedDebt.countNeg) + ")");
		КонецЕсли;
	КонецЕсли;

	ЕстьОстатки = Ложь;
	Для Каждого Б Из О.balance Цикл
		Если Б.result = "ok" Тогда
			ЕстьОстатки = Истина;
			Р.Добавить("Остатки регистра найдены по измерению «" + Б.byDimension + "» — брать срок/остаток из balance");
		КонецЕсли;
	КонецЦикла;
	Если О.register.exists И НЕ ЕстьОстатки Тогда
		Р.Добавить("Остатки регистра пусты/ошибка — для /membership использовать только Посещение.Основание");
	КонецЕсли;

	Возврат Р;

КонецФункции

#КонецОбласти

#Область Вывод

Функция Сводка(О, Путь, ОшибкаФайла)

	Т = "";
	Если ПустаяСтрока(ОшибкаФайла) Тогда
		Т = Т + "OK " + Путь + Символы.ПС;
	Иначе
		Т = Т + "FILE ERROR " + ОшибкаФайла + Символы.ПС;
	КонецЕсли;

	Если О.client.Свойство("name") Тогда
		Т = Т + "client: " + О.client.name + Символы.ПС;
		Если О.Свойство("phoneHits") Тогда
			Т = Т + "phone: " + СтрСоединить(О.phoneHits, " | ") + Символы.ПС;
		КонецЕсли;
	Иначе
		Т = Т + "client: NOT FOUND " + СтрСоединить(О.lookup, ", ") + Символы.ПС;
		Возврат Т;
	КонецЕсли;

	Если О.lastVisit.Свойство("osnovanieType") Тогда
		Т = Т + "visit " + О.lastVisit.visitDate + " → " + О.lastVisit.osnovanieType + Символы.ПС;
		Т = Т + "membership: " + О.lastVisit.osnovanie + Символы.ПС;
	Иначе
		Т = Т + "visit: " + ?(О.lastVisit.Свойство("result"), О.lastVisit.result, "?") + Символы.ПС;
	КонецЕсли;

	Если О.membership.Свойство("fullName") Тогда
		Т = Т + "type: " + О.membership.fullName + Символы.ПС;
		Т = Т + "dates: " + СтрСоединить(О.membership.dateFields, "; ") + Символы.ПС;
		Имена = Новый Массив;
		Для Каждого А Из О.membership.attributes Цикл
			Имена.Добавить(А.name);
		КонецЦикла;
		Т = Т + "attrs: " + СтрСоединить(Имена, ", ") + Символы.ПС;
	КонецЕсли;

	Если О.register.exists Тогда
		Т = Т + "register dims: " + СтрСоединить(О.register.dimensions, "; ") + Символы.ПС;
		Т = Т + "register res: " + СтрСоединить(О.register.resources, "; ") + Символы.ПС;
	КонецЕсли;
	Для Каждого Б Из О.balance Цикл
		Т = Т + "balance[" + Б.byDimension + "]=" + Б.result;
		Если Б.result = "ok" И Б.rows.Количество() > 0 Тогда
			Т = Т + " " + СтрСоединить(Б.rows[0], "; ");
		КонецЕсли;
		Т = Т + Символы.ПС;
	КонецЦикла;

	Если О.Свойство("registersByType") Тогда
		Для Каждого Р Из О.registersByType Цикл
			Т = Т + "reg " + Р.fullName + " [" + Р.dimension + "] " + Р.result;
			Если Р.result = "ok" И Р.rows.Количество() > 0 Тогда
				Т = Т + Символы.ПС + "    " + Лев(СтрСоединить(Р.rows[0], "; "), 400);
			КонецЕсли;
			Т = Т + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Если О.Свойство("commonModules") И О.commonModules.Количество() > 0 Тогда
		Т = Т + "modules: " + СтрСоединить(О.commonModules, ", ") + Символы.ПС;
	КонецЕсли;

	Если О.Свойство("money") Тогда
		Если О.money.pickedBalance <> Неопределено Тогда
			Т = Т + "balance: " + Формат(О.money.pickedBalance.amount, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " [" + О.money.pickedBalance.register + " / " + Строка(О.money.pickedBalance.kind) + "]" + Символы.ПС;
		Иначе
			Т = Т + "balance: NONE" + Символы.ПС;
		КонецЕсли;
		Если О.money.pickedDebt <> Неопределено Тогда
			Т = Т + "debt: " + Формат(О.money.pickedDebt.amount, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " [" + Строка(О.money.pickedDebt.rule) + " pos=" + Формат(О.money.pickedDebt.debtPos, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " absNeg=" + Формат(О.money.pickedDebt.debtAbsNeg, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " n=" + Строка(О.money.pickedDebt.countPos) + "/" + Строка(О.money.pickedDebt.countNeg) + "]" + Символы.ПС;
		Иначе
			Т = Т + "debt: 0" + Символы.ПС;
		КонецЕсли;
		Для Каждого А Из О.money.accounts Цикл
			Т = Т + "  acc " + ?(А.isDebt, "DEBT ", "") + Строка(А.kind) + "=" + Формат(А.amount, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " @" + А.register + Символы.ПС;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Стр Из О.recommendations Цикл
		Т = Т + "- " + Стр + Символы.ПС;
	КонецЦикла;

	Возврат Т;

КонецФункции

Процедура СохранитьОтчётВФайл(Отчёт, ПутьФайла)

	Поз = 0;
	Для Индекс = 1 По СтрДлина(ПутьФайла) Цикл
		С = Сред(ПутьФайла, Индекс, 1);
		Если С = "\" ИЛИ С = "/" Тогда
			Поз = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если Поз > 1 Тогда
		Попытка
			СоздатьКаталог(Лев(ПутьФайла, Поз - 1));
		Исключение
		КонецПопытки;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Отчёт);
	ТекстJSON = Запись.Закрыть();

	Док = Новый ТекстовыйДокумент;
	Док.УстановитьТекст(ТекстJSON);
	Док.Записать(ПутьФайла, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция ИменаРеквизитов(ПолноеИмя)

	Список = Новый Массив;
	Мд = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Мд = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Попытка
		Для Каждого Р Из Мд.Реквизиты Цикл
			Список.Добавить(Р.Имя);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Список;

КонецФункции

Функция ТипыСтрокой(ОписаниеТипов)

	Части = Новый Массив;
	Попытка
		Для Каждого Т Из ОписаниеТипов.Типы() Цикл
			Части.Добавить(Строка(Т));
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат СтрСоединить(Части, "|");

КонецФункции

// Только JSON-совместимые значения: строки/числа/булево. Ссылки и перечисления — строкой.
Функция ЗначениеСтрокой(Значение)

	Тип = ТипЗнч(Значение);
	Если Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "";
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=yyyy-MM-dd HH:mm:ss"), "");
	ИначеЕсли Тип = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧДЦ=2");
	ИначеЕсли Тип = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;
	Попытка
		Возврат Лев(Строка(Значение), 200);
	Исключение
		Возврат "<" + Строка(Тип) + ">";
	КонецПопытки;

КонецФункции

Функция ТолькоЦифры(Значение)

	Исх = Строка(Значение);
	Цифры = "";
	Для Индекс = 1 По СтрДлина(Исх) Цикл
		С = Сред(Исх, Индекс, 1);
		Если СтрНайти("0123456789", С) > 0 Тогда
			Цифры = Цифры + С;
		КонецЕсли;
	КонецЦикла;
	Возврат Цифры;

КонецФункции

Функция Безопасно_ИмяКонфигурации()
	Попытка
		Возврат Метаданные.Имя;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция КраткоОшибку(Инф)
	Попытка
		Возврат Лев(КраткоеПредставлениеОшибки(Инф), 160);
	Исключение
		Возврат "err";
	КонецПопытки;
КонецФункции

#КонецОбласти
