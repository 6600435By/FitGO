// =============================================================================
// FitGO: массовое списание старых долгов через Документ.СписаниеЗадолженности
// =============================================================================
// Куда вставлять: 1С:Предприятие → Консоль кода / «Выполнить» (НЕ конфигуратор).
// Логика выборки = Отчет.НеоплаченныеПродажи (отрицательный остаток → |сумма|).
//
// === ПЕРИОД (выберите один способ) ===
// A) ГодСписания = 2019  → только календарный год (тренировка).
//    Потом: 2020, 2021, … или 0 и задайте даты вручную.
// B) ГодСписания = 0     → используются ДатаНачалаПериода / ДатаОкончанияПериода.
//    Пример «всё до 2026»: 01.01.2018 .. 31.12.2025
//
// Прочие параметры:
//   ТолькоПросмотр = Истина → только список, документы НЕ создаются
//   ЛимитСтрок     = 0      → без лимита; для первой записи поставьте 5
//
// Порядок: бэкап → просмотр → ЛимитСтрок=5 запись → полный год → следующий год.
// После всех лет: Analytics + «Обновить из 1С» в FitGO.
// =============================================================================

ТолькоПросмотр = Истина;
ЛимитСтрок = 0;

// --- Выбор периода (по умолчанию тренировка: только 2019) ---
ГодСписания = 2019; // 0 = взять даты ниже вручную

ДатаНачалаПериода = Дата(2018, 1, 1);   // если ГодСписания = 0
ДатаОкончанияПериода = Дата(2025, 12, 31);

Если ГодСписания > 0 Тогда
	ДатаНачала = Дата(ГодСписания, 1, 1);
	ДатаОкончания = Дата(ГодСписания, 12, 31);
Иначе
	ДатаНачала = ДатаНачалаПериода;
	ДатаОкончания = ДатаОкончанияПериода;
КонецЕсли;

Сообщить("Период списания: " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
	+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy")
	+ ?(ГодСписания > 0, " (год " + Формат(ГодСписания, "ЧГ=0") + ")", " (ручной период)"));

МдСпис = Метаданные.Документы.Найти("СписаниеЗадолженности");
Если МдСпис = Неопределено Тогда
	Сообщить("Документ.СписаниеЗадолженности не найден в конфигурации");
Иначе

Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ РАЗРЕШЕННЫЕ
|	П.ДокументПродажи КАК ДокументПродажи,
|	П.Контрагент КАК Контрагент,
|	П.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
|	П.ДокументПродажи.Дата КАК ДатаПродажи,
|	П.ДокументПродажи.СуммаДокумента КАК СуммаДокумента
|ПОМЕСТИТЬ ВТПродажи
|ИЗ
|	РегистрНакопления.ПродажиСебестоимость.Обороты(&ДатаНачала, &ДатаОкончания, Авто, ) КАК П
|ГДЕ
|	П.Регистратор ССЫЛКА Документ.Реализация
|	И П.ДокументПродажи.Дата >= &ДатаНачала
|	И П.ДокументПродажи.Дата <= &ДатаОкончания
|
|СГРУППИРОВАТЬ ПО
|	П.ДокументПродажи,
|	П.Контрагент,
|	П.СтруктурнаяЕдиница,
|	П.ДокументПродажи.Дата,
|	П.ДокументПродажи.СуммаДокумента
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗРЕШЕННЫЕ
|	-1 * СУММА(О.СуммаОстаток) КАК Задолженность,
|	О.Основание КАК Основание
|ПОМЕСТИТЬ ВТ_Остатки
|ИЗ
|	РегистрНакопления.РасчетыСПокупателями.Остатки(
|			,
|			Основание В
|				(ВЫБРАТЬ
|					ВТПродажи.ДокументПродажи
|				ИЗ
|					ВТПродажи)) КАК О
|
|СГРУППИРОВАТЬ ПО
|	О.Основание
|
|ИМЕЮЩИЕ
|	СУММА(О.СуммаОстаток) < -0.009
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗРЕШЕННЫЕ
|	ВТПродажи.ДатаПродажи КАК ДатаПродажи,
|	ВТПродажи.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
|	ВТПродажи.ДокументПродажи КАК ДокументПродажи,
|	ВТПродажи.Контрагент КАК Контрагент,
|	ВТПродажи.СуммаДокумента КАК СуммаДокумента,
|	ВТ_Остатки.Задолженность КАК Задолженность
|ИЗ
|	ВТПродажи КАК ВТПродажи
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
|		ПО ВТПродажи.ДокументПродажи = ВТ_Остатки.Основание
|
|УПОРЯДОЧИТЬ ПО
|	ВТПродажи.Контрагент,
|	ВТПродажи.СтруктурнаяЕдиница,
|	ВТПродажи.ДатаПродажи";

Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

Таблица = Запрос.Выполнить().Выгрузить();
Сообщить("Найдено строк долга к списанию: " + Таблица.Количество()
	+ " (продажи " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
	+ " .. " + Формат(ДатаОкончания, "ДФ=dd.MM.yyyy") + ")");

Если Таблица.Количество() = 0 Тогда
	Сообщить("Нечего списывать. Сверьте период с Отчет.НеоплаченныеПродажи.");
Иначе

ИтогоСумма = 0;
Для Каждого Стр Из Таблица Цикл
	ИтогоСумма = ИтогоСумма + Стр.Задолженность;
КонецЦикла;
Сообщить("Сумма задолженности: " + Формат(ИтогоСумма, "ЧДЦ=2; ЧН=0"));

Если ТолькоПросмотр Тогда
	Показать = 30;
	Н = 0;
	Для Каждого Стр Из Таблица Цикл
		Н = Н + 1;
		Если Н > Показать Тогда
			Сообщить("... ещё " + (Таблица.Количество() - Показать) + " строк (ТолькоПросмотр)");
			Прервать;
		КонецЕсли;
		Сообщить(Формат(Стр.ДатаПродажи, "ДФ=dd.MM.yyyy")
			+ " | " + Строка(Стр.Контрагент)
			+ " | " + Строка(Стр.ДокументПродажи)
			+ " | " + Формат(Стр.Задолженность, "ЧДЦ=2; ЧН=0"));
	КонецЦикла;
	Сообщить("РЕЖИМ ПРОСМОТРА: документы не созданы. Поставьте ТолькоПросмотр = Ложь для записи.");
Иначе

ТекКлиент = Неопределено;
ТекСЕ = Неопределено;
ДокОбъект = Неопределено;
Создано = 0;
СтрокВДоках = 0;
Ошибки = 0;
Обработано = 0;

Для Каждого Стр Из Таблица Цикл

	Если ЛимитСтрок > 0 И Обработано >= ЛимитСтрок Тогда
		Сообщить("Достигнут ЛимитСтрок=" + ЛимитСтрок + ", останов.");
		Прервать;
	КонецЕсли;

	НуженНовый = (ДокОбъект = Неопределено)
		Или (Стр.Контрагент <> ТекКлиент)
		Или (Стр.СтруктурнаяЕдиница <> ТекСЕ);

	Если НуженНовый Тогда
		Если ДокОбъект <> Неопределено Тогда
			Попытка
				ДокОбъект.Комментарий = "FitGO: списание долгов "
					+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
					+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				Создано = Создано + 1;
				Сообщить("OK " + ДокОбъект.Ссылка + " строк=" + ДокОбъект.РасшифровкаСписания.Количество()
					+ " сумма=" + Формат(ДокОбъект.СуммаДокумента, "ЧДЦ=2; ЧН=0"));
			Исключение
				Ошибки = Ошибки + 1;
				Сообщить("ERR запись: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		ДокОбъект = Документы.СписаниеЗадолженности.СоздатьДокумент();
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.СтруктурнаяЕдиница = Стр.СтруктурнаяЕдиница;
		Попытка
			ДокОбъект.Контрагент = Стр.Контрагент;
		Исключение
		КонецПопытки;
		ДокОбъект.РасшифровкаСписания.Очистить();
		ТекКлиент = Стр.Контрагент;
		ТекСЕ = Стр.СтруктурнаяЕдиница;
	КонецЕсли;

	Нов = ДокОбъект.РасшифровкаСписания.Добавить();
	Нов.ДокументОснования = Стр.ДокументПродажи;
	Попытка
		Нов.СуммаДокумента = Стр.СуммаДокумента;
	Исключение
	КонецПопытки;
	Нов.СуммаСписания = Стр.Задолженность;

	СтрокВДоках = СтрокВДоках + 1;
	Обработано = Обработано + 1;

КонецЦикла;

Если ДокОбъект <> Неопределено И ДокОбъект.РасшифровкаСписания.Количество() > 0 Тогда
	Попытка
		ДокОбъект.Комментарий = "FitGO: списание долгов "
			+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + ".."
			+ Формат(ДатаОкончания, "ДФ=dd.MM.yyyy");
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Создано = Создано + 1;
		Сообщить("OK " + ДокОбъект.Ссылка + " строк=" + ДокОбъект.РасшифровкаСписания.Количество()
			+ " сумма=" + Формат(ДокОбъект.СуммаДокумента, "ЧДЦ=2; ЧН=0"));
	Исключение
		Ошибки = Ошибки + 1;
		Сообщить("ERR запись: " + ОписаниеОшибки());
	КонецПопытки;
КонецЕсли;

Сообщить("Итого: документов=" + Создано + " строк=" + СтрокВДоках + " ошибок=" + Ошибки);

КонецЕсли; // ТолькоПросмотр
КонецЕсли; // Таблица.Количество
КонецЕсли; // МдСпис
