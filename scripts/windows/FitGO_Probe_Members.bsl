// Консоль запросов / обработка: проверить доступность итогов абонементов.
// Ожидаемые поля: Статус, СрокДействия, ЧленствоПакетУслуг.Контрагент

Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ ПЕРВЫЕ 20
|    Итоги.ЧленствоПакетУслуг.Контрагент КАК Контрагент,
|    Итоги.Статус КАК Статус,
|    Итоги.СрокДействия КАК СрокДействия,
|    Итоги.ДатаАктивации КАК ДатаАктивации
|ИЗ
|    РегистрСведений.ЧленстваПакетыУслугИтоги КАК Итоги
|ГДЕ
|    НЕ Итоги.ЧленствоПакетУслуг.ПометкаУдаления
|УПОРЯДОЧИТЬ ПО
|    Итоги.СрокДействия УБЫВ";

Попытка
    Выборка = Запрос.Выполнить().Выбрать();
    Сообщить("ok rows=");
    Н = 0;
    Пока Выборка.Следующий() Цикл
        Н = Н + 1;
        Сообщить(Строка(Н) + " | " + Строка(Выборка.Статус) + " | " + Строка(Выборка.СрокДействия));
    КонецЦикла;
    Сообщить("total shown=" + Строка(Н));
Исключение
    Сообщить("error: " + ОписаниеОшибки());
КонецПопытки;
