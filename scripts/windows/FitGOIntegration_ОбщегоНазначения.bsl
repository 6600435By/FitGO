// Общий модуль FitGOIntegrationОбщегоНазначения (сервер)
// Зеркало для копирования в расширение; эталон также в fitgo-probe/1c-extension/.
// JSON, авторизация, телефон

Функция ПроверитьАвторизациюFitGO(Запрос) Экспорт
    Ключ = Запрос.Заголовки.Получить("apikey");
    Если ПустаяСтрока(Ключ) Тогда
        Возврат Ложь;
    КонецЕсли;

    ОжидаемыйКлюч = FitGOIntegrationНастройки.ApiKey();
    Если ЗначениеЗаполнено(ОжидаемыйКлюч) И Ключ <> ОжидаемыйКлюч Тогда
        Возврат Ложь;
    КонецЕсли;

    Basic = Запрос.Заголовки.Получить("Authorization");
    Если ПустаяСтрока(Basic) Тогда
        Возврат Ложь;
    КонецЕсли;

    ОжидаемыйBasic = FitGOIntegrationНастройки.BasicAuthHeader();
    Если ЗначениеЗаполнено(ОжидаемыйBasic) И Basic <> ОжидаемыйBasic Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат Истина;
КонецФункции

Функция НормализоватьТелефон(Телефон) Экспорт
    Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Телефон, "+", ""), " ", ""), "-", ""), "(", ""), ")", "");
    Возврат Результат;
КонецФункции

Функция ХвостТелефона(Телефон) Экспорт
    Нормализованный = НормализоватьТелефон(Телефон);
    Если СтрДлина(Нормализованный) > 9 Тогда
        Возврат Прав(Нормализованный, 9);
    КонецЕсли;
    Возврат Нормализованный;
КонецФункции

Функция ОтветJSON(Код, Данные) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Тело = Новый Структура("data", Данные);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Тело);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
    Возврат Ответ;
КонецФункции

Функция ОтветОшибки(Код, Сообщение) Экспорт
    Ответ = Новый HTTPСервисОтвет(Код);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Тело = Новый Структура("error", Новый Структура("code, message", Код, Сообщение));
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Тело);
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
    Возврат Ответ;
КонецФункции

Функция UUIDСсылка(Ссылка) Экспорт
    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

// Календарная дата сеанса (yyyy-MM-dd), без UTC-сдвига WriteJSON.
Функция ISOДата(Дата) Экспорт
    Если НЕ ЗначениеЗаполнено(Дата) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Формат(Дата, "ДФ=yyyy-MM-dd");
КонецФункции

Функция ISOДатаВремя(Дата) Экспорт
    Если НЕ ЗначениеЗаполнено(Дата) Тогда
        Возврат "";
    КонецЕсли;
    Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss");
КонецФункции
