# Database
DATABASE_URL="postgresql://fitgo:fitgo@127.0.0.1:5432/fitgo?schema=public"

# API
API_PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Провайдер расписания: mock (демо) | forma-wp (ffs.by / planvueplugin) | forma | 1c
FITNESS_PROVIDER="mock"

# 1C Fitness generic REST (when FITNESS_PROVIDER=1c)
ONEC_BASE_URL=""
ONEC_API_KEY=""

# 1C Forma API v3 (when FITNESS_PROVIDER=forma)
FORMA_BASE_URL=""
FORMA_FITGO_URL=""
FORMA_CLUB_ID=""
FORMA_ANALYTICS_URL=""
FORMA_API_KEY=""
FORMA_BASIC_AUTH=""
FORMA_DEFAULT_PASSWORD=""
# Self-signed TLS on club server (dev only): NODE_TLS_REJECT_UNAUTHORIZED=0

# 1C via WordPress proxy (when FITNESS_PROVIDER=forma-wp)
# Пример для FFS: https://ffs.by/wp-admin/admin-ajax.php
FORMA_WP_AJAX_URL="https://ffs.by/wp-admin/admin-ajax.php"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# OSMI Cards (club digital card + barcode)
OSMI_ENABLED="true"
OSMI_PROVIDER="mock"
# https://api6.osmicards.com/v2 (digest) or .../v2t (token)
OSMI_API_BASE_URL="https://api6.osmicards.com/v2"
OSMI_API_ID=""
OSMI_API_KEY=""
# token | digest — auto from base URL if omitted
OSMI_AUTH="digest"
OSMI_PROGRAM_ID="36006XCR7EE4TR"
OSMI_CAMPAIGN_NAME="registration"
OSMI_TEMPLATE_NAME=""
OSMI_ANKETA_URL="https://get.osmicards.com/anketa/36006XCR7EE4TR/get"
OSMI_CACHE_HOURS="6"

# Push notifications (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
ENABLE_NOTIFICATION_CRON="true"
