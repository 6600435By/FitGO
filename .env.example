# Database
DATABASE_URL="postgresql://fitgo:fitgo@localhost:5432/fitgo?schema=public"

# API
API_PORT=3001
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
FITNESS_PROVIDER="mock"

# 1C Fitness generic REST (when FITNESS_PROVIDER=1c)
ONEC_BASE_URL=""
ONEC_API_KEY=""

# 1C Forma API v3 (when FITNESS_PROVIDER=forma)
FORMA_BASE_URL=""
FORMA_API_KEY=""
FORMA_BASIC_AUTH=""
FORMA_DEFAULT_PASSWORD=""

# 1C via WordPress proxy (when FITNESS_PROVIDER=forma-wp)
# URL of planvueplugin AJAX endpoint on the club site
FORMA_WP_AJAX_URL="https://your-club-site.com/wp-admin/admin-ajax.php"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# Push notifications (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
ENABLE_NOTIFICATION_CRON="true"
