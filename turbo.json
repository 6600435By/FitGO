{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["API_PORT", "CORS_ORIGIN", "NEXT_PUBLIC_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:app": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:3010": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
