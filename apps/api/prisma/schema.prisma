  priceMinor             Int?
  membershipServiceName  String?
  consumedInCrmAt        DateTime?
  /// Atomic claim for consume-to-1C (IN_PROGRESS → DONE/FAILED).
  consumeState           SpaConsumeState?
  crmDocRef              String?
  cancelledBy            SpaCancelledBy?
  cancelledAt            DateTime?
  controlLevel           ServiceControlLevel   @default(BASE)
  presenceStatus         ServicePresenceStatus @default(PENDING)
  performanceStatus      ServicePerformanceStatus @default(PENDING)
  usageStatus            ServiceUsageStatus    @default(BOOKED)
  paymentStatus          ServicePaymentStatus  @default(N_A)
  reviewFlag             Boolean               @default(false)
  eligibleForMotivation  Boolean               @default(false)
  trustBand              TrustBand             @default(AMBER)
  trustReasons           Json                  @default("[]")
