generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  TRAINER
  SPECIALIST
  TECH
  ADMIN
  SUPER_ADMIN
}

enum AdminPermission {
  DASHBOARD_VIEW
  CLIENTS_VIEW
  CLIENTS_MESSAGE
  AT_RISK_VIEW
  FUNNEL_VIEW
  REPORTS_VIEW
  REPORTS_EDIT
  SETTINGS_BRANDING
  NOTIFICATIONS_SEND
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ClubCrmLinkStatus {
  LINKED
  PENDING_CRM
}

enum NotificationType {
  BOOKING_REMINDER
  MEMBERSHIP_EXPIRING
  INACTIVITY
  MILESTONE
  CHALLENGE
  RATING_DECAY
  GENERAL
  WAITLIST_SPOT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VisitSource {
  ONEC_SYNC
  APP_GEOFENCE
  APP_QR
  BOOKING_GROUP
  BOOKING_PT
  TRAINER_CONFIRM
  CLIENT_SELF_CONFIRM
}

enum VisitKind {
  GYM
  GROUP
  PT
  SPA_MASSAGE
  SPA_BODYCOMP
  SOLARIUM
  UNKNOWN
}

enum VisitVerification {
  PENDING
  VERIFIED_1C
  VERIFIED_TRAINER
  VERIFIED_CLIENT_SELF
  REJECTED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  RUBY
  EMERALD
  DIAMOND
  OBSIDIAN
}

enum LoyaltyStatus {
  ACTIVE
  FROZEN
  REACTIVATED
}

enum BadgeDataScope {
  SINCE_INSTALL
  HISTORICAL
}

enum BodyLogSource {
  CLIENT_SELF
  TRAINER
}

enum WorkoutType {
  RUNNING
  CYCLING
  STRENGTH
  YOGA
  HIIT
  WALKING
  SWIMMING
  OTHER
}

enum WorkoutSource {
  MANUAL
  APPLE_HEALTH
  GOOGLE_FIT
  GARMIN
}

enum NotificationStatus {
  PENDING
  COMPLETED
}

enum PersonalBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AvailabilityBlockStatus {
  DRAFT
  PUBLISHED
}

enum PersonalBookingOrigin {
  CLIENT_BOOKED
  TRAINER_ASSIGNED
}

enum SpaServiceKind {
  MASSAGE
  BODY_COMPOSITION
  WRAP
}

enum SpaPaymentType {
  QUOTA
  PAID
}

enum SpaBookingOrigin {
  CLIENT_BOOKED
  SPECIALIST_ASSIGNED
  ADMIN_ASSIGNED
}

enum SpaBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Кто отменил SPA-запись (для истории клиента).
enum SpaCancelledBy {
  CLIENT
  SPECIALIST
  ADMIN
  /// Отменено / удалено администратором в 1С (подтянуто синхронизацией)
  CRM_ADMIN
}

enum AccountStatus {
  ACTIVE
  SHADOW
}

enum TrainerClientLinkStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum TrainerClientSource {
  MANUAL
  INVITE
}

enum TrainerClientInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum GroupClassBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum GroupBookingOrigin {
  CLIENT_BOOKED
  STAFF_BOOKED
  ADMIN_BOOKED
}

/// Dual-gate control for service usage (SPA / PT / group).
enum ServiceControlLevel {
  BASE
  ELEVATED
}

enum ServicePresenceStatus {
  PENDING
  VERIFIED_1C
  ADMIN_OVERRIDE
}

enum ServicePerformanceStatus {
  PENDING
  CONFIRMED_BY_PERFORMER
  REJECTED
}

enum ServiceUsageStatus {
  BOOKED
  NO_SHOW
  ATTENDED
  CONSUMED
  CANCELLED
}

enum ServicePaymentStatus {
  N_A
  PENDING_PAYMENT
  DEBT
  PAID
}

/// L0 anti-padding trust for payroll eligibility.
enum TrustBand {
  GREEN
  AMBER
  RED
}

enum TrustResolution {
  NONE
  RESOLVED
}

enum GroupClassSessionStatus {
  OPEN
  SUBMITTED
  AUTO_READY
  NEEDS_ADMIN
  APPROVED
  LOCKED
}

enum GroupSessionBaselineQuality {
  FULL
  PARTIAL
}

enum GroupSessionMemberSource {
  BASELINE_1C
  TRAINER_ADDED
  ADMIN_ADDED
}

enum GroupSessionMemberAttendance {
  EXPECTED
  ATTENDED
  NO_SHOW
  REMOVED
}

enum MotivationRateKind {
  SPA_SERVICE
  SPA_KIND
  PT
  GROUP
}

enum MotivationRateType {
  PERCENT_OF_PRICE
  FIXED_PER_SESSION
  FIXED_PER_ATTENDEE
}

enum PtClientIssue {
  NONE
  WRONG_PHONE
  CRM_UNMATCHED
  IDENTITY_MISMATCH
}

enum PtSessionPayKind {
  UNKNOWN
  GIFT
  BLOCK
  PAID
}

enum TrainerShiftStatus {
  PLANNED
  OPEN
  CLOSED
}

enum TrainerDaySheetStatus {
  DRAFT
  TRAINER_SUBMITTED
  ADMIN_REVIEW
  ADMIN_APPROVED
  SA_APPROVED
  LOCKED
}

enum StaffShiftTrack {
  ADMIN
  TRAINER
  TECH
}

enum GroupClassWaitlistStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  CANCELLED
}

enum ConversationKind {
  ADMIN
  TRAINER
  TRAINER_ADMIN
}

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String?
  phone        String?
  website      String?
  externalId   String?  @unique
  currency     String   @default("BYN")
  /// Club opening hours Mon–Sun: { monday: { open, close, closed }, ... }
  workingHours Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                User[]
  oneCConfig           Club1CConfig?
  dailyReports         DailyReport[]
  theme                ClubTheme?
  challenges           Challenge[]
  referralRewardDesc   String   @default("Скидка 10% на следующий абонемент")
  adminTasks           AdminTask[]
  staffAuditLogs       StaffAuditLog[]
  clubMemberships      UserClubMembership[]
  spaServices          SpaService[]
  spaQuotaRules        SpaQuotaRule[]
  spaBookings          SpaBooking[]
  groupClassSessions   GroupClassSession[]
  staffCompensations   StaffCompensation[]
  motivationRates      MotivationRate[]
  payrollAdjustments   PayrollAdjustment[]
  payrollPeriodLocks   PayrollPeriodLock[]
  payrollPayouts       PayrollPayout[]
  trainerShifts        TrainerShift[]
  trainerDaySheets     TrainerDaySheet[]
  staffShifts          StaffShift[]
}

model ClubTheme {
  id           String  @id @default(cuid())
  clubId       String  @unique
  logoUrl      String?
  primaryColor String  @default("#14b88a")
  customDomain String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

/// Stand-wide product module toggles (super-admin). Default ON except catalog defaults.
model AppFeatureFlags {
  id        String   @id @default("default")
  modules   Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Club1CConfig {
  id        String   @id @default(cuid())
  clubId    String   @unique
  baseUrl   String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model User {
  id         String   @id @default(cuid())
  clubId     String?
  email      String   @unique
  password   String
  phone      String?
  phoneNormalized String? @unique
  accountStatus   AccountStatus @default(ACTIVE)
  createdByTrainerId String?
  activatedAt     DateTime?
  firstName  String
  lastName   String
  externalId String?
  /// Код сотрудника в 1С (например 000000151). Для выборок по сотруднику.
  employeeCode String? @unique
  /// false — учётка есть, пароль входа ещё не выдан.
  loginEnabled Boolean @default(true)
  referralCode String? @unique
  gender        Gender?
  dateOfBirth   DateTime? @db.Date
  profileCompletedAt DateTime?
  gamificationNickname String?
  useRealNameInPublic  Boolean @default(true)
  gamificationStartedAt DateTime?
  isActive              Boolean  @default(true)
  createdById           String?
  osmiCardId            String?
  osmiBarcode           String?
  osmiSyncedAt          DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  club                 Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shadowCreatedBy      User?                  @relation("ShadowCreatedBy", fields: [createdByTrainerId], references: [id], onDelete: SetNull)
  shadowsCreated       User[]                 @relation("ShadowCreatedBy")
  roles                UserRole[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationPrefs    NotificationPreference?
  badges               UserBadge[]
  gamificationPoints   Int                    @default(0)
  referredById         String?
  referrals            Referral[]             @relation("Referrer")
  referredBy           Referral?              @relation("Referred")
  trainerNotes         TrainerNote[]          @relation("TrainerNotes")
  clientNotes          TrainerNote[]          @relation("ClientNotes")
  clientGoals          ClientGoal[]           @relation("ClientGoals")
  trainerGoals         ClientGoal[]           @relation("TrainerGoals")
  measurements         ClientMeasurement[]    @relation("ClientMeasurements")
  recordedMeasurements ClientMeasurement[]    @relation("RecordedMeasurements")
  challengeEntries     ChallengeEntry[]
  wearableSyncs        WearableSync[]
  trainerWorkSlots     TrainerWorkSlot[]
  trainerAvailabilityBlocks TrainerAvailabilityBlock[]
  trainerSchedulePublications TrainerSchedulePublication[]
  trainerPersonalBookings PersonalTrainingBooking[] @relation("TrainerPersonalBookings")
  clientPersonalBookings  PersonalTrainingBooking[] @relation("ClientPersonalBookings")
  specialistWorkSlots             SpecialistWorkSlot[]
  specialistAvailabilityBlocks    SpecialistAvailabilityBlock[]
  specialistSchedulePublications  SpecialistSchedulePublication[]
  specialistSpaBookings           SpaBooking[] @relation("SpecialistSpaBookings")
  clientSpaBookings               SpaBooking[] @relation("ClientSpaBookings")
  specialistServices              SpecialistService[]
  spaQuotaRuleSpecialists         SpaQuotaRuleSpecialist[]
  groupClassBookings      GroupClassBooking[]
  groupClassWaitlist      GroupClassWaitlistEntry[]
  sentNotifications       Notification[]          @relation("NotificationSender")
  clientConversations     Conversation[]          @relation("ClientConversations")
  trainerConversations    Conversation[]          @relation("TrainerConversations")
  chatMessages            ChatMessage[]           @relation("ChatMessageSender")
  clubVisits              ClubVisit[]
  clubVisitEvents         ClubVisitEvent[]
  loyaltyProfile          LoyaltyProfile?
  clientRating            ClientRating?
  leagueGroupMembers      LeagueGroupMember[]
  bodyProfile             ClientBodyProfile?
  trainingProfile         ClientTrainingProfile?
  bodyLogs                ClientBodyLog[]         @relation("ClientBodyLogs")
  recordedBodyLogs        ClientBodyLog[]         @relation("RecordedBodyLogs")
  workoutLogs             WorkoutLog[]
  adminTasksAssigned      AdminTask[]            @relation("AdminTaskAssignee")
  adminTasksCreated       AdminTask[]            @relation("AdminTaskCreator")
  adminPermissions        AdminPermissionGrant[]
  staffCreated            User[]                 @relation("StaffCreatedBy")
  staffAuditLogs          StaffAuditLog[]        @relation("StaffAuditActor")
  trainerRosterClients    TrainerClientLink[]    @relation("TrainerRoster")
  clientRosterTrainers    TrainerClientLink[]    @relation("ClientRoster")
  trainerClientInvites    TrainerClientInvite[]  @relation("TrainerClientInvites")
  clubMemberships         UserClubMembership[]
  groupClassSessionsLed   GroupClassSession[]  @relation("GroupSessionTrainer")
  staffCompensation       StaffCompensation[]
  payrollAdjustments      PayrollAdjustment[]
  payrollPayouts          PayrollPayout[]
  trainerShifts           TrainerShift[]          @relation("TrainerShifts")
  trainerDaySheets        TrainerDaySheet[]       @relation("TrainerDaySheets")
  daySheetsAdminApproved  TrainerDaySheet[]       @relation("DaySheetAdminApprover")
  daySheetsSaApproved     TrainerDaySheet[]       @relation("DaySheetSaApprover")
  staffShifts             StaffShift[]            @relation("StaffShifts")

  @@unique([clubId, gamificationNickname])
  @@index([externalId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model UserClubMembership {
  id            String             @id @default(cuid())
  userId        String
  clubId        String
  externalId    String?
  crmStatus     ClubCrmLinkStatus?
  lastCrmSyncAt DateTime?
  joinedAt      DateTime           @default(now())
  leftAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([externalId])
  @@index([crmStatus])
}

model TrainerClientLink {
  id               String                  @id @default(cuid())
  trainerId        String
  clientId         String
  status           TrainerClientLinkStatus @default(PENDING)
  source           TrainerClientSource     @default(MANUAL)
  notes            String?
  clientAcceptedAt DateTime?
  createdAt        DateTime                @default(now())
  confirmedAt      DateTime?

  trainer User @relation("TrainerRoster", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientRoster", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
  @@index([trainerId, status])
  @@index([clientId])
}

model TrainerClientInvite {
  id              String                    @id @default(cuid())
  trainerId       String
  phoneNormalized String
  clientId        String?
  status          TrainerClientInviteStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?

  trainer User @relation("TrainerClientInvites", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([phoneNormalized, status])
  @@index([clientId])
}

model DailyReport {
  id        String   @id @default(cuid())
  clubId    String
  date      DateTime @db.Date
  revenue   Float
  problems  String?
  ideas     String?
  createdBy String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, date])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean            @default(false)
  status    NotificationStatus @default(PENDING)
  senderId  String?
  createdAt DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  bookingReminders    Boolean @default(true)
  membershipAlerts    Boolean @default(true)
  inactivityAlerts    Boolean @default(true)
  milestoneAlerts     Boolean @default(true)
  ratingDecayAlerts   Boolean @default(true)
  marketingAlerts     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  threshold   Int?
  category    String?
  tier        String?
  icon        String?
  dataScope   BadgeDataScope @default(SINCE_INSTALL)

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Challenge {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  targetVisits Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  club    Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]
}

model ChallengeEntry {
  id          String @id @default(cuid())
  challengeId String
  userId      String
  visits      Int    @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique
  createdAt    DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
}

model TrainerNote {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  content   String
  createdAt DateTime @default(now())

  trainer User @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientGoal {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  title     String
  target    String?
  progress  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer User @relation("TrainerGoals", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientGoals", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientMeasurement {
  id         String   @id @default(cuid())
  clientId   String
  trainerId  String
  weight     Float?
  notes      String?
  recordedAt DateTime @default(now())

  client  User @relation("ClientMeasurements", fields: [clientId], references: [id], onDelete: Cascade)
  trainer User @relation("RecordedMeasurements", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model WearableSync {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  visitsImported  Int      @default(0)
  lastSyncAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model TrainerWorkSlot {
  id        String   @id @default(cuid())
  trainerId String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model TrainerAvailabilityBlock {
  id        String                  @id @default(cuid())
  trainerId String
  startAt   DateTime
  endAt     DateTime
  status    AvailabilityBlockStatus @default(DRAFT)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, startAt])
  @@index([trainerId, status, startAt])
}

model TrainerSchedulePublication {
  id          String   @id @default(cuid())
  trainerId   String
  periodStart DateTime
  periodEnd   DateTime
  publishedAt DateTime @default(now())

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, periodStart])
}

model PersonalTrainingBooking {
  id                 String                @id @default(cuid())
  trainerId          String
  clientId           String
  startAt            DateTime
  endAt              DateTime
  status             PersonalBookingStatus @default(CONFIRMED)
  origin             PersonalBookingOrigin @default(CLIENT_BOOKED)
  clientCompletedAt  DateTime?
  trainerCompletedAt DateTime?
  workoutSheet       Json?
  /// Gift / complimentary PT — excluded from motivation totals by default.
  isComplimentary    Boolean               @default(false)
  controlLevel       ServiceControlLevel   @default(BASE)
  presenceStatus     ServicePresenceStatus @default(PENDING)
  performanceStatus  ServicePerformanceStatus @default(PENDING)
  usageStatus        ServiceUsageStatus    @default(BOOKED)
  paymentStatus      ServicePaymentStatus  @default(N_A)
  reviewFlag         Boolean               @default(false)
  eligibleForMotivation Boolean            @default(false)
  trustBand          TrustBand             @default(AMBER)
  trustReasons       Json                  @default("[]")
  trustResolution    TrustResolution       @default(NONE)
  trustResolveNote   String?
  trustResolvedAt    DateTime?
  trustResolvedById  String?
  bookedByUserId     String?
  presenceOverrideNote String?
  presenceOverrideAt DateTime?
  presenceOverrideById String?
  paidAt             DateTime?
  crmDocRef          String?
  /// Late booking created during/after session (exception path).
  isLateAdd          Boolean               @default(false)
  clientIssue        PtClientIssue         @default(NONE)
  clientIssueEscalated Boolean             @default(false)
  payKind            PtSessionPayKind      @default(UNKNOWN)
  priceMinor         Int?
  forceIncludeInPayroll Boolean            @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  trainer      User                          @relation("TrainerPersonalBookings", fields: [trainerId], references: [id], onDelete: Cascade)
  client       User                          @relation("ClientPersonalBookings", fields: [clientId], references: [id], onDelete: Cascade)
  sessionGoals PersonalTrainingSessionGoal[]
  daySheetLines TrainerDaySheetLine[]

  @@unique([trainerId, startAt])
  @@index([trainerId, startAt])
  @@index([clientId])
  @@index([reviewFlag, usageStatus])
  @@index([presenceStatus, startAt])
  @@index([trustBand, trustResolution])
  @@index([clientIssue, clientIssueEscalated])
  @@index([isLateAdd])
}

model PersonalTrainingSessionGoal {
  id               String   @id @default(cuid())
  bookingId        String
  title            String
  notes            String?
  sortOrder        Int      @default(0)
  clientConfirmed  Boolean  @default(false)
  trainerConfirmed Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking PersonalTrainingBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks   PersonalTrainingSessionTask[]

  @@index([bookingId])
}

model PersonalTrainingSessionTask {
  id               String   @id @default(cuid())
  goalId           String
  title            String
  sortOrder        Int      @default(0)
  clientConfirmed  Boolean  @default(false)
  trainerConfirmed Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  goal PersonalTrainingSessionGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GroupClassBooking {
  id            String                  @id @default(cuid())
  clientId      String
  appointmentId String
  title         String
  trainerName   String?
  startAt       DateTime
  endAt         DateTime
  status        GroupClassBookingStatus @default(CONFIRMED)
  origin        GroupBookingOrigin      @default(CLIENT_BOOKED)
  cancelledAt   DateTime?
  controlLevel       ServiceControlLevel   @default(BASE)
  presenceStatus     ServicePresenceStatus @default(PENDING)
  performanceStatus  ServicePerformanceStatus @default(PENDING)
  usageStatus        ServiceUsageStatus    @default(BOOKED)
  paymentStatus      ServicePaymentStatus  @default(N_A)
  reviewFlag         Boolean               @default(false)
  eligibleForMotivation Boolean            @default(false)
  trustBand          TrustBand             @default(AMBER)
  trustReasons       Json                  @default("[]")
  trustResolution    TrustResolution       @default(NONE)
  trustResolveNote   String?
  trustResolvedAt    DateTime?
  trustResolvedById  String?
  bookedByUserId     String?
  presenceOverrideNote String?
  presenceOverrideAt DateTime?
  presenceOverrideById String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, appointmentId])
  @@index([clientId, startAt])
  @@index([clientId, status])
