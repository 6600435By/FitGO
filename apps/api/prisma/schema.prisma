  packageName        String?
  startDate          String?
  endDate            String?
  freezeAllowed      Boolean  @default(false)
  debtAmount         Float    @default(0)
  currency           String?
  /// Remaining services JSON: [{ name, remaining, … }]
  servicesJson       Json     @default("[]")
  rawJson            Json?
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, clientExternalId])
  @@index([clubId, syncedAt])
  @@index([clubId, endDate])
}

