  clubId               String
  /// Document / line id in 1C
  externalSaleId       String
  soldAt               DateTime
  paidAt               DateTime?
  /// Major currency units (BYN)
  amount               Float
  /// Payment split from 1C (major). Motivation uses cash+card+personalAccount (no cashless).
  cash                 Float     @default(0)
  card                 Float     @default(0)
  cashless             Float     @default(0)
  personalAccount      Float     @default(0)
  /// membership | massage | solarium | shop
  saleType             String
  productName          String?
  clientExternalId     String?
  clientName           String?
  /// 1C Author (employee code) — attribution target
  employeeExternalId   String?
  employeeName         String?
  /// Line manager from 1C (reference only)
  managerExternalId    String?
  managerName          String?
  paymentMethod        String?
  /// false when document removed/cancelled in 1C
  isActive             Boolean   @default(true)
  syncedAt             DateTime  @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, externalSaleId])
  @@index([clubId, soldAt])
  @@index([clubId, paidAt])
  @@index([clubId, employeeExternalId, soldAt])
  @@index([clubId, isActive, paidAt])
}

