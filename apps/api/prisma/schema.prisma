generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  TRAINER
  ADMIN
  SUPER_ADMIN
}

enum AdminPermission {
  DASHBOARD_VIEW
  CLIENTS_VIEW
  CLIENTS_MESSAGE
  AT_RISK_VIEW
  FUNNEL_VIEW
  REPORTS_VIEW
  REPORTS_EDIT
  SETTINGS_BRANDING
  NOTIFICATIONS_SEND
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ClubCrmLinkStatus {
  LINKED
  PENDING_CRM
}

enum NotificationType {
  BOOKING_REMINDER
  MEMBERSHIP_EXPIRING
  INACTIVITY
  MILESTONE
  CHALLENGE
  RATING_DECAY
  GENERAL
  WAITLIST_SPOT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VisitSource {
  ONEC_SYNC
  APP_GEOFENCE
  APP_QR
  BOOKING_GROUP
  BOOKING_PT
  TRAINER_CONFIRM
  CLIENT_SELF_CONFIRM
}

enum VisitKind {
  GYM
  GROUP
  PT
  SPA_MASSAGE
  SPA_BODYCOMP
  SOLARIUM
  UNKNOWN
}

enum VisitVerification {
  PENDING
  VERIFIED_1C
  VERIFIED_TRAINER
  VERIFIED_CLIENT_SELF
  REJECTED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  RUBY
  EMERALD
  DIAMOND
  OBSIDIAN
}

enum LoyaltyStatus {
  ACTIVE
  FROZEN
  REACTIVATED
}

enum BadgeDataScope {
  SINCE_INSTALL
  HISTORICAL
}

enum BodyLogSource {
  CLIENT_SELF
  TRAINER
}

enum WorkoutType {
  RUNNING
  CYCLING
  STRENGTH
  YOGA
  HIIT
  WALKING
  SWIMMING
  OTHER
}

enum WorkoutSource {
  MANUAL
  APPLE_HEALTH
  GOOGLE_FIT
  GARMIN
}

enum NotificationStatus {
  PENDING
  COMPLETED
}

enum PersonalBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AvailabilityBlockStatus {
  DRAFT
  PUBLISHED
}

enum PersonalBookingOrigin {
  CLIENT_BOOKED
  TRAINER_ASSIGNED
}

enum AccountStatus {
  ACTIVE
  SHADOW
}

enum TrainerClientLinkStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum TrainerClientSource {
  MANUAL
  INVITE
}

enum TrainerClientInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum GroupClassBookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum GroupClassWaitlistStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  CANCELLED
}

enum ConversationKind {
  ADMIN
  TRAINER
  TRAINER_ADMIN
}

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String?
  phone        String?
  website      String?
  externalId   String?  @unique
  currency     String   @default("BYN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                User[]
  oneCConfig           Club1CConfig?
  dailyReports         DailyReport[]
  theme                ClubTheme?
  challenges           Challenge[]
  referralRewardDesc   String   @default("Скидка 10% на следующий абонемент")
  adminTasks           AdminTask[]
  staffAuditLogs       StaffAuditLog[]
  clubMemberships      UserClubMembership[]
}

model ClubTheme {
  id           String  @id @default(cuid())
  clubId       String  @unique
  logoUrl      String?
  primaryColor String  @default("#14b88a")
  customDomain String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

/// Stand-wide product module toggles (super-admin). Default ON except catalog defaults.
model AppFeatureFlags {
  id        String   @id @default("default")
  modules   Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Club1CConfig {
  id        String   @id @default(cuid())
  clubId    String   @unique
  baseUrl   String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model User {
  id         String   @id @default(cuid())
  clubId     String?
  email      String   @unique
  password   String
  phone      String?
  phoneNormalized String? @unique
  accountStatus   AccountStatus @default(ACTIVE)
  createdByTrainerId String?
  activatedAt     DateTime?
  firstName  String
  lastName   String
  externalId String?
  referralCode String? @unique
  gender        Gender?
  dateOfBirth   DateTime? @db.Date
  profileCompletedAt DateTime?
  gamificationNickname String?
  useRealNameInPublic  Boolean @default(true)
  gamificationStartedAt DateTime?
  isActive              Boolean  @default(true)
  createdById           String?
  osmiCardId            String?
  osmiBarcode           String?
  osmiSyncedAt          DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  club                 Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shadowCreatedBy      User?                  @relation("ShadowCreatedBy", fields: [createdByTrainerId], references: [id], onDelete: SetNull)
  shadowsCreated       User[]                 @relation("ShadowCreatedBy")
  roles                UserRole[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationPrefs    NotificationPreference?
  badges               UserBadge[]
  gamificationPoints   Int                    @default(0)
  referredById         String?
  referrals            Referral[]             @relation("Referrer")
  referredBy           Referral?              @relation("Referred")
  trainerNotes         TrainerNote[]          @relation("TrainerNotes")
  clientNotes          TrainerNote[]          @relation("ClientNotes")
  clientGoals          ClientGoal[]           @relation("ClientGoals")
  trainerGoals         ClientGoal[]           @relation("TrainerGoals")
  measurements         ClientMeasurement[]    @relation("ClientMeasurements")
  recordedMeasurements ClientMeasurement[]    @relation("RecordedMeasurements")
  challengeEntries     ChallengeEntry[]
  wearableSyncs        WearableSync[]
  trainerWorkSlots     TrainerWorkSlot[]
  trainerAvailabilityBlocks TrainerAvailabilityBlock[]
  trainerSchedulePublications TrainerSchedulePublication[]
  trainerPersonalBookings PersonalTrainingBooking[] @relation("TrainerPersonalBookings")
  clientPersonalBookings  PersonalTrainingBooking[] @relation("ClientPersonalBookings")
  groupClassBookings      GroupClassBooking[]
  groupClassWaitlist      GroupClassWaitlistEntry[]
  sentNotifications       Notification[]          @relation("NotificationSender")
  clientConversations     Conversation[]          @relation("ClientConversations")
  trainerConversations    Conversation[]          @relation("TrainerConversations")
  chatMessages            ChatMessage[]           @relation("ChatMessageSender")
  clubVisits              ClubVisit[]
  clubVisitEvents         ClubVisitEvent[]
  loyaltyProfile          LoyaltyProfile?
  clientRating            ClientRating?
  leagueGroupMembers      LeagueGroupMember[]
  bodyProfile             ClientBodyProfile?
  bodyLogs                ClientBodyLog[]         @relation("ClientBodyLogs")
  recordedBodyLogs        ClientBodyLog[]         @relation("RecordedBodyLogs")
  workoutLogs             WorkoutLog[]
  adminTasksAssigned      AdminTask[]            @relation("AdminTaskAssignee")
  adminTasksCreated       AdminTask[]            @relation("AdminTaskCreator")
  adminPermissions        AdminPermissionGrant[]
  staffCreated            User[]                 @relation("StaffCreatedBy")
  staffAuditLogs          StaffAuditLog[]        @relation("StaffAuditActor")
  trainerRosterClients    TrainerClientLink[]    @relation("TrainerRoster")
  clientRosterTrainers    TrainerClientLink[]    @relation("ClientRoster")
  trainerClientInvites    TrainerClientInvite[]  @relation("TrainerClientInvites")
  clubMemberships         UserClubMembership[]

  @@unique([clubId, gamificationNickname])
  @@index([externalId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model UserClubMembership {
  id            String             @id @default(cuid())
  userId        String
  clubId        String
  externalId    String?
  crmStatus     ClubCrmLinkStatus?
  lastCrmSyncAt DateTime?
  joinedAt      DateTime           @default(now())
  leftAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([externalId])
  @@index([crmStatus])
}

model TrainerClientLink {
  id               String                  @id @default(cuid())
  trainerId        String
  clientId         String
  status           TrainerClientLinkStatus @default(PENDING)
  source           TrainerClientSource     @default(MANUAL)
  notes            String?
  clientAcceptedAt DateTime?
  createdAt        DateTime                @default(now())
  confirmedAt      DateTime?

  trainer User @relation("TrainerRoster", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientRoster", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
  @@index([trainerId, status])
  @@index([clientId])
}

model TrainerClientInvite {
  id              String                    @id @default(cuid())
  trainerId       String
  phoneNormalized String
  clientId        String?
  status          TrainerClientInviteStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?

  trainer User @relation("TrainerClientInvites", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([phoneNormalized, status])
  @@index([clientId])
}

model DailyReport {
  id        String   @id @default(cuid())
  clubId    String
  date      DateTime @db.Date
  revenue   Float
  problems  String?
  ideas     String?
  createdBy String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, date])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean            @default(false)
  status    NotificationStatus @default(PENDING)
  senderId  String?
  createdAt DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  bookingReminders    Boolean @default(true)
  membershipAlerts    Boolean @default(true)
  inactivityAlerts    Boolean @default(true)
  milestoneAlerts     Boolean @default(true)
  ratingDecayAlerts   Boolean @default(true)
  marketingAlerts     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  threshold   Int?
  category    String?
  tier        String?
  icon        String?
  dataScope   BadgeDataScope @default(SINCE_INSTALL)

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Challenge {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  targetVisits Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  club    Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]
}

model ChallengeEntry {
  id          String @id @default(cuid())
  challengeId String
  userId      String
  visits      Int    @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique
  createdAt    DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
}

model TrainerNote {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  content   String
  createdAt DateTime @default(now())

  trainer User @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientNotes", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientGoal {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  title     String
  target    String?
  progress  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer User @relation("TrainerGoals", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientGoals", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientMeasurement {
  id         String   @id @default(cuid())
  clientId   String
  trainerId  String
  weight     Float?
  notes      String?
  recordedAt DateTime @default(now())

  client  User @relation("ClientMeasurements", fields: [clientId], references: [id], onDelete: Cascade)
  trainer User @relation("RecordedMeasurements", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model WearableSync {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  visitsImported  Int      @default(0)
  lastSyncAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model TrainerWorkSlot {
  id        String   @id @default(cuid())
  trainerId String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
}

model TrainerAvailabilityBlock {
  id        String                  @id @default(cuid())
  trainerId String
  startAt   DateTime
  endAt     DateTime
  status    AvailabilityBlockStatus @default(DRAFT)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, startAt])
  @@index([trainerId, status, startAt])
}

model TrainerSchedulePublication {
  id          String   @id @default(cuid())
  trainerId   String
  periodStart DateTime
  periodEnd   DateTime
  publishedAt DateTime @default(now())

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, periodStart])
}

model PersonalTrainingBooking {
  id                 String                @id @default(cuid())
  trainerId          String
  clientId           String
  startAt            DateTime
  endAt              DateTime
  status             PersonalBookingStatus @default(CONFIRMED)
  origin             PersonalBookingOrigin @default(CLIENT_BOOKED)
  clientCompletedAt  DateTime?
  trainerCompletedAt DateTime?
  workoutSheet       Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  trainer      User                          @relation("TrainerPersonalBookings", fields: [trainerId], references: [id], onDelete: Cascade)
  client       User                          @relation("ClientPersonalBookings", fields: [clientId], references: [id], onDelete: Cascade)
  sessionGoals PersonalTrainingSessionGoal[]

  @@unique([trainerId, startAt])
  @@index([trainerId, startAt])
  @@index([clientId])
}

model PersonalTrainingSessionGoal {
  id               String   @id @default(cuid())
  bookingId        String
  title            String
  notes            String?
  sortOrder        Int      @default(0)
  clientConfirmed  Boolean  @default(false)
  trainerConfirmed Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  booking PersonalTrainingBooking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tasks   PersonalTrainingSessionTask[]

  @@index([bookingId])
}

model PersonalTrainingSessionTask {
  id               String   @id @default(cuid())
  goalId           String
  title            String
  sortOrder        Int      @default(0)
  clientConfirmed  Boolean  @default(false)
  trainerConfirmed Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  goal PersonalTrainingSessionGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GroupClassBooking {
  id            String                  @id @default(cuid())
  clientId      String
  appointmentId String
  title         String
  trainerName   String?
  startAt       DateTime
  endAt         DateTime
  status        GroupClassBookingStatus @default(CONFIRMED)
  cancelledAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, appointmentId])
  @@index([clientId, startAt])
  @@index([clientId, status])
}

model GroupClassWaitlistEntry {
  id            String                   @id @default(cuid())
  clubId        String
  clientId      String
  appointmentId String
  title         String
  trainerName   String?
  startAt       DateTime
  endAt         DateTime
  position      Int
  status        GroupClassWaitlistStatus @default(WAITING)
  notifiedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, appointmentId])
  @@index([appointmentId, status, position])
  @@index([clubId, appointmentId])
}

model GroupClassWaitlistOpenEvent {
  id              String    @id @default(cuid())
  clubId          String
  appointmentId   String
  openedAt        DateTime  @default(now())
  firstNotifiedAt DateTime?
  restNotifiedAt  DateTime?
  resolvedAt      DateTime?

  @@index([appointmentId, resolvedAt])
  @@index([clubId, appointmentId])
}

model Conversation {
  id            String           @id @default(cuid())
  clubId        String
  clientId      String
  kind          ConversationKind
  trainerId     String?
  conversationKey String         @unique
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  client   User          @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  trainer  User?         @relation("TrainerConversations", fields: [trainerId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([clubId, lastMessageAt])
  @@index([clientId])
  @@index([trainerId])
}

model ChatMessage {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model ClubVisit {
  id         String      @id @default(cuid())
  userId     String
  clubId     String
  visitedAt  DateTime
  visitDate  String
  source     VisitSource
  externalId String?
  /// Only verified day-facts count for streak / loyalty / challenges.
  verified   Boolean     @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId, visitDate])
  @@index([userId, visitedAt])
  @@index([userId, verified, visitedAt])
}

/// Individual visit event (1C document or FitGO booking). History UI reads this.
model ClubVisitEvent {
  id           String            @id @default(cuid())
  userId       String
  clubId       String
  /// Dedup key: "1c:{externalId}" | "booking:{id}" | "self:{bookingId}"
  externalKey  String
  kind         VisitKind         @default(UNKNOWN)
  verification VisitVerification @default(PENDING)
  source       VisitSource
  externalId   String?
  bookingId    String?
  title        String?
  occurredAt   DateTime
  visitDate    String
  checkIn      String?
  checkOut     String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId, externalKey])
  @@index([userId, visitDate])
  @@index([userId, kind, visitDate])
  @@index([bookingId])
  @@index([externalId])
}

model LoyaltyProfile {
  userId            String        @id
  peakTier          LeagueTier    @default(BRONZE)
  currentTier       LeagueTier    @default(BRONZE)
  status            LoyaltyStatus @default(ACTIVE)
  continuityMonths  Int           @default(0)
  lastVisitAt       DateTime?
  frozenAt          DateTime?
  reactivatedAt     DateTime?
  downgradeCount    Int           @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientRating {
  userId                    String     @id
  clubId                    String
  leagueTier                LeagueTier @default(BRONZE)
  weeklyXp                  Int        @default(0)
  monthlyXp                 Int        @default(0)
  lifetimeXp                Int        @default(0)
  lastAppActivityAt         DateTime?
  consecutiveInactiveMonths Int        @default(0)
  leagueGroupId             String?
  ratingProtectedUntil      DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueGroup LeagueGroup? @relation(fields: [leagueGroupId], references: [id], onDelete: SetNull)

  @@index([clubId, leagueTier])
}

model LeagueGroup {
  id         String     @id @default(cuid())
  clubId     String
  leagueTier LeagueTier
  weekStart  DateTime   @db.Date
  weekEnd    DateTime   @db.Date

  members       LeagueGroupMember[]
  clientRatings ClientRating[]
}

model LeagueGroupMember {
  id            String @id @default(cuid())
  leagueGroupId String
  userId        String
  weeklyXp      Int    @default(0)

  leagueGroup LeagueGroup @relation(fields: [leagueGroupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueGroupId, userId])
  @@index([userId])
}

model ClientBodyProfile {
  userId           String   @id
  heightCm         Float?
  targetWeightKg   Float?
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClientBodyLog {
  id           String        @id @default(cuid())
  clientId     String
  recordedById String?
  source       BodyLogSource
  recordedAt   DateTime      @default(now())
  weightKg     Float?
  chestCm      Float?
  waistCm      Float?
  hipsCm       Float?
  bicepsCm     Float?
  thighCm      Float?
  bodyFatPct   Float?
  notes        String?

  client     User  @relation("ClientBodyLogs", fields: [clientId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("RecordedBodyLogs", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([clientId, recordedAt])
}

model WorkoutLog {
  id          String        @id @default(cuid())
  userId      String
  type        WorkoutType
  startedAt   DateTime
  durationMin Int
  distanceKm  Float?
  calories    Int?
  source      WorkoutSource @default(MANUAL)
  verified    Boolean       @default(false)
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model AdminPermissionGrant {
  id         String          @id @default(cuid())
  userId     String
  permission AdminPermission

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

model AdminTask {
  id          String          @id @default(cuid())
  clubId      String
  assigneeId  String
  createdById String
  title       String
  description String?
  dueAt       DateTime?
  status      AdminTaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  assignee  User @relation("AdminTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User @relation("AdminTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([clubId, assigneeId, status])
  @@index([clubId, status])
}

model StaffAuditLog {
  id        String   @id @default(cuid())
  clubId    String
  actorId   String
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  club  Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actor User @relation("StaffAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([clubId, createdAt])
  @@index([actorId])
}
