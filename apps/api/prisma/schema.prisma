generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  TRAINER
  SPECIALIST
  TECH
  ADMIN
  MANAGER
  SUPER_ADMIN
}

enum StaffEmploymentKind {
  STAFF
  EXTERNAL
}

enum AdminPermission {
  DASHBOARD_VIEW
  CLIENTS_VIEW
  CLIENTS_MESSAGE
  AT_RISK_VIEW
  FUNNEL_VIEW
  REPORTS_VIEW
  REPORTS_EDIT
  SETTINGS_BRANDING
  NOTIFICATIONS_SEND
}

enum AdminTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ClubCrmLinkStatus {
  LINKED
  PENDING_CRM
}

enum NotificationType {
  BOOKING_REMINDER
  MEMBERSHIP_EXPIRING
  INACTIVITY
  MILESTONE
  CHALLENGE
  RATING_DECAY
  GENERAL
  WAITLIST_SPOT
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum VisitSource {
  ONEC_SYNC
  APP_GEOFENCE
  APP_QR
  BOOKING_GROUP
  BOOKING_PT
  TRAINER_CONFIRM
  CLIENT_SELF_CONFIRM
}

enum VisitKind {
  GYM
  GROUP
  PT
  SPA_MASSAGE
  SPA_BODYCOMP
  SOLARIUM
  UNKNOWN
}

enum VisitVerification {
  PENDING
  VERIFIED_1C
  VERIFIED_TRAINER
  VERIFIED_CLIENT_SELF
  REJECTED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  RUBY
  EMERALD
  DIAMOND
  OBSIDIAN
}

enum LoyaltyStatus {
  ACTIVE
  FROZEN
  REACTIVATED
}

enum BadgeDataScope {
  SINCE_INSTALL
  HISTORICAL
}

enum BodyLogSource {
  CLIENT_SELF
  TRAINER
}

enum WorkoutType {
  RUNNING
  CYCLING
  STRENGTH
  YOGA
  HIIT
  WALKING
  SWIMMING
  OTHER
}

enum WorkoutSource {
  MANUAL
  APPLE_HEALTH
  GOOGLE_FIT
  GARMIN
}

enum NotificationStatus {
  PENDING
  COMPLETED
}

enum PersonalBookingStatus {
  PENDING_1C
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum AvailabilityBlockStatus {
  DRAFT
  PUBLISHED
}

enum PersonalBookingOrigin {
  CLIENT_BOOKED
  TRAINER_ASSIGNED
}

enum SpaServiceKind {
  MASSAGE
  BODY_COMPOSITION
  WRAP
}

enum SpaPaymentType {
  QUOTA
  PAID
}

/// How a SPA booking is tied to a 1C client or document.
enum SpaOneCLinkStatus {
  NOT_LINKED
  LINKED
}

enum SpaBookingOrigin {
  CLIENT_BOOKED
  SPECIALIST_ASSIGNED
  ADMIN_ASSIGNED
}

enum SpaBookingStatus {
  PENDING_1C
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum SpaWaitlistStatus {
  WAITING
  FULFILLED
  CANCELLED
  EXPIRED
}

/// Atomic claim for SPA consume-to-1C (prevents double post).
enum SpaConsumeState {
  IN_PROGRESS
  DONE
  FAILED
}

/// Кто отменил SPA-запись (для истории клиента).
enum SpaCancelledBy {
  CLIENT
  SPECIALIST
  ADMIN
  /// Отменено / удалено администратором в 1С (подтянуто синхронизацией)
  CRM_ADMIN
}

enum AccountStatus {
  ACTIVE
  SHADOW
}

enum TrainerClientLinkStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum TrainerClientSource {
  MANUAL
  INVITE
}

enum TrainerClientInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum GroupClassBookingStatus {
  PENDING_1C
  CONFIRMED
  CANCELLED
  COMPLETED
  FAILED
}

enum GroupBookingOrigin {
  CLIENT_BOOKED
  STAFF_BOOKED
  ADMIN_BOOKED
  /// Enrollment mirrored from 1C class session member (not booked in FitGO).
  ONEC_IMPORTED
}

enum ClubSyncTrigger {
  NIGHTLY
  MANUAL
  /// On-demand background refresh (trainer screens, etc.).
  AUTO
}

enum ClubSyncProfile {
  FULL
  LIGHT
  /// Today-only: classes, visits, schedule slots (no sales/debts).
  TODAY
}

enum ClubSyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Dual-gate control for service usage (SPA / PT / group).
enum ServiceControlLevel {
  BASE
  ELEVATED
}

enum ServicePresenceStatus {
  PENDING
  VERIFIED_1C
  ADMIN_OVERRIDE
}

enum ServicePerformanceStatus {
  PENDING
  CONFIRMED_BY_PERFORMER
  REJECTED
}

enum ServiceUsageStatus {
  BOOKED
  NO_SHOW
  ATTENDED
  CONSUMED
  CANCELLED
}

enum ServicePaymentStatus {
  N_A
  PENDING_PAYMENT
  DEBT
  PAID
}

/// L0 anti-padding trust for payroll eligibility.
enum TrustBand {
  GREEN
  AMBER
  RED
}

enum TrustResolution {
  NONE
  RESOLVED
}

enum GroupClassSessionStatus {
  OPEN
  SUBMITTED
  AUTO_READY
  NEEDS_ADMIN
  APPROVED
  LOCKED
}

enum GroupSessionBaselineQuality {
  FULL
  PARTIAL
}

enum GroupSessionMemberSource {
  BASELINE_1C
  TRAINER_ADDED
  ADMIN_ADDED
}

enum GroupSessionMemberAttendance {
  EXPECTED
  ATTENDED
  NO_SHOW
  REMOVED
}

/// Snapshot of Документ.Занятие from FitGOIntegration class-sessions sync.
enum OnexClassKind {
  GROUP
  PT
  SPA
  SOLARIUM
}

enum OnexClassStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OnexClassMemberAttendance {
  EXPECTED
  ATTENDED
  NO_SHOW
  CANCELLED
}

/// Remark on a class/session row in «Контроль записей».
enum SessionRemarkKind {
  GROUP
  PT
  SPA
  SOLARIUM
}

enum SessionRemarkStatus {
  OPEN
  CLOSED
}

enum MotivationRateKind {
  SPA_SERVICE
  SPA_KIND
  PT
  GROUP
}

enum MotivationRateType {
  PERCENT_OF_PRICE
  FIXED_PER_SESSION
  FIXED_PER_ATTENDEE
}

enum PtClientIssue {
  NONE
  WRONG_PHONE
  CRM_UNMATCHED
  IDENTITY_MISMATCH
}

enum PtSessionPayKind {
  UNKNOWN
  GIFT
  BLOCK
  PAID
}

enum TrainerShiftStatus {
  PLANNED
  OPEN
  CLOSED
}

enum TrainerDaySheetStatus {
  DRAFT
  TRAINER_SUBMITTED
  ADMIN_REVIEW
  ADMIN_APPROVED
  SA_APPROVED
  LOCKED
}

enum StaffShiftTrack {
  ADMIN
  TRAINER
  TECH
}

enum GroupClassWaitlistStatus {
  WAITING
  NOTIFIED
  CONFIRMED
  CANCELLED
}

enum ConversationKind {
  ADMIN
  TRAINER
  TRAINER_ADMIN
}

model Club {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  address      String?
  phone        String?
  website      String?
  externalId   String?  @unique
  currency     String   @default("BYN")
  /// Club opening hours Mon–Sun: { monday: { open, close, closed }, ... }
  workingHours Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                User[]
  oneCConfig           Club1CConfig?
  dailyReports         DailyReport[]
  theme                ClubTheme?
  challenges           Challenge[]
  referralRewardDesc   String   @default("Скидка 10% на следующий абонемент")
  adminTasks           AdminTask[]
  staffAuditLogs       StaffAuditLog[]
  clubMemberships      UserClubMembership[]
  spaServices          SpaService[]
  spaQuotaRules        SpaQuotaRule[]
  spaBookings          SpaBooking[]
  spaWaitlistEntries   SpaWaitlistEntry[]
  groupClassSessions   GroupClassSession[]
  staffCompensations   StaffCompensation[]
  motivationRates      MotivationRate[]
  payrollAdjustments   PayrollAdjustment[]
  payrollPeriodLocks   PayrollPeriodLock[]
  payrollPayouts       PayrollPayout[]
  payrollCorporateSales PayrollCorporateSale[]
  payrollStaffBalances PayrollStaffBalance[]
  trainerShifts        TrainerShift[]
  trainerDaySheets     TrainerDaySheet[]
  staffShifts          StaffShift[]
  saleTransactions     SaleTransaction[]
  salesSyncStates      SalesSyncState[]
  clubRevenueEntries   ClubRevenueEntry[]
  clubRevenueManuals   ClubRevenueManualEntry[]
  catalogProducts      CatalogProduct[]
  segmentSyncStates    SegmentSyncState[]
  onexClassSessions    OnexClassSession[]
  clubHallVisits       ClubHallVisit[]
  sessionRemarks       SessionRemark[]
  hallClassSnapshots   HallClassSnapshot[]
  groupClassApprovals  GroupClassApproval[]
  sessionApprovals     SessionApproval[]
  spaRooms             SpaRoom[]
  clubSyncRuns         ClubSyncRun[]
  clubScheduleSlots    ClubScheduleSlot[]
  clubMembershipSnapshots ClubMembershipSnapshot[]
  trainerPtSales       TrainerPtSale[]
  specialistServiceDebts SpecialistServiceDebt[]
}

model ClubTheme {
  id           String  @id @default(cuid())
  clubId       String  @unique
  logoUrl      String?
  primaryColor String  @default("#14b88a")
  customDomain String?

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

/// Stand-wide product module toggles (super-admin). Default ON except catalog defaults.
model AppFeatureFlags {
  id        String   @id @default("default")
  modules   Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Club1CConfig {
  id        String   @id @default(cuid())
  clubId    String   @unique
  baseUrl   String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model User {
  id         String   @id @default(cuid())
  clubId     String?
  email      String   @unique
  password   String
  phone      String?
  phoneNormalized String? @unique
  accountStatus   AccountStatus @default(ACTIVE)
  createdByTrainerId String?
  activatedAt     DateTime?
  firstName  String
  lastName   String
  externalId String?
  /// 1C client card linked to this staff (same FIO/phone as «Как клиент»).
  staffClientExternalId String?
  /// Код сотрудника в 1С (например 000000151). Для выборок по сотруднику.
  employeeCode String?
  /// true — тренер группы «Тренеры ГП» (ставки занятий).
  groupPrograms Boolean @default(false)
  /// true — тренер группы «Тренеры штат» (оклад, час, аванс, % ПТ).
  trainerStaff Boolean @default(false)
  /// true — тренер группы «Тренеры клуб» (% ПТ без оклада и аванса).
  trainerClub Boolean @default(false)
  /// false — группы ещё не выбирали; список Staff один раз относит не-ГП тренеров в штат.
  trainerGroupsSet Boolean @default(false)
  /// false — учётка есть, пароль входа ещё не выдан.
  loginEnabled Boolean @default(true)
  referralCode String? @unique
  gender        Gender?
  dateOfBirth   DateTime? @db.Date
  profileCompletedAt DateTime?
  gamificationNickname String?
  useRealNameInPublic  Boolean @default(true)
  gamificationStartedAt DateTime?
  isActive              Boolean  @default(true)
  /// When set, employee is archived (hidden from active staff lists; sync will not re-add).
  archivedAt            DateTime?
  /// STAFF = штат; EXTERNAL = сторонние специалисты (отдельная секция ЗП).
  employmentKind        StaffEmploymentKind @default(STAFF)
  createdById           String?
  osmiCardId            String?
  osmiBarcode           String?
  osmiSyncedAt          DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  club                 Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("StaffCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  shadowCreatedBy      User?                  @relation("ShadowCreatedBy", fields: [createdByTrainerId], references: [id], onDelete: SetNull)
  shadowsCreated       User[]                 @relation("ShadowCreatedBy")
  roles                UserRole[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  notificationPrefs    NotificationPreference?
  badges               UserBadge[]
  gamificationPoints   Int                    @default(0)
  referredById         String?
  referrals            Referral[]             @relation("Referrer")
  referredBy           Referral?              @relation("Referred")
  trainerNotes         TrainerNote[]          @relation("TrainerNotes")
  clientNotes          TrainerNote[]          @relation("ClientNotes")
  clientGoals          ClientGoal[]           @relation("ClientGoals")
  trainerGoals         ClientGoal[]           @relation("TrainerGoals")
  measurements         ClientMeasurement[]    @relation("ClientMeasurements")
  recordedMeasurements ClientMeasurement[]    @relation("RecordedMeasurements")
  challengeEntries     ChallengeEntry[]
  wearableSyncs        WearableSync[]
  trainerWorkSlots     TrainerWorkSlot[]
  trainerAvailabilityBlocks TrainerAvailabilityBlock[]
  trainerSchedulePublications TrainerSchedulePublication[]
  trainerPersonalBookings PersonalTrainingBooking[] @relation("TrainerPersonalBookings")
  clientPersonalBookings  PersonalTrainingBooking[] @relation("ClientPersonalBookings")
  specialistWorkSlots             SpecialistWorkSlot[]
  specialistAvailabilityBlocks    SpecialistAvailabilityBlock[]
  specialistSchedulePublications  SpecialistSchedulePublication[]
  specialistSpaBookings           SpaBooking[] @relation("SpecialistSpaBookings")
  clientSpaBookings               SpaBooking[] @relation("ClientSpaBookings")
  specialistSpaWaitlist           SpaWaitlistEntry[] @relation("SpecialistSpaWaitlist")
  clientSpaWaitlist               SpaWaitlistEntry[] @relation("ClientSpaWaitlist")
  createdSpaWaitlist              SpaWaitlistEntry[] @relation("CreatedSpaWaitlist")
  specialistServices              SpecialistService[]
  spaQuotaRuleSpecialists         SpaQuotaRuleSpecialist[]
  groupClassBookings      GroupClassBooking[]
  groupClassWaitlist      GroupClassWaitlistEntry[]
  sentNotifications       Notification[]          @relation("NotificationSender")
  clientConversations     Conversation[]          @relation("ClientConversations")
  trainerConversations    Conversation[]          @relation("TrainerConversations")
  chatMessages            ChatMessage[]           @relation("ChatMessageSender")
  clubVisits              ClubVisit[]
  clubVisitEvents         ClubVisitEvent[]
  loyaltyProfile          LoyaltyProfile?
  clientRating            ClientRating?
  leagueGroupMembers      LeagueGroupMember[]
  bodyProfile             ClientBodyProfile?
  trainingProfile         ClientTrainingProfile?
  bodyLogs                ClientBodyLog[]         @relation("ClientBodyLogs")
  recordedBodyLogs        ClientBodyLog[]         @relation("RecordedBodyLogs")
  workoutLogs             WorkoutLog[]
  adminTasksAssigned      AdminTask[]            @relation("AdminTaskAssignee")
  adminTasksCreated       AdminTask[]            @relation("AdminTaskCreator")
  adminTaskEvents         AdminTaskEvent[]       @relation("AdminTaskEventActor")
  adminPermissions        AdminPermissionGrant[]
  staffCreated            User[]                 @relation("StaffCreatedBy")
  staffAuditLogs          StaffAuditLog[]        @relation("StaffAuditActor")
  trainerRosterClients    TrainerClientLink[]    @relation("TrainerRoster")
  clientRosterTrainers    TrainerClientLink[]    @relation("ClientRoster")
  trainerClientInvites    TrainerClientInvite[]  @relation("TrainerClientInvites")
  clubMemberships         UserClubMembership[]
  groupClassSessionsLed   GroupClassSession[]  @relation("GroupSessionTrainer")
  staffCompensation       StaffCompensation[]
  payrollAdjustments      PayrollAdjustment[]
  payrollPayouts          PayrollPayout[]
  payrollCorporateSales   PayrollCorporateSale[]
  payrollStaffBalances    PayrollStaffBalance[]
  trainerShifts           TrainerShift[]          @relation("TrainerShifts")
  trainerDaySheets        TrainerDaySheet[]       @relation("TrainerDaySheets")
  daySheetsAdminApproved  TrainerDaySheet[]       @relation("DaySheetAdminApprover")
  daySheetsSaApproved     TrainerDaySheet[]       @relation("DaySheetSaApprover")
  staffShifts             StaffShift[]            @relation("StaffShifts")
  sessionRemarksStaff     SessionRemark[]         @relation("SessionRemarkStaff")
  sessionRemarksAdmin     SessionRemark[]         @relation("SessionRemarkAdmin")
  groupApprovalsTrainer   GroupClassApproval[]    @relation("GroupApprovalTrainer")
  groupApprovalsAdmin     GroupClassApproval[]    @relation("GroupApprovalAdmin")
  groupApprovalsOverride  GroupClassApproval[]    @relation("GroupApprovalOverride")
  groupApprovalsReturned  GroupClassApproval[]    @relation("GroupApprovalReturnedBy")
  staffProfile            StaffProfile?
  sessionApprovalsAdmin   SessionApproval[]       @relation("SessionApprovalAdmin")
  sessionApprovalsOverride SessionApproval[]      @relation("SessionApprovalOverride")
  defaultSpaRoom          SpaRoom?                @relation("SpaRoomDefaultSpecialist", fields: [defaultSpaRoomId], references: [id], onDelete: SetNull)
  defaultSpaRoomId        String?

  @@unique([clubId, gamificationNickname])
  @@unique([clubId, employeeCode])
  @@index([externalId])
  @@index([clubId, employeeCode])
}

/// Public bio + photo for trainers / SPA specialists (editable by staff).
model StaffProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  bio             String    @db.Text @default("")
  photoPath       String?
  photoThumbPath  String?
  photoUpdatedAt  DateTime?
  bioUpdatedAt    DateTime?
  /// Admin can hide bio/photo from clients without deleting.
  hiddenByAdminAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SessionApprovalKind {
  PT
  SPA
}

/// Payroll gate for PT / SPA bookings (mirrors GroupClassApproval phases).
model SessionApproval {
  id                   String              @id @default(cuid())
  clubId               String
  kind                 SessionApprovalKind
  bookingId            String
  performerConfirmedAt DateTime?
  adminApprovedAt      DateTime?
  adminApprovedById    String?
  overrideApprovedAt   DateTime?
  overrideApprovedById String?
  returnedAt           DateTime?
  returnReason         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  club         Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  adminUser    User? @relation("SessionApprovalAdmin", fields: [adminApprovedById], references: [id], onDelete: SetNull)
  overrideUser User? @relation("SessionApprovalOverride", fields: [overrideApprovedById], references: [id], onDelete: SetNull)

  @@unique([kind, bookingId])
  @@index([clubId, kind, adminApprovedAt])
  @@index([clubId, kind, performerConfirmedAt])
}

/// Optional SPA cabinet / room for conflict checks.
model SpaRoom {
  id        String   @id @default(cuid())
  clubId    String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club               Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  defaultSpecialists User[] @relation("SpaRoomDefaultSpecialist")

  @@unique([clubId, name])
  @@index([clubId, isActive])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model UserClubMembership {
  id            String             @id @default(cuid())
  userId        String
  clubId        String
  externalId    String?
  crmStatus     ClubCrmLinkStatus?
  lastCrmSyncAt DateTime?
  joinedAt      DateTime           @default(now())
  leftAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
  @@index([externalId])
  @@index([crmStatus])
}

model TrainerClientLink {
  id               String                  @id @default(cuid())
  trainerId        String
  clientId         String
  status           TrainerClientLinkStatus @default(PENDING)
  source           TrainerClientSource     @default(MANUAL)
  notes            String?
  clientAcceptedAt DateTime?
  createdAt        DateTime                @default(now())
  confirmedAt      DateTime?

  trainer User @relation("TrainerRoster", fields: [trainerId], references: [id], onDelete: Cascade)
  client  User @relation("ClientRoster", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerId, clientId])
  @@index([trainerId, status])
  @@index([clientId])
}

model TrainerClientInvite {
  id              String                    @id @default(cuid())
  trainerId       String
  phoneNormalized String
  clientId        String?
  status          TrainerClientInviteStatus @default(PENDING)
  createdAt       DateTime                  @default(now())
  expiresAt       DateTime?
  respondedAt     DateTime?

  trainer User @relation("TrainerClientInvites", fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([phoneNormalized, status])
  @@index([clientId])
}

model DailyReport {
  id        String   @id @default(cuid())
  clubId    String
  date      DateTime @db.Date
  revenue   Float
  problems  String?
  ideas     String?
  createdBy String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, date])
}

model Notification {
  id        String             @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean            @default(false)
  status    NotificationStatus @default(PENDING)
  senderId  String?
  createdAt DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  bookingReminders    Boolean @default(true)
  membershipAlerts    Boolean @default(true)
  inactivityAlerts    Boolean @default(true)
  milestoneAlerts     Boolean @default(true)
  ratingDecayAlerts   Boolean @default(true)
  marketingAlerts     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String
  threshold   Int?
  category    String?
  tier        String?
  icon        String?
  dataScope   BadgeDataScope @default(SINCE_INSTALL)

  users UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Challenge {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  targetVisits Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  club    Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  entries ChallengeEntry[]
}

model ChallengeEntry {
  id          String @id @default(cuid())
  challengeId String
  userId      String
  visits      Int    @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String   @unique
  createdAt    DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
}

model TrainerNote {
  id        String   @id @default(cuid())
  trainerId String
  clientId  String
  content   String
  createdAt DateTime @default(now())

  trainer User @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: Cascade)
