/// Club pays in two waves: 25th = advance for days 1–15; 15th = settlement for previous month.
enum PayrollPayoutKind {
  /// 25th: earn for current month days 1–15 (or fixed advance for admins).
  ADVANCE_HALF
  /// 15th: full previous month minus already paid ADVANCE_HALF.
  MONTH_SETTLEMENT
}

enum PayrollPayoutStatus {
  DRAFT
  PAID
  VOID
}

model PayrollPayout {
  id                String              @id @default(cuid())
  clubId            String
  userId            String
  kind              PayrollPayoutKind
  periodFrom        DateTime            @db.Date
  periodTo          DateTime            @db.Date
  /// Gross earned for this payout window (before deducting prior advance).
  earnedMinor       Int
  /// Already paid as ADVANCE_HALF for the same calendar month (settlement only).
  priorPaidMinor    Int                 @default(0)
  /// Net accrued for this payout (earned − priorPaid), before carry-in.
  totalMinor        Int
  /// Bank card transfer (accountant).
  cardTransferMinor Int                 @default(0)
  /// Suggested cash = payable − card (legacy / default).
  cashMinor         Int
  /// Fact paid from cash (may differ for rounding).
  actualCashMinor   Int                 @default(0)
  /// Carry balance applied into this payout (+ underpay / − overpay).
  carryInMinor      Int                 @default(0)
  /// Balance after payout: payable − (card + actualCash).
  carryOutMinor     Int                 @default(0)
  currency          String              @default("BYN")
  status            PayrollPayoutStatus @default(DRAFT)
  paidAt            DateTime?
  note              String?
  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, kind, periodFrom, periodTo])
  @@index([clubId, userId, status])
}

/// Per-employee rounding / under-over pay balance for next open payout.
